// ═══════════════════════════════════════════════════════════════
// THE PANEL
// ═══════════════════════════════════════════════════════════════
// Buys first, then the ones a single condition away, then the watchlist.
// Everything that is a flat no is hidden unless you ask for it, because a
// scanner that lists forty names has not narrowed anything down.
pPos = sPos == "Top Left" ? position.top_left : sPos == "Bottom Right" ? position.bottom_right : sPos == "Bottom Left" ? position.bottom_left : sPos == "Middle Right" ? position.middle_right : position.top_right
pSz  = sSize == "Tiny" ? size.tiny : sSize == "Normal" ? size.normal : size.small

var table sc = table.new(pPos, 3, 42, border_width = 1)

f_cell(int _c, int _r, string _s, color _bg, color _tx) =>
    table.cell(sc, _c, _r, _s, text_color = _tx, bgcolor = _bg, text_halign = text.align_left, text_size = pSz)

if barstate.islast
    table.clear(sc, 0, 0, 2, 41)
    _n = array.size(rSym)
    _buys = 0
    for _i = 0 to (_n > 0 ? _n - 1 : 0)
        if _n > 0 and array.get(rVer, _i) == 3
            _buys := _buys + 1
    _mName = chartMkt == 2 ? "INDIA" : chartMkt == 3 ? "CRYPTO" : "US"
    f_cell(0, 0, "STAGE SCANNER · " + _mName, color.new(#1a237e, 0), color.white)
    f_cell(1, 0, _buys > 0 ? "✅ " + str.tostring(_buys) + " TO BUY" : "nothing to buy — see triggers", _buys > 0 ? color.new(#00c853, 0) : color.new(color.gray, 30), color.white)
    _tfBad = scanTf != "D" and scanTf != "1D"
    f_cell(2, 0, _tfBad ? "⚠ " + scanTf + " — the 200-day is now 200 " + scanTf + " bars" : str.tostring(_n) + " " + _mName + " symbols on " + scanTf, _tfBad ? color.new(#b71c1c, 0) : color.new(#1a237e, 0), color.white)
    _r = 1
    // 3 then 2 then 1; a flat no only when asked for
    _done = array.new<bool>(math.max(_n, 1), false)
    for _want = 3 to 1
        for _k = 0 to (_n > 0 ? _n - 1 : 0)
            _pick = -1
            _near = 1.0e9
            for _i = 0 to (_n > 0 ? _n - 1 : 0)
                if _n > 0 and not array.get(_done, _i) and array.get(rVer, _i) == _want and array.get(rGap, _i) < _near
                    _near := array.get(rGap, _i)
                    _pick := _i
            if _pick >= 0 and _r < 41
                _i = _pick
                array.set(_done, _i, true)
                _v = array.get(rVer, _i)
                _bg = _v == 3 ? color.new(#00c853, 0) : _v == 2 ? color.new(#2e7d32, 35) : color.new(color.gray, 45)
                f_cell(0, _r, array.get(rSym, _i), _bg, color.white)
                f_cell(1, _r, _v == 3 ? "✅ BUY" : _v == 2 ? "► hold" : "👁 watch", _bg, color.white)
                f_cell(2, _r, array.get(rWhy, _i), _bg, color.white)
                _r := _r + 1
    if showAll
        for _i = 0 to (_n > 0 ? _n - 1 : 0)
            if _n > 0 and _r < 41 and array.get(rVer, _i) == 0
                f_cell(0, _r, array.get(rSym, _i), color.new(#b71c1c, 30), color.white)
                f_cell(1, _r, "⛔ no", color.new(#b71c1c, 30), color.white)
                f_cell(2, _r, array.get(rWhy, _i), color.new(#b71c1c, 30), color.white)
                _r := _r + 1
    array.clear(rGap)
    array.clear(rSym)
    array.clear(rVer)
    array.clear(rWhy)

// One alert for the whole list, so a name turning while you are on another
// chart still reaches you.
alertcondition(true, title = "Stage Scanner — something turned to BUY", message = "Stage Scanner: at least one symbol now reads BUY on {{interval}}")
