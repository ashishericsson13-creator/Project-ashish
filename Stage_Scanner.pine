// ═══════════════════════════════════════════════════════════════
// THE SCAN
// ═══════════════════════════════════════════════════════════════
// Everything below runs inside each symbol's own context, so close, volume
// and the averages refer to that symbol rather than the chart. One request
// call each, which is what keeps 38 of them inside the budget.
//
// Higher highs and higher lows are measured as this swing window against the
// one before it. That is coarser than the pivot store the Wyckoff panel uses
// and it has to be: a pivot store cannot be carried across a request.
f_state() =>
    _d200 = ta.sma(close, 200)
    _d50  = ta.sma(close, 50)
    _ref  = _d200[slopeN]
    _slp  = na(_ref) or _ref <= 0 ? na : (_d200 - _ref) / _ref * 100
    _up   = not na(_slp) and _slp > flatPct
    _dn   = not na(_slp) and _slp < -flatPct
    _hh   = ta.highest(high, swingN) > ta.highest(high, swingN)[swingN]
    _hl   = ta.lowest(low, swingN) > ta.lowest(low, swingN)[swingN]
    _va   = ta.sma(volume, 20)
    _vx   = na(_va) or _va <= 0 ? na : volume / _va
    _abv  = not na(_d200) and close > _d200
    // 2 advancing, 4 declining, 3 above a stalled average, 1 basing
    _stage = _abv and _up and _hh and _hl ? 2 : not _abv and _dn and not _hh and not _hl ? 4 : _abv ? 3 : 1
    _dip  = _abv and not na(_d50) and low <= _d50 * (1 + dipNear / 100) and (na(_vx) or _vx <= dipVol)
    _bHi  = ta.highest(high, baseN)[1]
    _bLo  = ta.lowest(low, baseN)[1]
    _base = not na(_bLo) and _bLo > 0 and (_bHi - _bLo) / _bLo * 100 <= baseW
    _brk  = _base and close > _bHi and not na(_vx) and _vx >= brkVol and close > close[1]
    [_stage, _dip ? 1 : 0, _brk ? 1 : 0, close, close[rsLen], _d50, _base ? _bHi : na]

var array<string> rSym = array.new<string>()
var array<int>    rVer = array.new<int>()
var array<string> rWhy = array.new<string>()
var array<float>  rGap = array.new<float>()

// 1 US, 2 India, 3 crypto — taken from the symbol string rather than from
// which input slot it sits in, so any slot can hold anything.
f_mkt(string _s) =>
    _u = str.upper(_s)
    str.contains(_u, "NSE:") or str.contains(_u, "BSE:") ? 2 : str.contains(_u, "USDT") or str.contains(_u, "USD.P") or str.contains(_u, "BINANCE") or str.contains(_u, "COINBASE") or str.contains(_u, "BITSTAMP") ? 3 : 1

f_label(string _s) =>
    _i = str.pos(_s, ":")
    na(_i) ? _s : str.substring(_s, _i + 1)

// The three benchmarks, declared ahead of f_push because it reads them.
benchPick = chartMkt == 2 ? rsBenc2 : chartMkt == 3 ? rsBenc3 : rsBench
[bNow, bOld] = request.security(benchPick, scanTf, [close, close[rsLen]], ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)

// 3 = buy, 2 = stage 2 with no entry, 1 = watchlist, 0 = no.
// Only the market you are looking at is collected, so a US chart never lists
// NSE names and the panel stays the length of one market.
f_push(string _sym, int _st, int _dp, int _bk, float _px, float _og, float _d50, float _bhi) =>
    _m = f_mkt(_sym)
    if barstate.islast and not na(_px)
        _b  = bNow
        _bo = bOld
        _rs = na(_og) or _og <= 0 or na(_b) or na(_bo) or _bo <= 0 ? false : _px / _og > _b / _bo
        _v = _st == 2 and (_bk == 1 or _dp == 1) and _rs ? 3 : _st == 2 ? 2 : _st == 1 ? 1 : 0
        // What would have to happen for this to become a buy, with the number.
        _gap = na(_d50) or _px <= 0 ? na : (_px - _d50) / _px * 100
        _trig = _v == 3 ? (_bk == 1 ? "BREAKOUT on volume, RS gaining" : "dip to the 50-day, RS gaining")
             : _v == 2 and not _rs ? "setup is there — needs RS to turn, see its chart"
             : _v == 2 and not na(_bhi) ? "buy a close above " + str.tostring(_bhi, format.mintick) + " on volume — " + str.tostring((_bhi - _px) / _px * 100, "#.#") + "% above"
             : _v == 2 and not na(_gap) and _gap > 0 ? "buy a dip to the 50-day " + str.tostring(_d50, format.mintick) + " — " + str.tostring(_gap, "#.#") + "% below"
             : _v == 2 ? "Stage 2, waiting for a dip or a base to form"
             : _v == 1 ? "basing — needs the 200-day to turn up and price to clear it"
             : _st == 4 ? "Stage 4 — stay away" : "above a stalled average"
        // how far the trigger is, so the list can lead with the nearest
        _dist = _v == 2 and not na(_bhi) ? math.abs(_bhi - _px) / _px * 100 : _v == 2 and not na(_gap) and _gap > 0 ? _gap : 999.0
        array.push(rGap, _dist)
        array.push(rSym, f_label(_sym))
        array.push(rVer, _v)
        array.push(rWhy, _trig)


[st01, dp01, bk01, px01, og01, md01, bh01] = request.security(sym01, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym01, st01, dp01, bk01, px01, og01, md01, bh01)
[st02, dp02, bk02, px02, og02, md02, bh02] = request.security(sym02, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym02, st02, dp02, bk02, px02, og02, md02, bh02)
