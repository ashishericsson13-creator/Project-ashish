us09 = input.symbol("LLY", "US #9", group = "2. US list")
in09 = input.symbol("NSE:SBIN", "India #9", group = "3. India list")
cr09 = input.symbol("BINANCE:LINKUSDT", "Crypto #9", group = "4. Crypto list")
us10 = input.symbol("UNH", "US #10", group = "2. US list")
in10 = input.symbol("NSE:AXISBANK", "India #10", group = "3. India list")
cr10 = input.symbol("BINANCE:DOTUSDT", "Crypto #10", group = "4. Crypto list")
us11 = input.symbol("V", "US #11", group = "2. US list")
in11 = input.symbol("NSE:KOTAKBANK", "India #11", group = "3. India list")
cr11 = input.symbol("BINANCE:TRXUSDT", "Crypto #11", group = "4. Crypto list")
us12 = input.symbol("JPM", "US #12", group = "2. US list")
in12 = input.symbol("NSE:HINDUNILVR", "India #12", group = "3. India list")
cr12 = input.symbol("BINANCE:LTCUSDT", "Crypto #12", group = "4. Crypto list")
us13 = input.symbol("XOM", "US #13", group = "2. US list")
in13 = input.symbol("NSE:BAJFINANCE", "India #13", group = "3. India list")
cr13 = input.symbol("BINANCE:BCHUSDT", "Crypto #13", group = "4. Crypto list")
us14 = input.symbol("CVX", "US #14", group = "2. US list")
in14 = input.symbol("NSE:MARUTI", "India #14", group = "3. India list")
cr14 = input.symbol("BINANCE:ATOMUSDT", "Crypto #14", group = "4. Crypto list")
us15 = input.symbol("COST", "US #15", group = "2. US list")
in15 = input.symbol("NSE:SUNPHARMA", "India #15", group = "3. India list")
cr15 = input.symbol("BINANCE:UNIUSDT", "Crypto #15", group = "4. Crypto list")
