//@version=6
// ═══════════════════════════════════════════════════════════════════════════
// STAGE SCANNER — "is it time to buy" across a whole watchlist
// ═══════════════════════════════════════════════════════════════════════════
// The Wyckoff panel answers that question for the chart you are looking at.
// This asks it of 38 symbols at once and shows only the ones worth your
// attention, so a name that turns while you are looking elsewhere does not go
// unnoticed.
//
// It is a separate script because Pine allows 40 request calls per indicator
// and the Wyckoff panel already spends 5 of its own. Here all 40 are free:
// 38 symbols plus one benchmark for relative strength.
//
// The rules are the same three the ★ IS IT TIME? row uses, in the same order:
//   the stage decides whether buying is allowed at all
//   a dip or a breakout decides whether now is the moment
//   relative strength decides whether this is the name worth owning
// What it does NOT do is replicate the full panel. A YES here means go and
// read that symbol's chart, not place an order.
// ═══════════════════════════════════════════════════════════════════════════
indicator("Stage Scanner", overlay = true, max_bars_back = 500)

scanTf  = input.timeframe("D", "Timeframe to scan", tooltip = "Daily keeps the 200-day a true 200-day whatever chart this sits on.", group = "1. Scan")
rsBench = input.symbol("AMEX:SPY", "Relative strength benchmark", group = "1. Scan")
rsLen   = input.int(26, "Relative strength lookback (bars)", minval = 5, maxval = 250, group = "1. Scan")
slopeN  = input.int(20, "Bars used to judge the 200-day slope", minval = 5, maxval = 120, group = "1. Scan")
flatPct = input.float(0.5, "Slope under this % counts as flat", minval = 0.0, maxval = 10.0, step = 0.1, group = "1. Scan")
swingN  = input.int(20, "Bars per swing when testing higher highs and lows", minval = 5, maxval = 100, group = "1. Scan")
dipNear = input.float(2.0, "A dip counts within this % of the 50-day", minval = 0.2, maxval = 15.0, step = 0.1, group = "1. Scan")
dipVol  = input.float(1.0, "Light volume is under this multiple", minval = 0.3, maxval = 2.0, step = 0.05, group = "1. Scan")
baseW   = input.float(15.0, "A base must be no wider than this (%) for a break of it to count", minval = 2.0, maxval = 60.0, step = 0.5, tooltip = "Without this the test is just a 10-bar high on volume, which fires on anything extended. The chart panel will not tick its pivot box without a base either, and the two must not disagree.", group = "1. Scan")
brkVol  = input.float(1.4, "Breakout volume multiple", minval = 1.0, maxval = 4.0, step = 0.05, group = "1. Scan")
showAll = input.bool(false, "Show every symbol, not just the ones that qualify", group = "4. Display")
sPos    = input.string("Top Right", "Panel position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group = "4. Display")
sSize   = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal"], group = "4. Display")

sym01 = input.symbol("NASDAQ:AAPL", "#1", group = "2. US symbols")
sym02 = input.symbol("NASDAQ:MSFT", "#2", group = "2. US symbols")
sym03 = input.symbol("NASDAQ:NVDA", "#3", group = "2. US symbols")
sym04 = input.symbol("NASDAQ:GOOGL", "#4", group = "2. US symbols")
sym05 = input.symbol("NASDAQ:AMZN", "#5", group = "2. US symbols")
sym06 = input.symbol("NASDAQ:META", "#6", group = "2. US symbols")
sym07 = input.symbol("NASDAQ:AVGO", "#7", group = "2. US symbols")
sym08 = input.symbol("NYSE:BRK.B", "#8", group = "2. US symbols")
sym09 = input.symbol("NYSE:LLY", "#9", group = "2. US symbols")
sym10 = input.symbol("NYSE:UNH", "#10", group = "2. US symbols")
sym11 = input.symbol("NYSE:V", "#11", group = "2. US symbols")
sym12 = input.symbol("NYSE:JPM", "#12", group = "2. US symbols")
sym13 = input.symbol("NYSE:XOM", "#13", group = "2. US symbols")
sym14 = input.symbol("NYSE:CVX", "#14", group = "2. US symbols")
sym15 = input.symbol("NASDAQ:COST", "#15", group = "2. US symbols")
sym16 = input.symbol("NYSE:KO", "#16", group = "2. US symbols")
sym17 = input.symbol("NYSE:NKE", "#17", group = "2. US symbols")
sym18 = input.symbol("NASDAQ:TSLA", "#18", group = "2. US symbols")
sym19 = input.symbol("NYSE:CRM", "#19", group = "2. US symbols")
sym20 = input.symbol("NSE:RELIANCE", "#20", group = "3. India symbols")
sym21 = input.symbol("NSE:HDFCBANK", "#21", group = "3. India symbols")
sym22 = input.symbol("NSE:TCS", "#22", group = "3. India symbols")
sym23 = input.symbol("NSE:INFY", "#23", group = "3. India symbols")
sym24 = input.symbol("NSE:ICICIBANK", "#24", group = "3. India symbols")
sym25 = input.symbol("NSE:BHARTIARTL", "#25", group = "3. India symbols")
sym26 = input.symbol("NSE:ITC", "#26", group = "3. India symbols")
sym27 = input.symbol("NSE:LT", "#27", group = "3. India symbols")
sym28 = input.symbol("NSE:SBIN", "#28", group = "3. India symbols")
sym29 = input.symbol("NSE:AXISBANK", "#29", group = "3. India symbols")
sym30 = input.symbol("NSE:KOTAKBANK", "#30", group = "3. India symbols")
sym31 = input.symbol("NSE:HINDUNILVR", "#31", group = "3. India symbols")
sym32 = input.symbol("NSE:BAJFINANCE", "#32", group = "3. India symbols")
sym33 = input.symbol("NSE:MARUTI", "#33", group = "3. India symbols")
sym34 = input.symbol("NSE:SUNPHARMA", "#34", group = "3. India symbols")
sym35 = input.symbol("NSE:TITAN", "#35", group = "3. India symbols")
sym36 = input.symbol("NSE:ASIANPAINT", "#36", group = "3. India symbols")
sym37 = input.symbol("NSE:NTPC", "#37", group = "3. India symbols")
sym38 = input.symbol("NSE:TATASTEEL", "#38", group = "3. India symbols")

// ═══════════════════════════════════════════════════════════════
// THE SCAN
// ═══════════════════════════════════════════════════════════════
// Everything below runs inside each symbol's own context, so close, volume
// and the averages refer to that symbol rather than the chart. One request
// call each, which is what keeps 38 of them inside the budget.
//
// Higher highs and higher lows are measured as this swing window against the
// one before it. That is coarser than the pivot store the Wyckoff panel uses
// and it has to be: a pivot store cannot be carried across a request.
f_state() =>
    _d200 = ta.sma(close, 200)
    _d50  = ta.sma(close, 50)
    _ref  = _d200[slopeN]
    _slp  = na(_ref) or _ref <= 0 ? na : (_d200 - _ref) / _ref * 100
    _up   = not na(_slp) and _slp > flatPct
    _dn   = not na(_slp) and _slp < -flatPct
    _hh   = ta.highest(high, swingN) > ta.highest(high, swingN)[swingN]
    _hl   = ta.lowest(low, swingN) > ta.lowest(low, swingN)[swingN]
    _va   = ta.sma(volume, 20)
    _vx   = na(_va) or _va <= 0 ? na : volume / _va
    _abv  = not na(_d200) and close > _d200
    // 2 advancing, 4 declining, 3 above a stalled average, 1 basing
    _stage = _abv and _up and _hh and _hl ? 2 : not _abv and _dn and not _hh and not _hl ? 4 : _abv ? 3 : 1
    _dip  = _abv and not na(_d50) and low <= _d50 * (1 + dipNear / 100) and (na(_vx) or _vx <= dipVol)
    _bHi  = ta.highest(high, 20)[1]
    _bLo  = ta.lowest(low, 20)[1]
    _base = not na(_bLo) and _bLo > 0 and (_bHi - _bLo) / _bLo * 100 <= baseW
    _brk  = _base and close > _bHi and not na(_vx) and _vx >= brkVol and close > close[1]
    [_stage, _dip ? 1 : 0, _brk ? 1 : 0, close, close[rsLen]]

var array<string> rSym = array.new<string>()
var array<int>    rVer = array.new<int>()
var array<string> rWhy = array.new<string>()

f_label(string _s) =>
    _i = str.pos(_s, ":")
    na(_i) ? _s : str.substring(_s, _i + 1)

// 3 = buy, 2 = stage 2 but nothing to buy, 1 = watchlist, 0 = no
f_push(string _sym, int _st, int _dp, int _bk, float _px, float _og, float _b, float _bo) =>
    if barstate.islast and not na(_px)
        _rs = na(_og) or _og <= 0 or na(_b) or na(_bo) or _bo <= 0 ? false : _px / _og > _b / _bo
        _v = _st == 2 and (_bk == 1 or _dp == 1) and _rs ? 3 : _st == 2 ? 2 : _st == 1 ? 1 : 0
        _w = _v == 3 ? (_bk == 1 ? "BREAKOUT on volume, RS gaining" : "dip to the 50-day, RS gaining") : _v == 2 ? (_bk == 1 or _dp == 1 ? "setup is there but RS is lagging" : "Stage 2, no entry here yet") : _v == 1 ? "basing — watch, do not commit" : _st == 4 ? "Stage 4 — stay away" : "above a stalled average"
        array.push(rSym, f_label(_sym))
        array.push(rVer, _v)
        array.push(rWhy, _w)

[bNow, bOld] = request.security(rsBench, scanTf, [close, close[rsLen]], ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)

[st01, dp01, bk01, px01, og01] = request.security(sym01, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym01, st01, dp01, bk01, px01, og01, bNow, bOld)
[st02, dp02, bk02, px02, og02] = request.security(sym02, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym02, st02, dp02, bk02, px02, og02, bNow, bOld)
[st03, dp03, bk03, px03, og03] = request.security(sym03, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym03, st03, dp03, bk03, px03, og03, bNow, bOld)
[st04, dp04, bk04, px04, og04] = request.security(sym04, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym04, st04, dp04, bk04, px04, og04, bNow, bOld)
[st05, dp05, bk05, px05, og05] = request.security(sym05, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym05, st05, dp05, bk05, px05, og05, bNow, bOld)
[st06, dp06, bk06, px06, og06] = request.security(sym06, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym06, st06, dp06, bk06, px06, og06, bNow, bOld)
[st07, dp07, bk07, px07, og07] = request.security(sym07, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym07, st07, dp07, bk07, px07, og07, bNow, bOld)
[st08, dp08, bk08, px08, og08] = request.security(sym08, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym08, st08, dp08, bk08, px08, og08, bNow, bOld)
[st09, dp09, bk09, px09, og09] = request.security(sym09, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym09, st09, dp09, bk09, px09, og09, bNow, bOld)
[st10, dp10, bk10, px10, og10] = request.security(sym10, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym10, st10, dp10, bk10, px10, og10, bNow, bOld)
[st11, dp11, bk11, px11, og11] = request.security(sym11, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym11, st11, dp11, bk11, px11, og11, bNow, bOld)
[st12, dp12, bk12, px12, og12] = request.security(sym12, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym12, st12, dp12, bk12, px12, og12, bNow, bOld)
[st13, dp13, bk13, px13, og13] = request.security(sym13, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym13, st13, dp13, bk13, px13, og13, bNow, bOld)
[st14, dp14, bk14, px14, og14] = request.security(sym14, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym14, st14, dp14, bk14, px14, og14, bNow, bOld)
[st15, dp15, bk15, px15, og15] = request.security(sym15, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym15, st15, dp15, bk15, px15, og15, bNow, bOld)
[st16, dp16, bk16, px16, og16] = request.security(sym16, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym16, st16, dp16, bk16, px16, og16, bNow, bOld)
[st17, dp17, bk17, px17, og17] = request.security(sym17, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym17, st17, dp17, bk17, px17, og17, bNow, bOld)
[st18, dp18, bk18, px18, og18] = request.security(sym18, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym18, st18, dp18, bk18, px18, og18, bNow, bOld)
[st19, dp19, bk19, px19, og19] = request.security(sym19, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym19, st19, dp19, bk19, px19, og19, bNow, bOld)
[st20, dp20, bk20, px20, og20] = request.security(sym20, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym20, st20, dp20, bk20, px20, og20, bNow, bOld)
[st21, dp21, bk21, px21, og21] = request.security(sym21, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym21, st21, dp21, bk21, px21, og21, bNow, bOld)
[st22, dp22, bk22, px22, og22] = request.security(sym22, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym22, st22, dp22, bk22, px22, og22, bNow, bOld)
[st23, dp23, bk23, px23, og23] = request.security(sym23, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym23, st23, dp23, bk23, px23, og23, bNow, bOld)
[st24, dp24, bk24, px24, og24] = request.security(sym24, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym24, st24, dp24, bk24, px24, og24, bNow, bOld)
[st25, dp25, bk25, px25, og25] = request.security(sym25, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym25, st25, dp25, bk25, px25, og25, bNow, bOld)
[st26, dp26, bk26, px26, og26] = request.security(sym26, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym26, st26, dp26, bk26, px26, og26, bNow, bOld)
[st27, dp27, bk27, px27, og27] = request.security(sym27, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym27, st27, dp27, bk27, px27, og27, bNow, bOld)
[st28, dp28, bk28, px28, og28] = request.security(sym28, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym28, st28, dp28, bk28, px28, og28, bNow, bOld)
[st29, dp29, bk29, px29, og29] = request.security(sym29, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym29, st29, dp29, bk29, px29, og29, bNow, bOld)
[st30, dp30, bk30, px30, og30] = request.security(sym30, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym30, st30, dp30, bk30, px30, og30, bNow, bOld)
[st31, dp31, bk31, px31, og31] = request.security(sym31, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym31, st31, dp31, bk31, px31, og31, bNow, bOld)
[st32, dp32, bk32, px32, og32] = request.security(sym32, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym32, st32, dp32, bk32, px32, og32, bNow, bOld)
[st33, dp33, bk33, px33, og33] = request.security(sym33, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym33, st33, dp33, bk33, px33, og33, bNow, bOld)
[st34, dp34, bk34, px34, og34] = request.security(sym34, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym34, st34, dp34, bk34, px34, og34, bNow, bOld)
[st35, dp35, bk35, px35, og35] = request.security(sym35, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym35, st35, dp35, bk35, px35, og35, bNow, bOld)
[st36, dp36, bk36, px36, og36] = request.security(sym36, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym36, st36, dp36, bk36, px36, og36, bNow, bOld)
[st37, dp37, bk37, px37, og37] = request.security(sym37, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym37, st37, dp37, bk37, px37, og37, bNow, bOld)
[st38, dp38, bk38, px38, og38] = request.security(sym38, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym38, st38, dp38, bk38, px38, og38, bNow, bOld)
// ═══════════════════════════════════════════════════════════════
// THE PANEL
// ═══════════════════════════════════════════════════════════════
// Buys first, then the ones a single condition away, then the watchlist.
// Everything that is a flat no is hidden unless you ask for it, because a
// scanner that lists forty names has not narrowed anything down.
pPos = sPos == "Top Left" ? position.top_left : sPos == "Bottom Right" ? position.bottom_right : sPos == "Bottom Left" ? position.bottom_left : sPos == "Middle Right" ? position.middle_right : position.top_right
pSz  = sSize == "Tiny" ? size.tiny : sSize == "Normal" ? size.normal : size.small

var table sc = table.new(pPos, 3, 42, border_width = 1)

f_cell(int _c, int _r, string _s, color _bg, color _tx) =>
    table.cell(sc, _c, _r, _s, text_color = _tx, bgcolor = _bg, text_halign = text.align_left, text_size = pSz)

if barstate.islast
    table.clear(sc, 0, 0, 2, 41)
    _n = array.size(rSym)
    _buys = 0
    for _i = 0 to (_n > 0 ? _n - 1 : 0)
        if _n > 0 and array.get(rVer, _i) == 3
            _buys := _buys + 1
    f_cell(0, 0, "STAGE SCANNER", color.new(#1a237e, 0), color.white)
    f_cell(1, 0, _buys > 0 ? "✅ " + str.tostring(_buys) + " TO BUY" : "nothing to buy", _buys > 0 ? color.new(#00c853, 0) : color.new(color.gray, 30), color.white)
    f_cell(2, 0, str.tostring(_n) + " scanned on " + scanTf, color.new(#1a237e, 0), color.white)
    _r = 1
    // 3 then 2 then 1; a flat no only when asked for
    for _want = 3 to 1
        for _i = 0 to (_n > 0 ? _n - 1 : 0)
            if _n > 0 and _r < 41 and array.get(rVer, _i) == _want
                _v = array.get(rVer, _i)
                _bg = _v == 3 ? color.new(#00c853, 0) : _v == 2 ? color.new(#2e7d32, 35) : color.new(color.gray, 45)
                f_cell(0, _r, array.get(rSym, _i), _bg, color.white)
                f_cell(1, _r, _v == 3 ? "✅ BUY" : _v == 2 ? "► hold" : "👁 watch", _bg, color.white)
                f_cell(2, _r, array.get(rWhy, _i), _bg, color.white)
                _r := _r + 1
    if showAll
        for _i = 0 to (_n > 0 ? _n - 1 : 0)
            if _n > 0 and _r < 41 and array.get(rVer, _i) == 0
                f_cell(0, _r, array.get(rSym, _i), color.new(#b71c1c, 30), color.white)
                f_cell(1, _r, "⛔ no", color.new(#b71c1c, 30), color.white)
                f_cell(2, _r, array.get(rWhy, _i), color.new(#b71c1c, 30), color.white)
                _r := _r + 1
    array.clear(rSym)
    array.clear(rVer)
    array.clear(rWhy)

// One alert for the whole list, so a name turning while you are on another
// chart still reaches you.
alertcondition(true, title = "Stage Scanner — something turned to BUY", message = "Stage Scanner: at least one symbol now reads BUY on {{interval}}")
