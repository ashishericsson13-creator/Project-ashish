[st13, dp13, bk13, px13, og13, md13, bh13] = request.security(sym13, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym13, st13, dp13, bk13, px13, og13, md13, bh13)
[st14, dp14, bk14, px14, og14, md14, bh14] = request.security(sym14, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym14, st14, dp14, bk14, px14, og14, md14, bh14)
[st15, dp15, bk15, px15, og15, md15, bh15] = request.security(sym15, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym15, st15, dp15, bk15, px15, og15, md15, bh15)
[st16, dp16, bk16, px16, og16, md16, bh16] = request.security(sym16, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym16, st16, dp16, bk16, px16, og16, md16, bh16)
