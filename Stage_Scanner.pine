in18 = input.symbol("NSE:NTPC", "India #18", group = "3. India list")
cr18 = input.symbol("BINANCE:NEARUSDT", "Crypto #18", group = "4. Crypto list")
us19 = input.symbol("CRM", "US #19", group = "2. US list")
in19 = input.symbol("NSE:TATASTEEL", "India #19", group = "3. India list")
cr19 = input.symbol("BINANCE:FILUSDT", "Crypto #19", group = "4. Crypto list")
us20 = input.symbol("ORCL", "US #20", group = "2. US list")
in20 = input.symbol("NSE:WIPRO", "India #20", group = "3. India list")
cr20 = input.symbol("BINANCE:APTUSDT", "Crypto #20", group = "4. Crypto list")

sym01 = chartMkt == 2 ? in01 : chartMkt == 3 ? cr01 : us01
sym02 = chartMkt == 2 ? in02 : chartMkt == 3 ? cr02 : us02
sym03 = chartMkt == 2 ? in03 : chartMkt == 3 ? cr03 : us03
sym04 = chartMkt == 2 ? in04 : chartMkt == 3 ? cr04 : us04
sym05 = chartMkt == 2 ? in05 : chartMkt == 3 ? cr05 : us05
sym06 = chartMkt == 2 ? in06 : chartMkt == 3 ? cr06 : us06
sym07 = chartMkt == 2 ? in07 : chartMkt == 3 ? cr07 : us07
sym08 = chartMkt == 2 ? in08 : chartMkt == 3 ? cr08 : us08
sym09 = chartMkt == 2 ? in09 : chartMkt == 3 ? cr09 : us09
sym10 = chartMkt == 2 ? in10 : chartMkt == 3 ? cr10 : us10
sym11 = chartMkt == 2 ? in11 : chartMkt == 3 ? cr11 : us11
sym12 = chartMkt == 2 ? in12 : chartMkt == 3 ? cr12 : us12
sym13 = chartMkt == 2 ? in13 : chartMkt == 3 ? cr13 : us13
sym14 = chartMkt == 2 ? in14 : chartMkt == 3 ? cr14 : us14
sym15 = chartMkt == 2 ? in15 : chartMkt == 3 ? cr15 : us15
sym16 = chartMkt == 2 ? in16 : chartMkt == 3 ? cr16 : us16
sym17 = chartMkt == 2 ? in17 : chartMkt == 3 ? cr17 : us17
sym18 = chartMkt == 2 ? in18 : chartMkt == 3 ? cr18 : us18
sym19 = chartMkt == 2 ? in19 : chartMkt == 3 ? cr19 : us19
sym20 = chartMkt == 2 ? in20 : chartMkt == 3 ? cr20 : us20

// ═══════════════════════════════════════════════════════════════
// THE SCAN
// ═══════════════════════════════════════════════════════════════
// Everything below runs inside each symbol's own context, so close, volume
// and the averages refer to that symbol rather than the chart. One request
// call each, which is what keeps 38 of them inside the budget.
//
// Higher highs and higher lows are measured as this swing window against the
// one before it. That is coarser than the pivot store the Wyckoff panel uses
// and it has to be: a pivot store cannot be carried across a request.
f_state() =>
    _d200 = ta.sma(close, 200)
    _d50  = ta.sma(close, 50)
    _ref  = _d200[slopeN]
    _slp  = na(_ref) or _ref <= 0 ? na : (_d200 - _ref) / _ref * 100
    _up   = not na(_slp) and _slp > flatPct
    _dn   = not na(_slp) and _slp < -flatPct
    _hh   = ta.highest(high, swingN) > ta.highest(high, swingN)[swingN]
    _hl   = ta.lowest(low, swingN) > ta.lowest(low, swingN)[swingN]
    _rsi  = ta.rsi(close, 14)
    _lo52 = ta.lowest(low, 250)
    _hi52 = ta.highest(high, 250)
    _va   = ta.sma(volume, 20)
    _vx   = na(_va) or _va <= 0 ? na : volume / _va
    _abv  = not na(_d200) and close > _d200
    // 2 advancing, 4 declining, 3 above a stalled average, 1 basing.
    // A falling 200-day can only be 4, or 1 once higher highs and higher lows
    // are both in. It can never be 3: that would quote a top's trigger on a
    // stock that is still in a downtrend.
    _stage = _abv and _up and _hh and _hl ? 2 : _dn and not (_hh and _hl) ? 4 : _dn ? 1 : _abv ? 3 : 1
    _dip  = _abv and not na(_d50) and low <= _d50 * (1 + dipNear / 100) and (na(_vx) or _vx <= dipVol)
    _bHi  = ta.highest(high, baseN)[1]
    _bLo  = ta.lowest(low, baseN)[1]
    _base = not na(_bLo) and _bLo > 0 and (_bHi - _bLo) / _bLo * 100 <= baseW
    _brk  = _base and close > _bHi and not na(_vx) and _vx >= brkVol and close > close[1]
    [_stage, _dip ? 1 : 0, _brk ? 1 : 0, close, close[rsLen], _d50, _base ? _bHi : na, _d200, _lo52, _hi52, _rsi]

var array<string> rSym = array.new<string>()
var array<int>    rVer = array.new<int>()
var array<string> rWhy = array.new<string>()
var array<float>  rGap = array.new<float>()
var array<bool>   rMe  = array.new<bool>()
var array<int>    rMiss = array.new<int>(1, 0)
var array<int>    rStg = array.new<int>()
var array<float>  rRsi = array.new<float>()

// 1 US, 2 India, 3 crypto — taken from the symbol string rather than from
// which input slot it sits in, so any slot can hold anything.
f_mkt(string _s) =>
    _u = str.upper(_s)
    str.contains(_u, "NSE:") or str.contains(_u, "BSE:") ? 2 : str.contains(_u, "USDT") or str.contains(_u, "USD.P") or str.contains(_u, "BINANCE") or str.contains(_u, "COINBASE") or str.contains(_u, "BITSTAMP") ? 3 : 1

f_label(string _s) =>
    _i = str.pos(_s, ":")
    na(_i) ? _s : str.substring(_s, _i + 1)

// ETHUSD on the chart and ETHUSDT in the list are the same coin. Strip the
// perpetual marker and the quote currency so the two match.
f_base(string _s) =>
    _t = str.upper(f_label(_s))
    _t := str.endswith(_t, ".P") ? str.substring(_t, 0, str.length(_t) - 2) : _t
    _t := str.endswith(_t, "USDT") or str.endswith(_t, "USDC") ? str.substring(_t, 0, str.length(_t) - 4) : str.endswith(_t, "USD") ? str.substring(_t, 0, str.length(_t) - 3) : _t
    _t

chartBase = f_base(syminfo.ticker)

// The three benchmarks, declared ahead of f_push because it reads them.
benchPick = chartMkt == 2 ? rsBenc2 : chartMkt == 3 ? rsBenc3 : rsBench
ftdPct = input.float(1.25, "A follow-through day needs the index up this much (%)", minval = 0.3, maxval = 5.0, step = 0.05, group = "7. Market direction")
ftdDay = input.int(4, "...on day 4 of the rally attempt or later", minval = 2, maxval = 15, group = "7. Market direction")
ftdOn  = input.bool(true, "Hold new buys until the market confirms", tooltip = "O'Neil's M. Three stocks in four follow the index, so a buy signal in a market that has not confirmed is a buy signal with the odds against it.", group = "7. Market direction")

// O'Neil's rally-attempt count, run on the index's own bars.
// Day 1 is the first up close after a low. The low of that day is the line in
// the sand: undercut it and the count starts again from nothing. From day 4 a
// big gain on heavier volume than the day before is the follow-through.
f_bench() =>
    var float _attLo = na
    var int   _att = 0
    var int   _ftdAgo = -1
    _d50 = ta.sma(close, 50)
    if not na(_attLo) and low < _attLo
        _att := 0
        _attLo := low
        _ftdAgo := -1
    else if _att >= 1
        _att := _att + 1
    else if close > close[1]
        _att := 1
        _attLo := low
    _pct = close[1] > 0 ? (close - close[1]) / close[1] * 100 : 0.0
    _ftd = _att >= ftdDay and _pct >= ftdPct and volume > volume[1]
    if _ftd
        _ftdAgo := 0
    else if _ftdAgo >= 0
        _ftdAgo := _ftdAgo + 1
    [close, close[rsLen], _att, _ftdAgo, _pct, _d50, _attLo]

[bNow, bOld, bAtt, bFtd, bPct, bD50, bAtLo] = request.security(benchPick, scanTf, f_bench(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
mktConf = not na(bFtd) and bFtd >= 0
mktAtt  = not na(bAtt) and bAtt >= 1 and not mktConf
mktUnd  = not na(bD50) and not na(bNow) and bNow < bD50

// 3 = buy, 2 = stage 2 with no entry, 1 = watchlist, 0 = no.
// Only the market you are looking at is collected, so a US chart never lists
// NSE names and the panel stays the length of one market.
f_push(string _sym, int _st, int _dp, int _bk, float _px, float _og, float _d50, float _bhi, float _d200, float _lo, float _hi, float _rsi, bool _me) =>
    _m = f_mkt(_sym)
    if barstate.islast and na(_px) and not _me
        array.set(rMiss, 0, array.get(rMiss, 0) + 1)
    if barstate.islast and not na(_px) and (_me or f_base(_sym) != chartBase)
        _b  = bNow
        _bo = bOld
        _rs = na(_og) or _og <= 0 or na(_b) or na(_bo) or _bo <= 0 ? false : _px / _og > _b / _bo
        _young = na(_d200)
        _v = _young ? 1 : _st == 2 and (_bk == 1 or _dp == 1) and _rs ? 3 : _st == 2 ? 2 : _st == 1 ? 1 : 0
        // What would have to happen for this to become a buy, with the number.
        _gap = na(_d50) or _px <= 0 ? na : (_px - _d50) / _px * 100
        // Where the last year of trade found a floor. Not a forecast: it is
        // the level buyers have already defended, which is what a bottom is
        // until a higher low proves a new one.
        _newLo = not na(_lo) and _px < _lo
        _onLo  = not na(_lo) and not _newLo and _px <= _lo * 1.02
        _far = na(_lo) or _px <= 0 or (_px - _lo) / _px * 100 > 20
        _btm = na(_lo) or _px <= 0 or (_v >= 2 and _far) ? "" : _newLo ? "   ·   at new lows — nothing under it to name" : _onLo ? "   ·   sitting on its floor " + str.tostring(_lo, format.mintick) + " — it holds here or it does not" : "   ·   bottom zone " + str.tostring(_lo, format.mintick) + ", " + str.tostring((_px - _lo) / _px * 100, "#.#") + "% below"
        _upTo = na(_bhi) ? _hi : _bhi
        _hold = ftdOn and not mktConf
        _trig = _young ? "too new to stage — no 200-day yet, it has not traded 200 days" + _btm
             : _v == 3 ? "✅ BUY NOW near " + str.tostring(_px, format.mintick) + " — " + (_bk == 1 ? "breakout on volume, RS gaining" : "dip to the 50-day, RS gaining") + (_hold ? "   ·   ⚠ market has not confirmed — start small or wait" : "")
             : _v == 2 and not _rs and not na(_upTo) ? "buy over " + str.tostring(_upTo, format.mintick) + " once RS turns — see its chart" + _btm
             : _v == 2 and not _rs ? "setup is there — needs RS to turn, see its chart" + _btm
             : _v == 2 and not na(_bhi) ? "buy a close above " + str.tostring(_bhi, format.mintick) + " on volume, " + str.tostring((_bhi - _px) / _px * 100, "#.#") + "% above" + _btm
             : _v == 2 and not na(_gap) and _gap > 0 ? "buy a dip to the 50-day " + str.tostring(_d50, format.mintick) + ", " + str.tostring(_gap, "#.#") + "% below" + _btm
             : _v == 2 and not na(_d50) ? "buy a dip to the 50-day " + str.tostring(_d50, format.mintick) + _btm
             : _v == 2 ? "Stage 2, waiting for a dip or a base to form" + _btm
             : _v == 1 and not na(_d200) and _d200 <= _px ? "over the 200-day " + str.tostring(_d200, format.mintick) + " already — wait for it to stop falling and turn up" + _btm
             : _v == 1 and not na(_d200) ? "buy only over the 200-day " + str.tostring(_d200, format.mintick) + ", " + str.tostring(math.abs(_d200 - _px) / _px * 100, "#.#") + "% " + (_d200 > _px ? "above" : "below") + ", once it flattens" + _btm
             : _v == 1 ? "basing — needs the 200-day to turn up and price to clear it" + _btm
             : _st == 4 and not na(_d200) and _d200 <= _px ? "NO — over the 200-day " + str.tostring(_d200, format.mintick) + " already, but it is still falling and the last high was lower" + _btm
             : _st == 4 and not na(_d200) ? "NO — needs a higher low, then a close over the 200-day " + str.tostring(_d200, format.mintick) + _btm
             : _st == 4 ? "NO — Stage 4, stay away" + _btm
             : not na(_hi) ? "NO — nothing to buy under " + str.tostring(_hi, format.mintick) + ", the year's high, " + str.tostring((_hi - _px) / _px * 100, "#.#") + "% above" + _btm
             : "NO — above a stalled average" + _btm
        // how far the trigger is, so the list can lead with the nearest
        _dist = _v == 2 and not na(_bhi) ? math.abs(_bhi - _px) / _px * 100 : _v == 2 and not na(_gap) and _gap > 0 ? _gap : 999.0
        array.push(rMe, _me)
        array.push(rStg, _young ? 9 : _st)
        array.push(rRsi, _rsi)
        array.push(rGap, _dist)
        array.push(rSym, (_me ? "◆ " : "") + f_label(_sym))
        array.push(rVer, _v)
        array.push(rWhy, _trig)


w200on  = input.bool(true, "200-week average line", group = "5. Lines")
w200col = input.color(color.black, "200-week colour", group = "5. Lines")
d200on  = input.bool(true, "200-day average line", group = "5. Lines")
d200col = input.color(#1565c0, "200-day colour", group = "5. Lines")
d50on   = input.bool(false, "50-day average line", group = "5. Lines")
d50col  = input.color(#ef6c00, "50-day colour", group = "5. Lines")
supOn   = input.bool(true, "Bottom-zone support lines", tooltip = "The lows the last 1, 2 and 5 years have already defended. A level only counts as support while price is above it.", group = "5. Lines")
supCol  = input.color(#00897b, "Support colour", group = "5. Lines")
supMax  = input.float(40.0, "Only draw supports within this % of price", minval = 5.0, maxval = 90.0, step = 5.0, tooltip = "A floor far below price is not a level anyone plans around. Gold's five-year low sits 58% down.", group = "5. Lines")

// One request covers the long average and the three floors beneath price.
[w200, sup1, sup2, sup3] = request.security(syminfo.tickerid, "W", [ta.sma(close, 200), ta.lowest(low, 52), ta.lowest(low, 104), ta.lowest(low, 260)], ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
plot(w200on and not na(w200) ? w200 : na, "200-week average", color = w200col, linewidth = 2)

lvlOn  = input.bool(true, "Key price levels", group = "6. Levels & targets")
pvN    = input.int(5, "Pivot strength — bars either side of a turn", minval = 2, maxval = 60, group = "6. Levels & targets")
lvlMax = input.int(4, "Levels to draw ON EACH SIDE of price", minval = 1, maxval = 10, group = "6. Levels & targets")
lvlSep = input.float(1.5, "Levels closer than this % are the same level", minval = 0.1, maxval = 10.0, step = 0.1, group = "6. Levels & targets")
lvlAtr = input.float(1.0, "...or this many ATRs apart, whichever is wider", minval = 0.0, maxval = 5.0, step = 0.1, tooltip = "A fixed percentage packs four levels onto one shelf on a volatile name and spreads them too far on a quiet one. One ATR is roughly a day's range, so levels inside it are the same shelf.", group = "6. Levels & targets")
resCol = input.color(#c62828, "Level above price", group = "6. Levels & targets")
supCol2 = input.color(#2e7d32, "Level below price", group = "6. Levels & targets")
trOn   = input.bool(true, "Trendlines through the last two turns", tooltip = "One line through the last two pivot highs and one through the last two pivot lows. Converging lines are a wedge; the break of one is the signal.", group = "6. Levels & targets")
trExt  = input.int(40, "Project trendlines this many bars forward", minval = 0, maxval = 300, tooltip = "A line through two turns close together has a brutal slope. Extended forever it leaves the chart and says nothing, so the projection is capped both by this many bars and by the point where it has travelled 40% of price.", group = "6. Levels & targets")
trHiC  = input.color(#c62828, "Trendline through highs", group = "6. Levels & targets")
trLoC  = input.color(#2e7d32, "Trendline through lows", group = "6. Levels & targets")
boxOn  = input.bool(true, "Consolidation ranges", group = "6. Levels & targets")
rngN   = input.int(20, "Bars that make a range", minval = 5, maxval = 120, group = "6. Levels & targets")
rngW   = input.float(25.0, "A range is no wider than this %", minval = 2.0, maxval = 40.0, step = 0.5, group = "6. Levels & targets")
boxCol = input.color(#1565c0, "Range fill", group = "6. Levels & targets")

// Turning points, kept as they confirm. A level is only a level because price
// turned there, so the pivots are the levels and the levels are the targets.
var array<float> pvs = array.new<float>()
_ph = ta.pivothigh(pvN, pvN)
_pl = ta.pivotlow(pvN, pvN)
if not na(_ph)
    array.push(pvs, _ph)
if not na(_pl)
    array.push(pvs, _pl)
if array.size(pvs) > 250
    array.shift(pvs)

atrV = ta.atr(14)
var float thA = na
var float thB = na
var int   txA = na
var int   txB = na
var float tlA = na
var float tlB = na
var int   lxA = na
var int   lxB = na
if not na(_ph)
    thB := thA
    txB := txA
    thA := _ph
    txA := bar_index - pvN
if not na(_pl)
    tlB := tlA
    lxB := lxA
    tlA := _pl
    lxA := bar_index - pvN

var line trH = na
var line trL = na

rgH = ta.highest(high, rngN)
rgL = ta.lowest(low, rngN)
rgH2 = ta.highest(high, rngN * 2)
rgL2 = ta.lowest(low, rngN * 2)

var array<line>  lvLn = array.new<line>()
var array<label> lvLb = array.new<label>()
var array<box>   lvBx = array.new<box>()
var array<float> lvOut = array.new<float>()

var line  supL1 = na
var line  supL2 = na
var line  supL3 = na
var label supB1 = na
var label supB2 = na
var label supB3 = na

[stMe, dpMe, bkMe, pxMe, ogMe, mdMe, bhMe, ddMe, loMe, hiMe, rsMe] = request.security(syminfo.tickerid, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(syminfo.tickerid, stMe, dpMe, bkMe, pxMe, ogMe, mdMe, bhMe, ddMe, loMe, hiMe, rsMe, true)

plot(d200on and not na(ddMe) ? ddMe : na, "200-day average", color = d200col, linewidth = 2)
plot(d50on and not na(mdMe) ? mdMe : na, "50-day average", color = d50col, linewidth = 1)

// The bottom zone, drawn where you can read it off the price axis. A floor
// within half a percent of the one above it is the same floor, so it is
// dropped rather than printed twice.
if barstate.islast
    line.delete(supL1)
    line.delete(supL2)
    line.delete(supL3)
    label.delete(supB1)
    label.delete(supB2)
    label.delete(supB3)
    _s1 = na(loMe) ? sup1 : loMe
    _near1 = not na(_s1) and close > 0 and (close - _s1) / close * 100 <= supMax
    _near2 = not na(sup2) and close > 0 and (close - sup2) / close * 100 <= supMax
    _near3 = not na(sup3) and close > 0 and (close - sup3) / close * 100 <= supMax
    _same2 = not na(_s1) and not na(sup2) and _s1 > 0 and math.abs(sup2 - _s1) / _s1 <= 0.005
    _same3 = not na(_s1) and not na(sup3) and _s1 > 0 and math.abs(sup3 - _s1) / _s1 <= 0.005
    _age1 = _same3 ? "5-yr low" : _same2 ? "2-yr low" : "1-yr low"
    _ok1 = supOn and _near1 and _s1 < close
    _ok2 = supOn and _near2 and sup2 < close and (na(_s1) or math.abs(sup2 - _s1) / _s1 > 0.005)
    _ok3 = supOn and _near3 and sup3 < close and (na(sup2) or math.abs(sup3 - sup2) / sup2 > 0.005) and (na(_s1) or math.abs(sup3 - _s1) / _s1 > 0.005)
    if _ok1
        supL1 := line.new(bar_index - 2, _s1, bar_index, _s1, extend = extend.both, color = supCol, width = 2, style = line.style_dashed)
        supB1 := label.new(bar_index, _s1, "bottom zone · " + _age1 + "  " + str.tostring(_s1, format.mintick), style = label.style_label_left, color = supCol, textcolor = color.white, size = size.small)
    if _ok2
        supL2 := line.new(bar_index - 2, sup2, bar_index, sup2, extend = extend.both, color = color.new(supCol, 35), width = 1, style = line.style_dashed)
        supB2 := label.new(bar_index, sup2, "2-yr low  " + str.tostring(sup2, format.mintick), style = label.style_label_left, color = color.new(supCol, 35), textcolor = color.white, size = size.small)
    if _ok3
        supL3 := line.new(bar_index - 2, sup3, bar_index, sup3, extend = extend.both, color = color.new(supCol, 55), width = 1, style = line.style_dotted)
        supB3 := label.new(bar_index, sup3, "5-yr low  " + str.tostring(sup3, format.mintick), style = label.style_label_left, color = color.new(supCol, 55), textcolor = color.white, size = size.small)
[st01, dp01, bk01, px01, og01, md01, bh01, dd01, lo01, hi01, rs01] = request.security(sym01, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym01, st01, dp01, bk01, px01, og01, md01, bh01, dd01, lo01, hi01, rs01, false)
[st02, dp02, bk02, px02, og02, md02, bh02, dd02, lo02, hi02, rs02] = request.security(sym02, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym02, st02, dp02, bk02, px02, og02, md02, bh02, dd02, lo02, hi02, rs02, false)
[st03, dp03, bk03, px03, og03, md03, bh03, dd03, lo03, hi03, rs03] = request.security(sym03, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym03, st03, dp03, bk03, px03, og03, md03, bh03, dd03, lo03, hi03, rs03, false)
[st04, dp04, bk04, px04, og04, md04, bh04, dd04, lo04, hi04, rs04] = request.security(sym04, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym04, st04, dp04, bk04, px04, og04, md04, bh04, dd04, lo04, hi04, rs04, false)
[st05, dp05, bk05, px05, og05, md05, bh05, dd05, lo05, hi05, rs05] = request.security(sym05, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym05, st05, dp05, bk05, px05, og05, md05, bh05, dd05, lo05, hi05, rs05, false)
[st06, dp06, bk06, px06, og06, md06, bh06, dd06, lo06, hi06, rs06] = request.security(sym06, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym06, st06, dp06, bk06, px06, og06, md06, bh06, dd06, lo06, hi06, rs06, false)
[st07, dp07, bk07, px07, og07, md07, bh07, dd07, lo07, hi07, rs07] = request.security(sym07, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym07, st07, dp07, bk07, px07, og07, md07, bh07, dd07, lo07, hi07, rs07, false)
[st08, dp08, bk08, px08, og08, md08, bh08, dd08, lo08, hi08, rs08] = request.security(sym08, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym08, st08, dp08, bk08, px08, og08, md08, bh08, dd08, lo08, hi08, rs08, false)
[st09, dp09, bk09, px09, og09, md09, bh09, dd09, lo09, hi09, rs09] = request.security(sym09, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym09, st09, dp09, bk09, px09, og09, md09, bh09, dd09, lo09, hi09, rs09, false)
[st10, dp10, bk10, px10, og10, md10, bh10, dd10, lo10, hi10, rs10] = request.security(sym10, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym10, st10, dp10, bk10, px10, og10, md10, bh10, dd10, lo10, hi10, rs10, false)
[st11, dp11, bk11, px11, og11, md11, bh11, dd11, lo11, hi11, rs11] = request.security(sym11, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym11, st11, dp11, bk11, px11, og11, md11, bh11, dd11, lo11, hi11, rs11, false)
[st12, dp12, bk12, px12, og12, md12, bh12, dd12, lo12, hi12, rs12] = request.security(sym12, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym12, st12, dp12, bk12, px12, og12, md12, bh12, dd12, lo12, hi12, rs12, false)
[st13, dp13, bk13, px13, og13, md13, bh13, dd13, lo13, hi13, rs13] = request.security(sym13, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym13, st13, dp13, bk13, px13, og13, md13, bh13, dd13, lo13, hi13, rs13, false)
[st14, dp14, bk14, px14, og14, md14, bh14, dd14, lo14, hi14, rs14] = request.security(sym14, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym14, st14, dp14, bk14, px14, og14, md14, bh14, dd14, lo14, hi14, rs14, false)
[st15, dp15, bk15, px15, og15, md15, bh15, dd15, lo15, hi15, rs15] = request.security(sym15, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym15, st15, dp15, bk15, px15, og15, md15, bh15, dd15, lo15, hi15, rs15, false)
[st16, dp16, bk16, px16, og16, md16, bh16, dd16, lo16, hi16, rs16] = request.security(sym16, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym16, st16, dp16, bk16, px16, og16, md16, bh16, dd16, lo16, hi16, rs16, false)
[st17, dp17, bk17, px17, og17, md17, bh17, dd17, lo17, hi17, rs17] = request.security(sym17, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym17, st17, dp17, bk17, px17, og17, md17, bh17, dd17, lo17, hi17, rs17, false)
[st18, dp18, bk18, px18, og18, md18, bh18, dd18, lo18, hi18, rs18] = request.security(sym18, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym18, st18, dp18, bk18, px18, og18, md18, bh18, dd18, lo18, hi18, rs18, false)
[st19, dp19, bk19, px19, og19, md19, bh19, dd19, lo19, hi19, rs19] = request.security(sym19, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym19, st19, dp19, bk19, px19, og19, md19, bh19, dd19, lo19, hi19, rs19, false)
[st20, dp20, bk20, px20, og20, md20, bh20, dd20, lo20, hi20, rs20] = request.security(sym20, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym20, st20, dp20, bk20, px20, og20, md20, bh20, dd20, lo20, hi20, rs20, false)

// ═══════════════════════════════════════════════════════════════
// THE PANEL
// ═══════════════════════════════════════════════════════════════
// Buys first, then the ones a single condition away, then the watchlist.
// Everything that is a flat no is hidden unless you ask for it, because a
// scanner that lists forty names has not narrowed anything down.
pPos = sPos == "Top Left" ? position.top_left : sPos == "Bottom Right" ? position.bottom_right : sPos == "Bottom Left" ? position.bottom_left : sPos == "Middle Right" ? position.middle_right : position.top_right
pSz  = sSize == "Tiny" ? size.tiny : sSize == "Normal" ? size.normal : size.small

var table sc = table.new(pPos, 3, 42, border_width = 1)

f_rs(float _v) =>
    na(_v) ? "" : "   " + str.tostring(_v, "#")

f_cell(int _c, int _r, string _s, color _bg, color _tx) =>
    table.cell(sc, _c, _r, _s, text_color = _tx, bgcolor = _bg, text_halign = text.align_left, text_size = pSz)

if barstate.islast
    for _i = 0 to (array.size(lvLn) > 0 ? array.size(lvLn) - 1 : 0)
        if array.size(lvLn) > 0
            line.delete(array.get(lvLn, _i))
    for _i = 0 to (array.size(lvLb) > 0 ? array.size(lvLb) - 1 : 0)
        if array.size(lvLb) > 0
            label.delete(array.get(lvLb, _i))
    for _i = 0 to (array.size(lvBx) > 0 ? array.size(lvBx) - 1 : 0)
        if array.size(lvBx) > 0
            box.delete(array.get(lvBx, _i))
    array.clear(lvLn)
    array.clear(lvLb)
    array.clear(lvBx)
    array.clear(lvOut)
    line.delete(trH)
    line.delete(trL)
    if trOn and not na(thA) and not na(thB) and txA - txB >= pvN
        _sH = (thA - thB) / (txA - txB)
        _nH = _sH == 0 or close <= 0 ? trExt : math.min(trExt, int(math.abs(close * 0.4 / _sH)))
        trH := line.new(txB, thB, txA + _nH, thA + _sH * _nH, color = trHiC, width = 2)
    if trOn and not na(tlA) and not na(tlB) and lxA - lxB >= pvN
        _sL = (tlA - tlB) / (lxA - lxB)
        _nL = _sL == 0 or close <= 0 ? trExt : math.min(trExt, int(math.abs(close * 0.4 / _sL)))
        trL := line.new(lxB, tlB, lxA + _nL, tlA + _sL * _nL, color = trLoC, width = 2)

    // Nearest turning points first, so the levels drawn are the ones price has
    // to deal with next, not the loudest ones on the chart.
    _sepPct = math.max(lvlSep, na(atrV) or close <= 0 ? 0.0 : atrV / close * 100 * lvlAtr)
    _np = array.size(pvs)
    _seen = array.new<bool>(math.max(_np, 1), false)
    for _side = 0 to 1
        array.fill(_seen, false)
        _got = 0
        for _k = 0 to (_np > 0 ? _np - 1 : 0)
            if _np > 0 and _got < lvlMax
                _pick = -1
                _near = 1.0e12
                for _i = 0 to _np - 1
                    _c0 = array.get(pvs, _i)
                    _fits = _side == 0 ? _c0 > close : _c0 < close
                    if not array.get(_seen, _i) and _fits
                        _d = math.abs(_c0 - close)
                        if _d < _near
                            _near := _d
                            _pick := _i
                if _pick >= 0
                    array.set(_seen, _pick, true)
                    _lv = array.get(pvs, _pick)
                    _dup = false
                    for _j = 0 to (array.size(lvOut) > 0 ? array.size(lvOut) - 1 : 0)
                        if array.size(lvOut) > 0 and _lv > 0 and math.abs(array.get(lvOut, _j) - _lv) / _lv * 100 < _sepPct
                            _dup := true
                    if not _dup and _lv > 0
                        array.push(lvOut, _lv)
                        _got := _got + 1
                        if lvlOn
                            _c = _lv > close ? resCol : supCol2
                            array.push(lvLn, line.new(bar_index - 2, _lv, bar_index, _lv, extend = extend.both, color = color.new(_c, 40), width = 1, style = line.style_solid))
                            array.push(lvLb, label.new(bar_index, _lv, str.tostring(_lv, format.mintick), style = label.style_label_left, color = color.new(_c, 20), textcolor = color.white, size = size.tiny))

    // The stretches where price went nowhere. A breakout only means something
    // against one of these, which is why they are worth shading.
    if boxOn
        _found = 0
        _skip = 0
        for _i = 0 to 299
            if _skip > 0
                _skip := _skip - 1
            else if _found < 3
                _h2 = rgH2[_i]
                _l2 = rgL2[_i]
                _wide = not na(_l2) and _l2 > 0 and not na(_h2) and (_h2 - _l2) / _l2 * 100 <= rngW
                _bh = _wide ? _h2 : rgH[_i]
                _bl = _wide ? _l2 : rgL[_i]
                _len = _wide ? rngN * 2 : rngN
                if not na(_bl) and _bl > 0 and not na(_bh) and (_bh - _bl) / _bl * 100 <= rngW
                    array.push(lvBx, box.new(bar_index - _i - _len + 1, _bh, bar_index - _i, _bl, border_color = color.new(boxCol, 35), bgcolor = color.new(boxCol, 85)))
                    _found := _found + 1
                    _skip := _len

    table.clear(sc, 0, 0, 2, 41)
    _n = array.size(rSym)
    _buys = 0
    for _i = 0 to (_n > 0 ? _n - 1 : 0)
        if _n > 0 and array.get(rVer, _i) == 3
            _buys := _buys + 1
    _mName = chartMkt == 2 ? "INDIA" : chartMkt == 3 ? "CRYPTO" : "US"
    f_cell(0, 0, "STAGE SCANNER · " + _mName, color.new(#1a237e, 0), color.white)
    f_cell(1, 0, _buys > 0 ? "✅ " + str.tostring(_buys) + " BUY   RSI" : "⛔ 0 buy   RSI", _buys > 0 ? color.new(#00c853, 0) : color.new(color.gray, 30), color.white)
    _tfBad = scanTf != "D" and scanTf != "1D"
    f_cell(2, 0, _tfBad ? "⚠ " + scanTf + " — the 200-day is now 200 " + scanTf + " bars" : str.tostring(_n) + " " + _mName + " on " + scanTf + (_buys > 0 ? " — green rows are the buys" : " — nothing to buy yet; each row says what it needs") + "   ·   ◆ is this chart" + (array.get(rMiss, 0) > 0 ? "   ·   ⚠ " + str.tostring(array.get(rMiss, 0)) + " symbol(s) not resolving — check the list" : ""), _tfBad ? color.new(#b71c1c, 0) : color.new(#1a237e, 0), color.white)
    _r = 1
    for _i = 0 to (_n > 0 ? _n - 1 : 0)
        if _n > 0 and array.get(rMe, _i)
            _v = array.get(rVer, _i)
            _bg = _v == 3 ? color.new(#00e676, 0) : _v == 2 ? color.new(#1b5e20, 0) : _v == 1 ? color.new(#37474f, 0) : color.new(#b71c1c, 0)
            _tx = _v == 3 ? color.black : color.white
            f_cell(0, _r, array.get(rSym, _i), _bg, _tx)
            f_cell(1, _r, (_v == 3 ? "✅ BUY" : _v == 2 ? "► hold" : _v == 1 ? (array.get(rStg, _i) == 9 ? "👁 new" : "👁 watch") : array.get(rStg, _i) == 4 ? "⛔ SELL" : "⛔ no") + f_rs(array.get(rRsi, _i)), _bg, _tx)
            f_cell(2, _r, array.get(rWhy, _i), _bg, _tx)
            _r := _r + 1
    float _up1 = na
    float _up2 = na
    float _dn1 = na
    float _dn2 = na
    _nl = array.size(lvOut)
    for _i = 0 to (_nl > 0 ? _nl - 1 : 0)
        if _nl > 0
            _lv = array.get(lvOut, _i)
            if _lv > close
                if na(_up1) or _lv < _up1
                    _up2 := _up1
                    _up1 := _lv
                else if na(_up2) or _lv < _up2
                    _up2 := _lv
            if _lv < close
                if na(_dn1) or _lv > _dn1
                    _dn2 := _dn1
                    _dn1 := _lv
                else if na(_dn2) or _lv > _dn2
                    _dn2 := _lv
    // Past the last level drawn, the year's extreme is the only thing left.
    _upT = na(_up2) and not na(hiMe) and hiMe > close * 1.005 ? hiMe : _up2
    _dnT = na(_dn2) and not na(loMe) and loMe < close * 0.995 ? loMe : _dn2
    if _r < 41 and close > 0
        _pct1 = na(_up1) ? "" : " (+" + str.tostring((_up1 - close) / close * 100, "#.#") + "%)"
        _pct2 = na(_upT) ? "" : " (+" + str.tostring((_upT - close) / close * 100, "#.#") + "%)"
        f_cell(0, _r, "▲ IF IT GOES UP", color.new(#0d47a1, 0), color.white)
        f_cell(1, _r, na(_up1) ? "open air" : str.tostring(_up1, format.mintick), color.new(#0d47a1, 0), color.white)
        f_cell(2, _r, na(_up1) ? "nothing overhead on this chart — it is at the top of its own range" : "clears " + str.tostring(_up1, format.mintick) + _pct1 + " → then " + (na(_upT) ? "open air above" : str.tostring(_upT, format.mintick) + _pct2), color.new(#0d47a1, 0), color.white)
        _r := _r + 1
    if _r < 41 and close > 0
        _pct3 = na(_dn1) ? "" : " (" + str.tostring((_dn1 - close) / close * 100, "#.#") + "%)"
        _pct4 = na(_dnT) ? "" : " (" + str.tostring((_dnT - close) / close * 100, "#.#") + "%)"
        f_cell(0, _r, "▼ IF IT GOES DOWN", color.new(#bf360c, 0), color.white)
        f_cell(1, _r, na(_dn1) ? "no floor" : str.tostring(_dn1, format.mintick), color.new(#bf360c, 0), color.white)
        f_cell(2, _r, na(_dn1) ? "nothing under it on this chart — it is at the bottom of its own range" : "loses " + str.tostring(_dn1, format.mintick) + _pct3 + " → then " + (na(_dnT) ? "nothing below in range" : str.tostring(_dnT, format.mintick) + _pct4), color.new(#bf360c, 0), color.white)
        _r := _r + 1
    // Rule 1: three stocks in four follow the index, so count them.
    _bUp = 0
    _bDn = 0
    for _i = 0 to (_n > 0 ? _n - 1 : 0)
        if _n > 0
            _sg = array.get(rStg, _i)
            _bUp := _sg == 2 ? _bUp + 1 : _bUp
            _bDn := _sg == 4 ? _bDn + 1 : _bDn
    if _r < 41
        _mBg = mktConf ? color.new(#00e676, 0) : mktAtt ? color.new(#f9a825, 0) : color.new(#b71c1c, 0)
        _mTx = mktConf ? color.black : color.white
        _mWord = mktConf ? "✅ GO" : mktAtt ? "◷ WAIT" : "⛔ CASH"
        _mWhy = (mktConf ? "CONFIRMED UPTREND — follow-through day was " + str.tostring(bFtd) + " bars back and still stands. Buy, but start small and add only if the first buys work"
              : mktAtt ? "RALLY ATTEMPT, DAY " + str.tostring(bAtt) + " — from day " + str.tostring(ftdDay) + " a gain over " + str.tostring(ftdPct, "#.##") + "% on heavier volume is the follow-through. Undercut " + str.tostring(bAtLo, format.mintick) + " and the count restarts"
              : "IN CORRECTION — no rally attempt yet. No new buys, raise cash, cut any loss at 7-8%")
              + (mktUnd ? "   ·   index under its 50-day" : "")
              + "   ·   breadth " + str.tostring(_bUp) + " advancing / " + str.tostring(_bDn) + " declining of " + str.tostring(_n)
        f_cell(0, _r, "★ MARKET · " + f_label(benchPick), _mBg, _mTx)
        f_cell(1, _r, _mWord, _mBg, _mTx)
        f_cell(2, _r, _mWhy, _mBg, _mTx)
        _r := _r + 1
    // 3 then 2 then 1; a flat no only when asked for
    _done = array.new<bool>(math.max(_n, 1), false)
    for _want = 3 to 1
        for _k = 0 to (_n > 0 ? _n - 1 : 0)
            _pick = -1
            _near = 1.0e9
            for _i = 0 to (_n > 0 ? _n - 1 : 0)
                if _n > 0 and not array.get(_done, _i) and not array.get(rMe, _i) and array.get(rVer, _i) == _want and array.get(rGap, _i) < _near
                    _near := array.get(rGap, _i)
                    _pick := _i
            if _pick >= 0 and _r < 41
                _i = _pick
                array.set(_done, _i, true)
                _v = array.get(rVer, _i)
                _bg = _v == 3 ? color.new(#00e676, 0) : _v == 2 ? color.new(#1b5e20, 0) : color.new(#37474f, 0)
                _tx = _v == 3 ? color.black : color.white
                f_cell(0, _r, array.get(rSym, _i), _bg, _tx)
                f_cell(1, _r, (_v == 3 ? "✅ BUY" : _v == 2 ? "► hold" : array.get(rStg, _i) == 9 ? "👁 new" : "👁 watch") + f_rs(array.get(rRsi, _i)), _bg, _tx)
                f_cell(2, _r, array.get(rWhy, _i), _bg, _tx)
                _r := _r + 1
    for _i = 0 to (_n > 0 ? _n - 1 : 0)
        if showAll and _n > 0 and _r < 41 and array.get(rVer, _i) == 0 and not array.get(rMe, _i)
            f_cell(0, _r, array.get(rSym, _i), color.new(#b71c1c, 0), color.white)
            f_cell(1, _r, (array.get(rStg, _i) == 4 ? "⛔ SELL" : "⛔ no") + f_rs(array.get(rRsi, _i)), color.new(#b71c1c, 0), color.white)
            f_cell(2, _r, array.get(rWhy, _i), color.new(#b71c1c, 0), color.white)
            _r := _r + 1
    array.set(rMiss, 0, 0)
    array.clear(rRsi)
    array.clear(rStg)
    array.clear(rMe)
    array.clear(rGap)
    array.clear(rSym)
    array.clear(rVer)
    array.clear(rWhy)

// One alert for the whole list, so a name turning while you are on another
// chart still reaches you.
alertcondition(true, title = "Stage Scanner — something turned to BUY", message = "Stage Scanner: at least one symbol now reads BUY on {{interval}}")
