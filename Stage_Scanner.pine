//@version=6
// ═══════════════════════════════════════════════════════════════════════════
// STAGE SCANNER — "is it time to buy" across a whole watchlist
// ═══════════════════════════════════════════════════════════════════════════
// The Wyckoff panel answers that question for the chart you are looking at.
// This asks it of 38 symbols at once and shows only the ones worth your
// attention, so a name that turns while you are looking elsewhere does not go
// unnoticed.
//
// It is a separate script because Pine allows 40 request calls per indicator
// and the Wyckoff panel already spends 5 of its own. Here all 40 are free:
// 38 symbols plus one benchmark for relative strength.
//
// The rules are the same three the ★ IS IT TIME? row uses, in the same order:
//   the stage decides whether buying is allowed at all
//   a dip or a breakout decides whether now is the moment
//   relative strength decides whether this is the name worth owning
// What it does NOT do is replicate the full panel. A YES here means go and
// read that symbol's chart, not place an order.
// ═══════════════════════════════════════════════════════════════════════════
indicator("Stage Scanner", overlay = true, max_bars_back = 500)

scanTf  = input.timeframe("D", "Timeframe to scan", tooltip = "Daily keeps the 200-day a true 200-day whatever chart this sits on.", group = "1. Scan")
rsBench = input.symbol("AMEX:SPY", "Benchmark for the US list", group = "1. Scan")
rsBenc3 = input.symbol("BINANCE:BTCUSDT", "Benchmark for the crypto list", group = "1. Scan")
rsBenc2 = input.symbol("NSE:NIFTY", "Benchmark for the India list", tooltip = "Relative strength only means anything against the market the stock trades in. Measuring an NSE name against SPY mixes two market cycles and the rupee, and buries a stock leading its own index.", group = "1. Scan")
rsLen   = input.int(26, "Relative strength lookback (bars)", minval = 5, maxval = 250, group = "1. Scan")
slopeN  = input.int(20, "Bars used to judge the 200-day slope", minval = 5, maxval = 120, group = "1. Scan")
flatPct = input.float(0.5, "Slope under this % counts as flat", minval = 0.0, maxval = 10.0, step = 0.1, group = "1. Scan")
swingN  = input.int(40, "Bars per swing when testing higher highs and lows", minval = 5, maxval = 150, group = "1. Scan")
dipNear = input.float(2.0, "A dip counts within this % of the 50-day", minval = 0.2, maxval = 15.0, step = 0.1, group = "1. Scan")
dipVol  = input.float(1.0, "Light volume is under this multiple", minval = 0.3, maxval = 2.0, step = 0.05, group = "1. Scan")
baseN   = input.int(50, "Bars the base is measured over", minval = 10, maxval = 200, tooltip = "Scanning daily keeps the 200-day honest, but it also makes every window daily. The chart panel measures a base over 10 weekly bars, so 50 is the daily equivalent. Shorten this and the scanner starts calling four-week pauses inside a run a base.", group = "1. Scan")
baseW   = input.float(15.0, "A base must be no wider than this (%) for a break of it to count", minval = 2.0, maxval = 60.0, step = 0.5, tooltip = "Without this the test is just a 10-bar high on volume, which fires on anything extended. The chart panel will not tick its pivot box without a base either, and the two must not disagree.", group = "1. Scan")
brkVol  = input.float(1.4, "Breakout volume multiple", minval = 1.0, maxval = 4.0, step = 0.05, group = "1. Scan")
showAll = input.bool(false, "Show every symbol, not just the ones that qualify", group = "4. Display")
sPos    = input.string("Top Right", "Panel position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group = "4. Display")
sSize   = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal"], group = "4. Display")

sym01 = input.symbol("NASDAQ:AAPL", "#1", group = "2. US symbols")
sym02 = input.symbol("NASDAQ:MSFT", "#2", group = "2. US symbols")
sym03 = input.symbol("NASDAQ:NVDA", "#3", group = "2. US symbols")
sym04 = input.symbol("NASDAQ:GOOGL", "#4", group = "2. US symbols")
sym05 = input.symbol("NASDAQ:AMZN", "#5", group = "2. US symbols")
sym06 = input.symbol("NASDAQ:META", "#6", group = "2. US symbols")
sym07 = input.symbol("NASDAQ:AVGO", "#7", group = "2. US symbols")
sym08 = input.symbol("NYSE:BRK.B", "#8", group = "2. US symbols")
sym09 = input.symbol("NYSE:LLY", "#9", group = "2. US symbols")
sym10 = input.symbol("NYSE:UNH", "#10", group = "2. US symbols")
sym11 = input.symbol("NYSE:V", "#11", group = "2. US symbols")
sym12 = input.symbol("NYSE:JPM", "#12", group = "2. US symbols")
sym13 = input.symbol("NYSE:XOM", "#13", group = "2. US symbols")
sym14 = input.symbol("NASDAQ:COST", "#14", group = "2. US symbols")
sym15 = input.symbol("NYSE:KO", "#15", group = "2. US symbols")
sym16 = input.symbol("NSE:RELIANCE", "#16", group = "3. India symbols")
sym17 = input.symbol("NSE:HDFCBANK", "#17", group = "3. India symbols")
sym18 = input.symbol("NSE:TCS", "#18", group = "3. India symbols")
sym19 = input.symbol("NSE:INFY", "#19", group = "3. India symbols")
sym20 = input.symbol("NSE:ICICIBANK", "#20", group = "3. India symbols")
sym21 = input.symbol("NSE:BHARTIARTL", "#21", group = "3. India symbols")
sym22 = input.symbol("NSE:ITC", "#22", group = "3. India symbols")
sym23 = input.symbol("NSE:LT", "#23", group = "3. India symbols")
sym24 = input.symbol("NSE:SBIN", "#24", group = "3. India symbols")
sym25 = input.symbol("NSE:AXISBANK", "#25", group = "3. India symbols")
sym26 = input.symbol("NSE:KOTAKBANK", "#26", group = "3. India symbols")
sym27 = input.symbol("NSE:HINDUNILVR", "#27", group = "3. India symbols")
sym28 = input.symbol("NSE:BAJFINANCE", "#28", group = "3. India symbols")
sym29 = input.symbol("BINANCE:BTCUSDT", "#29", group = "4. Crypto symbols")
sym30 = input.symbol("BINANCE:ETHUSDT", "#30", group = "4. Crypto symbols")
sym31 = input.symbol("BINANCE:SOLUSDT", "#31", group = "4. Crypto symbols")
sym32 = input.symbol("BINANCE:BNBUSDT", "#32", group = "4. Crypto symbols")
sym33 = input.symbol("BINANCE:XRPUSDT", "#33", group = "4. Crypto symbols")
sym34 = input.symbol("BINANCE:ADAUSDT", "#34", group = "4. Crypto symbols")
sym35 = input.symbol("BINANCE:AVAXUSDT", "#35", group = "4. Crypto symbols")
sym36 = input.symbol("BINANCE:LINKUSDT", "#36", group = "4. Crypto symbols")
sym37 = input.symbol("BINANCE:DOTUSDT", "#37", group = "4. Crypto symbols")

// ═══════════════════════════════════════════════════════════════
// THE SCAN
// ═══════════════════════════════════════════════════════════════
// Everything below runs inside each symbol's own context, so close, volume
// and the averages refer to that symbol rather than the chart. One request
// call each, which is what keeps 38 of them inside the budget.
//
// Higher highs and higher lows are measured as this swing window against the
// one before it. That is coarser than the pivot store the Wyckoff panel uses
// and it has to be: a pivot store cannot be carried across a request.
f_state() =>
    _d200 = ta.sma(close, 200)
    _d50  = ta.sma(close, 50)
    _ref  = _d200[slopeN]
    _slp  = na(_ref) or _ref <= 0 ? na : (_d200 - _ref) / _ref * 100
    _up   = not na(_slp) and _slp > flatPct
    _dn   = not na(_slp) and _slp < -flatPct
    _hh   = ta.highest(high, swingN) > ta.highest(high, swingN)[swingN]
    _hl   = ta.lowest(low, swingN) > ta.lowest(low, swingN)[swingN]
    _va   = ta.sma(volume, 20)
    _vx   = na(_va) or _va <= 0 ? na : volume / _va
    _abv  = not na(_d200) and close > _d200
    // 2 advancing, 4 declining, 3 above a stalled average, 1 basing
    _stage = _abv and _up and _hh and _hl ? 2 : not _abv and _dn and not _hh and not _hl ? 4 : _abv ? 3 : 1
    _dip  = _abv and not na(_d50) and low <= _d50 * (1 + dipNear / 100) and (na(_vx) or _vx <= dipVol)
    _bHi  = ta.highest(high, baseN)[1]
    _bLo  = ta.lowest(low, baseN)[1]
    _base = not na(_bLo) and _bLo > 0 and (_bHi - _bLo) / _bLo * 100 <= baseW
    _brk  = _base and close > _bHi and not na(_vx) and _vx >= brkVol and close > close[1]
    [_stage, _dip ? 1 : 0, _brk ? 1 : 0, close, close[rsLen], _d50, _base ? _bHi : na]

var array<string> rSym = array.new<string>()
var array<int>    rVer = array.new<int>()
var array<string> rWhy = array.new<string>()
var array<float>  rGap = array.new<float>()

// 1 US, 2 India, 3 crypto — taken from the symbol string rather than from
// which input slot it sits in, so any slot can hold anything.
f_mkt(string _s) =>
    _u = str.upper(_s)
    str.contains(_u, "NSE:") or str.contains(_u, "BSE:") ? 2 : str.contains(_u, "USDT") or str.contains(_u, "USD.P") or str.contains(_u, "BINANCE") or str.contains(_u, "COINBASE") or str.contains(_u, "BITSTAMP") ? 3 : 1

chartMkt = syminfo.type == "crypto" ? 3 : str.contains(str.upper(syminfo.prefix), "NSE") or str.contains(str.upper(syminfo.prefix), "BSE") ? 2 : 1

f_label(string _s) =>
    _i = str.pos(_s, ":")
    na(_i) ? _s : str.substring(_s, _i + 1)

// The three benchmarks, declared ahead of f_push because it reads them.
[bNow3, bOld3] = request.security(rsBenc3, scanTf, [close, close[rsLen]], ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
[bNow2, bOld2] = request.security(rsBenc2, scanTf, [close, close[rsLen]], ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
[bNow, bOld] = request.security(rsBench, scanTf, [close, close[rsLen]], ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)

// 3 = buy, 2 = stage 2 with no entry, 1 = watchlist, 0 = no.
// Only the market you are looking at is collected, so a US chart never lists
// NSE names and the panel stays the length of one market.
f_push(string _sym, int _st, int _dp, int _bk, float _px, float _og, float _d50, float _bhi) =>
    _m = f_mkt(_sym)
    if barstate.islast and not na(_px) and _m == chartMkt
        _b  = _m == 2 ? bNow2 : _m == 3 ? bNow3 : bNow
        _bo = _m == 2 ? bOld2 : _m == 3 ? bOld3 : bOld
        _rs = na(_og) or _og <= 0 or na(_b) or na(_bo) or _bo <= 0 ? false : _px / _og > _b / _bo
        _v = _st == 2 and (_bk == 1 or _dp == 1) and _rs ? 3 : _st == 2 ? 2 : _st == 1 ? 1 : 0
        // What would have to happen for this to become a buy, with the number.
        _gap = na(_d50) or _px <= 0 ? na : (_px - _d50) / _px * 100
        _trig = _v == 3 ? (_bk == 1 ? "BREAKOUT on volume, RS gaining" : "dip to the 50-day, RS gaining")
             : _v == 2 and not _rs ? "setup is there — needs RS to turn, see its chart"
             : _v == 2 and not na(_bhi) ? "buy a close above " + str.tostring(_bhi, format.mintick) + " on volume — " + str.tostring((_bhi - _px) / _px * 100, "#.#") + "% above"
             : _v == 2 and not na(_gap) and _gap > 0 ? "buy a dip to the 50-day " + str.tostring(_d50, format.mintick) + " — " + str.tostring(_gap, "#.#") + "% below"
             : _v == 2 ? "Stage 2, waiting for a dip or a base to form"
             : _v == 1 ? "basing — needs the 200-day to turn up and price to clear it"
             : _st == 4 ? "Stage 4 — stay away" : "above a stalled average"
        // how far the trigger is, so the list can lead with the nearest
        _dist = _v == 2 and not na(_bhi) ? math.abs(_bhi - _px) / _px * 100 : _v == 2 and not na(_gap) and _gap > 0 ? _gap : 999.0
        array.push(rGap, _dist)
        array.push(rSym, f_label(_sym))
        array.push(rVer, _v)
        array.push(rWhy, _trig)


[st01, dp01, bk01, px01, og01, md01, bh01] = request.security(sym01, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym01, st01, dp01, bk01, px01, og01, md01, bh01)
[st02, dp02, bk02, px02, og02, md02, bh02] = request.security(sym02, scanTf, f_state(), ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
f_push(sym02, st02, dp02, bk02, px02, og02, md02, bh02)
