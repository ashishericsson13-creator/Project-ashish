//@version=6
// ═══════════════════════════════════════════════════════════════════════════
// STAGE SCANNER — "is it time to buy" across a whole watchlist
// ═══════════════════════════════════════════════════════════════════════════
// The Wyckoff panel answers that question for the chart you are looking at.
// This asks it of 38 symbols at once and shows only the ones worth your
// attention, so a name that turns while you are looking elsewhere does not go
// unnoticed.
//
// It is a separate script because Pine allows 40 request calls per indicator
// and the Wyckoff panel already spends 5 of its own. Here all 40 are free:
// 38 symbols plus one benchmark for relative strength.
//
// The rules are the same three the ★ IS IT TIME? row uses, in the same order:
//   the stage decides whether buying is allowed at all
//   a dip or a breakout decides whether now is the moment
//   relative strength decides whether this is the name worth owning
// What it does NOT do is replicate the full panel. A YES here means go and
// read that symbol's chart, not place an order.
// ═══════════════════════════════════════════════════════════════════════════
indicator("Stage Scanner", overlay = true, max_bars_back = 500, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 50)

// Which market this chart belongs to. Every slot below points at that
// market's symbol, so 32 requests cover 96 symbols: only the 32 that match
// the chart are ever fetched.
mktMode  = input.string("Auto", "Which list to show", options = ["Auto", "US", "India", "Crypto"], tooltip = "Auto follows the chart. Set it by hand if a symbol's exchange is not recognised.", group = "1. Scan")
autoMkt  = syminfo.type == "crypto" ? 3 : syminfo.prefix == "NSE" or syminfo.prefix == "BSE" ? 2 : 1
chartMkt = mktMode == "US" ? 1 : mktMode == "India" ? 2 : mktMode == "Crypto" ? 3 : autoMkt

scanTf  = input.timeframe("D", "Timeframe to scan", tooltip = "Daily keeps the 200-day a true 200-day whatever chart this sits on.", group = "1. Scan")
rsBench = input.symbol("AMEX:SPY", "Benchmark — US", group = "1. Scan")
rsBenc3 = input.symbol("BINANCE:BTCUSDT", "Benchmark for the crypto list", group = "1. Scan")
rsBenc2 = input.symbol("NSE:NIFTY", "Benchmark for the India list", tooltip = "Relative strength only means anything against the market the stock trades in. Measuring an NSE name against SPY mixes two market cycles and the rupee, and buries a stock leading its own index.", group = "1. Scan")
rsLen   = input.int(26, "Relative strength lookback (bars)", minval = 5, maxval = 250, group = "1. Scan")
slopeN  = input.int(20, "Bars used to judge the 200-day slope", minval = 5, maxval = 120, group = "1. Scan")
flatPct = input.float(0.5, "Slope under this % counts as flat", minval = 0.0, maxval = 10.0, step = 0.1, group = "1. Scan")
swingN  = input.int(40, "Bars per swing when testing higher highs and lows", minval = 5, maxval = 150, group = "1. Scan")
dipNear = input.float(2.0, "A dip counts within this % of the 50-day", minval = 0.2, maxval = 15.0, step = 0.1, group = "1. Scan")
dipVol  = input.float(1.0, "Light volume is under this multiple", minval = 0.3, maxval = 2.0, step = 0.05, group = "1. Scan")
baseN   = input.int(50, "Bars the base is measured over", minval = 10, maxval = 200, tooltip = "Scanning daily keeps the 200-day honest, but it also makes every window daily. The chart panel measures a base over 10 weekly bars, so 50 is the daily equivalent. Shorten this and the scanner starts calling four-week pauses inside a run a base.", group = "1. Scan")
baseW   = input.float(15.0, "A base must be no wider than this (%) for a break of it to count", minval = 2.0, maxval = 60.0, step = 0.5, tooltip = "Without this the test is just a 10-bar high on volume, which fires on anything extended. The chart panel will not tick its pivot box without a base either, and the two must not disagree.", group = "1. Scan")
brkVol  = input.float(1.4, "Breakout volume multiple", minval = 1.0, maxval = 4.0, step = 0.05, group = "1. Scan")
showAll = input.bool(false, "Show every symbol, not just the ones that qualify", group = "4. Display")
sPos    = input.string("Top Right", "Panel position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group = "4. Display")
sSize   = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal"], group = "4. Display")

us01 = input.symbol("AAPL", "US #1", group = "2. US list")
in01 = input.symbol("NSE:RELIANCE", "India #1", group = "3. India list")
cr01 = input.symbol("BINANCE:BTCUSDT", "Crypto #1", group = "4. Crypto list")
