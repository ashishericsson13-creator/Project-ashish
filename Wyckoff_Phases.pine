//@version=6
// ═══════════════════════════════════════════════════════════════════════════
// WYCKOFF PHASES v1.0
//
// WHAT IT IS
//   A reader for the Wyckoff accumulation and distribution schematics. It
//   finds a trading range, works out whether that range sits after an advance
//   (distribution) or after a decline (accumulation), then names the events
//   inside it and the phase they add up to.
//
// WHAT IT WILL NOT DO
//   It does not predict the phase that comes next. A range is only a range
//   until it breaks, and Phase B can run far longer than anyone's patience.
//   Every event below is reported after its bar has closed.
//
// WHY IT IS A SEPARATE SCRIPT
//   Money Line already detects the spring and the upthrust - it calls them
//   failed breakdown and failed breakout - but it is at its token limit and
//   the phase logic needs room. Run both; this one answers "where in the
//   structure are we", that one answers "what do I do".
//
// THE EVENTS
//   accumulation   PS · SC · AR · ST · Spring · Test · SOS · LPS
//   distribution   PSY · BC · AR · ST · UT · UTAD · SOW · LPSY
//
// THE PHASES
//   A  the prior trend is stopped          climax, then the automatic reaction
//   B  the cause is built                  the range, tests of both edges
//   C  the test                            spring (accum) or UTAD (dist)
//   D  the move to the edge                SOS/LPS up, or SOW/LPSY down
//   E  the trend out of the range          markup or markdown
// ═══════════════════════════════════════════════════════════════════════════
indicator("Wyckoff Phases v1.7", overlay = true, max_labels_count = 500, max_lines_count = 500, max_bars_back = 1000)

// ── 1. The range ───
rngLen   = input.int(30, "Range lookback (bars)", minval = 8, maxval = 200, tooltip = "How far back the script measures the consolidation. Too short and every pause looks like a range; too long and a real range is diluted by the trend that preceded it.", group = "1. Range")
rngMaxW  = input.float(70.0, "Sanity cap on range width (%)", minval = 10.0, maxval = 200.0, step = 5.0, tooltip = "A backstop only. Width is a poor test of sideways: seven months of weekly bars on a liquid large-cap routinely spans 40% while going nowhere. What actually defines the range is the touch count below.", group = "1. Range")
minTouch = input.int(2, "Visits to each edge before it counts as a range", minval = 1, maxval = 6, tooltip = "This is the real test. A range is a range because price went to both boundaries more than once. A V-shaped reversal touches each extreme once and is not a range, however flat its net move looks.", group = "1. Range")
rngMinB  = input.int(10, "Minimum bars before a range counts", minval = 5, maxval = 100, group = "1. Range")
edgeTol  = input.float(1.5, "Edge tolerance (% of range width)", minval = 0.2, maxval = 10.0, step = 0.1, tooltip = "How close to a boundary a bar must come to count as a test of it.", group = "1. Range")

// ── 2. The prior trend ───
// A range after an advance is distribution. The same range after a decline is
// accumulation. Nothing else about the range tells you which, so this is the
// single most important input in the script.
priorLen = input.int(40, "Bars before the range used to judge the prior trend", minval = 10, maxval = 300, group = "2. Prior trend")
priorMin = input.float(15.0, "Prior move must be at least this big (%)", minval = 3.0, maxval = 100.0, step = 1.0, group = "2. Prior trend")

// ── 3. Events ───
volLen   = input.int(20, "Volume average length", minval = 5, maxval = 100, group = "3. Events")
climX    = input.float(1.8, "Climax: volume this many times the average", minval = 1.1, maxval = 6.0, step = 0.1, tooltip = "The buying or selling climax is the bar that ends the prior trend on extreme participation. Below about 1.5 ordinary bars start qualifying.", group = "3. Events")
wideX    = input.float(1.3, "Climax: bar range this many times ATR", minval = 0.8, maxval = 4.0, step = 0.1, group = "3. Events")
sprBack  = input.int(3, "Spring / upthrust must be retaken within this many bars", minval = 1, maxval = 10, group = "3. Events")
sosVolX  = input.float(1.2, "SOS / SOW needs volume this many times the average", minval = 0.8, maxval = 4.0, step = 0.1, group = "3. Events")
evAge    = input.int(60, "Forget an event after this many bars", minval = 10, maxval = 300, group = "3. Events")

// ── 4. Display ───
showBox  = input.bool(true, "Draw the range boundaries", group = "4. Display")
showEv   = input.bool(true, "Label events on the chart", group = "4. Display")
panelPos = input.string("Bottom Left", "Panel position", options = ["Bottom Left", "Top Left", "Top Right", "Middle Left", "Bottom Right"], group = "4. Display")
panelSz  = input.string("Small", "Panel text size", options = ["Tiny", "Small", "Normal"], group = "4. Display")
show200  = input.bool(true, "Draw the 200-week moving average", group = "5. 200-week average")
col200   = input.color(#ff6d00, "Line colour", group = "5. 200-week average")

// ═══════════════════════════════════════════════════════════════
// MEASUREMENTS — every ta.* call runs unconditionally, on every bar
// ═══════════════════════════════════════════════════════════════
atrV   = ta.atr(14)
volAvg = ta.sma(volume, volLen)
volX   = volAvg > 0 ? volume / volAvg : na
// A forming bar carries partial volume, so every climax and SOS/SOW test reads
// light. BE showed 0.2x, AMZN 0.1x, CRM 0x - all of them mid-week.
barLive = time_close > timenow

// Formatting helpers, kept above every row that uses them.
f_px(float _v) => str.tostring(_v, format.mintick)
f_n0(float _v) => str.tostring(_v, "#")
f_n1(float _v) => str.tostring(_v, "#.#")
// "#.#" drops the decimal below 0.05 and prints a bare "0", so the volume
// multiple gets a format that always keeps one.
f_nx(float _v) => str.tostring(_v, "0.0")
barRng = high - low
wideBar = not na(atrV) and atrV > 0 and barRng >= atrV * wideX

// The range is measured to the PREVIOUS bar, so the bar being judged is never
// part of the boundary it is being tested against. Without the offset a spring
// can never happen: the low that breaks the range also redefines it.
rngHi = ta.highest(high, rngLen)[1]
rngLo = ta.lowest(low, rngLen)[1]
rngW  = not na(rngHi) and not na(rngLo) and rngLo > 0 ? (rngHi - rngLo) / rngLo * 100 : na
tol   = na(rngHi) or na(rngLo) ? na : (rngHi - rngLo) * edgeTol / 100

// Distinct visits to a boundary: the count rises when price arrives, not for
// every bar it loiters there.
f_visits(float _lvl, float _tol, int _n, bool _up) =>
    _c = 0
    _prev = false
    for _i = _n to 1
        _now = _up ? high[_i] >= _lvl - _tol : low[_i] <= _lvl + _tol
        if _now and not _prev
            _c += 1
        _prev := _now
    _c

hiVisits = na(rngHi) or na(tol) ? 0 : f_visits(rngHi, tol, rngLen, true)
loVisits = na(rngLo) or na(tol) ? 0 : f_visits(rngLo, tol, rngLen, false)
touchOk = hiVisits >= minTouch and loVisits >= minTouch
rngOk = not na(rngW) and rngW <= rngMaxW and bar_index >= rngMinB + rngLen and touchOk

// Prior trend, measured from before the range so the range itself cannot
// colour the verdict.
pStart = close[rngLen + priorLen]
pEnd   = close[rngLen]
pMove  = not na(pStart) and not na(pEnd) and pStart > 0 ? (pEnd - pStart) / pStart * 100 : na
priorUp = not na(pMove) and pMove >= priorMin
priorDn = not na(pMove) and pMove <= -priorMin

// bias: +1 distribution (range after an advance), -1 accumulation, 0 unknown
bias = priorUp ? 1 : priorDn ? -1 : 0

// ═══════════════════════════════════════════════════════════════
// EVENTS
// ═══════════════════════════════════════════════════════════════
hiTest = not na(rngHi) and not na(tol) and high >= rngHi - tol
loTest = not na(rngLo) and not na(tol) and low <= rngLo + tol

// CLIMAX — the bar that ends the prior trend on extreme participation.
climVol = not na(volX) and volX >= climX
bcNow = rngOk and bias == 1 and climVol and wideBar and hiTest
scNow = rngOk and bias == -1 and climVol and wideBar and loTest

// SPRING / UPTHRUST — the boundary gives way intrabar and is taken back.
// This is the single most useful event in the schematic and the one Money
// Line already finds under the name "failed breakdown" / "failed breakout".
sprNow = rngOk and low < rngLo and close > rngLo
utNow  = rngOk and high > rngHi and close < rngHi

// SOS / SOW — a decisive close outside the range, on volume.
sosNow = rngOk and close > rngHi and not na(volX) and volX >= sosVolX
sowNow = rngOk and close < rngLo and not na(volX) and volX >= sosVolX

// ── event memory ───
var int bcBar = na
var float bcPx = na
var int scBar = na
var float scPx = na
var int arBar = na
var float arPx = na
var int stBar = na
var int sprBar = na
var int utBar = na
var int utadBar = na
var int sosBar = na
var int sowBar = na
var int lpsBar = na
var int lpsyBar = na
var float lastSwHi = na
var float lastSwLo = na

if bcNow
    bcBar := bar_index
    bcPx  := high
if scNow
    scBar := bar_index
    scPx  := low
// AUTOMATIC REACTION — the sharp move away from the climax that sets the
// opposite boundary. It is only an AR if a climax came first.
if not na(bcBar) and bar_index > bcBar and bar_index - bcBar <= 10 and na(arBar) and loTest
    arBar := bar_index
    arPx  := low
if not na(scBar) and bar_index > scBar and bar_index - scBar <= 10 and na(arBar) and hiTest
    arBar := bar_index
    arPx  := high
// SECONDARY TEST — a return to the climax end of the range that fails on
// lighter volume than the climax itself.
if not na(arBar) and bar_index > arBar and na(stBar) and not na(volX) and volX < climX
    if bias == 1 and hiTest
        stBar := bar_index
    if bias == -1 and loTest
        stBar := bar_index
if sprNow
    sprBar := bar_index
if utNow
    utBar := bar_index
    // An upthrust AFTER the range has been tested from both sides is UTAD -
    // the last one, the one that matters.
    if not na(stBar)
        utadBar := bar_index
if sosNow
    sosBar := bar_index
if sowNow
    sowBar := bar_index

// ── swings, for LPS and LPSY ───
swHi = ta.pivothigh(high, 3, 3)
swLo = ta.pivotlow(low, 3, 3)
if not na(swHi)
    // LPSY: a LOWER high after a sign of weakness. The last place supply shows
    // up before the markdown.
    if not na(sowBar) and bar_index - 3 > sowBar and not na(lastSwHi) and swHi < lastSwHi
        lpsyBar := bar_index - 3
    lastSwHi := swHi
if not na(swLo)
    // LPS: a HIGHER low after a sign of strength.
    if not na(sosBar) and bar_index - 3 > sosBar and not na(lastSwLo) and swLo > lastSwLo
        lpsBar := bar_index - 3
    lastSwLo := swLo

// ═══════════════════════════════════════════════════════════════
// WAVE STRUCTURE — the Elliott rules, without the counting
// ═══════════════════════════════════════════════════════════════
// A labelled count repaints by nature: a swing called wave 3 becomes wave 1 of
// a larger degree once price extends, so the count rewrites its own history.
// These two readings do not. The first is the swing sequence, which is a fact
// about six specific pivots. The second tests whether those pivots COULD be a
// valid impulse - a violation rules a count out, which is hard information,
// where a label would only be one of several readings the data allows.
var float w1 = na
var float w2 = na
var float w3 = na
var float w4 = na
var float w5 = na
var float w6 = na
var int w1t = 0
var int w2t = 0
var int w3t = 0
var int w4t = 0
var int w5t = 0
var int w6t = 0

// A new pivot of the same type as the last one extends it rather than being
// recorded separately, so the store always alternates high, low, high, low.
if not na(swHi)
    if w1t == 1
        if swHi > w1
            w1 := swHi
    else
        w6 := w5
        w6t := w5t
        w5 := w4
        w5t := w4t
        w4 := w3
        w4t := w3t
        w3 := w2
        w3t := w2t
        w2 := w1
        w2t := w1t
        w1 := swHi
        w1t := 1
if not na(swLo)
    if w1t == -1
        if swLo < w1
            w1 := swLo
    else
        w6 := w5
        w6t := w5t
        w5 := w4
        w5t := w4t
        w4 := w3
        w4t := w3t
        w3 := w2
        w3t := w2t
        w2 := w1
        w2t := w1t
        w1 := swLo
        w1t := -1

wHave = not na(w1) and not na(w2) and not na(w3) and not na(w4)
wFull = wHave and not na(w5) and not na(w6)
// the two most recent highs and the two most recent lows, whichever way the
// store happens to be oriented
hA = w1t == 1 ? w1 : w2
hB = w1t == 1 ? w3 : w4
lA = w1t == 1 ? w2 : w1
lB = w1t == 1 ? w4 : w3
wUp = wHave and hA > hB and lA > lB
wDn = wHave and hA < hB and lA < lB

// THE THREE IMPULSE RULES, read over w6 to w1 as waves 1 to 5.
upImp = wFull and w6t == -1 and w1t == 1
dnImp = wFull and w6t == 1 and w1t == -1
len1 = wFull ? math.abs(w5 - w6) : na
len3 = wFull ? math.abs(w3 - w4) : na
len5 = wFull ? math.abs(w1 - w2) : na
// rule 2: wave 2 never retraces past the start of wave 1
r2 = upImp ? w4 > w6 : dnImp ? w4 < w6 : false
// rule 3: wave 3 is never the shortest of the three impulse legs
r3 = (upImp or dnImp) and not na(len3) and not (len3 < len1 and len3 < len5)
// rule 4: wave 4 never enters the price territory of wave 1
r4 = upImp ? w2 > w5 : dnImp ? w2 < w5 : false
rAll = r2 and r3 and r4
rBroke = (upImp or dnImp) and not rAll

wWord = not wHave ? "► NOT ENOUGH SWINGS" : wUp and rAll ? "▲ BULLISH" : wDn and rAll ? "▼ BEARISH" : wUp ? "▲ bullish, but not a clean impulse" : wDn ? "▼ bearish, but not a clean impulse" : "► CORRECTIVE"
wSay = not wHave ? "Fewer than four confirmed swings so far." : (wUp ? "higher highs and higher lows" : wDn ? "lower highs and lower lows" : "swings overlap — a correction, not an impulse") + (not (upImp or dnImp) ? "   ·   not impulse-shaped, so the rules do not apply" : rAll ? "   ·   all three impulse rules satisfied" : "   ·   wave 2 " + (r2 ? "✓" : "✗") + "  wave 3 " + (r3 ? "✓" : "✗") + "  wave 4 " + (r4 ? "✓" : "✗") + " — NOT a valid impulse") + "   ·   last 4 swings — the current leg, not the whole chart"

f_age(int _b) => na(_b) ? na : bar_index - _b
f_live(int _b) => not na(_b) and bar_index - _b <= evAge

// ═══════════════════════════════════════════════════════════════
// PHASE
// ═══════════════════════════════════════════════════════════════
// Read strictly in order: the latest event that has fired decides the phase,
// because the schematic only ever runs forwards.
inRange = rngOk and close <= rngHi and close >= rngLo
brokeUp = rngOk and close > rngHi
brokeDn = rngOk and close < rngLo

phase = not rngOk ? "—" : bias == 0 ? "—" : f_live(lpsyBar) or (f_live(sowBar) and brokeDn and not na(stBar)) ? "E" : f_live(lpsBar) or (f_live(sosBar) and brokeUp and not na(stBar)) ? "E" : f_live(sowBar) or f_live(sosBar) ? "D" : f_live(utadBar) or f_live(sprBar) ? "C" : not na(stBar) ? "B" : not na(arBar) ? "A" : not na(bcBar) or not na(scBar) ? "A" : "B"

phWord = phase == "—" ? (not rngOk ? "no range — " + f_n0(hiVisits) + " visit(s) to the high and " + f_n0(loVisits) + " to the low; " + f_n0(minTouch) + " of each are needed" : "a range, but the move into it was too small to classify")  : phase == "A" ? "A — the prior trend is being stopped" : phase == "B" ? "B — building the cause inside the range" : phase == "C" ? "C — the test" : phase == "D" ? "D — moving to the edge of the range" : "E — the trend out of the range"

// Zones and targets. The measured move is the range height projected from the
// edge it breaks - the standard Wyckoff objective, and the reason the cause
// built in Phase B sets the size of the effect in Phase E.
rngH   = na(rngHi) or na(rngLo) ? na : rngHi - rngLo
buyHi  = na(rngH) ? na : rngLo + rngH * 0.25
sellLo = na(rngH) ? na : rngHi - rngH * 0.25
tgtUp  = na(rngH) ? na : rngHi + rngH
tgtDn  = na(rngH) ? na : rngLo - rngH
late   = phase == "C" or phase == "D" or phase == "E"

// Without a range there is nothing to classify yet, so the schematic answers
// the conditional question - if a range forms here, which kind would it be -
// rather than reporting accumulation as a finding two rows above RANGE saying
// there is no range.
schem = (bias == 1 ? "DISTRIBUTION" : bias == -1 ? "ACCUMULATION" : "UNCLASSIFIED") + (rngOk or bias == 0 ? "" : " — ONLY IF A RANGE FORMS")
// The bias is the whole interpretation. A spring in accumulation is the buy;
// the identical bar in distribution is a failed break inside a topping range.
schemCol = not rngOk ? color.new(color.gray, 45) : bias == 1 ? color.new(#d50000, 20) : bias == -1 ? color.new(#00c853, 20) : color.new(color.gray, 45)

// ═══════════════════════════════════════════════════════════════
// READ-OUT
// ═══════════════════════════════════════════════════════════════
f_ev(string _n, int _b) => f_live(_b) ? _n + " " + f_n0(f_age(_b)) + "b · " : ""

evList = (f_ev(bias == 1 ? "BC" : "SC", bias == 1 ? bcBar : scBar)) + f_ev("AR", arBar) + f_ev("ST", stBar) + f_ev(bias == 1 ? "UT" : "spring", bias == 1 ? utBar : sprBar) + f_ev("UTAD", utadBar) + f_ev(bias == 1 ? "SOW" : "SOS", bias == 1 ? sowBar : sosBar) + f_ev(bias == 1 ? "LPSY" : "LPS", bias == 1 ? lpsyBar : lpsBar)
evSay = bias == 0 ? "no schematic to name events against" : evList == "" ? "none yet in the last " + f_n0(evAge) + " bars" : str.substring(evList, 0, math.max(0, str.length(evList) - 3))

rngSay = not rngOk ? (na(rngW) ? "not enough history" : "no range — " + f_n1(rngW) + "% wide, " + f_n0(hiVisits) + " visit(s) to the high and " + f_n0(loVisits) + " to the low over " + f_n0(rngLen) + " bars" + (rngW > rngMaxW ? ", and past the width cap" : "")) : f_px(rngLo) + " to " + f_px(rngHi) + "   ·   " + f_n1(rngW) + "% wide   ·   price " + (brokeUp ? "ABOVE it" : brokeDn ? "BELOW it" : "inside, " + f_n1((close - rngLo) / (rngHi - rngLo) * 100) + "% up the range")

priorSay = na(pMove) ? "not enough history to judge the prior trend" : (pMove >= 0 ? "+" : "") + f_n1(pMove) + "% " + (rngOk ? "into the range" : "into this area") + " over " + f_n0(priorLen) + " bars" + (bias == 0 ? " — too small to call, so no schematic applies" : bias == 1 ? " — an advance, so a range here is distribution" : " — a decline, so a range here is accumulation")

// What the phase means for someone deciding what to do. Wyckoff is a map of
// where you are, not a signal, so this says what would confirm the next step
// rather than issuing an order.
meanSay = phase == "—" ? "Nothing to read. Either price is trending rather than ranging, or the move into it was too small to classify." : bias == 1 and phase == "C" ? "The upthrust is the tell. If price cannot regain " + f_px(rngHi) + ", supply has won and Phase D markdown follows." : bias == -1 and phase == "C" ? "The spring is the tell. If price holds above " + f_px(rngLo) + " and tests it successfully, Phase D markup follows." : phase == "D" and bias == 1 ? "Supply is in control. Rallies to " + f_px(rngLo) + " are last points of supply, not entries." : phase == "D" and bias == -1 ? "Demand is in control. Pullbacks to " + f_px(rngHi) + " are last points of support." : phase == "E" and bias == 1 ? "Markdown. The range is behind; " + f_px(rngLo) + " is resistance now." : phase == "E" and bias == -1 ? "Markup. The range is behind; " + f_px(rngHi) + " is support now." : phase == "A" ? "The prior trend is being stopped. Too early to position — wait for the range to form and be tested." : "Cause is being built. Nothing here is actionable until the range is tested at one edge and breaks at the other."

// Phases A and B are the cause being built - there is nothing to act on there,
// whichever schematic it turns out to be. The bias only becomes a direction
// once the test in Phase C has happened.
// ── the two methods, each reduced to one word, and whether they agree ──
// Wyckoff reads a trading range; Elliott reads the swing sequence. They are
// independent, so when both point the same way that is two methods agreeing,
// and when they split that is information too - it says the structure is in
// transition and neither read is worth acting on yet.
wySide = not rngOk or bias == 0 or not late ? 0 : bias == -1 ? 1 : -1
ewSide = not wHave ? 0 : wUp and rAll ? 1 : wDn and rAll ? -1 : wUp ? 1 : wDn ? -1 : 0
wyShort = not rngOk ? "► NO SETUP" : bias == 0 ? "► UNCLASSIFIED" : not late ? "► NEUTRAL" : bias == -1 ? "▲ BULLISH" : "▼ BEARISH"
ewShort = not wHave ? "► NOT ENOUGH SWINGS" : wUp and rAll ? "▲ BULLISH" : wDn and rAll ? "▼ BEARISH" : wUp ? "▲ leaning bullish" : wDn ? "▼ leaning bearish" : "► CORRECTIVE"
bothUp = wySide == 1 and ewSide == 1
bothDn = wySide == -1 and ewSide == -1
bothSay = wySide == 0 and ewSide == 0 ? "neither method has a read on this chart yet" : wySide == 0 or ewSide == 0 ? "only one method has a read — treat it as half a signal" : bothUp ? "BOTH AGREE — BULLISH" : bothDn ? "BOTH AGREE — BEARISH" : "THEY DISAGREE — the structure is in transition, so wait for one to give way"

actWord = not rngOk ? "► NO SETUP" : bias == 0 ? "► UNCLASSIFIED" : not late ? "► NEUTRAL — cause still building" : bias == -1 ? "▲ BULLISH" : "▼ BEARISH"
actSay = not rngOk ? "No Wyckoff setup: there is no range here. Nothing to enter against until price visits both edges " + f_n0(minTouch) + " times." : bias == 0 ? "A range, but the move into it was too flat to say whether this is accumulation or distribution. No entry either way." : not late ? "Phase " + phase + ". The cause is still being built — no entry until the range is tested at one edge and breaks at the other." : bias == -1 and phase == "C" ? "BUY ZONE " + f_px(rngLo) + " to " + f_px(buyHi) + ". Stop below " + f_px(rngLo) + ". First target " + f_px(rngHi) + ", measured move " + f_px(tgtUp) + "." : bias == -1 ? "Buy pullbacks toward " + f_px(rngHi) + ", support now. Stop below " + f_px(rngLo) + ". Measured move " + f_px(tgtUp) + "." : phase == "C" ? "SELL / EXIT ZONE " + f_px(sellLo) + " to " + f_px(rngHi) + ". Stop above " + f_px(rngHi) + ". First target " + f_px(rngLo) + ", measured move " + f_px(tgtDn) + "." : "Sell rallies toward " + f_px(rngLo) + ", resistance now. Stop above " + f_px(rngHi) + ". Measured move " + f_px(tgtDn) + "."

trigSay = not rngOk ? "No range yet, so nothing to trigger. Watch for a second visit to either edge — that is what turns this area into a range worth trading." : bias == 1 ? "A close below " + f_px(rngLo) + " on volume is the sign of weakness. A close back above " + f_px(rngHi) + " would break the distribution read." : bias == -1 ? "A close above " + f_px(rngHi) + " on volume is the sign of strength. A close below " + f_px(rngLo) + " would break the accumulation read." : "—"

// ═══════════════════════════════════════════════════════════════
// CHART
// ═══════════════════════════════════════════════════════════════
var line hiLn = na
var line loLn = na
if barstate.islast and showBox and rngOk
    line.delete(hiLn)
    line.delete(loLn)
    hiLn := line.new(bar_index - rngLen, rngHi, bar_index + 6, rngHi, color = color.new(#d50000, 25), width = 2)
    loLn := line.new(bar_index - rngLen, rngLo, bar_index + 6, rngLo, color = color.new(#00c853, 25), width = 2)

if showEv and bcNow
    label.new(bar_index, high, "BC", style = label.style_label_down, color = color.new(#d50000, 0), textcolor = color.white, size = size.tiny)
if showEv and scNow
    label.new(bar_index, low, "SC", style = label.style_label_up, color = color.new(#00c853, 0), textcolor = color.white, size = size.tiny)
if showEv and sprNow
    label.new(bar_index, low, bias == -1 ? "SPRING" : "spring", style = label.style_label_up, color = color.new(#00c853, 0), textcolor = color.white, size = size.tiny)
if showEv and utNow
    label.new(bar_index, high, na(stBar) ? "UT" : "UTAD", style = label.style_label_down, color = color.new(#d50000, 0), textcolor = color.white, size = size.tiny)
if showEv and sosNow
    label.new(bar_index, low, "SOS", style = label.style_label_up, color = color.new(#2962ff, 0), textcolor = color.white, size = size.tiny)
if showEv and sowNow
    label.new(bar_index, high, "SOW", style = label.style_label_down, color = color.new(#ff6d00, 0), textcolor = color.white, size = size.tiny)

// ═══════════════════════════════════════════════════════════════
// PANEL
// ═══════════════════════════════════════════════════════════════
pPos = panelPos == "Top Left" ? position.top_left : panelPos == "Top Right" ? position.top_right : panelPos == "Middle Left" ? position.middle_left : panelPos == "Bottom Right" ? position.bottom_right : position.bottom_left
pSz  = panelSz == "Tiny" ? size.tiny : panelSz == "Normal" ? size.normal : size.small
// ═══════════════════════════════════════════════════════════════
// 200-WEEK MOVING AVERAGE
// ═══════════════════════════════════════════════════════════════
// Requested from weekly data rather than taken as 200 bars of the chart, so
// it is the same line whether you are on a daily, weekly or monthly chart.
// On anything but a weekly chart, 200 bars would be a different average
// entirely and the reading below would mean nothing.
ma200w = request.security(syminfo.tickerid, "W", ta.sma(close, 200), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
plot(show200 ? ma200w : na, "200-week average", color = col200, linewidth = 2)
ma200Gap = na(ma200w) or ma200w <= 0 ? na : (close - ma200w) / ma200w * 100
ma200Up = not na(ma200Gap) and ma200Gap >= 0
ma200Say = na(ma200Gap) ? "not enough history — a 200-week average needs 200 weeks of data behind it" : (ma200Up ? "▲ BULLISH — price is " + f_n1(ma200Gap) + "% ABOVE the 200-week average " : "▼ BEARISH — price is " + f_n1(-ma200Gap) + "% BELOW the 200-week average ") + f_px(ma200w) + ", so the long-term trend is " + (ma200Up ? "up" : "down")

var table wp = table.new(pPos, 2, 12, border_width = 2)

f_row(table _t, int _r, string _k, string _v, color _c) =>
    table.cell(_t, 0, _r, _k, text_color = color.white, bgcolor = color.new(color.black, 0), text_halign = text.align_left, text_size = pSz)
    table.cell(_t, 1, _r, _v, text_color = color.white, bgcolor = _c, text_halign = text.align_left, text_size = pSz)

if barstate.islast
    table.clear(wp, 0, 0, 1, 11)
    f_row(wp, 0, "★ BOTH METHODS", "WYCKOFF  " + wyShort + "      ·      ELLIOTT  " + ewShort + "      ·      " + bothSay, bothUp ? color.new(#00c853, 10) : bothDn ? color.new(#d50000, 10) : wySide != 0 and ewSide != 0 ? color.new(color.orange, 15) : color.new(color.gray, 40))
    f_row(wp, 1, "WYCKOFF ▸ SCHEMATIC", schem + "   ·   " + priorSay, schemCol)
    f_row(wp, 2, "WYCKOFF ▸ PHASE", phWord, phase == "C" ? color.new(color.orange, 15) : phase == "D" or phase == "E" ? schemCol : color.new(color.gray, 45))
    f_row(wp, 3, "WYCKOFF ▸ RANGE", rngSay, color.new(#2962ff, 40))
    f_row(wp, 4, "WYCKOFF ▸ EVENTS", evSay, color.new(color.purple, 35))
    f_row(wp, 5, "WYCKOFF ▸ MEANS", meanSay, color.new(#00695c, 10))
    f_row(wp, 6, "WYCKOFF ▸ DO THIS", actWord + "   ·   " + actSay, not rngOk or bias == 0 or not late ? color.new(color.gray, 45) : bias == -1 ? color.new(#00c853, 15) : color.new(#d50000, 15))
    f_row(wp, 7, "ELLIOTT ▸ STRUCTURE", wWord + "   ·   " + wSay, not wHave ? color.new(color.gray, 45) : wUp and rAll ? color.new(#00c853, 15) : wDn and rAll ? color.new(#d50000, 15) : rBroke ? color.new(color.orange, 25) : color.new(color.gray, 40))
    f_row(wp, 8, "WYCKOFF ▸ TRIGGER", trigSay, color.new(color.black, 25))
    f_row(wp, 9, "200-WEEK AVERAGE", ma200Say, na(ma200Gap) ? color.new(color.gray, 45) : ma200Up ? color.new(#00c853, 20) : color.new(#d50000, 20))
    f_row(wp, 10, "VOLUME — BOTH", (barLive and not na(volX) ? "⧗ this bar is still forming, so volume is partial — no climax or sign of strength can fire yet. " : "") + (na(volX) ? "not reported for this symbol" : f_nx(volX) + "x the " + f_n0(volLen) + "-bar average" + (barLive ? " so far" : "") + (volX >= climX ? " — climactic" : volX >= sosVolX ? " — above average" : barLive ? "" : " — light")), color.new(color.navy, 35))
    f_row(wp, 11, "CAUTION", "A range is a range until it breaks, and Phase B can outlast your patience. Events are reported only after the bar closed. Wave structure is not a count — it changes as new swings form.", color.new(color.gray, 55))

alertcondition(sprNow, title = "Wyckoff SPRING", message = "{{ticker}} {{interval}}: spring — the range low gave way and was taken back at {{close}}")
alertcondition(utNow, title = "Wyckoff UPTHRUST / UTAD", message = "{{ticker}} {{interval}}: upthrust — the range high gave way and was taken back at {{close}}")
alertcondition(sosNow, title = "Wyckoff SIGN OF STRENGTH", message = "{{ticker}} {{interval}}: sign of strength — closed above the range on volume at {{close}}")
alertcondition(sowNow, title = "Wyckoff SIGN OF WEAKNESS", message = "{{ticker}} {{interval}}: sign of weakness — closed below the range on volume at {{close}}")
