//@version=6
// ═══════════════════════════════════════════════════════════════════════════
// WYCKOFF PHASES v1.0
//
// WHAT IT IS
//   A reader for the Wyckoff accumulation and distribution schematics. It
//   finds a trading range, works out whether that range sits after an advance
//   (distribution) or after a decline (accumulation), then names the events
//   inside it and the phase they add up to.
//
// WHAT IT WILL NOT DO
//   It does not predict the phase that comes next. A range is only a range
//   until it breaks, and Phase B can run far longer than anyone's patience.
//   Every event below is reported after its bar has closed.
//
// WHY IT IS A SEPARATE SCRIPT
//   Money Line already detects the spring and the upthrust - it calls them
//   failed breakdown and failed breakout - but it is at its token limit and
//   the phase logic needs room. Run both; this one answers "where in the
//   structure are we", that one answers "what do I do".
//
// THE EVENTS
//   accumulation   PS · SC · AR · ST · Spring · Test · SOS · LPS
//   distribution   PSY · BC · AR · ST · UT · UTAD · SOW · LPSY
//
// THE PHASES
//   A  the prior trend is stopped          climax, then the automatic reaction
//   B  the cause is built                  the range, tests of both edges
//   C  the test                            spring (accum) or UTAD (dist)
//   D  the move to the edge                SOS/LPS up, or SOW/LPSY down
//   E  the trend out of the range          markup or markdown
// ═══════════════════════════════════════════════════════════════════════════
indicator("Wyckoff Phases v4.9", overlay = true, max_labels_count = 500, max_lines_count = 500, max_bars_back = 1000)

// ── 1. The range ───
rngLen   = input.int(30, "Range lookback (bars)", minval = 8, maxval = 200, tooltip = "How far back the script measures the consolidation. Too short and every pause looks like a range; too long and a real range is diluted by the trend that preceded it.", group = "1. Range")
rngMaxW  = input.float(70.0, "Sanity cap on range width (%)", minval = 10.0, maxval = 200.0, step = 5.0, tooltip = "A backstop only. Width is a poor test of sideways: seven months of weekly bars on a liquid large-cap routinely spans 40% while going nowhere. What actually defines the range is the touch count below.", group = "1. Range")
minTouch = input.int(2, "Visits to each edge before it counts as a range", minval = 1, maxval = 6, tooltip = "This is the real test. A range is a range because price went to both boundaries more than once. A V-shaped reversal touches each extreme once and is not a range, however flat its net move looks.", group = "1. Range")
rngMinB  = input.int(10, "Minimum bars before a range counts", minval = 5, maxval = 100, group = "1. Range")
edgeTol  = input.float(1.5, "Edge tolerance (% of range width)", minval = 0.2, maxval = 10.0, step = 0.1, tooltip = "How close to a boundary a bar must come to count as a test of it.", group = "1. Range")

// ── 2. The prior trend ───
// A range after an advance is distribution. The same range after a decline is
// accumulation. Nothing else about the range tells you which, so this is the
// single most important input in the script.
priorLen = input.int(40, "Bars before the range used to judge the prior trend", minval = 10, maxval = 300, group = "2. Prior trend")
priorMin = input.float(15.0, "Prior move must be at least this big (%)", minval = 3.0, maxval = 100.0, step = 1.0, group = "2. Prior trend")

// ── 3. Events ───
volLen   = input.int(20, "Volume average length", minval = 5, maxval = 100, group = "3. Events")
climX    = input.float(1.8, "Climax: volume this many times the average", minval = 1.1, maxval = 6.0, step = 0.1, tooltip = "The buying or selling climax is the bar that ends the prior trend on extreme participation. Below about 1.5 ordinary bars start qualifying.", group = "3. Events")
wideX    = input.float(1.3, "Climax: bar range this many times ATR", minval = 0.8, maxval = 4.0, step = 0.1, group = "3. Events")
sprBack  = input.int(3, "Spring / upthrust must be retaken within this many bars", minval = 1, maxval = 10, group = "3. Events")
sosVolX  = input.float(1.2, "SOS / SOW needs volume this many times the average", minval = 0.8, maxval = 4.0, step = 0.1, group = "3. Events")
evAge    = input.int(60, "Forget an event after this many bars", minval = 10, maxval = 300, group = "3. Events")

// ── 4. Display ───
showBox  = input.bool(true, "Draw the range boundaries", group = "4. Display")
showEv   = input.bool(true, "Label events on the chart", group = "4. Display")
panelPos = input.string("Bottom Left", "Panel position", options = ["Bottom Left", "Top Left", "Top Right", "Middle Left", "Bottom Right"], group = "4. Display")
panelSz  = input.string("Small", "Panel text size", options = ["Tiny", "Small", "Normal"], group = "4. Display")
baseLen  = input.int(10, "Base: bars in the consolidation", minval = 4, maxval = 60, tooltip = "The tight box that precedes the move. Short enough that it is a pause, not a range.", group = "5. Base breakout")
baseATRx = input.float(2.0, "Base: height as a multiple of ATR", minval = 0.5, maxval = 10.0, step = 0.1, tooltip = "The real test of tight. A fixed percentage cannot work across timeframes or instruments: 8% is a wide box on a daily chart and a narrow one on a weekly megacap. Measured in ATR, the same number means the same thing everywhere. Over this many bars a random walk spans roughly the square root of the bar count in ATR, so a base should sit well under that.", group = "5. Base breakout")
baseMaxW = input.float(25.0, "Base: sanity cap on width (%)", minval = 1.0, maxval = 80.0, step = 0.5, tooltip = "A backstop only. The ATR test above is what decides.", group = "5. Base breakout")
baseBefore = input.int(15, "Base: bars before it used to judge the move into it", minval = 5, maxval = 100, group = "5. Base breakout")
baseMinM = input.float(8.0, "Base: the move into it must be at least this big (%)", minval = 2.0, maxval = 60.0, step = 1.0, group = "5. Base breakout")
baseRR   = input.float(2.0, "Base: target as a multiple of base height", minval = 0.5, maxval = 6.0, step = 0.5, group = "5. Base breakout")
showBase = input.bool(true, "Draw the base box", group = "5. Base breakout")
show200  = input.bool(true, "Draw the 200-week moving average", group = "5. 200-week average")
ma200Band = input.float(2.0, "200-week: within this % counts as sitting on it", minval = 0.1, maxval = 15.0, step = 0.1, tooltip = "Price a fraction of a percent under a long-term average is not a downtrend, it is price sitting on the average. Inside this band the row declines to call a direction.", group = "5. 200-week average")
stSlope  = input.int(20, "Stage: days used to judge the 200-day slope", minval = 5, maxval = 120, tooltip = "The 200-day average is almost never exactly flat, so direction is judged against where it sat this many days ago rather than against the previous bar.", group = "6. Stage 2 / Stage 4")
stFlat   = input.float(0.5, "Stage: slope under this % over the window counts as flat", minval = 0.0, maxval = 10.0, step = 0.1, tooltip = "Without a flat band any hundredth of a point counts as a rising average, and a topping or basing chart is read as a trending one.", group = "6. Stage 2 / Stage 4")
stNear   = input.float(2.0, "Stage: a dip counts within this % of the 50-day", minval = 0.2, maxval = 15.0, step = 0.1, group = "6. Stage 2 / Stage 4")
stLight  = input.float(1.0, "Stage: light volume is under this multiple of average", minval = 0.3, maxval = 2.0, step = 0.05, group = "6. Stage 2 / Stage 4")
stReclN  = input.int(13, "Stage: bars since price was under the 200-day that still counts as a reclaim", minval = 2, maxval = 60, tooltip = "Price above a falling average means two opposite things. After a long advance it is a top. Days after price climbed back over it, it is a recovery attempt. This is where one ends and the other begins.", group = "6. Stage 2 / Stage 4")
dbTol    = input.float(3.0, "Double bottom: how level the two lows must be (%)", minval = 0.5, maxval = 15.0, step = 0.5, group = "10. Double bottom")
dbBrkV   = input.float(1.4, "Double bottom: volume multiple that confirms the break", minval = 1.0, maxval = 4.0, step = 0.05, group = "10. Double bottom")
rsSym    = input.symbol("AMEX:SPY", "Relative strength benchmark", group = "9. Relative strength")
rsLen    = input.int(26, "Relative strength lookback (bars)", minval = 4, maxval = 200, tooltip = "Weinstein's RS line is the stock divided by the index. What matters is its direction, not its level: a stock can be down and still leading if the market is down more.", group = "9. Relative strength")
show30   = input.bool(true, "Draw the 30-week average (Weinstein's own line)", group = "9. Relative strength")
acLen    = input.int(25, "Accumulation: bars to weigh up-volume against down-volume", minval = 5, maxval = 120, group = "8. Accumulation / distribution")
acEdge   = input.float(1.2, "Accumulation: ratio that counts as one side being in control", minval = 1.0, maxval = 3.0, step = 0.05, tooltip = "Up-volume divided by down-volume. Above this is accumulation, below its reciprocal is distribution, and between the two neither side has committed.", group = "8. Accumulation / distribution")
ddDrop   = input.float(0.2, "Distribution bar: close down at least this much (%)", minval = 0.0, maxval = 5.0, step = 0.1, group = "8. Accumulation / distribution")
ddCaut   = input.int(4, "Distribution bars in the window that mean caution", minval = 2, maxval = 15, tooltip = "Four or five heavy down bars inside twenty-five sessions is the classic warning that institutions are selling into strength.", group = "8. Accumulation / distribution")
s2Vol    = input.float(1.4, "Stage 2: breakout volume as a multiple of average", minval = 1.0, maxval = 4.0, step = 0.05, tooltip = "40% above average is the usual bar. Volume is what separates a breakout institutions are buying from one that drifts back into the base.", group = "7. Shakeout and gap rules")
sbWin    = input.int(4, "Shakeout: bars to reclaim the 200-day before it is a breakdown", minval = 1, maxval = 20, tooltip = "An undercut that is taken back quickly is a shakeout. The same undercut left unreclaimed is a breakdown. This is where one becomes the other.", group = "7. Shakeout and gap rules")
sbFadeX  = input.float(1.0, "Shakeout: selling counts as fading under this volume multiple", minval = 0.3, maxval = 2.0, step = 0.05, group = "7. Shakeout and gap rules")
gapPct   = input.float(8.0, "Drop of this size starts the wait (%)", minval = 2.0, maxval = 40.0, step = 0.5, group = "7. Shakeout and gap rules")
waitBars = input.int(3, "Bars to wait after that drop before considering a buy", minval = 1, maxval = 15, tooltip = "The 3-day rule. Institutions cannot sell millions of shares in one session, so the first bounce is usually short covering rather than demand. On a weekly chart these are weeks, not days.", group = "7. Shakeout and gap rules")
vixOn    = input.bool(true, "Show the fear gauge", group = "7. Shakeout and gap rules")
vixSym   = input.symbol("CBOE:VIX", "Fear gauge symbol", group = "7. Shakeout and gap rules")
vixCalm  = input.float(20.0, "Below this is calm", minval = 5.0, maxval = 40.0, step = 0.5, group = "7. Shakeout and gap rules")
vixFear  = input.float(26.0, "Above this is fear", minval = 10.0, maxval = 80.0, step = 0.5, group = "7. Shakeout and gap rules")
showStg  = input.bool(true, "Draw the 50-day and 200-day averages", group = "6. Stage 2 / Stage 4")
col200   = input.color(#ff6d00, "Line colour", group = "5. 200-week average")

// ═══════════════════════════════════════════════════════════════
// MEASUREMENTS — every ta.* call runs unconditionally, on every bar
// ═══════════════════════════════════════════════════════════════
atrV   = ta.atr(14)
volAvg = ta.sma(volume, volLen)
volX   = volAvg > 0 ? volume / volAvg : na
// A forming bar carries partial volume, so every climax and SOS/SOW test reads
// light. BE showed 0.2x, AMZN 0.1x, CRM 0x - all of them mid-week.
barLive = time_close > timenow

// Formatting helpers, kept above every row that uses them.
f_px(float _v) => str.tostring(_v, format.mintick)
f_n0(float _v) => str.tostring(_v, "#")
f_n1(float _v) => str.tostring(_v, "#.#")
f_vis(int _n) => str.tostring(_n) + (_n == 1 ? " visit" : " visits")
// "#.#" drops the decimal below 0.05 and prints a bare "0", so the volume
// multiple gets a format that always keeps one.
f_nx(float _v) => str.tostring(_v, "0.0")
f_n2(float _v) => str.tostring(_v, "0.00")
barRng = high - low
wideBar = not na(atrV) and atrV > 0 and barRng >= atrV * wideX

// The range is measured to the PREVIOUS bar, so the bar being judged is never
// part of the boundary it is being tested against. Without the offset a spring
// can never happen: the low that breaks the range also redefines it.
rngHi = ta.highest(high, rngLen)[1]
rngLo = ta.lowest(low, rngLen)[1]
rngW  = not na(rngHi) and not na(rngLo) and rngLo > 0 ? (rngHi - rngLo) / rngLo * 100 : na
tol   = na(rngHi) or na(rngLo) ? na : (rngHi - rngLo) * edgeTol / 100

// Distinct visits to a boundary: the count rises when price arrives, not for
// every bar it loiters there.
f_visits(float _lvl, float _tol, int _n, bool _up) =>
    _c = 0
    _prev = false
    for _i = _n to 1
        _now = _up ? high[_i] >= _lvl - _tol : low[_i] <= _lvl + _tol
        if _now and not _prev
            _c += 1
        _prev := _now
    _c

hiVisits = na(rngHi) or na(tol) ? 0 : f_visits(rngHi, tol, rngLen, true)
loVisits = na(rngLo) or na(tol) ? 0 : f_visits(rngLo, tol, rngLen, false)
touchOk = hiVisits >= minTouch and loVisits >= minTouch
rngOk = not na(rngW) and rngW <= rngMaxW and bar_index >= rngMinB + rngLen and touchOk

// Prior trend, measured from before the range so the range itself cannot
// colour the verdict.
pStart = close[rngLen + priorLen]
pEnd   = close[rngLen]
pMove  = not na(pStart) and not na(pEnd) and pStart > 0 ? (pEnd - pStart) / pStart * 100 : na
priorUp = not na(pMove) and pMove >= priorMin
priorDn = not na(pMove) and pMove <= -priorMin

// bias: +1 distribution (range after an advance), -1 accumulation, 0 unknown
bias = priorUp ? 1 : priorDn ? -1 : 0

// ═══════════════════════════════════════════════════════════════
// EVENTS
// ═══════════════════════════════════════════════════════════════
hiTest = not na(rngHi) and not na(tol) and high >= rngHi - tol
loTest = not na(rngLo) and not na(tol) and low <= rngLo + tol

// CLIMAX — the bar that ends the prior trend on extreme participation.
climVol = not na(volX) and volX >= climX
bcNow = rngOk and bias == 1 and climVol and wideBar and hiTest
scNow = rngOk and bias == -1 and climVol and wideBar and loTest

// SPRING / UPTHRUST — the boundary gives way intrabar and is taken back.
// This is the single most useful event in the schematic and the one Money
// Line already finds under the name "failed breakdown" / "failed breakout".
sprNow = rngOk and low < rngLo and close > rngLo
utNow  = rngOk and high > rngHi and close < rngHi

// SOS / SOW — a decisive close outside the range, on volume.
sosNow = rngOk and close > rngHi and not na(volX) and volX >= sosVolX
sowNow = rngOk and close < rngLo and not na(volX) and volX >= sosVolX

// ── event memory ───
var int bcBar = na
var float bcPx = na
var int scBar = na
var float scPx = na
var int arBar = na
var float arPx = na
var int stBar = na
var int sprBar = na
var int utBar = na
var int utadBar = na
var int sosBar = na
var int sowBar = na
var int lpsBar = na
var int lpsyBar = na
var float lastSwHi = na
var float lastSwLo = na

if bcNow
    bcBar := bar_index
    bcPx  := high
if scNow
    scBar := bar_index
    scPx  := low
// AUTOMATIC REACTION — the sharp move away from the climax that sets the
// opposite boundary. It is only an AR if a climax came first.
if not na(bcBar) and bar_index > bcBar and bar_index - bcBar <= 10 and na(arBar) and loTest
    arBar := bar_index
    arPx  := low
if not na(scBar) and bar_index > scBar and bar_index - scBar <= 10 and na(arBar) and hiTest
    arBar := bar_index
    arPx  := high
// SECONDARY TEST — a return to the climax end of the range that fails on
// lighter volume than the climax itself.
if not na(arBar) and bar_index > arBar and na(stBar) and not na(volX) and volX < climX
    if bias == 1 and hiTest
        stBar := bar_index
    if bias == -1 and loTest
        stBar := bar_index
if sprNow
    sprBar := bar_index
if utNow
    utBar := bar_index
    // An upthrust AFTER the range has been tested from both sides is UTAD -
    // the last one, the one that matters.
    if not na(stBar)
        utadBar := bar_index
if sosNow
    sosBar := bar_index
if sowNow
    sowBar := bar_index

// ── swings, for LPS and LPSY ───
swHi = ta.pivothigh(high, 3, 3)
swLo = ta.pivotlow(low, 3, 3)
if not na(swHi)
    // LPSY: a LOWER high after a sign of weakness. The last place supply shows
    // up before the markdown.
    if not na(sowBar) and bar_index - 3 > sowBar and not na(lastSwHi) and swHi < lastSwHi
        lpsyBar := bar_index - 3
    lastSwHi := swHi
if not na(swLo)
    // LPS: a HIGHER low after a sign of strength.
    if not na(sosBar) and bar_index - 3 > sosBar and not na(lastSwLo) and swLo > lastSwLo
        lpsBar := bar_index - 3
    lastSwLo := swLo

// ═══════════════════════════════════════════════════════════════
// WAVE STRUCTURE — the Elliott rules, without the counting
// ═══════════════════════════════════════════════════════════════
// A labelled count repaints by nature: a swing called wave 3 becomes wave 1 of
// a larger degree once price extends, so the count rewrites its own history.
// These two readings do not. The first is the swing sequence, which is a fact
// about six specific pivots. The second tests whether those pivots COULD be a
// valid impulse - a violation rules a count out, which is hard information,
// where a label would only be one of several readings the data allows.
// Volume at each pivot, carried alongside the price. A double bottom is
// graded on whether the second low came on lighter selling than the first,
// and that cannot be read from the prices alone.
var float w1v = na
var float w2v = na
var float w3v = na
var float w4v = na
var float w1 = na
var float w2 = na
var float w3 = na
var float w4 = na
var float w5 = na
var float w6 = na
var int w1t = 0
var int w2t = 0
var int w3t = 0
var int w4t = 0
var int w5t = 0
var int w6t = 0

// A new pivot of the same type as the last one extends it rather than being
// recorded separately, so the store always alternates high, low, high, low.
if not na(swHi)
    if w1t == 1
        if swHi > w1
            w1 := swHi
    else
        w6 := w5
        w6t := w5t
        w5 := w4
        w5t := w4t
        w4v := w3v
        w4 := w3
        w4t := w3t
        w3v := w2v
        w3 := w2
        w3t := w2t
        w2v := w1v
        w2 := w1
        w2t := w1t
        w1 := swHi
        w1v := volume[3]
        w1t := 1
if not na(swLo)
    if w1t == -1
        if swLo < w1
            w1 := swLo
    else
        w6 := w5
        w6t := w5t
        w5 := w4
        w5t := w4t
        w4v := w3v
        w4 := w3
        w4t := w3t
        w3v := w2v
        w3 := w2
        w3t := w2t
        w2v := w1v
        w2 := w1
        w2t := w1t
        w1 := swLo
        w1v := volume[3]
        w1t := -1

wHave = not na(w1) and not na(w2) and not na(w3) and not na(w4)
wFull = wHave and not na(w5) and not na(w6)
// the two most recent highs and the two most recent lows, whichever way the
// store happens to be oriented
hA = w1t == 1 ? w1 : w2
hB = w1t == 1 ? w3 : w4
lA = w1t == 1 ? w2 : w1
lB = w1t == 1 ? w4 : w3
wUp = wHave and hA > hB and lA > lB
wDn = wHave and hA < hB and lA < lB

// THE THREE IMPULSE RULES, read over w6 to w1 as waves 1 to 5.
upImp = wFull and w6t == -1 and w1t == 1
dnImp = wFull and w6t == 1 and w1t == -1
len1 = wFull ? math.abs(w5 - w6) : na
len3 = wFull ? math.abs(w3 - w4) : na
len5 = wFull ? math.abs(w1 - w2) : na
// rule 2: wave 2 never retraces past the start of wave 1
r2 = upImp ? w4 > w6 : dnImp ? w4 < w6 : false
// rule 3: wave 3 is never the shortest of the three impulse legs
r3 = (upImp or dnImp) and not na(len3) and not (len3 < len1 and len3 < len5)
// rule 4: wave 4 never enters the price territory of wave 1
r4 = upImp ? w2 > w5 : dnImp ? w2 < w5 : false
rAll = r2 and r3 and r4
rBroke = (upImp or dnImp) and not rAll

wWord = not wHave ? "► NOT ENOUGH SWINGS" : wUp and rAll ? "▲ BULLISH" : wDn and rAll ? "▼ BEARISH" : wUp ? "▲ bullish, but not a clean impulse" : wDn ? "▼ bearish, but not a clean impulse" : "► CORRECTIVE"
wSay = not wHave ? "Fewer than four confirmed swings so far." : (wUp ? "higher highs and higher lows" : wDn ? "lower highs and lower lows" : "swings overlap — a correction, not an impulse") + (not (wUp or wDn) ? "" : not (upImp or dnImp) ? "   ·   not impulse-shaped, so the rules do not apply" : rAll ? "   ·   all three impulse rules satisfied" : "   ·   wave 2 " + (r2 ? "✓" : "✗") + "  wave 3 " + (r3 ? "✓" : "✗") + "  wave 4 " + (r4 ? "✓" : "✗") + " — NOT a valid impulse") + "   ·   last 4 swings — the current leg, not the whole chart"

f_age(int _b) => na(_b) ? na : bar_index - _b
f_live(int _b) => not na(_b) and bar_index - _b <= evAge

// ═══════════════════════════════════════════════════════════════
// PHASE
// ═══════════════════════════════════════════════════════════════
// Read strictly in order: the latest event that has fired decides the phase,
// because the schematic only ever runs forwards.
inRange = rngOk and close <= rngHi and close >= rngLo
brokeUp = rngOk and close > rngHi
brokeDn = rngOk and close < rngLo

phase = not rngOk ? "—" : bias == 0 ? "—" : f_live(lpsyBar) or (f_live(sowBar) and brokeDn and not na(stBar)) ? "E" : f_live(lpsBar) or (f_live(sosBar) and brokeUp and not na(stBar)) ? "E" : f_live(sowBar) or f_live(sosBar) ? "D" : f_live(utadBar) or f_live(sprBar) ? "C" : not na(stBar) ? "B" : not na(arBar) ? "A" : not na(bcBar) or not na(scBar) ? "A" : "B"

phWord = phase == "—" ? (not rngOk ? "no phase — phases exist only inside a range, and there is none here yet; RANGE below says what is missing" : "a range, but the move into it was too small to classify")  : phase == "A" ? "A — the prior trend is being stopped" : phase == "B" ? "B — building the cause inside the range" : phase == "C" ? "C — the test" : phase == "D" ? "D — moving to the edge of the range" : "E — the trend out of the range"

// Zones and targets. The measured move is the range height projected from the
// edge it breaks - the standard Wyckoff objective, and the reason the cause
// built in Phase B sets the size of the effect in Phase E.
rngH   = na(rngHi) or na(rngLo) ? na : rngHi - rngLo
buyHi  = na(rngH) ? na : rngLo + rngH * 0.25
sellLo = na(rngH) ? na : rngHi - rngH * 0.25
tgtUp  = na(rngH) ? na : rngHi + rngH
tgtDn  = na(rngH) ? na : rngLo - rngH
late   = phase == "C" or phase == "D" or phase == "E"

// Without a range there is nothing to classify yet, so the schematic answers
// the conditional question - if a range forms here, which kind would it be -
// rather than reporting accumulation as a finding two rows above RANGE saying
// there is no range.
schem = (bias == 1 ? "DISTRIBUTION" : bias == -1 ? "ACCUMULATION" : "UNCLASSIFIED") + (rngOk or bias == 0 ? "" : " — ONLY IF A RANGE FORMS")
// The bias is the whole interpretation. A spring in accumulation is the buy;
// the identical bar in distribution is a failed break inside a topping range.
schemCol = not rngOk ? color.new(color.gray, 45) : bias == 1 ? color.new(#d50000, 20) : bias == -1 ? color.new(#00c853, 20) : color.new(color.gray, 45)

// ═══════════════════════════════════════════════════════════════
// READ-OUT
// ═══════════════════════════════════════════════════════════════
f_ev(string _n, int _b) => f_live(_b) ? _n + " " + f_n0(f_age(_b)) + "b · " : ""

evList = (f_ev(bias == 1 ? "BC" : "SC", bias == 1 ? bcBar : scBar)) + f_ev("AR", arBar) + f_ev("ST", stBar) + f_ev(bias == 1 ? "UT" : "spring", bias == 1 ? utBar : sprBar) + f_ev("UTAD", utadBar) + f_ev(bias == 1 ? "SOW" : "SOS", bias == 1 ? sowBar : sosBar) + f_ev(bias == 1 ? "LPSY" : "LPS", bias == 1 ? lpsyBar : lpsBar)
evSay = bias == 0 ? "no schematic to name events against" : evList == "" ? "none yet in the last " + f_n0(evAge) + " bars" : str.substring(evList, 0, math.max(0, str.length(evList) - 3))

rngSay = not rngOk ? (na(rngW) ? "not enough history" : "no range — " + f_n1(rngW) + "% wide, " + f_vis(hiVisits) + " to the high and " + f_vis(loVisits) + " to the low over " + f_n0(rngLen) + " bars, where " + f_n0(minTouch) + " of each are needed" + (rngW > rngMaxW ? ", and past the width cap" : "")) : f_px(rngLo) + " to " + f_px(rngHi) + "   ·   " + f_n1(rngW) + "% wide   ·   price " + (brokeUp ? "ABOVE it" : brokeDn ? "BELOW it" : "inside, " + f_n1((close - rngLo) / (rngHi - rngLo) * 100) + "% up the range")

priorSay = na(pMove) ? "not enough history to judge the prior trend" : (pMove >= 0 ? "+" : "") + f_n1(pMove) + "% " + (rngOk ? "into the range" : "into this area") + " over " + f_n0(priorLen) + " bars" + (bias == 0 ? " — too small to call, so no schematic applies" : bias == 1 ? " — an advance, so a range here is distribution" : " — a decline, so a range here is accumulation")

// What the phase means for someone deciding what to do. Wyckoff is a map of
// where you are, not a signal, so this says what would confirm the next step
// rather than issuing an order.
// It said "either price is trending, or the move was too small to classify"
// while holding the number that decides which - on a chart up 65% into the
// area, the prior-trend test has already answered it.
meanSay = phase == "—" ? (bias == 0 ? "Nothing to read — the move into this area was too small to class it as accumulation or distribution." : "Price is trending, not ranging. There is no cause being built here, so there is nothing for this method to trade.") : bias == 1 and phase == "C" ? "The upthrust is the tell. If price cannot regain " + f_px(rngHi) + ", supply has won and Phase D markdown follows." : bias == -1 and phase == "C" ? "The spring is the tell. If price holds above " + f_px(rngLo) + " and tests it successfully, Phase D markup follows." : phase == "D" and bias == 1 ? "Supply is in control. Rallies to " + f_px(rngLo) + " are last points of supply, not entries." : phase == "D" and bias == -1 ? "Demand is in control. Pullbacks to " + f_px(rngHi) + " are last points of support." : phase == "E" and bias == 1 ? "Markdown. The range is behind; " + f_px(rngLo) + " is resistance now." : phase == "E" and bias == -1 ? "Markup. The range is behind; " + f_px(rngHi) + " is support now." : phase == "A" ? "The prior trend is being stopped. Too early to position — wait for the range to form and be tested." : "Cause is being built. Nothing here is actionable until the range is tested at one edge and breaks at the other."

// Phases A and B are the cause being built - there is nothing to act on there,
// whichever schematic it turns out to be. The bias only becomes a direction
// once the test in Phase C has happened.
// ═══════════════════════════════════════════════════════════════
// BASE BREAKOUT — continuation and reversal, with both entries
// ═══════════════════════════════════════════════════════════════
// A tight box after a move, then a break out of it. The box after an advance
// is a continuation; the box after a decline is a potential reversal, and the
// difference matters because only the first has the trend behind it. Two
// entries, as the setup is usually drawn: the risk entry sits inside the base
// before anything is proven, and the confirmation entry waits for the close
// through the edge. Measured against closed bars, so the forming bar cannot
// widen the box it is supposed to break.
bHi = ta.highest(high, baseLen)[1]
bLo = ta.lowest(low, baseLen)[1]
bW = na(bHi) or na(bLo) or bLo <= 0 ? na : (bHi - bLo) / bLo * 100
bH = na(bHi) or na(bLo) ? na : bHi - bLo
bATR = ta.atr(14)
// Tight has to be measured against the instrument's own volatility. A fixed
// percentage silently made this row dead on weekly charts, where ten bars of
// an ordinary megacap consolidation span far more than eight percent.
bAx = na(bH) or na(bATR) or bATR <= 0 ? na : bH / bATR
bOk = not na(bAx) and bAx <= baseATRx and not na(bW) and bW <= baseMaxW and bar_index >= baseLen + baseBefore
bPs = close[baseLen + baseBefore]
bPm = na(bPs) or bPs <= 0 ? na : (close[baseLen] - bPs) / bPs * 100
bUpIn = not na(bPm) and bPm >= baseMinM
bDnIn = not na(bPm) and bPm <= -baseMinM
bBrkUp = bOk and close > bHi
bBrkDn = bOk and close < bLo
bRiskHi = na(bH) ? na : bLo + bH * 0.5
bTgtUp = na(bH) ? na : bHi + bH * baseRR
bTgtDn = na(bH) ? na : bLo - bH * baseRR
// unproven until it breaks: a box after a decline is only a reversal if it
// actually turns, and until then it is as likely to go on falling
bsShort = not bOk ? "► none" : bBrkUp ? "▲ broken up" : bBrkDn ? "▼ broken down" : bUpIn ? "▲ continuation" : bDnIn ? "► reversal, unproven" : "► unclassified"
bsSide = not bOk ? 0 : bBrkUp ? 1 : bBrkDn ? -1 : bUpIn ? 1 : 0
bsWord = not bOk ? "► NO BASE" : bBrkUp ? "▲ BULLISH — the base has broken up" : bBrkDn ? "▼ BEARISH — the base has broken down" : bUpIn ? "▲ CONTINUATION BASE" : bDnIn ? "► REVERSAL BASE — unproven" : "► BASE — no move into it to classify"
bsSay = not bOk ? "No tight box in the last " + f_n0(baseLen) + " bars" + (na(bAx) ? "" : " — " + f_n2(bAx) + "x ATR against a " + f_n2(baseATRx) + "x cap, " + f_n1(bW) + "% wide") : bBrkUp ? "Confirmation entry is live. Stop below " + f_px(bLo) + "   ·   target " + f_px(bTgtUp) : bBrkDn ? "Short confirmation is live. Stop above " + f_px(bHi) + "   ·   target " + f_px(bTgtDn) : "RISK ENTRY " + f_px(bLo) + "–" + f_px(bRiskHi) + " inside the base   ·   CONFIRMATION on a close above " + f_px(bHi) + "   ·   stop " + f_px(bLo) + "   ·   target " + f_px(bTgtUp)

// ── the three methods, each reduced to one word, and whether they agree ──
// Wyckoff reads a trading range; Elliott reads the swing sequence. They are
// independent, so when both point the same way that is two methods agreeing,
// and when they split that is information too - it says the structure is in
// transition and neither read is worth acting on yet.
wySide = not rngOk or bias == 0 or not late ? 0 : bias == -1 ? 1 : -1
ewSide = not wHave ? 0 : wUp and rAll ? 1 : wDn and rAll ? -1 : wUp ? 1 : wDn ? -1 : 0
wyShort = not rngOk ? "► NO SETUP" : bias == 0 ? "► UNCLASSIFIED" : not late ? "► NEUTRAL" : bias == -1 ? "▲ BULLISH" : "▼ BEARISH"
ewShort = not wHave ? "► NOT ENOUGH SWINGS" : wUp and rAll ? "▲ BULLISH" : wDn and rAll ? "▼ BEARISH" : wUp ? "▲ leaning bullish" : wDn ? "▼ leaning bearish" : "► CORRECTIVE"

actWord = not rngOk ? "► NO SETUP" : bias == 0 ? "► UNCLASSIFIED" : not late ? "► NEUTRAL — cause still building" : bias == -1 ? "▲ BULLISH" : "▼ BEARISH"
actSay = not rngOk ? "No Wyckoff setup: there is no range here. " + (bOk ? "The BASE row below has one — read that instead." : wUp or wDn ? "ELLIOTT holds the only directional read on this chart." : "Nothing on the base or wave rows either, so this chart has no setup at all.") : bias == 0 ? "A range, but the move into it was too flat to say whether this is accumulation or distribution. No entry either way." : not late ? "Phase " + phase + ". The cause is still being built — no entry until the range is tested at one edge and breaks at the other." : bias == -1 and phase == "C" ? "BUY ZONE " + f_px(rngLo) + " to " + f_px(buyHi) + ". Stop below " + f_px(rngLo) + ". First target " + f_px(rngHi) + ", measured move " + f_px(tgtUp) + "." : bias == -1 ? "Buy pullbacks toward " + f_px(rngHi) + ", support now. Stop below " + f_px(rngLo) + ". Measured move " + f_px(tgtUp) + "." : phase == "C" ? "SELL / EXIT ZONE " + f_px(sellLo) + " to " + f_px(rngHi) + ". Stop above " + f_px(rngHi) + ". First target " + f_px(rngLo) + ", measured move " + f_px(tgtDn) + "." : "Sell rallies toward " + f_px(rngLo) + ", resistance now. Stop above " + f_px(rngHi) + ". Measured move " + f_px(tgtDn) + "."

trigSay = not rngOk ? "No range yet, so nothing to trigger. Watch for a second visit to either edge — that is what turns this area into a range worth trading." : bias == 1 ? "A close below " + f_px(rngLo) + " on volume is the sign of weakness. A close back above " + f_px(rngHi) + " would break the distribution read." : bias == -1 ? "A close above " + f_px(rngHi) + " on volume is the sign of strength. A close below " + f_px(rngLo) + " would break the accumulation read." : "—"

// ═══════════════════════════════════════════════════════════════
// CHART
// ═══════════════════════════════════════════════════════════════
var line hiLn = na
var line loLn = na
if barstate.islast and showBox and rngOk
    line.delete(hiLn)
    line.delete(loLn)
    hiLn := line.new(bar_index - rngLen, rngHi, bar_index + 6, rngHi, color = color.new(#d50000, 25), width = 2)
    loLn := line.new(bar_index - rngLen, rngLo, bar_index + 6, rngLo, color = color.new(#00c853, 25), width = 2)

var box bsBx = na
if barstate.islast and showBase and bOk
    box.delete(bsBx)
    bsBx := box.new(bar_index - baseLen, bHi, bar_index + 4, bLo, border_color = color.new(#2962ff, 10), bgcolor = color.new(#2962ff, 80), border_width = 2)

if showEv and bcNow
    label.new(bar_index, high, "BC", style = label.style_label_down, color = color.new(#d50000, 0), textcolor = color.white, size = size.tiny)
if showEv and scNow
    label.new(bar_index, low, "SC", style = label.style_label_up, color = color.new(#00c853, 0), textcolor = color.white, size = size.tiny)
if showEv and sprNow
    label.new(bar_index, low, bias == -1 ? "SPRING" : "spring", style = label.style_label_up, color = color.new(#00c853, 0), textcolor = color.white, size = size.tiny)
if showEv and utNow
    label.new(bar_index, high, na(stBar) ? "UT" : "UTAD", style = label.style_label_down, color = color.new(#d50000, 0), textcolor = color.white, size = size.tiny)
if showEv and sosNow
    label.new(bar_index, low, "SOS", style = label.style_label_up, color = color.new(#2962ff, 0), textcolor = color.white, size = size.tiny)
if showEv and sowNow
    label.new(bar_index, high, "SOW", style = label.style_label_down, color = color.new(#ff6d00, 0), textcolor = color.white, size = size.tiny)

// ═══════════════════════════════════════════════════════════════
// PANEL
// ═══════════════════════════════════════════════════════════════
pPos = panelPos == "Top Left" ? position.top_left : panelPos == "Top Right" ? position.top_right : panelPos == "Middle Left" ? position.middle_left : panelPos == "Bottom Right" ? position.bottom_right : position.bottom_left
pSz  = panelSz == "Tiny" ? size.tiny : panelSz == "Normal" ? size.normal : size.small
// ═══════════════════════════════════════════════════════════════
// 200-WEEK MOVING AVERAGE
// ═══════════════════════════════════════════════════════════════
// Requested from weekly data rather than taken as 200 bars of the chart, so
// it is the same line whether you are on a daily, weekly or monthly chart.
// On anything but a weekly chart, 200 bars would be a different average
// entirely and the reading below would mean nothing.
ma200w = request.security(syminfo.tickerid, "W", ta.sma(close, 200), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
plot(show200 ? ma200w : na, "200-week average", color = col200, linewidth = 2)
ma200Gap = na(ma200w) or ma200w <= 0 ? na : (close - ma200w) / ma200w * 100
ma200Up = not na(ma200Gap) and ma200Gap >= 0
ma200At = not na(ma200Gap) and math.abs(ma200Gap) <= ma200Band
// ═══════════════════════════════════════════════════════════════
// STAGE 2 / STAGE 4 — is a dip a gift or a trap
// ═══════════════════════════════════════════════════════════════
// Requested from daily data so these are genuinely 200-day and 50-day
// averages whatever the chart is set to. Taken as bars of a weekly chart the
// 200 would be four years of history and the whole stage model would be
// measuring the wrong thing.
[d200, d200p, d50, d200pp] = request.security(syminfo.tickerid, "D", [ta.sma(close, 200), ta.sma(close, 200)[stSlope], ta.sma(close, 50), ta.sma(close, 200)[stSlope * 3]], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
plot(showStg ? d200 : na, "200-day average", color = color.new(#8e24aa, 0), linewidth = 2)
plot(showStg ? d50 : na, "50-day average", color = color.new(#1e88e5, 0), linewidth = 1)
stHave = not na(d200) and not na(d200p) and d200p > 0
stSlp = stHave ? (d200 - d200p) / d200p * 100 : na
stUpMA = stHave and stSlp > stFlat
stDnMA = stHave and stSlp < -stFlat
stFlatMA = stHave and not stUpMA and not stDnMA
// Where the average was heading before this flat patch, not where price is now.
stWas = not na(d200p) and not na(d200pp) and d200pp > 0 ? (d200p - d200pp) / d200pp * 100 : na
stWasUp = not na(stWas) and stWas > stFlat
stAbove = not na(d200) and close > d200
// The direction of the average decides whether the dip is a gift or a trap,
// and the swing structure has to agree with it. Price above a rising average
// that is making lower highs is not Stage 2; it is a stage in transition.
stg2 = stAbove and stUpMA and wUp
stg4 = not stAbove and stDnMA and wDn
stg3 = stAbove and not stUpMA and stWasUp
stg1 = stFlatMA and not stWasUp
// Below a still-RISING average is not a base. It is the deepest dip an
// uptrend produces, and lumping it in with Stage 1 told a reader to wait for
// an advance that is already years old. It is also not Stage 4, because the
// average has not turned - so it gets named for what it is.
stPull = not stAbove and stUpMA
// Price above a FALLING average is the one genuinely ambiguous spot in the
// model, and it was all being called Stage 3. A top is price that has held
// above the average for months while it rolls over. A stock that crashed and
// has just climbed back over a still-falling average is the opposite - the
// earliest part of a turn - and telling its reader NO NEW BUYS had the model
// backwards. The two are separated by how recently price was underneath.
stUnder = ta.barssince(not na(d200) and close < d200)
stRecl = stAbove and not stUpMA and not na(stUnder) and stUnder <= stReclN
// ═══════════════════════════════════════════════════════════════
// SHAKEOUT OR BREAKDOWN, AND WHAT TO DO AFTER A GAP DOWN
// ═══════════════════════════════════════════════════════════════
// Both readings turn on the same event — price losing the 200-day — and are
// told apart by what happens next, not by the loss itself. An undercut taken
// back inside a few bars on fading volume is a shakeout. The same undercut
// left unreclaimed, with lower highs and heavy selling, is a breakdown.
stOver = ta.barssince(not na(d200) and close > d200)
sbFade = not na(volX) and volX < sbFadeX
sbHeavy = not na(volX) and volX >= 1.3
sbShake = stHave and stAbove and stUnder >= 1 and stUnder <= sbWin and not wDn
sbBreak = stHave and not stAbove and not na(stOver) and stOver > sbWin and wDn
sbWord = not stHave ? "► NO 200-DAY YET" : sbShake ? "▲ SHAKEOUT — undercut and reclaimed" : sbBreak ? "▼ BREAKDOWN — the 200-day is resistance now" : stAbove ? "► ABOVE THE LINE — nothing to judge yet" : "► BELOW THE LINE — too early to call"
sbSay = not stHave ? "needs 200 days of history" : sbShake ? "back above " + f_px(d200) + " after " + f_n0(stUnder) + " bars under it" + (sbFade ? ", and the selling has dried up" : sbHeavy ? ", but volume is still heavy — not confirmed" : "") : sbBreak ? f_n0(stOver) + " bars below " + f_px(d200) + " with lower highs and lower lows" + (sbHeavy ? ", on heavy volume" : "") : stAbove ? "price is above " + f_px(d200) + " and has not been under it recently" : "under " + f_px(d200) + " for " + f_n0(stOver) + " bars — " + f_n0(sbWin) + " is the line between a shakeout and a breakdown"

// ── DOUBLE BOTTOM, GRADED ──
// The pattern is two lows at the same level with a high between them, which
// the swing store already holds. What it is graded on is volume: the second
// low should come on LIGHTER selling than the first, because that is weaker
// sellers rather than a coincidence of price, and the break of the neckline
// should come on heavier volume than usual, because that is who is buying it.
dbLo2 = w1t == -1 ? w1 : w2
dbNk = w1t == -1 ? w2 : w1
dbLo1 = w1t == -1 ? w3 : w4
dbV2 = w1t == -1 ? w1v : w2v
dbV1 = w1t == -1 ? w3v : w4v
dbHave = not na(dbLo1) and not na(dbLo2) and not na(dbNk) and dbLo1 > 0 and dbNk > dbLo1 and dbNk > dbLo2
dbLevel = dbHave and math.abs(dbLo2 - dbLo1) / dbLo1 * 100 <= dbTol
dbDry = not na(dbV1) and not na(dbV2) and dbV1 > 0 and dbV2 < dbV1
dbOver = dbHave and close > dbNk
dbPow = dbOver and not na(volX) and volX >= dbBrkV and close > close[1]
dbBack = dbOver and low <= dbNk * (1 + dbTol / 100)
dbN = (dbLevel ? 1 : 0) + (dbDry ? 1 : 0) + (dbOver ? 1 : 0) + (dbPow ? 1 : 0)
dbWord = not dbHave ? "► NO DOUBLE BOTTOM" : not dbLevel ? "► NOT ONE — the two lows are too far apart" : dbOver and dbPow and dbDry ? "▲ CONFIRMED — all four" : dbOver ? "▲ BROKEN OUT — " + f_n0(dbN) + " of 4" : "► FORMING — " + f_n0(dbN) + " of 4, neckline " + f_px(dbNk)
dbSay = not dbHave ? "the last three swings are not a low, a high and a low" : "lows " + f_px(dbLo1) + " and " + f_px(dbLo2) + " " + (dbLevel ? "level ✓" : "uneven ✗") + "   ·   lighter selling at the second " + (dbDry ? "✓" : "✗") + "   ·   neckline " + f_px(dbNk) + " " + (dbOver ? "broken ✓" : "intact ✗") + "   ·   break volume " + (na(volX) ? "—" : f_n1(volX) + "x") + " " + (dbPow ? "✓" : "✗") + (dbBack ? "   ·   retesting it — must hold" : "")

// ── RELATIVE STRENGTH, AND WEINSTEIN'S OWN AVERAGE ──
// The RS line is the stock divided by the index. Its direction is the whole
// reading: a stock down 10% while the index is down 20% is leading, and the
// price chart alone cannot say that. Stage 2 breakouts that work tend to have
// this already turning up before the breakout, which is why it sits in its own
// row rather than inside the breakout checklist.
bench = request.security(rsSym, timeframe.period, close, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
rsR = na(bench) or bench <= 0 ? na : close / bench
rsOld = rsR[rsLen]
rsUp = not na(rsR) and not na(rsOld) and rsR > rsOld
rsPeak = ta.highest(nz(rsR, 0), rsLen * 2)
rsNew = not na(rsR) and rsPeak > 0 and rsR >= rsPeak * 0.999
rsGap = na(rsR) or na(rsOld) or rsOld <= 0 ? na : (rsR / rsOld - 1) * 100
// Weinstein uses the 30-week average, this script the 200-day. The line is
// drawn so the textbook picture is on the chart; the rows keep one yardstick.
ma30w = request.security(syminfo.tickerid, "W", ta.sma(close, 30), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
plot(show30 ? ma30w : na, "30-week average", color = color.new(#f06292, 0), linewidth = 2)
rsWord = na(rsR) ? "► NO BENCHMARK DATA" : rsNew ? "▲ LEADING — RS line at a new high" : rsUp ? "▲ IMPROVING — gaining on the market" : "▼ LAGGING — losing to the market"
rsSay = na(rsGap) ? "could not read " + rsSym : (rsGap >= 0 ? "+" : "") + f_n1(rsGap) + "% against " + rsSym + " over " + f_n0(rsLen) + " bars" + (rsNew ? "   ·   and the RS line is at a new high, which is what leadership looks like" : rsUp ? "   ·   improving, though not yet leading" : "   ·   a Stage 2 breakout without this tends to fail")

// ── ACCUMULATION OR DISTRIBUTION ──
// Volume on up bars against volume on down bars. A rally nobody funds and a
// decline everybody funds are the same chart with the buyers removed, and the
// bar count alone cannot tell them apart. Where the bar closes inside its own
// range is the second half of it: closing near the high on volume is being
// bought, closing near the low on volume is being sold.
acUpV = math.sum(close > close[1] ? volume : 0, acLen)
acDnV = math.sum(close < close[1] ? volume : 0, acLen)
acR = na(acUpV) or na(acDnV) or acDnV <= 0 ? na : acUpV / acDnV
acRng = high - low
acLoc = ta.sma(acRng > 0 ? (close - low) / acRng : 0.5, acLen)
ddBar = not na(close[1]) and close < close[1] * (1 - ddDrop / 100) and not na(volume[1]) and volume > volume[1]
ddN = math.sum(ddBar ? 1 : 0, acLen)
acBull = not na(acR) and acR >= acEdge and acLoc >= 0.5
acBear = not na(acR) and acR <= 1 / acEdge and acLoc < 0.5
acWord = na(acR) ? "► NO VOLUME ON THIS SYMBOL" : acBull ? "▲ ACCUMULATION — buyers in control" : acBear ? "▼ DISTRIBUTION — sellers in control" : "► NEITHER — volume has not taken a side"
acSay = na(acR) ? "an index or metal reports none, so this reads nothing" : "up volume " + f_n1(acR) + "x down volume   ·   closes in the top " + f_n0(acLoc * 100) + "% of the bar   ·   " + f_n0(ddN) + " heavy down bars in " + f_n0(acLen) + (ddN >= ddCaut ? " ⚠ institutions are selling into this" : "")

// ── STAGE 2 BREAKOUT ──
// Five conditions, all of which this script already computes separately. The
// base has to be one built AFTER a decline — that is what makes it Stage 1
// rather than a pause inside an advance — which is the same box the BASE row
// calls a reversal base and refuses to grade until it breaks. This is the
// break it was waiting for.
s2a = stAbove
s2b = stHave and not stDnMA
s2c = bOk and bDnIn and not bBrkDn
s2d = bOk and not na(bHi) and close > bHi
s2e = s2d and not na(volX) and volX >= s2Vol and close > close[1]
s2N = (s2a ? 1 : 0) + (s2b ? 1 : 0) + (s2c ? 1 : 0) + (s2d ? 1 : 0) + (s2e ? 1 : 0)
s2Go = s2a and s2b and s2c and s2d and s2e
s2Word = s2Go ? "▲ STAGE 2 BREAKOUT — all five" : s2N >= 3 ? "► CLOSE — " + f_n0(s2N) + " of 5" : "► NOT YET — " + f_n0(s2N) + " of 5"
s2Say = "above the 200-day " + (s2a ? "✓" : "✗") + "   ·   slope flat or up " + (s2b ? "✓" : "✗") + "   ·   base after a decline " + (s2c ? "✓" : "✗") + "   ·   pivot " + (na(bHi) ? "—" : f_px(bHi)) + " " + (s2d ? "✓" : "✗") + "   ·   volume " + (na(volX) ? "—" : f_n1(volX) + "x") + " " + (s2e ? "✓" : "✗")

// The 3-day rule. The first bounce after a hard drop is usually short covering,
// because the institutions doing the selling need several sessions to finish.
gapDn = not na(close[1]) and close[1] > 0 and (close - close[1]) / close[1] * 100 <= -gapPct
gapAge = ta.barssince(gapDn)
gapWait = not na(gapAge) and gapAge < waitBars
gapLo = ta.lowest(low, waitBars + 1)
gapHold = not na(gapLo) and close > gapLo
vix = vixOn ? request.security(vixSym, "D", close, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off) : na
vixSay = na(vix) ? "" : "   ·   fear gauge " + f_n1(vix) + " — " + (vix < vixCalm ? "calm" : vix <= vixFear ? "caution" : "fear")
gapWord = na(gapAge) ? "► NO RECENT DROP" : gapWait ? "⏳ WAIT — bar " + f_n0(gapAge + 1) + " of " + f_n0(waitBars) + " since the drop" : gapAge <= evAge ? "► PAST THE WAIT — now check the list" : "► NO RECENT DROP"
gapSay = (na(gapAge) or gapAge > evAge ? "No drop of " + f_n1(gapPct) + "% or more lately." : gapWait ? "Do not buy yet; the first bounce is short covering, not demand." : "Selling " + (sbFade ? "has dried up ✓" : "is still heavy ✗") + "   ·   price " + (gapHold ? "holding above the low ✓" : "making new lows ✗") + "   ·   and you must know why it dropped") + vixSay
// A dip is only buyable where there is a dip: price has come back to the
// rising 50-day, and it came back on light volume rather than heavy selling.
stAtMA = not na(d50) and low <= d50 * (1 + stNear / 100)
stLightV = na(volX) or volX <= stLight
stDipOk = stg2 and stAtMA and stLightV
stWord = not stHave ? "► NO 200-DAY YET" : stPull ? "► NEUTRAL — STAGE 2 → 3, BELOW A RISING 200-DAY" : stRecl ? (wUp ? "► leaning bullish — STAGE 1 → 2, RECLAIM OF A FALLING 200-DAY" : "► NEUTRAL — STAGE 1 → 2 ATTEMPT, THE SWINGS HAVE NOT TURNED") : stg2 ? (stDipOk ? "▲ BULLISH — STAGE 2, THIS DIP IS BUYABLE" : "▲ BULLISH — STAGE 2, NO DIP HERE YET") : stg4 ? "▼ BEARISH — STAGE 4, STAY AWAY" : stg3 ? "▼ BEARISH — STAGE 3, TOPPING AFTER A RUN" : stg1 ? "► NEUTRAL — STAGE 1, BASING AFTER A DECLINE" : (stAbove ? "► NEUTRAL — STAGE 2 UNCONFIRMED, THE SWINGS HAVE NOT TURNED" : wUp ? "► NEUTRAL — STAGE 4 → 1, THE SWINGS HAVE TURNED UP" : "► NEUTRAL — STAGE 4 → 1, THE DECLINE IS STALLING")
// The stage is a method in its own right and now counts with the others. Its
// side follows the words exactly: Stage 2 bullish, Stages 3 and 4 bearish, a
// reclaim with the swings turned a lean, everything else neutral.
stShort = not stHave ? "► none" : stg2 ? "▲ STAGE 2" : stg4 ? "▼ STAGE 4" : stg3 ? "▼ STAGE 3" : stRecl ? (wUp ? "▲ STAGE 1→2" : "► 1→2 attempt") : stPull ? "► STAGE 2→3" : stg1 ? "► STAGE 1" : stAbove ? "► STAGE 2 unconfirmed" : "► STAGE 4→1"
stSide = not stHave ? 0 : stg2 ? 1 : stg4 or stg3 ? -1 : stRecl and wUp ? 1 : 0
stSay = not stHave ? "needs 200 days of history behind it" : "200-day " + f_px(d200) + " " + (stAbove ? "▲ above" : "▼ below") + " and " + (stUpMA ? "rising" : stDnMA ? "falling" : "flat") + "   ·   " + (wUp ? "higher highs and higher lows" : wDn ? "lower highs and lower lows" : "swings overlap") + "   ·   " + (stg2 ? (stDipOk ? "back at the 50-day " + f_px(d50) + " on light volume" : stAtMA ? "at the 50-day but volume is heavy — let it settle" : "wait for a pullback to the 50-day " + f_px(d50)) : stg4 ? "cheap gets cheaper; wait for the 200-day to stop falling — then STAGE 1" : stPull ? "trend intact but the average is lost — it must be reclaimed first" : stRecl ? (wUp ? "back over the average but it has not turned up — early and unproven" : "price is back over the average, but neither it nor the swings have turned") : stg1 ? "wait for the average to turn up and price to clear it" : stg3 ? "above the average but it has rolled over — distribution, not a dip" : (stAbove ? "above a rising average, but the swings do not confirm it yet" : wUp ? "the swings have turned up, but price is still under a falling average — a first sign, not the turn" : "below a falling average, but the swings have stopped confirming the downtrend"))

ma200Say = na(ma200Gap) ? "not enough history — a 200-week average needs 200 weeks of data behind it" : ma200At ? "► ON THE LINE — price is " + f_n1(math.abs(ma200Gap)) + "% " + (ma200Up ? "above" : "below") + " the 200-week average " + f_px(ma200w) + ", too close to call a long-term direction" : (ma200Up ? "▲ BULLISH — price is " + f_n1(ma200Gap) + "% ABOVE the 200-week average " : "▼ BEARISH — price is " + f_n1(-ma200Gap) + "% BELOW the 200-week average ") + f_px(ma200w) + ", so the long-term trend is " + (ma200Up ? "up" : "down")

// ═══════════════════════════════════════════════════════════════
// ONE WORD FOR THE WHOLE PANEL
// ═══════════════════════════════════════════════════════════════
// Wyckoff, Elliott and the base, and nothing else. The 200-week trend keeps
// its own row and is deliberately kept out of this one: it is a long-term
// filter, not a setup, and letting it carry the verdict would mean the word
// could read BULLISH on a chart where none of the three methods has found
// anything. Silence from all three is NEUTRAL, which is the honest answer.
nBull = (wySide == 1 ? 1 : 0) + (ewSide == 1 ? 1 : 0) + (bsSide == 1 ? 1 : 0) + (stSide == 1 ? 1 : 0)
nBear = (wySide == -1 ? 1 : 0) + (ewSide == -1 ? 1 : 0) + (bsSide == -1 ? 1 : 0) + (stSide == -1 ? 1 : 0)
nRead = nBull + nBear
bothUp = nBear == 0 and nBull >= 2
bothDn = nBull == 0 and nBear >= 2
f_names(int _w, int _e, int _b, int _s, int _side) => (_w == _side ? "Wyckoff " : "") + (_e == _side ? "Elliott " : "") + (_b == _side ? "Base " : "") + (_s == _side ? "Stage" : "")
vBull = f_names(wySide, ewSide, bsSide, stSide, 1)
vBear = f_names(wySide, ewSide, bsSide, stSide, -1)
bothSay = nRead == 0 ? "none has a directional read yet" : nRead == 1 ? "only one has a read — half a signal" : nBear == 0 ? f_n0(nBull) + " of 4 bullish, none against" : nBull == 0 ? f_n0(nBear) + " of 4 bearish, none against" : f_n0(nBull) + " bullish against " + f_n0(nBear) + " bearish — they disagree"
vSet = nBull - nBear
// One method speaking while the other two are silent is half a signal - the
// row below has always said so - and printing a full-strength BULLISH over
// that line made the panel argue with itself. A lone read is now a lean, in
// a muted colour, and BULLISH is reserved for two or more agreeing.
vFirm = nRead >= 2
vWord = vSet == 0 ? "► NEUTRAL" : vSet > 0 ? (vFirm ? "▲ BULLISH" : "▲ leaning bullish") : (vFirm ? "▼ BEARISH" : "▼ leaning bearish")
vSay = nRead == 0 ? "none of the four has a directional read on this chart" : nBull > 0 and nBear > 0 ? "bullish: " + vBull + "   ·   bearish: " + vBear + "   — so this is the balance of them" : f_n0(nRead) + " of 4 agree — " + (nBull > 0 ? vBull : vBear) + "  ·  the rest are silent"

// ═══════════════════════════════════════════════════════════════
// IS IT TIME TO BUY
// ═══════════════════════════════════════════════════════════════
// Twenty-one rows and not one of them answered the only question most
// readings end on. This is not a summary of the panel — it is three rows in
// Weinstein's own order: the stage decides whether buying is allowed at all,
// the breakout checklist decides whether now is the moment, and relative
// strength decides whether this is the name worth owning. Everything else on
// the panel explains those three. Each verdict names the row it came from so
// the reasoning is one glance away.
byWait = gapWait
byNo = stg4 or stg3
byBuyBrk = s2Go and rsUp
byBuyDip = stg2 and stDipOk and rsUp
byWatch = stRecl or stPull or stg1
byWord = byWait ? "⏳ NOT YET" : byNo ? "⛔ NO — DO NOT BUY" : byBuyBrk ? "✅ YES — BUY THE BREAKOUT" : byBuyDip ? "✅ YES — BUY THIS DIP" : stg2 ? "► HOLD — NO ENTRY HERE" : byWatch ? "👁 WATCHLIST — NOT YET" : "⛔ NO — NOTHING HERE"
bySay = byWait ? "bar " + f_n0(gapAge + 1) + " of " + f_n0(waitBars) + " since the drop; the first bounce is short covering   ·   see ▸ AFTER A DROP" : byNo ? (stg4 ? "Stage 4 — the trend is down and the average is falling" : "Stage 3 — distribution after a run") + "   ·   see STAGE ▸ DIP OR TRAP" : byBuyBrk ? "all five breakout checks and relative strength is gaining   ·   see STAGE 2 ▸ BREAKOUT" : byBuyDip ? "Stage 2, back at the rising 50-day on light volume   ·   see STAGE ▸ DIP OR TRAP" : stg2 ? (stDipOk or s2Go ? (stDipOk ? "the dip is here and buyable" : "all five breakout checks are in") + ", but it is lagging the market — RS has to turn first   ·   see RS ▸ VS MARKET" : "no dip to buy and no breakout yet" + (rsUp ? "" : ", and it is lagging the market") + "   ·   see STAGE 2 ▸ BREAKOUT") : byWatch ? "not in Stage 2 yet — build the watchlist, do not commit   ·   see STAGE ▸ DIP OR TRAP" : "neither the stage nor the structure supports a buy"

var table wp = table.new(pPos, 2, 22, border_width = 2)

f_row(table _t, int _r, string _k, string _v, color _c) =>
    table.cell(_t, 0, _r, _k, text_color = color.white, bgcolor = color.new(color.black, 0), text_halign = text.align_left, text_size = pSz)
    table.cell(_t, 1, _r, _v, text_color = color.white, bgcolor = _c, text_halign = text.align_left, text_size = pSz)

if barstate.islast
    table.clear(wp, 0, 0, 1, 21)
    f_row(wp, 0, "★ IS IT TIME?", byWord + "   ·   " + bySay, byBuyBrk or byBuyDip ? color.new(#00c853, 0) : byNo ? color.new(#b71c1c, 0) : byWait ? color.new(color.orange, 10) : byWatch ? color.new(#2e7d32, 35) : color.new(color.gray, 35))
    f_row(wp, 1, "★ VERDICT", vWord + "   ·   " + vSay, vSet > 0 ? color.new(vFirm ? #00c853 : #2e7d32, 10) : vSet < 0 ? color.new(vFirm ? #d50000 : #b71c1c, 10) : color.new(color.gray, 40))
    f_row(wp, 2, "★ ALL FOUR", "WYCKOFF " + wyShort + "  ·  ELLIOTT " + ewShort + "  ·  BASE " + bsShort + "  ·  STAGE " + stShort + "  ·  " + bothSay, bothUp ? color.new(#00c853, 10) : bothDn ? color.new(#d50000, 10) : nBull > 0 and nBear > 0 ? color.new(color.orange, 15) : color.new(color.gray, 40))
    f_row(wp, 3, "WYCKOFF ▸ SCHEMATIC", schem + "   ·   " + priorSay, schemCol)
    f_row(wp, 4, "WYCKOFF ▸ PHASE", phWord, phase == "C" ? color.new(color.orange, 15) : phase == "D" or phase == "E" ? schemCol : color.new(color.gray, 45))
    f_row(wp, 5, "WYCKOFF ▸ RANGE", rngSay, color.new(#2962ff, 40))
    f_row(wp, 6, "WYCKOFF ▸ EVENTS", evSay, color.new(color.purple, 35))
    f_row(wp, 7, "WYCKOFF ▸ MEANS", meanSay, color.new(#00695c, 10))
    f_row(wp, 8, "WYCKOFF ▸ DO THIS", actWord + "   ·   " + actSay, not rngOk or bias == 0 or not late ? color.new(color.gray, 45) : bias == -1 ? color.new(#00c853, 15) : color.new(#d50000, 15))
    f_row(wp, 9, "ELLIOTT ▸ STRUCTURE", wWord + "   ·   " + wSay, not wHave ? color.new(color.gray, 45) : wUp and rAll ? color.new(#00c853, 15) : wDn and rAll ? color.new(#d50000, 15) : (wUp or wDn) and rBroke ? color.new(color.orange, 25) : color.new(color.gray, 40))
    f_row(wp, 10, "WYCKOFF ▸ TRIGGER", trigSay, color.new(color.black, 25))
    f_row(wp, 11, "BASE ▸ BREAKOUT", bsWord + "   ·   " + bsSay + (bBrkUp and (stg4 or (stg3 and not stRecl)) ? "   ⚠ STAGE says " + (stg4 ? "Stage 4" : "Stage 3") + " — no trend behind it" : bBrkUp and stRecl ? "   ⚠ the 200-day has not turned up yet" : bBrkDn and stg2 ? "   ⚠ STAGE says Stage 2 — likely a shakeout" : ""), not bOk ? color.new(color.gray, 45) : bsSide == 1 ? color.new(#00c853, 20) : bsSide == -1 ? color.new(#d50000, 20) : color.new(color.orange, 30))
    f_row(wp, 12, "200-WEEK AVERAGE", ma200Say, na(ma200Gap) or ma200At ? color.new(color.gray, 45) : ma200Up ? color.new(#00c853, 20) : color.new(#d50000, 20))
    f_row(wp, 13, "STAGE ▸ DIP OR TRAP", stWord + "   ·   " + stSay, not stHave ? color.new(color.gray, 45) : stg2 ? color.new(#00c853, stDipOk ? 5 : 25) : stg4 ? color.new(#d50000, 10) : stPull ? color.new(color.orange, 20) : stRecl ? (wUp ? color.new(#2e7d32, 10) : color.new(color.gray, 40)) : stg3 ? color.new(#b71c1c, 10) : color.new(color.gray, 40))
    f_row(wp, 14, "STAGE 2 ▸ BREAKOUT", s2Word + "   ·   " + s2Say, s2Go ? color.new(#00c853, 5) : s2N >= 3 ? color.new(#2e7d32, 40) : color.new(color.gray, 45))
    f_row(wp, 15, "200-DAY ▸ SHAKEOUT?", sbWord + "   ·   " + sbSay, not stHave ? color.new(color.gray, 45) : sbShake ? color.new(#2e7d32, 10) : sbBreak ? color.new(#b71c1c, 10) : color.new(color.gray, 40))
    f_row(wp, 16, "▸ AFTER A DROP", gapWord + "   ·   " + gapSay, na(gapAge) or gapAge > evAge ? color.new(color.gray, 45) : gapWait ? color.new(color.orange, 15) : color.new(#00695c, 10))
    f_row(wp, 17, "DOUBLE BOTTOM", dbWord + "   ·   " + dbSay, not dbHave ? color.new(color.gray, 45) : dbOver and dbPow and dbLevel and dbDry ? color.new(#00c853, 5) : dbOver ? color.new(#2e7d32, 25) : color.new(color.gray, 40))
    f_row(wp, 18, "RS ▸ VS MARKET", rsWord + "   ·   " + rsSay, na(rsR) ? color.new(color.gray, 45) : rsNew ? color.new(#00c853, 5) : rsUp ? color.new(#2e7d32, 10) : color.new(#b71c1c, 10))
    f_row(wp, 19, "VOLUME ▸ CONTROL", acWord + "   ·   " + acSay, na(acR) ? color.new(color.gray, 45) : acBull ? color.new(#2e7d32, 10) : acBear ? color.new(#b71c1c, 10) : color.new(color.gray, 40))
    f_row(wp, 20, "VOLUME — ALL", (barLive and not na(volX) ? "⧗ this bar is still forming, so volume is partial — no climax or sign of strength can fire yet. " : "") + (na(volX) ? "not reported for this symbol" : f_nx(volX) + "x the " + f_n0(volLen) + "-bar average" + (barLive ? " so far" : "") + (volX >= climX ? " — climactic" : volX >= sosVolX ? " — above average" : barLive ? "" : " — light")), color.new(color.navy, 35))
    f_row(wp, 21, "CAUTION", "A range is a range until it breaks, and Phase B can outlast your patience. Events are reported only after the bar closed. Wave structure is not a count — it changes as new swings form.", color.new(color.gray, 55))

alertcondition(sprNow, title = "Wyckoff SPRING", message = "{{ticker}} {{interval}}: spring — the range low gave way and was taken back at {{close}}")
alertcondition(utNow, title = "Wyckoff UPTHRUST / UTAD", message = "{{ticker}} {{interval}}: upthrust — the range high gave way and was taken back at {{close}}")
alertcondition(sosNow, title = "Wyckoff SIGN OF STRENGTH", message = "{{ticker}} {{interval}}: sign of strength — closed above the range on volume at {{close}}")
alertcondition(sowNow, title = "Wyckoff SIGN OF WEAKNESS", message = "{{ticker}} {{interval}}: sign of weakness — closed below the range on volume at {{close}}")
