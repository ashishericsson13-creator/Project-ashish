# ── copy to .env and fill in. never commit .env ──

# Shared secret. Must match the "secret" field in every TradingView alert.
# Generate one: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=CHANGE_ME

# ── IBKR connection ──
# 7497 = TWS paper   7496 = TWS live
# 4002 = Gateway paper   4001 = Gateway live
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=17

# Must be set to exactly LIVE to place real orders. Anything else = paper.
# This is deliberately awkward. One word is the whole difference.
TRADING_MODE=PAPER

# ── sizing: 1% risk, max 5 positions ──
RISK_PCT=1.0
MAX_POSITIONS=5

# Hard ceiling per order in dollars, regardless of what the risk maths says.
# At $10k with 5 positions, 2500 means no single order can exceed 25% of the book.
MAX_ORDER_USD=2500

# Reject a signal whose stop is closer than this or further than this, as a
# percent of price. A 0.2% stop would size to a colossal position; a 60% stop
# is not a stop. Both are signs the alert is malformed.
MIN_STOP_PCT=2.0
MAX_STOP_PCT=25.0

# ── what may be traded at all ──
# Comma separated. A symbol not on this list is refused, logged and ignored.
ALLOWLIST=AAPL,MSFT,GOOGL,AMZN,BRK.B,NOW,CRM,INTC,TSLA,SMH,VOO

# Only act during US regular trading hours.
RTH_ONLY=true
