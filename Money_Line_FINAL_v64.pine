[st10, sd10, sf10, sq10] = request.security(s10, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st11, sd11, sf11, sq11] = request.security(s11, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st12, sd12, sf12, sq12] = request.security(s12, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st13, sd13, sf13, sq13] = request.security(s13, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st14, sd14, sf14, sq14] = request.security(s14, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st15, sd15, sf15, sq15] = request.security(s15, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st16, sd16, sf16, sq16] = request.security(s16, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st17, sd17, sf17, sq17] = request.security(s17, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st18, sd18, sf18, sq18] = request.security(s18, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st19, sd19, sf19, sq19] = request.security(s19, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st20, sd20, sf20, sq20] = request.security(s20, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st21, sd21, sf21, sq21] = request.security(s21, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st22, sd22, sf22, sq22] = request.security(s22, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st23, sd23, sf23, sq23] = request.security(s23, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st24, sd24, sf24, sq24] = request.security(s24, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st25, sd25, sf25, sq25] = request.security(s25, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st26, sd26, sf26, sq26] = request.security(s26, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st27, sd27, sf27, sq27] = request.security(s27, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st28, sd28, sf28, sq28] = request.security(s28, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st29, sd29, sf29, sq29] = request.security(s29, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st30, sd30, sf30, sq30] = request.security(s30, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st31, sd31, sf31, sq31] = request.security(s31, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st32, sd32, sf32, sq32] = request.security(s32, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)

// build priority-sorted focus list: fresh flips first, then nearest-to-trigger
scPos = scanPos == "Top Right" ? position.top_right : scanPos == "Middle Right" ? position.middle_right : scanPos == "Bottom Left" ? position.bottom_left : position.bottom_right
var table sc = table.new(scPos, 2, 40, border_width = 1)

f_score(_t, _d, _f) =>
    // lower score = more urgent
    _f == 1 ? 0.0 : na(_d) ? 999.0 : math.abs(_d)

// "up 7%" read as a 7% GAIN. It never meant that — it is the distance between
// price and the LINE, i.e. headroom above the exit (bullish) or the gap still to
// climb to the trigger (bearish). A symbol can sit "up 7%" while the trade is
// down. The wording now says which.
f_tag(_t, _d, _f) =>
    na(_t) or na(_d) ? "— no data" : _f == 1 and _t == 1 ? "★ NEW BUY" : _f == 1 and _t == -1 ? "★ NEW SELL" : _t == -1 and _d > -3 ? "◆ NEAR BUY " + str.tostring(_d, "#.#") + "%" : _t == 1 and _d < 3 ? "◆ NEAR SELL " + str.tostring(_d, "#.#") + "%" : _t == 1 ? str.tostring(_d, "#") + "% above exit" : str.tostring(math.abs(_d), "#") + "% below trigger"

f_tagCol(_t, _d, _f) =>
    na(_t) or na(_d) ? color.new(color.gray, 55) : _f == 1 and _t == 1 ? color.new(#00c853, 0) : _f == 1 and _t == -1 ? color.new(#d50000, 0) : (_t == -1 and not na(_d) and _d > -3) or (_t == 1 and not na(_d) and _d < 3) ? color.new(color.orange, 10) : _t == 1 ? color.new(#00c853, 60) : color.new(#d50000, 60)

if showScanner and barstate.islast
    table.clear(sc, 0, 0, 1, 33)
    scores = array.new_float()
    idxs   = array.new_int()
    array.push(scores, f_score(st1, sd1, sf1)), array.push(idxs, 1)
    array.push(scores, f_score(st2, sd2, sf2)), array.push(idxs, 2)
    array.push(scores, f_score(st3, sd3, sf3)), array.push(idxs, 3)
    array.push(scores, f_score(st4, sd4, sf4)), array.push(idxs, 4)
    array.push(scores, f_score(st5, sd5, sf5)), array.push(idxs, 5)
    array.push(scores, f_score(st6, sd6, sf6)), array.push(idxs, 6)
    array.push(scores, f_score(st7, sd7, sf7)), array.push(idxs, 7)
    array.push(scores, f_score(st8, sd8, sf8)), array.push(idxs, 8)
    array.push(scores, f_score(st9, sd9, sf9)), array.push(idxs, 9)
    array.push(scores, f_score(st10, sd10, sf10)), array.push(idxs, 10)
    array.push(scores, f_score(st11, sd11, sf11)), array.push(idxs, 11)
    array.push(scores, f_score(st12, sd12, sf12)), array.push(idxs, 12)
    array.push(scores, f_score(st13, sd13, sf13)), array.push(idxs, 13)
    array.push(scores, f_score(st14, sd14, sf14)), array.push(idxs, 14)
    array.push(scores, f_score(st15, sd15, sf15)), array.push(idxs, 15)
    array.push(scores, f_score(st16, sd16, sf16)), array.push(idxs, 16)
    array.push(scores, f_score(st17, sd17, sf17)), array.push(idxs, 17)
    array.push(scores, f_score(st18, sd18, sf18)), array.push(idxs, 18)
    array.push(scores, f_score(st19, sd19, sf19)), array.push(idxs, 19)
    array.push(scores, f_score(st20, sd20, sf20)), array.push(idxs, 20)
    array.push(scores, f_score(st21, sd21, sf21)), array.push(idxs, 21)
    array.push(scores, f_score(st22, sd22, sf22)), array.push(idxs, 22)
    array.push(scores, f_score(st23, sd23, sf23)), array.push(idxs, 23)
    array.push(scores, f_score(st24, sd24, sf24)), array.push(idxs, 24)
    array.push(scores, f_score(st25, sd25, sf25)), array.push(idxs, 25)
    array.push(scores, f_score(st26, sd26, sf26)), array.push(idxs, 26)
    array.push(scores, f_score(st27, sd27, sf27)), array.push(idxs, 27)
    array.push(scores, f_score(st28, sd28, sf28)), array.push(idxs, 28)
    array.push(scores, f_score(st29, sd29, sf29)), array.push(idxs, 29)
    array.push(scores, f_score(st30, sd30, sf30)), array.push(idxs, 30)
    array.push(scores, f_score(st31, sd31, sf31)), array.push(idxs, 31)
    // Slot 32 holds the chart's own symbol. Pin it to the top of the list with a
    // score below any real one, so the symbol you are actually looking at is
    // always present — the urgency sort would otherwise drop a settled trend
    // (e.g. TCS at +12% above its line) below the display cut.
    array.push(scores, addChartSym ? -1.0 : f_score(st32, sd32, sf32)), array.push(idxs, 32)
    table.cell(sc, 0, 0, "FOCUS LIST v62", text_color = color.white, bgcolor = color.new(color.blue, 20), text_halign = text.align_left, text_size = txtSize)
    // diagnostic: the bar each symbol was read at. Same date on two different
    // charts = the Focus List is genuinely aligned.
    // Every symbol should be read at the SAME bar. If they are not, the scan is
    // getting uneven history and the levels cannot be compared — that is the
    // failure this whole header exists to catch.
    sqAll  = array.from(sq1, sq2, sq3, sq4, sq5, sq6, sq7, sq8, sq9, sq10, sq11, sq12, sq13, sq14, sq15, sq16, sq17, sq18, sq19, sq20, sq21, sq22, sq23, sq24, sq25, sq26, sq27, sq28, sq29, sq30, sq31, sq32)
    asOfT  = array.max(sqAll)
    asOfMin = array.min(sqAll)
    // tolerance: symbols on different exchanges open their bar at different times
    // of day. Only a gap of several days means they are on different BARS.
    // Tolerance must scale with the scan timeframe, not be a fixed number of days.
    // A symbol on a later-closing exchange legitimately reports one bar behind:
    // on an NSE chart the week ends 10:00 UTC Friday, but NASDAQ's week ends at
    // 20:00 UTC, and lookahead_off correctly refuses to return a bar that closes
    // after the chart bar did. That one-bar offset is the anti-repainting rule
    // working, not a fault — so only a gap of MORE than one bar is a real problem.
    tolMs  = math.round(timeframe.in_seconds(scanTF) * 1000 * tolBars)
    mixed  = not na(asOfT) and not na(asOfMin) and (asOfT - asOfMin) > tolMs
    asOfTx = showAsOf and nz(asOfT, 0) > 0 ? "  ·  as of w/e " + str.format_time(asOfT, "dd MMM", syminfo.timezone) + (mixed ? "  ⚠ MIXED DATES" : "") + "  ⚡=live" : ""
    hdrCol = mixed ? color.new(#d50000, 10) : color.new(color.blue, 20)
    table.cell(sc, 1, 0, scanTF + "  " + chartMkt + "  (top " + str.tostring(maxShow) + ")" + asOfTx, text_color = color.white, bgcolor = hdrCol, text_halign = text.align_center, text_size = txtSize)
    shown = 0
    // names already rendered, so the chart symbol in slot 32 cannot appear twice
    seenNames = array.new_string()
    while shown < maxShow and array.size(scores) > 0
        best = 0
        for k = 1 to array.size(scores) - 1
            if array.get(scores, k) < array.get(scores, best)
                best := k
        id = array.get(idxs, best)
        array.remove(scores, best), array.remove(idxs, best)
        sym = switch id
            1 => s1
            2 => s2
            3 => s3
            4 => s4
            5 => s5
            6 => s6
            7 => s7
            8 => s8
            9 => s9
            10 => s10
            11 => s11
            12 => s12
            13 => s13
            14 => s14
            15 => s15
            16 => s16
            17 => s17
            18 => s18
            19 => s19
            20 => s20
            21 => s21
            22 => s22
            23 => s23
            24 => s24
            25 => s25
            26 => s26
            27 => s27
            28 => s28
            29 => s29
            30 => s30
            31 => s31
            32 => s32
            => s1
        tv = switch id
            1 => st1
            2 => st2
            3 => st3
            4 => st4
            5 => st5
            6 => st6
            7 => st7
            8 => st8
            9 => st9
            10 => st10
            11 => st11
            12 => st12
            13 => st13
            14 => st14
            15 => st15
            16 => st16
            17 => st17
            18 => st18
            19 => st19
            20 => st20
            21 => st21
            22 => st22
            23 => st23
            24 => st24
            25 => st25
            26 => st26
            27 => st27
            28 => st28
            29 => st29
            30 => st30
            31 => st31
            32 => st32
            => st1
        dv = switch id
            1 => sd1
            2 => sd2
            3 => sd3
            4 => sd4
            5 => sd5
            6 => sd6
            7 => sd7
            8 => sd8
            9 => sd9
            10 => sd10
            11 => sd11
            12 => sd12
            13 => sd13
            14 => sd14
            15 => sd15
            16 => sd16
            17 => sd17
            18 => sd18
            19 => sd19
            20 => sd20
            21 => sd21
            22 => sd22
            23 => sd23
            24 => sd24
            25 => sd25
            26 => sd26
            27 => sd27
            28 => sd28
            29 => sd29
            30 => sd30
            31 => sd31
            32 => sd32
            => sd1
        fv = switch id
            1 => sf1
            2 => sf2
            3 => sf3
            4 => sf4
            5 => sf5
            6 => sf6
            7 => sf7
            8 => sf8
            9 => sf9
            10 => sf10
            11 => sf11
            12 => sf12
            13 => sf13
            14 => sf14
            15 => sf15
            16 => sf16
            17 => sf17
            18 => sf18
            19 => sf19
            20 => sf20
            21 => sf21
            22 => sf22
            23 => sf23
            24 => sf24
            25 => sf25
            26 => sf26
            27 => sf27
            28 => sf28
            29 => sf29
            30 => sf30
            31 => sf31
            32 => sf32
            => sf1
        qv = switch id
            1 => sq1
            2 => sq2
            3 => sq3
            4 => sq4
            5 => sq5
            6 => sq6
            7 => sq7
            8 => sq8
            9 => sq9
            10 => sq10
            11 => sq11
            12 => sq12
            13 => sq13
            14 => sq14
            15 => sq15
            16 => sq16
            17 => sq17
            18 => sq18
            19 => sq19
            20 => sq20
            21 => sq21
            22 => sq22
            23 => sq23
            24 => sq24
            25 => sq25
            26 => sq26
            27 => sq27
            28 => sq28
            29 => sq29
            30 => sq30
            31 => sq31
            32 => sq32
            => int(na)
        // a symbol that is invalid, or still inside its warm-up window, is skipped
        // entirely instead of occupying a slot with a misleading tag
        symMkt = f_mkt(f_exch(sym))
        mktOK  = not mktFilter or symMkt == "ANY" or symMkt == chartMkt
        nm = syminfo.ticker(sym)   // pinned chart symbol is reached first, so a
                                   // duplicate elsewhere in the set is the one dropped
        dup = array.includes(seenNames, nm)
        if not na(tv) and not na(dv) and shown < 32 and mktOK and not dup
            shown += 1
            array.push(seenNames, nm)
            fvBits = fv % 4
            fvFlip = fvBits % 2            // bit 1: confirmed flip on the closed bar
            pv     = fvBits >= 2 ? 1 : 0   // bit 2: live bar is crossing right now
            fvAge  = math.floor(fv / 4)    // bars in the current regime
            ageTxt = fvAge <= 0 ? "" : "  " + str.tostring(fvAge) + tfBar
            stale = not na(qv) and not na(asOfT) and (asOfT - qv) > tolMs
            table.cell(sc, 0, shown, (stale ? "⧗ " : "") + syminfo.ticker(sym), text_color = color.white, bgcolor = stale ? color.new(#d50000, 45) : color.new(color.black, 20), text_halign = text.align_left, text_size = txtSize)
            // ⚡ = the live bar has already crossed but the bar has not closed.
            // Early warning, and explicitly NOT a confirmed signal.
            table.cell(sc, 1, shown, (pv == 1 ? "⚡ " : "") + f_tag(tv, dv, fvFlip) + ageTxt, text_color = color.white, bgcolor = pv == 1 ? color.new(#7c4dff, 15) : f_tagCol(tv, dv, fvFlip), text_halign = text.align_center, text_size = txtSize)

// ═══════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════
alertcondition(buySignal and scorePct >= 0.88 and not thinHist, title = "BUY — Grade A (high quality)", message = "{{ticker}} {{interval}}: BUY signal, GRADE A (88%+ of checks passed) at {{close}}")
alertcondition(buySignal, title = "BUY — any grade", message = "{{ticker}} {{interval}}: BUY signal at {{close}} — check grade on chart")
alertcondition(sellSignal, title = "SELL", message = "{{ticker}} {{interval}}: SELL signal at {{close}}")

// intraweek tripwire: fires the moment price trades ABOVE the buy flip level while still bearish
// (unconfirmed — the weekly close can still fall back below; this is the EARLY-PRICE heads-up)
tripwireUp = (buySignal and not barstate.isconfirmed) or (trend == -1 and close > moneyLine)
alertcondition(tripwireUp, title = "⚡ PRICE ABOVE BUY LEVEL (unconfirmed)", message = "{{ticker}}: price {{close}} is ABOVE the buy flip level intrabar — unconfirmed until the bar closes. Early-entry zone.")

alertcondition(tlBreakUp, title = "Trendline BREAKOUT (falling resistance)", message = "{{ticker}} {{interval}}: closed above its falling resistance trendline at {{close}}")
alertcondition(tlBreakDn, title = "Trendline BREAKDOWN (rising support)", message = "{{ticker}} {{interval}}: closed below its rising support trendline at {{close}}")

alertcondition(proBreakUp, title = "PRO LINE breakout (closed above long resistance)", message = "{{ticker}} {{interval}}: closed above its long-term resistance trendline at {{close}}")
alertcondition(proBreakDn, title = "PRO LINE breakdown (closed below long support)", message = "{{ticker}} {{interval}}: closed below its long-term support trendline at {{close}}")

// ═══════════════════════════════════════════════════════════════════════════
// v64 — BREAKOUT CONSOLE + SETUP QUALITY + STRUCTURE
//
// NOTHING ABOVE THIS LINE IS CHANGED. This section only reads.
//
// WHY ALMOST ALL OF IT LIVES IN FUNCTIONS (CE10295)
//   TradingView rejected an earlier draft with "The main body of the script
//   is too long. Try wrapping code in functions". That is a limit on
//   GLOBAL-SCOPE statements, and v62 alone already sits close to it; ~300
//   more at global scope went over. A function body is compiled as its own
//   scope and does not count, so the work is in functions and the main body
//   holds only inputs, a handful of assignments, and the plot/alert calls
//   that Pine refuses to allow anywhere else.
//
//   That forced one real design change. Pine CANNOT assign to a global from
//   inside a function, so the usual `var line x = na` + `x := line.new(...)`
//   pattern cannot be wrapped. Arrays are reference types and CAN be mutated
//   inside a function, so every drawable this section owns lives in one of
//   three arrays, wiped and repopulated on the last bar. That is also why
//   the sync-mode cleanup works: deleting another block's line is a call,
//   not an assignment, so it is allowed.
//
// WHAT WAS ALREADY HERE AND IS REUSED RATHER THAN REBUILT
//   proBreakUp/Dn   long best-fit trendlines, already touch-counted
//   tlBreakUp/Dn    short swing trendlines
//   buySignal/Dn    the ATR Money Line flip
//   hi52 / hiAll    already computed, previously feeding one panel row
//   hiA/hiB,loA/loB the short swing anchors the structure read is built on
//
// THREE SCORES, DELIBERATELY NOT ADDED TOGETHER
//   c1-c9   (above)  how well confirmed is the REGIME I am already in
//   k1-k10  (here)   is THIS BREAKOUT real
//   SETUP   (here)   was the thing that broke worth breaking
//   Different questions. Merging them would destroy the only information
//   that matters when they disagree.
// ═══════════════════════════════════════════════════════════════════════════
boOn       = input.bool(true, "Enable BREAKOUT console", group = "6. Breakout Console")
boMinTouch = input.int(2, "Horizontal level: minimum touches", minval = 1, maxval = 6, tooltip = "How many times price must have reacted at a price before it counts as a level.\n\n1 = every swing pivot is a level, which is what the Auto S/R rows above do and why they show levels that have never been defended.\n2 (default) = a price that turned the market away at least twice.\n3+ = heavily defended prices only; on fast movers you may get none.", group = "6. Breakout Console")
boTolATR   = input.float(0.50, "Horizontal level: cluster width (ATR)", minval = 0.05, maxval = 3.0, step = 0.05, tooltip = "Two pivots within this distance are the SAME level and their touch counts merge. In ATR so it scales with the symbol instead of a fixed percentage that is too wide on one chart and too narrow on the next.", group = "6. Breakout Console")
boBufPct   = input.float(0.15, "Breakout buffer (% beyond the level)", minval = 0.0, maxval = 5.0, step = 0.05, tooltip = "How far past the level a close must land to count. Stops a close landing exactly ON the level from registering — the most common false positive.", group = "6. Breakout Console")
boFresh    = input.int(3, "Breakout stays 'live' for N bars", minval = 1, maxval = 20, tooltip = "A breakout is a dated event, not a permanent state. After this many bars the verdict stops calling it an entry. Keeps the console from saying BUY NOW for six months because something broke in March.", group = "6. Breakout Console")
boVolSurge = input.float(1.50, "Volume surge required (x 20-bar avg)", minval = 0.5, maxval = 5.0, step = 0.1, tooltip = "Breakout-bar volume over the 20-bar average. A level breaking on below-average volume is the textbook failure: price moved, nobody came.", group = "6. Breakout Console")
boRsiMax   = input.float(80.0, "RSI ceiling (above = move already spent)", minval = 60, maxval = 95, step = 1, tooltip = "RSI above this means buying the end of a run. This is the check that stops a BUY into a vertical blow-off.", group = "6. Breakout Console")
boStopATR  = input.float(0.50, "Breakout stop: ATR below the broken level", minval = 0.1, maxval = 3.0, step = 0.1, tooltip = "A broken resistance becomes support; the trade is wrong if price closes back under it. NOT the Money Line, which on weekly can be 25% away and is a REGIME stop. Both are printed — size off the one you are trading.", group = "6. Breakout Console")
boShowLvl  = input.bool(true, "Draw the defended horizontal levels", group = "6. Breakout Console")
boShowVert = input.bool(true, "Vertical line at each scored breakout", group = "6. Breakout Console")
boPos      = input.string("Top Right", "Console position", options = ["Top Right", "Top Left", "Middle Right", "Bottom Left", "Bottom Right"], group = "6. Breakout Console")
suOn       = input.bool(true, "Enable SETUP QUALITY (base, new high, squeeze, targets)", group = "7. Setup Quality")
suBaseMax  = input.float(25.0, "Base: max range width (% of its low)", minval = 3.0, maxval = 80.0, step = 0.5, tooltip = "How tight a stretch must be to count as a base. The script tries 200, 120, 80, 50, 30 and 20 bars and takes the LONGEST that fits inside this width.\n\n25% suits weekly equities. Crypto needs 40-50% because a quiet quarter there is still a 40% range. Too tight and nothing qualifies; too loose and an ordinary downtrend reads as a base.", group = "7. Setup Quality")
suBaseMin  = input.int(30, "Base: minimum bars to call it a base", minval = 10, maxval = 200, tooltip = "Below this the range is chop, not a base. On weekly, 30 bars is about seven months — roughly where enough holders are trapped for a breakout to matter.", group = "7. Setup Quality")
suSqzPct   = input.float(15.0, "Squeeze: within % of the tightest band in 100 bars", minval = 2.0, maxval = 60.0, step = 1.0, tooltip = "Bollinger width against its own lowest reading over 100 bars. Inside this margin the market is coiled.\n\nThis is a VOLATILITY state, not a direction. A squeeze says a big move is near; it never says which way. It belongs in the quality grade, never in the buy/sell decision.", group = "7. Setup Quality")
suShowBox  = input.bool(true, "Draw the base box", group = "7. Setup Quality")
suShowTgt  = input.bool(true, "Draw measured-move targets (1.0 / 1.618)", group = "7. Setup Quality")
suShowATH  = input.bool(true, "Draw the 52-week and all-time high lines", group = "7. Setup Quality")
wgOn       = input.bool(true, "Draw the converging pair / channel + apex", group = "8. Structure")
wgMaxBar   = input.int(60, "Apex: ignore if further out than N bars", minval = 5, maxval = 400, tooltip = "Two nearly-parallel lines meet hundreds of bars away, which is not an apex anyone trades. Past this the pair is reported as a channel and the lines are not drawn to a meeting point.", group = "8. Structure")
wgFlat     = input.float(0.02, "Flat-slope tolerance (ATR per bar)", minval = 0.001, maxval = 0.5, step = 0.005, tooltip = "A slope smaller than this per bar counts as horizontal, which is what separates an ASCENDING triangle (flat top, rising lows) from a symmetrical one. In ATR so it means the same on every symbol.", group = "8. Structure")
wgShowMid  = input.bool(true, "Channel: draw the midline (3rd rail)", group = "8. Structure")

// ── DEFENDED HORIZONTAL LEVELS ───────────────────────────────────────
// Reuses ph / pl from the Auto S/R block above — no second pivot scan.
var array<float> boLvlPx  = array.new_float()
var array<int>   boLvlHit = array.new_int()
var array<int>   boLvlBar = array.new_int()

// CE10235, and why the shape matters: every if/else in Pine is an EXPRESSION
// and both arms must agree on a type. array.set() is void while array.shift()
// returns the element removed, so ending the arms on those made this
// "void; series int". The size cap sits ABOVE the pushes so both arms end on
// a void call, and _found is returned explicitly.
f_boMerge(array<float> _px, array<int> _hit, array<int> _bar, float _new, float _tol, int _bi) =>
    int _found = -1
    if not na(_new) and not na(_tol) and _tol > 0
        if array.size(_px) > 0
            for i = 0 to array.size(_px) - 1
                if math.abs(array.get(_px, i) - _new) <= _tol
                    _found := i
                    break
        if _found >= 0
            // running mean: the level settles where price actually reacted,
            // not wherever the most recent wick happened to end
            int   _n = array.get(_hit, _found) + 1
            float _o = array.get(_px, _found)
            array.set(_px,  _found, _o + (_new - _o) / _n)
            array.set(_hit, _found, _n)
        else
            if array.size(_px) >= 60
                array.shift(_px)
                array.shift(_hit)
                array.shift(_bar)
            array.push(_px,  _new)
            array.push(_hit, 1)
            array.push(_bar, _bi)
    _found

f_boPick(array<float> _px, array<int> _hit, array<int> _bar, int _min, bool _above, float _ref) =>
    float _bestPx  = na
    int   _bestHit = 0
    int   _bestBar = na
    if array.size(_px) > 0
        for i = 0 to array.size(_px) - 1
            float _v = array.get(_px, i)
            int   _h = array.get(_hit, i)
            if _h >= _min and (_above ? _v > _ref : _v < _ref)
                if na(_bestPx) or (_above ? _v < _bestPx : _v > _bestPx)
                    _bestPx  := _v
                    _bestHit := _h
                    _bestBar := array.get(_bar, i)
    [_bestPx, _bestHit, _bestBar]

boTol = na(atrV) ? na : boTolATR * atrV
if not na(ph)
    f_boMerge(boLvlPx, boLvlHit, boLvlBar, ph, boTol, bar_index - pivLen)
if not na(pl)
    f_boMerge(boLvlPx, boLvlHit, boLvlBar, pl, boTol, bar_index - pivLen)

[boRes, boResHit, boResBar] = f_boPick(boLvlPx, boLvlHit, boLvlBar, boMinTouch, true,  close)
[boSup, boSupHit, boSupBar] = f_boPick(boLvlPx, boLvlHit, boLvlBar, boMinTouch, false, close)

// The level IN FORCE before this bar opened. Testing against the CURRENT
// bar's level can never fire: the moment price closes above a resistance,
// that resistance is recomputed to the next one up.
boResRef = boRes[1]
boSupRef = boSup[1]
boBrkHorzUp = boOn and not na(boResRef) and close > boResRef * (1 + boBufPct / 100) and close[1] <= boResRef
boBrkHorzDn = boOn and not na(boSupRef) and close < boSupRef * (1 - boBufPct / 100) and close[1] >= boSupRef

// ── SETUP QUALITY: base / new high / squeeze / targets ───────────────
// Six fixed lengths rather than a search loop: ta.highest() needs a constant
// length, and six pairs every bar is cheaper and more predictable than any
// loop hunting the exact longest tight window. Longest qualifying wins — a
// 200-bar base that also fits in 20 bars is still a 200-bar base.
f_suW(float _h, float _l) => _l > 0 ? (_h - _l) / _l * 100 : na
f_suBase(float _maxW) =>
    h200 = ta.highest(high, 200), l200 = ta.lowest(low, 200)
    h120 = ta.highest(high, 120), l120 = ta.lowest(low, 120)
    h80  = ta.highest(high,  80), l80  = ta.lowest(low,  80)
    h50  = ta.highest(high,  50), l50  = ta.lowest(low,  50)
    h30  = ta.highest(high,  30), l30  = ta.lowest(low,  30)
    h20  = ta.highest(high,  20), l20  = ta.lowest(low,  20)
    t200 = bar_index >= 200 and f_suW(h200, l200) <= _maxW
    t120 = bar_index >= 120 and f_suW(h120, l120) <= _maxW
    t80  = bar_index >=  80 and f_suW(h80,  l80)  <= _maxW
    t50  = bar_index >=  50 and f_suW(h50,  l50)  <= _maxW
    t30  = bar_index >=  30 and f_suW(h30,  l30)  <= _maxW
    t20  = bar_index >=  20 and f_suW(h20,  l20)  <= _maxW
    // assigned to locals first: Pine's line-continuation rules inside a
    // multi-line tuple literal are fragile, and a one-line return is not.
    bb = t200 ? 200 : t120 ? 120 : t80 ? 80 : t50 ? 50 : t30 ? 30 : t20 ? 20 : 0
    bh = t200 ? h200 : t120 ? h120 : t80 ? h80 : t50 ? h50 : t30 ? h30 : t20 ? h20 : na
    bl = t200 ? l200 : t120 ? l120 : t80 ? l80 : t50 ? l50 : t30 ? l30 : t20 ? l20 : na
    [bb, bh, bl]

f_suSqueeze(float _pct) =>
    _basis = ta.sma(close, 20)
    _w     = _basis > 0 ? (4 * ta.stdev(close, 20)) / _basis * 100 : na
    _lo    = ta.lowest(_w, 100)
    not na(_w) and not na(_lo) and _lo > 0 and _w <= _lo * (1 + _pct / 100)

[suBars, suHi, suLo] = f_suBase(suBaseMax)
suSqz    = suOn and f_suSqueeze(suSqzPct)
suIsBase = suOn and suBars >= suBaseMin
// Tested against the PREVIOUS bar's ceiling, for the same reason as every
// other break here.
suBaseBrk = suIsBase and not na(suHi[1]) and close > suHi[1] and close[1] <= suHi[1]
// hi52 and hiAll were already computed above and fed exactly one panel row;
// they were never allowed to signal. 0.5% tolerance so a close a tick under
// the old high still reads as a new high rather than a near miss.
suNewATH = suOn and close >= hiAll * 0.995
suNew52  = suOn and close >= hi52  * 0.995
suATHBrk = suOn and close > hiAll[1] and close[1] <= hiAll[1]
// the base's own height projected from its ceiling — what a posted chart's
// 161.8 / 261.8 labels actually are: the range repeated, not a magic ratio
suHeight = na(suHi) or na(suLo) ? na : suHi - suLo
suTgt1   = na(suHeight) ? na : suHi + suHeight
suTgt2   = na(suHeight) ? na : suHi + suHeight * 1.618
suPts    = (suIsBase ? 1 : 0) + (suNewATH ? 2 : suNew52 ? 1 : 0) + (suSqz ? 1 : 0)
suGrade  = not suOn ? "—" : suPts >= 4 ? "A+" : suPts == 3 ? "A" : suPts == 2 ? "B" : suPts == 1 ? "C" : "D"

// ── STRUCTURE: the converging pair, its apex, the channel ────────────
// Built on the SHORT swing anchors (hiA/hiB, loA/loB), not the PRO scan.
// On SPCX daily with 119 bars the PRO scan reported "swings H1 L1, no valid
// res line, no valid sup line" and drew nothing, while these were perfectly
// well formed. A structure read that needs a decade of history is useless on
// exactly the charts people most want it for.
f_wgCalc(float _flatTol) =>
    _ok = not na(hiA_px) and not na(hiB_px) and not na(loA_px) and not na(loB_px) and not na(tlUpNow) and not na(tlLoNow) and hiB_bar > hiA_bar and loB_bar > loA_bar
    _rs = _ok ? (hiB_px - hiA_px) / (hiB_bar - hiA_bar) : na
    _ss = _ok ? (loB_px - loA_px) / (loB_bar - loA_bar) : na
    _gp = _ok ? tlUpNow - tlLoNow : na
    // positive = support gaining on resistance = converging
    _cv = _ok ? _ss - _rs : na
    [_ok, _rs, _ss, _gp, _cv]

[wgHave, wgResSl, wgSupSl, wgGap, wgConv] = f_wgCalc(wgFlat)
wgApexN  = wgHave and not na(wgConv) and wgConv > 0 and not na(wgGap) and wgGap > 0 ? wgGap / wgConv : na
wgApexOk = wgOn and not na(wgApexN) and wgApexN <= wgMaxBar
wgTol    = na(atrV) ? na : wgFlat * atrV
wgRFlat  = wgHave and not na(wgTol) and math.abs(wgResSl) <= wgTol
wgSFlat  = wgHave and not na(wgTol) and math.abs(wgSupSl) <= wgTol
// Named the way a chartist names them — by what the two slopes do, not by
// any forecast attached to the name.
wgType   = not wgOn or not wgHave ? "—" : wgApexOk ? (wgRFlat and wgSupSl > 0 ? "ASCENDING TRIANGLE" : wgSFlat and wgResSl < 0 ? "DESCENDING TRIANGLE" : wgResSl < 0 and wgSupSl > 0 ? "SYMMETRICAL TRIANGLE" : wgResSl < 0 and wgSupSl < 0 ? "FALLING WEDGE" : wgResSl > 0 and wgSupSl > 0 ? "RISING WEDGE" : "CONVERGING") : (not na(wgGap) and wgGap < 0 ? "APEX PASSED — lines crossed" : not na(wgConv) and wgConv < 0 ? "BROADENING" : "CHANNEL")
// wgGap is tlUpNow - tlLoNow, and it goes NEGATIVE once the two lines have
// crossed — the apex is behind us and the "resistance" now sits under the
// "support". Nothing downstream caught that: wgApexN is guarded by wgGap > 0
// so it went na, wgApexOk went false, and the classifier fell through to the
// channel branch. BTCUSD weekly printed "CHANNEL · gap -7.6%", which is wrong
// twice over — it is not a channel, and a gap cannot be negative. A crossed
// pair is a STALE structure waiting to re-anchor on the next swing, and it is
// now reported as exactly that.
wgCrossed = wgHave and not na(wgGap) and wgGap < 0
wgIsChan = not wgCrossed and (wgType == "CHANNEL" or wgType == "BROADENING")
wgPct    = wgHave and close > 0 and not wgCrossed ? wgGap / close * 100 : na
wgPos    = wgHave and not na(wgGap) and wgGap > 0 ? (close - tlLoNow) / wgGap * 100 : na

// ── THE EVENT: six sources, four of them already in this script ─────
boBrkUp = boOn and (suBaseBrk or suATHBrk or boBrkHorzUp or proBreakUp or tlBreakUp or buySignal)
boBrkDn = boOn and (boBrkHorzDn or proBreakDn or tlBreakDn or sellSignal)
// An int code rather than a `var string` written inside an if: Pine cannot
// assign to a global from inside a function, and everything here had to move
// into functions for CE10295. A code survives ta.valuewhen and is decoded for
// display, which needs no global write at all.
boKindCode = suATHBrk ? 6 : suBaseBrk ? 5 : boBrkHorzUp ? 4 : proBreakUp ? 3 : tlBreakUp ? 2 : buySignal ? 1 : boBrkHorzDn ? -4 : proBreakDn ? -3 : tlBreakDn ? -2 : sellSignal ? -1 : 0
boKindAt   = ta.valuewhen(boBrkUp or boBrkDn, boKindCode, 0)
boAgeUp = ta.barssince(boBrkUp)
boAgeDn = ta.barssince(boBrkDn)
boLiveUp = not na(boAgeUp) and boAgeUp <= boFresh and (na(boAgeDn) or boAgeUp < boAgeDn)
boLiveDn = not na(boAgeDn) and boAgeDn <= boFresh and (na(boAgeUp) or boAgeDn < boAgeUp)

// Captured AT the breakout bar — these describe the EVENT and are meaningless
// read off a later bar.
//
// WHY THIS DOES NOT USE volRatio, which is right there and looks correct.
//   volRatio substitutes the PREVIOUS finished bar whenever the live bar is
//   still filling, because a forming bar's volume is partial. Right for c4,
//   which describes the symbol NOW. Wrong here: k1 must describe the BREAKOUT
//   BAR, and a break firing on the live bar would be scored on the volume of
//   the bar BEFORE it. Observed on BRK.B weekly — a 9/10 setup with a 94%
//   close gated out by "0.86x volume" belonging to the previous week.
boVolOwn  = volAvg > 0 ? volume / volAvg : na
boVolAt   = ta.valuewhen(boBrkUp or boBrkDn, boVolOwn, 0)
boCloAt   = ta.valuewhen(boBrkUp or boBrkDn, (close - low) / math.max(high - low, syminfo.mintick), 0)
// The level that broke depends on WHICH line broke. Quoting the horizontal
// level after a trendline break would put the stop where nothing happened.
boLvlNow  = suATHBrk ? hiAll[1] : suBaseBrk ? suHi[1] : boBrkHorzUp ? boResRef : proBreakUp ? proResNow : tlBreakUp ? tlUpNow : boBrkHorzDn ? boSupRef : proBreakDn ? proSupNow : tlBreakDn ? tlLoNow : (buySignal or sellSignal) ? moneyLine : na
boLvlAt   = ta.valuewhen(boBrkUp or boBrkDn, nz(boLvlNow, close), 0)
boLiveBar = barstate.islast and time_close > timenow

// ── k1-k10: IS THIS BREAKOUT REAL ────────────────────────────────────
// Direction-aware, same discipline as c1-c9: in a breakdown the bearish
// reading is the PASS. Each check is one way a breakout fails, as a pass
// condition.
boDir = boLiveUp ? 1 : boLiveDn ? -1 : 0
k1  = na(boVolAt) ? false : boVolAt >= boVolSurge                                      // participation
k2  = na(boCloAt) ? false : (boDir >= 0 ? boCloAt >= 0.60 : boCloAt <= 0.40)           // closed strong, not rejected
k3  = na(rsiV)    ? false : (boDir >= 0 ? rsiV > 50 : rsiV < 50)                       // momentum on side
k4  = na(rsiV)    ? false : (boDir >= 0 ? rsiV < boRsiMax : rsiV > 100 - boRsiMax)     // not already spent
k5  = na(macdL) or na(macdS) ? false : (boDir >= 0 ? macdL > macdS : macdL < macdS)    // MACD crossed
k6  = na(macdH)   ? false : (boDir >= 0 ? macdH > 0 and macdH > macdH[1] : macdH < 0 and macdH < macdH[1])
k7  = boDir >= 0 ? trend == 1 : trend == -1                                            // ATR model agrees
k8  = na(ma200bar) ? false : (boDir >= 0 ? close > ma200bar : close < ma200bar)        // right side of the slow line
k9  = na(adxV)    ? false : adxV >= adxMin                                             // actually trending
k10 = na(ext200)  ? false : math.abs(ext200) <= extMax                                 // not stretched
boScore = (k1?1:0)+(k2?1:0)+(k3?1:0)+(k4?1:0)+(k5?1:0)+(k6?1:0)+(k7?1:0)+(k8?1:0)+(k9?1:0)+(k10?1:0)

// A partial bar can CONFIRM a pass — volume only goes up — but can never
// confirm a FAIL. Reporting "no volume" on a bar still filling is a false
// negative that would stand for days on a weekly chart, so an unsettled gate
// is PENDING: not an entry, and not a rejection.
boBrkAge    = boDir == 1 ? boAgeUp : boDir == -1 ? boAgeDn : na
boBrkUnconf = boDir != 0 and not na(boBrkAge) and boBrkAge == 0 and boLiveBar
boGate      = k1 and k2
boPending   = boBrkUnconf and not boGate
boAssess    = boDir != 0
boVerdict = not boOn ? "OFF" : thinHist ? "NO CALL — too little history" : boDir == 0 ? "NO SETUP" : boPending ? "PENDING — bar still forming" : boDir == 1 ? (boGate and boScore >= 8 ? "STRONG BUY" : boGate and boScore >= 6 ? "BUY" : boScore >= 6 ? "WATCH — no volume / weak close" : boScore >= 4 ? "WATCH" : "STAND ASIDE") : (boGate and boScore >= 8 ? "STRONG SELL" : boGate and boScore >= 6 ? "SELL" : boScore >= 6 ? "WATCH — no volume / weak close" : boScore >= 4 ? "WATCH" : "STAND ASIDE")
boActing  = boVerdict == "STRONG BUY" or boVerdict == "BUY" or boVerdict == "STRONG SELL" or boVerdict == "SELL"

// Trade geometry off the BROKEN LEVEL, not the Money Line: sizing a breakout
// off a regime stop 25% away turns 2% risk into 25%.
boEntry  = close
boStop   = boDir == 1 ? nz(boLvlAt, close) - boStopATR * atrV : boDir == -1 ? nz(boLvlAt, close) + boStopATR * atrV : na
boRisk   = na(boStop) ? na : math.abs(boEntry - boStop)
// On a chart making new highs there is no old level above to aim at, and that
// is exactly when a target is most needed. Fall back to the measured move.
// Three real references, in order of how directly price has transacted there,
// never an invented number. BTCUSD weekly sat in a confirmed long with no
// defended level overhead and no base, so Target read "— (no level beyond)"
// and R:R could not be computed at all — on a chart whose all-time high was
// plainly visible above. The ATH only qualifies while price is still under it.
boTgtATH = boDir == 1 and not na(hiAll) and hiAll > close * 1.005 ? hiAll : na
boTgtMA  = boDir == -1 and not na(ma200bar) and ma200bar < close * 0.995 ? ma200bar : na
boTarget = boDir == 1 ? nz(boRes, nz(suTgt1, boTgtATH)) : boDir == -1 ? nz(boSup, nz(suLo, boTgtMA)) : na
boTgtSrc = boDir == 1 and na(boRes) and not na(suTgt1) ? " (measured move)" : boDir == 1 and na(boRes) and na(suTgt1) and not na(boTgtATH) ? " (all-time high)" : boDir == -1 and na(boSup) and na(suLo) and not na(boTgtMA) ? " (200-bar mean)" : ""
boRR     = na(boTarget) or na(boRisk) or boRisk <= 0 ? na : math.abs(boTarget - boEntry) / boRisk
boSizePc = na(boRisk) or boEntry <= 0 or boRisk <= 0 ? na : riskPct / (boRisk / boEntry * 100) * 100

// ── THE FAST PAIR, THE EXTENSION, AND THE POLARITY FLIP ──────────────
// Three things on a posted chart that nothing above could produce.
//
// 1. 9 / 21 EMA. This file had no EMA at all — ma50/100/200 and the 200-bar
//    line are all SMAs, and all of them are SLOW. The pair momentum traders
//    actually read on a leader is the 9 and 21 EMA, which is why the chart
//    labels them by name. They are the line price rides on the way up and the
//    first thing it loses when the run ends.
//
// 2. ATR EXTENSION FROM THEM. ext200 above measures distance from the mean as
//    a PERCENT, which is not comparable across symbols — 10% is nothing on a
//    high-ATR name and a lot on a utility. Measured in ATR it is the same
//    statement everywhere: "1.5 ATR above the 21 EMA" means the same thing on
//    any chart. Past about 3-4 ATR a move is extended and a new entry there is
//    paying for someone else's position.
//
// 3. RESISTANCE TURNED INTO SUPPORT — the line you labelled by hand, and the
//    one genuinely missing idea here. A level only becomes interesting TWICE:
//    once when it caps price, and again, from underneath, after price has
//    taken it. The script knew about defended levels and knew when one broke,
//    but threw the level away the moment it was taken. It is kept now: the
//    most recent level broken upward is carried forward as support for as
//    long as price stays above it, and the console says whether price has
//    come back to test it or has simply run.
//
//    A retest that HOLDS is the lowest-risk entry on any of these charts,
//    because the stop is a few percent away instead of back at the base. A
//    level that has never been retested is not worse — it is just unproven,
//    and the console says which it is rather than pretending to know.
emaFastLen = input.int(9,  "Fast EMA", minval = 2, maxval = 50, group = "9. Fast pair & polarity")
emaSlowLen = input.int(21, "Slow EMA", minval = 3, maxval = 100, group = "9. Fast pair & polarity")
emaAtrLen  = input.int(11, "ATR length for the extension reading", minval = 2, maxval = 50, tooltip = "Shorter than the 21 used by the Money Line, because this measures how stretched price is RIGHT NOW rather than how wide to set a regime stop.", group = "9. Fast pair & polarity")
emaExtMax  = input.float(3.0, "Extended beyond this many ATR from the slow EMA", minval = 0.5, maxval = 10.0, step = 0.25, tooltip = "Past this the move is stretched and a fresh entry is paying for someone else's position. It is a warning on the LINES SAY row, never a sell signal — leaders stay extended for a long time.", group = "9. Fast pair & polarity")
emaShow    = input.bool(true, "Plot the fast pair", group = "9. Fast pair & polarity")

f_emaExt(int _f, int _s, int _a) =>
    _e9  = ta.ema(close, _f)
    _e21 = ta.ema(close, _s)
    _at  = ta.atr(_a)
    _x9  = _at > 0 ? (close - _e9) / _at : na
    _x21 = _at > 0 ? (close - _e21) / _at : na
    // how long the trend has actually held its line — persistence, not slope
    _ba  = ta.barssince(close < _e21)
    [_e9, _e21, _at, _x9, _x21, _ba]

[emaF, emaS, emaAtr, emaX9, emaX21, emaBarsAbove] = f_emaExt(emaFastLen, emaSlowLen, emaAtrLen)
emaAtrPct = close > 0 and not na(emaAtr) ? emaAtr / close * 100 : na
// Your reference panel quotes BOTH ("21 EMA 884.31  24.77%" next to
// "1.46x above"), and both earn their place: the percent is what you feel in
// the P&L, the ATR multiple is what lets you compare this chart with the next.
emaPctF = not na(emaF) and emaF > 0 ? (close - emaF) / emaF * 100 : na
emaPctS = not na(emaS) and emaS > 0 ? (close - emaS) / emaS * 100 : na
emaOver   = not na(emaX21) and emaX21 >= emaExtMax

// The most recent level taken to the upside, carried forward. valuewhen keeps
// it without a `var` write, which matters because everything here had to move
// into functions for CE10295 and Pine cannot assign to a global from one.
boFlipLvl = ta.valuewhen(boBrkHorzUp or suBaseBrk or suATHBrk, nz(boLvlNow, close), 0)
boFlipOn  = not na(boFlipLvl) and close > boFlipLvl
// Retested = price has since traded back down into it and still closed above.
// Tracked as a count of bars whose LOW reached the level while the close held.
boFlipTag = boFlipOn and low <= boFlipLvl * 1.015 and close > boFlipLvl
// Hoisted and na-guarded rather than inlined: ta.barssince returns na until
// its condition has fired once, and `na < x` is na, not false — a na bool
// propagating into the LINES SAY ladder would silently skip a branch.
boFlipAgo = ta.barssince(boFlipTag)
boBrkAgoU = ta.barssince(boBrkHorzUp or suBaseBrk or suATHBrk)
boFlipRe  = boFlipOn and not na(boFlipAgo) and not na(boBrkAgoU) and boFlipAgo < boBrkAgoU
boFlipPct = boFlipOn and close > 0 ? (close - boFlipLvl) / close * 100 : na

// ── THE WEEKLY 9 EMA RULE ────────────────────────────────────────────
// A named, testable method rather than another indicator: enter as close to
// the weekly 9 EMA as possible, judge it on the WEEKLY CLOSE, and ignore the
// daily noise in between. Reclaiming it is the entry; losing it on a weekly
// close is the exit; pulling back INTO it and closing above is the lowest-risk
// add there is.
//
// WHY IT IS ANCHORED IN WEEKS AND NOT TO THE CHART
//   The whole point of the method is to ZOOM OUT, so a 9 EMA that silently
//   becomes a 9-BAR EMA on a 15-minute chart would invert it — you would be
//   reacting to exactly the noise it exists to ignore. The length is therefore
//   specified in WEEKS and converted through f_daysToBars, which this file
//   already uses for the same reason.
//
//   HONEST ABOUT THE APPROXIMATION. On a WEEKLY chart this is exactly the
//   weekly 9 EMA — f_daysToBars(45) returns 9. On a DAILY chart it returns 45,
//   a span-matched 45-day EMA: very close, but not identical, because an EMA
//   of daily closes samples differently from an EMA of weekly closes. The true
//   series would need a request.security call, and this file already uses
//   exactly 40 of the 40 allowed (32 focus list + daily + weekly + 6
//   financials) — one more breaks the whole script, not just this row. The
//   console says which of the two you are looking at rather than letting you
//   assume.
//
// AND IT IS AN ADAPTATION, NOT A LAW. Its author put it forward as what works
// when a market is hitting stops left and right; it is a way to stop being
// shaken out of names that are still fine. In a trending market a tighter
// stop may well do better. The row reports the state and does not override the
// Money Line, the gate or k1-k10.
profOn    = input.bool(true, "Weekly 9 EMA rule (reclaim / respect / lose)", group = "10. Weekly 9 EMA rule")
profWeeks = input.int(9, "EMA length in WEEKS (not bars)", minval = 2, maxval = 52, tooltip = "Converted to bars for whatever chart you are on, so it stays a NINE-WEEK average everywhere. On a weekly chart that is exactly a 9 EMA; on daily it becomes a 45-day EMA covering the same span.", group = "10. Weekly 9 EMA rule")
profNear  = input.float(0.5, "'At the line' = within this many ATR of it", minval = 0.1, maxval = 3.0, step = 0.1, tooltip = "The method asks for an entry as close to the line as possible, because that is what makes the stop small. Inside this distance the console calls it an entry; beyond it, a wait.", group = "10. Weekly 9 EMA rule")
profShow  = input.bool(true, "Plot the weekly 9 EMA", group = "10. Weekly 9 EMA rule")

f_prof(int _wk, float _atr) =>
    _len = f_daysToBars(_wk * 5)
    _e   = ta.ema(close, _len)
    _ab  = close > _e
    // every test is on the CLOSE. A wick through the line is not a loss of it,
    // which is the entire point of judging this on the weekly close.
    _rec = _ab and not _ab[1]
    _los = not _ab and _ab[1]
    _res = _ab and low <= _e
    _bars = ta.barssince(not _ab)
    _px   = ta.valuewhen(_rec, close, 0)
    _dist = not na(_atr) and _atr > 0 ? (close - _e) / _atr : na
    [_len, _e, _ab, _rec, _los, _res, _bars, _px, _dist]

[profLen, profEma, profAbove, profReclaim, profLost, profRespect, profBars, profRecPx, profDist] = f_prof(profWeeks, emaAtr)
profExact = timeframe.isweekly
profGain  = profAbove and not na(profRecPx) and profRecPx > 0 ? (close - profRecPx) / profRecPx * 100 : na
profAtLine = profAbove and not na(profDist) and profDist <= profNear
profPct   = not na(profEma) and profEma > 0 ? (close - profEma) / profEma * 100 : na

// ── DRAWING — every object this section owns lives in one of three arrays ──
// Pine cannot assign to a global inside a function, so `var line x = na` +
// `x := line.new(...)` cannot be wrapped and would have to stay in the main
// body. Arrays are reference types and CAN be mutated inside a function, so
// the drawables go in arrays, wiped and repopulated on the last bar.
var array<line>  boLn = array.new<line>()
var array<label> boLb = array.new<label>()
var array<box>   boBx = array.new<box>()
var array<line>  boVt = array.new<line>()

f_wipe(array<line> _l, array<label> _b, array<box> _x) =>
    if array.size(_l) > 0
        for i = 0 to array.size(_l) - 1
            line.delete(array.get(_l, i))
        array.clear(_l)
    if array.size(_b) > 0
        for i = 0 to array.size(_b) - 1
            label.delete(array.get(_b, i))
        array.clear(_b)
    if array.size(_x) > 0
        for i = 0 to array.size(_x) - 1
            box.delete(array.get(_x, i))
        array.clear(_x)
    0

f_boDraw(array<line> _l, array<label> _b, array<box> _x) =>
    // defended horizontals, labelled with how many times they held
    if boShowLvl and not na(boRes)
        array.push(_l, line.new(bar_index - 100, boRes, bar_index + 12, boRes, extend = extend.right, color = color.new(#ff5252, 0), width = 2))
        array.push(_b, label.new(bar_index + 12, boRes, "DEFENDED R " + str.tostring(boRes, format.mintick) + "  ·  " + str.tostring(boResHit, "#") + " touches", style = label.style_label_left, color = color.new(#ff5252, 25), textcolor = color.white, size = size.tiny))
    if boShowLvl and not na(boSup)
        array.push(_l, line.new(bar_index - 100, boSup, bar_index + 12, boSup, extend = extend.right, color = color.new(#00e676, 0), width = 2))
        array.push(_b, label.new(bar_index + 12, boSup, "DEFENDED S " + str.tostring(boSup, format.mintick) + "  ·  " + str.tostring(boSupHit, "#") + " touches", style = label.style_label_left, color = color.new(#00e676, 25), textcolor = color.white, size = size.tiny))
    // the base box — the SNOW / PLTR rectangle. A box and not two lines
    // because the DURATION is as much the point as the price.
    if suOn and suShowBox and suIsBase and not na(suHi) and not na(suLo)
        array.push(_x, box.new(bar_index - suBars + 1, suHi, bar_index, suLo, border_color = color.new(#00bcd4, 20), border_width = 2, bgcolor = color.new(#00bcd4, 92), text = str.tostring(suBars, "#") + "-bar base  ·  " + str.tostring(f_suW(suHi, suLo), "#.#") + "% wide", text_color = color.new(#00bcd4, 0), text_size = size.small, text_halign = text.align_center, text_valign = text.align_top))
    if suOn and suShowTgt and suIsBase and not na(suTgt1)
        array.push(_l, line.new(bar_index - suBars + 1, suTgt1, bar_index + 12, suTgt1, extend = extend.right, color = color.new(#9c27b0, 25), style = line.style_dashed, width = 1))
        array.push(_b, label.new(bar_index + 12, suTgt1, "T1 " + str.tostring(suTgt1, format.mintick) + "  (1.0x base)", style = label.style_label_left, color = color.new(#9c27b0, 30), textcolor = color.white, size = size.tiny))
        array.push(_l, line.new(bar_index - suBars + 1, suTgt2, bar_index + 12, suTgt2, extend = extend.right, color = color.new(#9c27b0, 55), style = line.style_dashed, width = 1))
        array.push(_b, label.new(bar_index + 12, suTgt2, "T2 " + str.tostring(suTgt2, format.mintick) + "  (1.618x)", style = label.style_label_left, color = color.new(#9c27b0, 55), textcolor = color.white, size = size.tiny))
    // the all-time high: the only level with no overhead supply behind it
    if suOn and suShowATH and not na(hiAll)
        array.push(_l, line.new(bar_index - 100, hiAll, bar_index + 12, hiAll, extend = extend.right, color = color.new(#ffc107, 20), style = line.style_dotted, width = 2))
        array.push(_b, label.new(bar_index + 12, hiAll, (suNewATH ? "AT ALL-TIME HIGH " : "ATH ") + str.tostring(hiAll, format.mintick), style = label.style_label_left, color = color.new(#ffc107, 25), textcolor = color.black, size = size.tiny))
    // the converging pair, drawn TO the apex and stopped there. Not
    // extend.right: a wedge has a natural right-hand end where the lines
    // cross, and stopping there keeps a steep projection off the axis.
    if wgOn and wgHave and wgApexOk
        // int(): math.round() returns a float and line.new needs a series int
        wgApexBar = bar_index + int(math.round(wgApexN))
        wgApexPx  = tlUpNow + wgResSl * wgApexN
        array.push(_l, line.new(hiB_bar, hiB_px, wgApexBar, wgApexPx, color = color.new(#2962ff, 0), width = 2))
        array.push(_l, line.new(loB_bar, loB_px, wgApexBar, wgApexPx, color = color.new(#2962ff, 0), width = 2))
        array.push(_b, label.new(wgApexBar, wgApexPx, wgType + "\napex in " + str.tostring(wgApexN, "#") + " bars", style = label.style_label_left, color = color.new(#2962ff, 20), textcolor = color.white, size = size.tiny))
    // a channel gets three rails, which is the shape people actually draw
    if wgOn and wgHave and wgIsChan
        array.push(_l, line.new(hiB_bar, hiB_px, bar_index + 15, tlUpNow + wgResSl * 15, color = color.new(#2962ff, 15), width = 2))
        array.push(_l, line.new(loB_bar, loB_px, bar_index + 15, tlLoNow + wgSupSl * 15, color = color.new(#2962ff, 15), width = 2))
        if wgShowMid
            wgMidSl = (wgResSl + wgSupSl) / 2
            wgMidNw = (tlUpNow + tlLoNow) / 2
            array.push(_l, line.new(bar_index - 40, wgMidNw - wgMidSl * 40, bar_index + 15, wgMidNw + wgMidSl * 15, color = color.new(#2962ff, 45), style = line.style_dashed, width = 1))
    // the line you labelled by hand
    if boFlipOn and boShowLvl
        array.push(_l, line.new(bar_index - 60, boFlipLvl, bar_index + 12, boFlipLvl, extend = extend.right, color = color.new(#2962ff, 10), width = 2))
        array.push(_b, label.new(bar_index + 12, boFlipLvl, "Resistance turned into support  " + str.tostring(boFlipLvl, format.mintick) + (boFlipRe ? "  ✓ retested" : "  · untested"), style = label.style_label_left, color = color.new(#2962ff, 25), textcolor = color.white, size = size.tiny))
    if boActing
        array.push(_b, label.new(bar_index, boDir == 1 ? low : high, boVerdict + "  " + str.tostring(boScore, "#") + "/10", style = boDir == 1 ? label.style_label_up : label.style_label_down, color = boDir == 1 ? color.new(#00c853, 0) : color.new(#d50000, 0), textcolor = color.white, size = size.normal))
    0

f_boVert(array<line> _v) =>
    array.push(_v, line.new(bar_index, low, bar_index, high + syminfo.mintick, extend = extend.both, color = boBrkUp ? color.new(#00e676, 55) : color.new(#ff1744, 55), style = line.style_dotted, width = 1))
    if array.size(_v) > 12
        line.delete(array.shift(_v))
    0

plot(profOn and profShow and not syncMode ? profEma : na, "Weekly 9 EMA", color = color.new(#ffd600, 0), linewidth = 3)
plot(emaShow and not syncMode ? emaF : na, "Fast EMA", color = color.new(#ff5252, 10), linewidth = 2)
plot(emaShow and not syncMode ? emaS : na, "Slow EMA", color = color.new(color.gray, 10), linewidth = 2)
plotshape(boBrkHorzUp, "BO — defended level", style = shape.triangleup,   location = location.belowbar, color = color.new(#00e676, 0), size = size.small, text = "BO", textcolor = color.new(#00e676, 0))
plotshape(boBrkHorzDn, "BD — defended level", style = shape.triangledown, location = location.abovebar, color = color.new(#ff1744, 0), size = size.small, text = "BD", textcolor = color.new(#ff1744, 0))

if boOn and boShowVert and (boBrkUp or boBrkDn) and barstate.isconfirmed
    f_boVert(boVt)
if barstate.islast
    f_wipe(boLn, boLb, boBx)
if barstate.islast and boOn and not syncMode
    f_boDraw(boLn, boLb, boBx)

// ── THE CONSOLE ──────────────────────────────────────────────────────
// Reading a global inside a function is allowed; only ASSIGNING to one is
// not. table.cell() on a global table is a call, so the whole console fits
// in a function and costs the main body a single statement.
f_boKind(float _c) => _c == 6 ? "ALL-TIME HIGH" : _c == 5 ? "BASE BREAKOUT" : _c == 4 ? "DEFENDED LEVEL" : _c == 3 ? "PRO TRENDLINE" : _c == 2 ? "SWING TRENDLINE" : _c == 1 ? "ATR MONEY LINE" : _c == -4 ? "DEFENDED LEVEL" : _c == -3 ? "PRO TRENDLINE" : _c == -2 ? "SWING TRENDLINE" : _c == -1 ? "ATR MONEY LINE" : "—"
// NO SETUP is not the same as FAILED. With boDir == 0 the k-checks still
// evaluate (boDir >= 0 takes the long arm), so without this the console
// printed a red "FAILED" gate and red rows describing a breakout that never
// happened — seen on TCS weekly, "nothing broke in the last 3 bars" above
// six red rows.
f_boTick(bool _v) => not boAssess ? "·" : _v ? "✓" : "✗"
f_boCol(bool _v)  => not boAssess ? color.new(color.gray, 60) : _v ? color.new(#00c853, 55) : color.new(#d50000, 55)
f_boTxt(bool _v, string _s) => not boAssess ? "—" : _s

// The method's own branches fire on price-vs-line alone, which is correct for
// the method but incomplete as advice. On TSLA weekly it read "AT THE 9-WEEK
// EMA — this is where the method wants you in" while the ATR model was BEAR,
// MODELS said SPLIT, ADX was 11 and the gate had failed on volume. Its author
// uses that line to HOLD winners and re-enter reclaims, not to buy into a dead
// tape. The branches still fire — this just refuses to let them read clean.
f_emaCaveat() =>
    _c = ""
    if trend == -1
        _c := "  ⚠ but the ATR model is BEARISH — this is a scout entry against the regime, half size at most."
    else if not na(adxV) and adxV < adxMin
        _c := "  ⚠ but ADX is " + str.tostring(adxV, "#.#") + " — no trend to ride yet, so expect chop."
    // GOOGL weekly sat at the line with a SYMMETRICAL TRIANGLE three bars from
    // its apex and a squeeze on. "Buy near the line" was true and badly
    // incomplete: a decision was three bars away and the row never said so,
    // because the structure branch sits ten rungs below the method branch and
    // never gets reached. Timing is not a caveat about size, so it is added
    // even when the regime is clean.
    else if wgApexOk and not na(wgApexN) and wgApexN <= 5
        _c := "  ⏱ and a " + wgType + " resolves in " + str.tostring(wgApexN, "#") + " bars — size for either outcome, not just this one."
    else if suOn and suSqz
        _c := "  ⏱ and the squeeze is on — expect the range to expand soon, in whichever direction."
    _c

// ── WHAT THE LINES SAY ───────────────────────────────────────────────
// One sentence, read ONLY from structure — where price sits against the
// levels, the flip, the base and the fast pair. It deliberately does not
// consult RSI, MACD or ADX: those already have rows, and the question this
// answers is "given the lines, what do I do", which is the question a posted
// chart answers and this script never did.
//
// Ordered by RISK, not by how exciting the setup is. A retest that holds is
// first because its stop is a few percent away; a fresh breakout is second
// because its stop is the broken level; an extended chart is a WAIT however
// strong it looks, since the stop there is far enough to ruin the arithmetic.
f_linesSay() =>
    _r = ""
    if not boOn
        _r := "console off"
    else if thinHist
        _r := "too little history to read the lines"
    else if profOn and profLost
        _r := "LOST THE " + str.tostring(profWeeks, "#") + "-WEEK EMA on this close (" + str.tostring(profEma, format.mintick) + "). That is the exit for this method — a wick through it was not, this close is."
    else if profOn and profReclaim
        _r := "RECLAIMED THE " + str.tostring(profWeeks, "#") + "-WEEK EMA at " + str.tostring(profEma, format.mintick) + ". This is the entry: buy near the line, exit on a close back under it." + f_emaCaveat()
    else if profOn and profRespect and not emaOver
        _r := "RESPECTED THE " + str.tostring(profWeeks, "#") + "-WEEK EMA — wicked into " + str.tostring(profEma, format.mintick) + " and closed above. Lowest-risk add there is; stop on a close below." + f_emaCaveat()
    else if profOn and profAtLine and not emaOver
        _r := "AT THE " + str.tostring(profWeeks, "#") + "-WEEK EMA (" + str.tostring(profDist, "#.#") + "x ATR from it). This is where the method wants you in, because the stop is small here." + f_emaCaveat()
    else if boFlipOn and boFlipRe and not emaOver and not na(boFlipPct) and boFlipPct <= 8
        _r := "BUY THE RETEST — " + str.tostring(boFlipLvl, format.mintick) + " was resistance, held as support, price " + str.tostring(boFlipPct, "#.#") + "% above it. Stop just under it: the tightest entry on this chart."
    else if boDir == 1 and boGate and boScore >= 6
        _r := "BUY THE BREAK of " + f_boKind(boKindAt) + " at " + str.tostring(boLvlAt, format.mintick) + ". Stop " + str.tostring(boStop, format.mintick) + (na(boTarget) ? "" : ", first target " + str.tostring(boTarget, format.mintick)) + "."
    // The short side was missing entirely: every breakout branch tested
    // boDir == 1, so a live SELL fell through all of them and landed on the
    // base branch. Seen on NIFTYBEES weekly — "STRONG SELL" in the header
    // sitting above "IN A 50-BAR BASE, wait" at the bottom. A verdict and a
    // reading that contradict each other are worse than either one alone.
    else if boDir == -1 and boGate and boScore >= 6
        _r := "SELL / STAY OUT — " + f_boKind(boKindAt) + " broke DOWN at " + str.tostring(boLvlAt, format.mintick) + ". If you are long, that was the exit. Do not buy the dip while this holds; the level to reclaim is " + str.tostring(boLvlAt, format.mintick) + "."
    else if boDir == -1
        _r := "BREAKING DOWN (" + f_boKind(boKindAt) + ") on only " + str.tostring(boScore, "#") + "/10. Stand aside — not a long setup, and not yet a clean short."
    else if boDir == 1 and boPending
        _r := "A LEVEL IS GIVING WAY but the bar has not closed. Nothing to do until it does."
    else if emaOver
        _r := "EXTENDED — " + str.tostring(emaX21, "#.#") + " ATR above the " + str.tostring(emaSlowLen, "#") + " EMA. Do not start here; wait for a pullback toward " + str.tostring(emaS, format.mintick) + "."
    else if boFlipOn and not boFlipRe
        _r := "ABOVE A BROKEN LEVEL at " + str.tostring(boFlipLvl, format.mintick) + ", not yet retested. Either buy a pullback into it or stand aside — chasing here has no close stop."
    else if suIsBase and suSqz
        _r := "COILED — " + str.tostring(suBars, "#") + "-bar base and a volatility squeeze. Nothing to do yet; set an alert at " + str.tostring(suHi, format.mintick) + "."
    else if suIsBase
        _r := "IN A " + str.tostring(suBars, "#") + "-BAR BASE. The decision is a close above " + str.tostring(suHi, format.mintick) + " or below " + str.tostring(suLo, format.mintick) + "."
    else if not na(emaS) and close < emaS and trend == -1
        _r := "BELOW THE " + str.tostring(emaSlowLen, "#") + " EMA and below the Money Line. No long setup — this is a downtrend, not a dip."
    else if wgApexOk
        _r := wgType + " closing in " + str.tostring(wgApexN, "#") + " bars. Wait for the resolution; do not pre-position inside a coil."
    else if not na(boRes)
        _r := "NO SETUP. Next decision is " + str.tostring(boRes, format.mintick) + " overhead (" + str.tostring((boRes - close) / close * 100, "#.#") + "% away)" + (na(boSup) ? "." : ", support " + str.tostring(boSup, format.mintick) + ".")
    else
        _r := "NO SETUP and no defended level above — price is in open air. Wait for structure to form."
    _r

// ── WHAT TO DO ───────────────────────────────────────────────────────
// LINES SAY explains the READING. This is the INSTRUCTION, with the numbers
// already filled in, so the row can be acted on without doing arithmetic off
// the other rows. Kept separate deliberately: a sentence that both explains
// and instructs ends up doing neither well, and the instruction is the part
// you want at a glance.
//
// Ordered so EXITS come before entries, and an unfinished bar outranks both:
// acting on a level that has not closed is the single most expensive mistake
// this console can invite.
f_whatToDo() =>
    _a = ""
    if not boOn
        _a := "—"
    else if thinHist
        _a := "DO NOTHING — only " + str.tostring(histDays, "#") + " days of history. Nothing here is trustworthy yet."
    else if boPending or boBrkUnconf
        _a := "WAIT for this bar to close. A level is giving way intrabar and it can still un-happen."
    else if profOn and profLost
        _a := "EXIT. Close is below the " + str.tostring(profWeeks, "#") + "-week EMA (" + str.tostring(profEma, format.mintick) + "). Re-entry only on a close back above it."
    else if boDir == -1 and boGate and boScore >= 6
        _a := "EXIT / STAY OUT. Stop for a short " + str.tostring(boStop, format.mintick) + (na(boTarget) ? "" : ", target " + str.tostring(boTarget, format.mintick)) + ". Do not buy until a close back above " + str.tostring(boLvlAt, format.mintick) + "."
    else if boDir == 1 and boGate and boScore >= 6
        _a := "BUY " + (na(boSizePc) ? "" : str.tostring(math.min(boSizePc, 100), "#.#") + "% of account at " + str.tostring(riskPct, "#.#") + "% risk") + ". Stop " + str.tostring(boStop, format.mintick) + (na(boTarget) ? "" : ", first target " + str.tostring(boTarget, format.mintick) + (na(boRR) ? "" : " (R:R " + str.tostring(boRR, "#.##") + ")")) + "."
    else if profOn and (profReclaim or profRespect or profAtLine) and not emaOver
        _a := (trend == -1 ? "HALF SIZE AT MOST near " : "BUY near ") + str.tostring(profEma, format.mintick) + " — the " + str.tostring(profWeeks, "#") + "-week EMA. Stop on a CLOSE below it." + (trend == -1 ? " The ATR model is bearish, so this is a scout entry against the regime." : " Size up here because the stop is close.")
    else if boFlipOn and boFlipRe and not emaOver
        _a := "BUY the retest of " + str.tostring(boFlipLvl, format.mintick) + ". Stop just under it — tightest stop available on this chart."
    else if emaOver
        _a := "DO NOT START HERE. " + str.tostring(emaX21, "#.#") + " ATR above the " + str.tostring(emaSlowLen, "#") + " EMA. Hold what you have; add only back near " + str.tostring(emaS, format.mintick) + "."
    else if suIsBase
        _a := "DO NOTHING. Set two alerts: above " + str.tostring(suHi, format.mintick) + " and below " + str.tostring(suLo, format.mintick) + ". Act on whichever closes first."
    else if trend == 1
        _a := "HOLD. Only act if a " + tfWord + " candle CLOSES below " + str.tostring(moneyLine, format.mintick) + "."
    else
        _a := "STAY OUT. Your only entry trigger is a " + tfWord + " close above " + str.tostring(moneyLine, format.mintick) + " (" + str.tostring((moneyLine - close) / close * 100, "#.#") + "% away)."
    _a

boPosMap = boPos == "Top Right" ? position.top_right : boPos == "Top Left" ? position.top_left : boPos == "Middle Right" ? position.middle_right : boPos == "Bottom Left" ? position.bottom_left : position.bottom_right
var table bot = table.new(boPosMap, 2, 26, border_width = 2)

f_boConsole(table _t) =>
    table.clear(_t, 0, 0, 1, 25)
    vCol = boVerdict == "STRONG BUY" ? color.new(#00c853, 0) : boVerdict == "BUY" ? color.new(#00c853, 30) : boVerdict == "STRONG SELL" ? color.new(#d50000, 0) : boVerdict == "SELL" ? color.new(#d50000, 30) : boVerdict == "NO SETUP" ? color.new(color.gray, 40) : color.new(color.orange, 25)
    table.cell(_t, 0, 0, "BREAKOUT", text_color = color.white, bgcolor = color.new(color.black, 0), text_halign = text.align_left, text_size = txtSize)
    table.cell(_t, 1, 0, boVerdict + (boDir == 0 ? "" : "   " + str.tostring(boScore, "#") + "/10"), text_color = color.white, bgcolor = vCol, text_halign = text.align_center, text_size = txtSize)
    // WHAT TO DO sits at row 1, immediately under the verdict, and not at the
    // bottom where it was. The console is 26 rows tall; on SPX weekly at Small
    // text it ran off the bottom of the chart and the single most important
    // row was the one you could not see. Order by importance, not by the order
    // the features were written.
    table.cell(_t, 0, 1, "▶ WHAT TO DO", text_color = color.white, bgcolor = color.new(color.black, 0), text_halign = text.align_left, text_size = txtSize)
    table.cell(_t, 1, 1, f_whatToDo(), text_color = color.white, bgcolor = boDir == 1 and boGate ? color.new(#00c853, 15) : boDir == -1 and boGate ? color.new(#d50000, 15) : boPending or boBrkUnconf ? color.new(color.orange, 25) : color.new(#004d40, 10), text_halign = text.align_left, text_size = txtSize)
    what = boDir == 0 ? "nothing broke in the last " + str.tostring(boFresh, "#") + " bars" : f_boKind(boKindAt) + "  ·  " + str.tostring(boBrkAge, "#") + " bar(s) ago" + (boBrkUnconf ? "   ⧗ BAR NOT CLOSED" : "")
    table.cell(_t, 0, 2, "What broke", text_color = color.white, bgcolor = color.new(color.black, 20), text_halign = text.align_left, text_size = txtSize)
    table.cell(_t, 1, 2, what, text_color = color.white, bgcolor = color.new(color.black, 40), text_halign = text.align_center, text_size = txtSize)
    table.cell(_t, 0, 3, "Level", text_color = color.white, bgcolor = color.new(color.black, 20), text_halign = text.align_left, text_size = txtSize)
    table.cell(_t, 1, 3, na(boLvlAt) or boDir == 0 ? "—" : str.tostring(boLvlAt, format.mintick) + "   (now " + str.tostring(close, format.mintick) + ")", text_color = color.white, bgcolor = color.new(color.black, 40), text_halign = text.align_center, text_size = txtSize)
    table.cell(_t, 0, 4, "GATE  vol + close", text_color = color.white, bgcolor = color.new(color.teal, 10), text_halign = text.align_left, text_size = txtSize)
    table.cell(_t, 1, 4, not boAssess ? "— nothing to assess" : boGate ? "✓ PASSED" : boPending ? "⧗ NOT SETTLED — bar still filling" : "✗ FAILED — not an entry at any score", text_color = color.white, bgcolor = not boAssess ? color.new(color.gray, 60) : boGate ? f_boCol(true) : boPending ? color.new(color.orange, 35) : f_boCol(false), text_halign = text.align_center, text_size = txtSize)
    table.cell(_t, 0, 5, f_boTick(k1) + " Volume surge", text_color = color.white, bgcolor = color.new(color.black, 20), text_halign = text.align_left, text_size = txtSize)
    table.cell(_t, 1, 5, f_boTxt(k1, na(boVolAt) ? "—" : str.tostring(boVolAt, "#.##") + "x   (need " + str.tostring(boVolSurge, "#.##") + "x)" + (boBrkUnconf and not k1 ? "  ⧗ still filling" : "")), text_color = color.white, bgcolor = k1 ? f_boCol(true) : boBrkUnconf ? color.new(color.orange, 35) : f_boCol(false), text_halign = text.align_center, text_size = txtSize)
    table.cell(_t, 0, 6, f_boTick(k2) + " Close strength", text_color = color.white, bgcolor = color.new(color.black, 20), text_halign = text.align_left, text_size = txtSize)
    table.cell(_t, 1, 6, f_boTxt(k2, na(boCloAt) ? "—" : str.tostring(boCloAt * 100, "#") + "% of the bar's range"), text_color = color.white, bgcolor = f_boCol(k2), text_halign = text.align_center, text_size = txtSize)
    table.cell(_t, 0, 7, f_boTick(k3 and k4) + " RSI", text_color = color.white, bgcolor = color.new(color.black, 20), text_halign = text.align_left, text_size = txtSize)
    table.cell(_t, 1, 7, na(rsiV) ? "—" : str.tostring(rsiV, "#.#") + (not boAssess ? "" : (k4 ? "" : "  ⚠ spent") + (k3 ? "" : "  ⚠ wrong side of 50")), text_color = color.white, bgcolor = f_boCol(k3 and k4), text_halign = text.align_center, text_size = txtSize)
    table.cell(_t, 0, 8, f_boTick(k5 and k6) + " MACD", text_color = color.white, bgcolor = color.new(color.black, 20), text_halign = text.align_left, text_size = txtSize)
    table.cell(_t, 1, 8, na(macdH) ? "—" : (k5 ? "cross ✓" : "cross ✗") + "    " + (k6 ? "thrust expanding ✓" : "thrust flat / fading ✗"), text_color = color.white, bgcolor = f_boCol(k5 and k6), text_halign = text.align_center, text_size = txtSize)
    table.cell(_t, 0, 9, f_boTick(k7) + " ATR Money Line", text_color = color.white, bgcolor = color.new(color.black, 20), text_halign = text.align_left, text_size = txtSize)
    table.cell(_t, 1, 9, (trend == 1 ? "▲ bull" : "▼ bear") + (not boAssess ? "" : k7 ? "  — agrees" : "  — DISAGREES (scout entry)"), text_color = color.white, bgcolor = f_boCol(k7), text_halign = text.align_center, text_size = txtSize)
    table.cell(_t, 0, 10, f_boTick(k8) + " 200-bar mean", text_color = color.white, bgcolor = color.new(color.black, 20), text_halign = text.align_left, text_size = txtSize)
    table.cell(_t, 1, 10, na(ma200bar) ? "—" : str.tostring(ma200bar, format.mintick), text_color = color.white, bgcolor = f_boCol(k8), text_halign = text.align_center, text_size = txtSize)
    table.cell(_t, 0, 11, f_boTick(k9) + " ADX trending", text_color = color.white, bgcolor = color.new(color.black, 20), text_halign = text.align_left, text_size = txtSize)
    table.cell(_t, 1, 11, na(adxV) ? "—" : str.tostring(adxV, "#.#") + "   (need " + str.tostring(adxMin, "#") + ")", text_color = color.white, bgcolor = f_boCol(k9), text_halign = text.align_center, text_size = txtSize)
    table.cell(_t, 0, 12, f_boTick(k10) + " Not over-extended", text_color = color.white, bgcolor = color.new(color.black, 20), text_halign = text.align_left, text_size = txtSize)
    table.cell(_t, 1, 12, na(ext200) ? "—" : f_pc(ext200) + " from the mean   (max " + str.tostring(extMax, "#") + "%)", text_color = color.white, bgcolor = f_boCol(k10), text_halign = text.align_center, text_size = txtSize)
    table.cell(_t, 0, 13, "Entry / Stop", text_color = color.white, bgcolor = color.new(color.navy, 10), text_halign = text.align_left, text_size = txtSize)
    table.cell(_t, 1, 13, boDir == 0 or na(boStop) ? "—" : str.tostring(boEntry, format.mintick) + "  /  " + str.tostring(boStop, format.mintick) + "   (" + str.tostring(boRisk / boEntry * 100, "#.#") + "% risk)", text_color = color.white, bgcolor = color.new(color.navy, 35), text_halign = text.align_center, text_size = txtSize)
    table.cell(_t, 0, 14, "Target / R:R", text_color = color.white, bgcolor = color.new(color.navy, 10), text_halign = text.align_left, text_size = txtSize)
    table.cell(_t, 1, 14, na(boRR) ? "— (no level beyond)" : str.tostring(boTarget, format.mintick) + boTgtSrc + "    R:R " + str.tostring(boRR, "#.##") + (boRR < 1.5 ? "  ⚠ thin" : ""), text_color = color.white, bgcolor = na(boRR) or boRR < 1.5 ? color.new(color.orange, 35) : color.new(color.navy, 35), text_halign = text.align_center, text_size = txtSize)
    table.cell(_t, 0, 15, "Size at " + str.tostring(riskPct, "#.#") + "% risk", text_color = color.white, bgcolor = color.new(color.navy, 10), text_halign = text.align_left, text_size = txtSize)
    table.cell(_t, 1, 15, na(boSizePc) ? "—" : str.tostring(math.min(boSizePc, 100), "#.#") + "% of account", text_color = color.white, bgcolor = color.new(color.navy, 35), text_halign = text.align_center, text_size = txtSize)
    // the two models side by side, never merged: a breakout under a bearish
    // Money Line is the scout entry, a bullish line with no breakout is a
    // trend you are late to. Averaging them would mean neither.
    table.cell(_t, 0, 16, "MODELS", text_color = color.white, bgcolor = color.new(color.gray, 20), text_halign = text.align_left, text_size = txtSize)
    table.cell(_t, 1, 16, boDir == 0 ? "lines: quiet   ·   ATR: " + (trend == 1 ? "bull" : "bear") : (boDir == 1 ? "lines: BULL" : "lines: BEAR") + "   ·   ATR: " + (trend == 1 ? "bull" : "bear") + (k7 ? "   → ALIGNED" : "   → SPLIT"), text_color = color.white, bgcolor = k7 and boDir != 0 ? color.new(#00c853, 45) : color.new(color.gray, 45), text_halign = text.align_center, text_size = txtSize)
    // touches AND age: a level defended twice over two years is a different
    // object from one defended twice last month, and only the pair says which
    rAge = na(boResBar) ? na : bar_index - boResBar
    sAge = na(boSupBar) ? na : bar_index - boSupBar
    table.cell(_t, 0, 17, "Next level", text_color = color.white, bgcolor = color.new(color.black, 20), text_halign = text.align_left, text_size = txtSize)
    table.cell(_t, 1, 17, (na(boRes) ? "R —" : "R " + str.tostring(boRes, format.mintick) + "  " + str.tostring(boResHit, "#") + "t/" + str.tostring(rAge, "#") + "b") + "   ·   " + (na(boSup) ? "S —" : "S " + str.tostring(boSup, format.mintick) + "  " + str.tostring(boSupHit, "#") + "t/" + str.tostring(sAge, "#") + "b"), text_color = color.white, bgcolor = color.new(color.black, 40), text_halign = text.align_center, text_size = txtSize)
    // SETUP sits BELOW the verdict, not inside it: whether the thing that
    // broke was worth breaking is a different question from whether the
    // break is real.
    suWhy = not suOn ? "off" : (suIsBase ? str.tostring(suBars, "#") + "-bar base (" + str.tostring(f_suW(suHi, suLo), "#.#") + "% wide)" : "no base — " + (suBars > 0 ? str.tostring(suBars, "#") + " bars only" : "range too wide")) + (suNewATH ? "  ·  AT ALL-TIME HIGH" : suNew52 ? "  ·  at 52w high" : "") + (suSqz ? "  ·  SQUEEZE" : "")
    table.cell(_t, 0, 18, "SETUP  " + suGrade, text_color = color.white, bgcolor = color.new(#00bcd4, 25), text_halign = text.align_left, text_size = txtSize)
    table.cell(_t, 1, 18, suWhy, text_color = color.white, bgcolor = suGrade == "A+" ? color.new(#00c853, 10) : suGrade == "A" ? color.new(#00c853, 40) : suGrade == "B" ? color.new(color.orange, 35) : color.new(color.gray, 45), text_halign = text.align_center, text_size = txtSize)
    table.cell(_t, 0, 19, "Measured move", text_color = color.white, bgcolor = color.new(#9c27b0, 25), text_halign = text.align_left, text_size = txtSize)
    table.cell(_t, 1, 19, not suIsBase or na(suTgt1) ? "— (no base to measure)" : "T1 " + str.tostring(suTgt1, format.mintick) + "   T2 " + str.tostring(suTgt2, format.mintick) + "   (base " + str.tostring(suLo, format.mintick) + "-" + str.tostring(suHi, format.mintick) + ")", text_color = color.white, bgcolor = color.new(#9c27b0, 45), text_halign = text.align_center, text_size = txtSize)
    // a pattern is not a direction: a symmetrical triangle resolves either
    // way and a falling wedge is bullish only by convention, so this names
    // the structure and says when the decision is due — it does not vote.
    wgWhy = not wgOn ? "off" : not wgHave ? "no pair yet — need two swing highs and two swing lows" : wgCrossed ? wgType + "  ·  stale until the next swing confirms" : wgType + (wgApexOk ? "  ·  apex in " + str.tostring(wgApexN, "#") + " bars" : "") + "  ·  gap " + str.tostring(wgPct, "#.#") + "%" + (na(wgPos) ? "" : "  ·  price " + (wgPos > 110 ? "ABOVE the upper rail" : wgPos < -10 ? "BELOW the lower rail" : str.tostring(wgPos, "#") + "% up the range"))
    table.cell(_t, 0, 20, "STRUCTURE", text_color = color.white, bgcolor = color.new(#2962ff, 15), text_halign = text.align_left, text_size = txtSize)
    table.cell(_t, 1, 20, wgWhy, text_color = color.white, bgcolor = not wgHave ? color.new(color.gray, 55) : wgApexOk ? color.new(#2962ff, 30) : color.new(#2962ff, 55), text_halign = text.align_center, text_size = txtSize)
    // extension in ATR, not percent: "1.5 ATR above the 21 EMA" means the same
    // thing on every symbol, where "10% above" does not.
    table.cell(_t, 0, 21, str.tostring(emaFastLen, "#") + " / " + str.tostring(emaSlowLen, "#") + " EMA", text_color = color.white, bgcolor = color.new(#ff5252, 30), text_halign = text.align_left, text_size = txtSize)
    table.cell(_t, 1, 21, na(emaF) ? "—" : str.tostring(emaF, format.mintick) + "  /  " + str.tostring(emaS, format.mintick) + "   ·   " + str.tostring(emaX9, "#.#") + "x / " + str.tostring(emaX21, "#.#") + "x ATR   (" + (emaPctS >= 0 ? str.tostring(emaPctS, "#.#") + "% above the " : str.tostring(-emaPctS, "#.#") + "% BELOW the ") + str.tostring(emaSlowLen, "#") + ")" + (emaOver ? "  ⚠ EXTENDED" : "") + (na(emaBarsAbove) ? "" : "   ·   " + str.tostring(emaBarsAbove, "#") + " bars above"), text_color = color.white, bgcolor = emaOver ? color.new(color.orange, 30) : color.new(#ff5252, 55), text_halign = text.align_center, text_size = txtSize)
    table.cell(_t, 0, 22, "POLARITY", text_color = color.white, bgcolor = color.new(#2962ff, 25), text_halign = text.align_left, text_size = txtSize)
    table.cell(_t, 1, 22, not boFlipOn ? "— no level taken yet" : "resistance → support at " + str.tostring(boFlipLvl, format.mintick) + "   (" + str.tostring(boFlipPct, "#.#") + "% below price)" + (boFlipRe ? "   ✓ retested and held" : "   · untested"), text_color = color.white, bgcolor = not boFlipOn ? color.new(color.gray, 55) : boFlipRe ? color.new(#00c853, 35) : color.new(#2962ff, 45), text_halign = text.align_center, text_size = txtSize)
    // the whole point of the section: one sentence, from the lines alone
    table.cell(_t, 0, 23, "LINES SAY", text_color = color.white, bgcolor = color.new(color.black, 0), text_halign = text.align_left, text_size = txtSize)
    table.cell(_t, 1, 23, f_linesSay(), text_color = color.white, bgcolor = color.new(#00695c, 20), text_halign = text.align_left, text_size = txtSize)
    // syminfo.sector / .industry are built-ins — they cost nothing against the
    // request budget, which is full at exactly 40 of the 40 allowed, where a
    // single extra request.*() would break the whole script.
    secTxt = (syminfo.sector == "" ? "—" : syminfo.sector) + (syminfo.industry == "" ? "" : "   ·   " + syminfo.industry) + "   ·   " + syminfo.type
    profTxt = not profOn ? "off" : na(profEma) ? "—" : (profAbove ? "ABOVE " : "BELOW ") + str.tostring(profEma, format.mintick) + "   (" + str.tostring(profPct, "#.#") + "%, " + str.tostring(profDist, "#.#") + "x ATR)" + (profLost ? "   ⚠ LOST IT THIS BAR — this is the exit" : profReclaim ? "   ★ RECLAIMED THIS BAR" : profRespect ? "   ✓ RESPECTED — wicked in, closed above" : profAtLine ? "   ◆ AT THE LINE — entry zone" : "") + (profAbove and not na(profBars) ? "   ·  held " + str.tostring(profBars, "#") + " bars" : "") + (na(profGain) ? "" : ", " + (profGain >= 0 ? "+" : "") + str.tostring(profGain, "#.#") + "% since reclaim")
    table.cell(_t, 0, 25, str.tostring(profWeeks, "#") + "w EMA RULE" + (profExact ? "" : " ~"), text_color = color.white, bgcolor = color.new(#ffd600, 25), text_halign = text.align_left, text_size = txtSize)
    table.cell(_t, 1, 25, profTxt, text_color = color.white, bgcolor = not profOn or na(profEma) ? color.new(color.gray, 55) : profLost ? color.new(#d50000, 15) : profReclaim or profRespect or profAtLine ? color.new(#00c853, 20) : profAbove ? color.new(#00c853, 50) : color.new(#d50000, 45), text_halign = text.align_center, text_size = txtSize)
    table.cell(_t, 0, 24, "SECTOR", text_color = color.white, bgcolor = color.new(color.gray, 25), text_halign = text.align_left, text_size = txtSize)
    table.cell(_t, 1, 24, secTxt, text_color = color.white, bgcolor = color.new(color.gray, 50), text_halign = text.align_center, text_size = txtSize)
    0

// ── CHART SYNC MODE — remove only what drags the axis ────────────────
// A delete pass, not a guard on the drawing blocks, and that is deliberate:
// the PRO block COMPUTES proResNow, proSupNow and the touch counts inside
// the same block that draws, and proBreakUp/Dn are built from those. Gating
// it would switch off a third of the breakout engine's inputs whenever
// someone ticked a display option. A display setting must never change a
// signal. Deleting another block's line is a call, not a global assignment,
// so this is legal inside a function.
f_syncWipe() =>
    line.delete(proResLn)
    line.delete(proSupLn)
    line.delete(proChLn)
    line.delete(proKRLn)
    line.delete(proKSLn)
    label.delete(proResLb)
    label.delete(proSupLb)
    label.delete(proKRLb)
    label.delete(proKSLb)
    line.delete(lnR1)
    line.delete(lnR2)
    line.delete(lnR3)
    line.delete(lnS1)
    line.delete(lnS2)
    line.delete(lnS3)
    label.delete(lbR1)
    label.delete(lbS1)
    line.delete(flipLn)
    label.delete(flipLb)
    line.delete(tlUpLn)
    line.delete(tlLoLn)
    0

if barstate.islast and boOn
    f_boConsole(bot)
if barstate.islast and syncMode
    f_syncWipe()

alertcondition(boBrkHorzUp, title = "v64 BREAKOUT — defended level", message = "{{ticker}} {{interval}}: closed above a defended level at {{close}}")
alertcondition(boBrkHorzDn, title = "v64 BREAKDOWN — defended level", message = "{{ticker}} {{interval}}: closed below a defended level at {{close}}")
alertcondition(suBaseBrk, title = "v64 BASE BREAKOUT (out of a long consolidation)", message = "{{ticker}} {{interval}}: closed above a multi-bar base at {{close}}")
alertcondition(suATHBrk,  title = "v64 NEW ALL-TIME HIGH", message = "{{ticker}} {{interval}}: new all-time high at {{close}} — no overhead supply")
alertcondition(profReclaim, title = "v64 RECLAIMED the weekly 9 EMA", message = "{{ticker}} {{interval}}: closed back above the 9-week EMA at {{close}} — the method's entry")
alertcondition(profLost,    title = "v64 LOST the weekly 9 EMA", message = "{{ticker}} {{interval}}: closed below the 9-week EMA at {{close}} — the method's exit")
alertcondition(profRespect, title = "v64 RESPECTED the weekly 9 EMA (pullback held)", message = "{{ticker}} {{interval}}: wicked into the 9-week EMA and closed above at {{close}}")
