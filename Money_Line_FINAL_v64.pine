[st11, sd11, sf11, sq11] = request.security(s11, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st12, sd12, sf12, sq12] = request.security(s12, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st13, sd13, sf13, sq13] = request.security(s13, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st14, sd14, sf14, sq14] = request.security(s14, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st15, sd15, sf15, sq15] = request.security(s15, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st16, sd16, sf16, sq16] = request.security(s16, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st17, sd17, sf17, sq17] = request.security(s17, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st18, sd18, sf18, sq18] = request.security(s18, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st19, sd19, sf19, sq19] = request.security(s19, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st20, sd20, sf20, sq20] = request.security(s20, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st21, sd21, sf21, sq21] = request.security(s21, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st22, sd22, sf22, sq22] = request.security(s22, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st23, sd23, sf23, sq23] = request.security(s23, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st24, sd24, sf24, sq24] = request.security(s24, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st25, sd25, sf25, sq25] = request.security(s25, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st26, sd26, sf26, sq26] = request.security(s26, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st27, sd27, sf27, sq27] = request.security(s27, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st28, sd28, sf28, sq28] = request.security(s28, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st29, sd29, sf29, sq29] = request.security(s29, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st30, sd30, sf30, sq30] = request.security(s30, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st31, sd31, sf31, sq31] = request.security(s31, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
[st32, sd32, sf32, sq32] = request.security(s32, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)

// build priority-sorted focus list: fresh flips first, then nearest-to-trigger
scPos = scanPos == "Top Right" ? position.top_right : scanPos == "Middle Right" ? position.middle_right : scanPos == "Bottom Left" ? position.bottom_left : position.bottom_right
var table sc = table.new(scPos, 2, 40, border_width = 1)

f_score(_t, _d, _f) =>
    // lower score = more urgent
    _f == 1 ? 0.0 : na(_d) ? 999.0 : math.abs(_d)

// "up 7%" read as a 7% GAIN. It never meant that — it is the distance between
// price and the LINE, i.e. headroom above the exit (bullish) or the gap still to
// climb to the trigger (bearish). A symbol can sit "up 7%" while the trade is
// down. The wording now says which.
f_tag(_t, _d, _f) =>
    na(_t) or na(_d) ? "— no data" : _f == 1 and _t == 1 ? "★ NEW BUY" : _f == 1 and _t == -1 ? "★ NEW SELL" : _t == -1 and _d > -3 ? "◆ NEAR BUY " + str.tostring(_d, "#.#") + "%" : _t == 1 and _d < 3 ? "◆ NEAR SELL " + str.tostring(_d, "#.#") + "%" : _t == 1 ? str.tostring(_d, "#") + "% above exit" : str.tostring(math.abs(_d), "#") + "% below trigger"

f_tagCol(_t, _d, _f) =>
    na(_t) or na(_d) ? cP7 : _f == 1 and _t == 1 ? cP4 : _f == 1 and _t == -1 ? cP5 : (_t == -1 and not na(_d) and _d > -3) or (_t == 1 and not na(_d) and _d < 3) ? color.new(color.orange, 10) : _t == 1 ? color.new(#00c853, 60) : color.new(#d50000, 60)

if showScanner and barstate.islast
    table.clear(sc, 0, 0, 1, 33)
    scores = array.new_float()
    idxs   = array.new_int()
    array.push(scores, f_score(st1, sd1, sf1)), array.push(idxs, 1)
    array.push(scores, f_score(st2, sd2, sf2)), array.push(idxs, 2)
    array.push(scores, f_score(st3, sd3, sf3)), array.push(idxs, 3)
    array.push(scores, f_score(st4, sd4, sf4)), array.push(idxs, 4)
    array.push(scores, f_score(st5, sd5, sf5)), array.push(idxs, 5)
    array.push(scores, f_score(st6, sd6, sf6)), array.push(idxs, 6)
    array.push(scores, f_score(st7, sd7, sf7)), array.push(idxs, 7)
    array.push(scores, f_score(st8, sd8, sf8)), array.push(idxs, 8)
    array.push(scores, f_score(st9, sd9, sf9)), array.push(idxs, 9)
    array.push(scores, f_score(st10, sd10, sf10)), array.push(idxs, 10)
    array.push(scores, f_score(st11, sd11, sf11)), array.push(idxs, 11)
    array.push(scores, f_score(st12, sd12, sf12)), array.push(idxs, 12)
    array.push(scores, f_score(st13, sd13, sf13)), array.push(idxs, 13)
    array.push(scores, f_score(st14, sd14, sf14)), array.push(idxs, 14)
    array.push(scores, f_score(st15, sd15, sf15)), array.push(idxs, 15)
    array.push(scores, f_score(st16, sd16, sf16)), array.push(idxs, 16)
    array.push(scores, f_score(st17, sd17, sf17)), array.push(idxs, 17)
    array.push(scores, f_score(st18, sd18, sf18)), array.push(idxs, 18)
    array.push(scores, f_score(st19, sd19, sf19)), array.push(idxs, 19)
    array.push(scores, f_score(st20, sd20, sf20)), array.push(idxs, 20)
    array.push(scores, f_score(st21, sd21, sf21)), array.push(idxs, 21)
    array.push(scores, f_score(st22, sd22, sf22)), array.push(idxs, 22)
    array.push(scores, f_score(st23, sd23, sf23)), array.push(idxs, 23)
    array.push(scores, f_score(st24, sd24, sf24)), array.push(idxs, 24)
    array.push(scores, f_score(st25, sd25, sf25)), array.push(idxs, 25)
    array.push(scores, f_score(st26, sd26, sf26)), array.push(idxs, 26)
    array.push(scores, f_score(st27, sd27, sf27)), array.push(idxs, 27)
    array.push(scores, f_score(st28, sd28, sf28)), array.push(idxs, 28)
    array.push(scores, f_score(st29, sd29, sf29)), array.push(idxs, 29)
    array.push(scores, f_score(st30, sd30, sf30)), array.push(idxs, 30)
    array.push(scores, f_score(st31, sd31, sf31)), array.push(idxs, 31)
    // Slot 32 holds the chart's own symbol. Pin it to the top of the list with a
    // score below any real one, so the symbol you are actually looking at is
    // always present — the urgency sort would otherwise drop a settled trend
    // (e.g. TCS at +12% above its line) below the display cut.
    array.push(scores, addChartSym ? -1.0 : f_score(st32, sd32, sf32)), array.push(idxs, 32)
    f_cellL(sc, 0, 0, "FOCUS LIST v62", cP19)
    // diagnostic: the bar each symbol was read at. Same date on two different
    // charts = the Focus List is genuinely aligned.
    // Every symbol should be read at the SAME bar. If they are not, the scan is
    // getting uneven history and the levels cannot be compared — that is the
    // failure this whole header exists to catch.
    sqAll  = array.from(sq1, sq2, sq3, sq4, sq5, sq6, sq7, sq8, sq9, sq10, sq11, sq12, sq13, sq14, sq15, sq16, sq17, sq18, sq19, sq20, sq21, sq22, sq23, sq24, sq25, sq26, sq27, sq28, sq29, sq30, sq31, sq32)
    asOfT  = array.max(sqAll)
    asOfMin = array.min(sqAll)
    // tolerance: symbols on different exchanges open their bar at different times
    // of day. Only a gap of several days means they are on different BARS.
    // Tolerance must scale with the scan timeframe, not be a fixed number of days.
    // A symbol on a later-closing exchange legitimately reports one bar behind:
    // on an NSE chart the week ends 10:00 UTC Friday, but NASDAQ's week ends at
    // 20:00 UTC, and lookahead_off correctly refuses to return a bar that closes
    // after the chart bar did. That one-bar offset is the anti-repainting rule
    // working, not a fault — so only a gap of MORE than one bar is a real problem.
    tolMs  = math.round(timeframe.in_seconds(scanTF) * 1000 * tolBars)
    mixed  = not na(asOfT) and not na(asOfMin) and (asOfT - asOfMin) > tolMs
    asOfTx = showAsOf and nz(asOfT, 0) > 0 ? "  ·  as of w/e " + str.format_time(asOfT, "dd MMM", syminfo.timezone) + (mixed ? "  ⚠ MIXED DATES" : "") + "  ⚡=live" : ""
    hdrCol = mixed ? color.new(#d50000, 10) : cP19
    f_cellC(sc, 1, 0, scanTF + "  " + chartMkt + "  (top " + str.tostring(maxShow) + ")" + asOfTx, hdrCol)
    shown = 0
    // names already rendered, so the chart symbol in slot 32 cannot appear twice
    seenNames = array.new_string()
    while shown < maxShow and array.size(scores) > 0
        best = 0
        for k = 1 to array.size(scores) - 1
            if array.get(scores, k) < array.get(scores, best)
                best := k
        id = array.get(idxs, best)
        array.remove(scores, best), array.remove(idxs, best)
        sym = switch id
            1 => s1
            2 => s2
            3 => s3
            4 => s4
            5 => s5
            6 => s6
            7 => s7
            8 => s8
            9 => s9
            10 => s10
            11 => s11
            12 => s12
            13 => s13
            14 => s14
            15 => s15
            16 => s16
            17 => s17
            18 => s18
            19 => s19
            20 => s20
            21 => s21
            22 => s22
            23 => s23
            24 => s24
            25 => s25
            26 => s26
            27 => s27
            28 => s28
            29 => s29
            30 => s30
            31 => s31
            32 => s32
            => s1
        tv = switch id
            1 => st1
            2 => st2
            3 => st3
            4 => st4
            5 => st5
            6 => st6
            7 => st7
            8 => st8
            9 => st9
            10 => st10
            11 => st11
            12 => st12
            13 => st13
            14 => st14
            15 => st15
            16 => st16
            17 => st17
            18 => st18
            19 => st19
            20 => st20
            21 => st21
            22 => st22
            23 => st23
            24 => st24
            25 => st25
            26 => st26
            27 => st27
            28 => st28
            29 => st29
            30 => st30
            31 => st31
            32 => st32
            => st1
        dv = switch id
            1 => sd1
            2 => sd2
            3 => sd3
            4 => sd4
            5 => sd5
            6 => sd6
            7 => sd7
            8 => sd8
            9 => sd9
            10 => sd10
            11 => sd11
            12 => sd12
            13 => sd13
            14 => sd14
            15 => sd15
            16 => sd16
            17 => sd17
            18 => sd18
            19 => sd19
            20 => sd20
            21 => sd21
            22 => sd22
            23 => sd23
            24 => sd24
            25 => sd25
            26 => sd26
            27 => sd27
            28 => sd28
            29 => sd29
            30 => sd30
            31 => sd31
            32 => sd32
            => sd1
        fv = switch id
            1 => sf1
            2 => sf2
            3 => sf3
            4 => sf4
            5 => sf5
            6 => sf6
            7 => sf7
            8 => sf8
            9 => sf9
            10 => sf10
            11 => sf11
            12 => sf12
            13 => sf13
            14 => sf14
            15 => sf15
            16 => sf16
            17 => sf17
            18 => sf18
            19 => sf19
            20 => sf20
            21 => sf21
            22 => sf22
            23 => sf23
            24 => sf24
            25 => sf25
            26 => sf26
            27 => sf27
            28 => sf28
            29 => sf29
            30 => sf30
            31 => sf31
            32 => sf32
            => sf1
        qv = switch id
            1 => sq1
            2 => sq2
            3 => sq3
            4 => sq4
            5 => sq5
            6 => sq6
            7 => sq7
            8 => sq8
            9 => sq9
            10 => sq10
            11 => sq11
            12 => sq12
            13 => sq13
            14 => sq14
            15 => sq15
            16 => sq16
            17 => sq17
            18 => sq18
            19 => sq19
            20 => sq20
            21 => sq21
            22 => sq22
            23 => sq23
            24 => sq24
            25 => sq25
            26 => sq26
            27 => sq27
            28 => sq28
            29 => sq29
            30 => sq30
            31 => sq31
            32 => sq32
            => int(na)
        // a symbol that is invalid, or still inside its warm-up window, is skipped
        // entirely instead of occupying a slot with a misleading tag
        symMkt = f_mkt(f_exch(sym))
        mktOK  = not mktFilter or symMkt == "ANY" or symMkt == chartMkt
        nm = syminfo.ticker(sym)   // pinned chart symbol is reached first, so a
                                   // duplicate elsewhere in the set is the one dropped
        dup = array.includes(seenNames, nm)
        if not na(tv) and not na(dv) and shown < 32 and mktOK and not dup
            shown += 1
            array.push(seenNames, nm)
            fvBits = fv % 4
            fvFlip = fvBits % 2            // bit 1: confirmed flip on the closed bar
            pv     = fvBits >= 2 ? 1 : 0   // bit 2: live bar is crossing right now
            fvAge  = math.floor(fv / 4)    // bars in the current regime
            ageTxt = fvAge <= 0 ? "" : "  " + str.tostring(fvAge) + tfBar
            stale = not na(qv) and not na(asOfT) and (asOfT - qv) > tolMs
            f_cellL(sc, 0, shown, (stale ? "⧗ " : "") + syminfo.ticker(sym), stale ? color.new(#d50000, 45) : cP1)
            // ⚡ = the live bar has already crossed but the bar has not closed.
            // Early warning, and explicitly NOT a confirmed signal.
            f_cellC(sc, 1, shown, (pv == 1 ? "⚡ " : "") + f_tag(tv, dv, fvFlip) + ageTxt, pv == 1 ? color.new(#7c4dff, 15) : f_tagCol(tv, dv, fvFlip))

// ═══════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════
alertcondition(buySignal and scorePct >= 0.88 and not thinHist, title = "BUY — Grade A (high quality)", message = "{{ticker}} {{interval}}: BUY signal, GRADE A (88%+ of checks passed) at {{close}}")
alertcondition(buySignal, title = "BUY — any grade", message = "{{ticker}} {{interval}}: BUY signal at {{close}} — check grade on chart")
alertcondition(sellSignal, title = "SELL", message = "{{ticker}} {{interval}}: SELL signal at {{close}}")

// intraweek tripwire: fires the moment price trades ABOVE the buy flip level while still bearish
// (unconfirmed — the weekly close can still fall back below; this is the EARLY-PRICE heads-up)
tripwireUp = (buySignal and not barstate.isconfirmed) or (trend == -1 and close > moneyLine)
alertcondition(tripwireUp, title = "⚡ PRICE ABOVE BUY LEVEL (unconfirmed)", message = "{{ticker}}: price {{close}} is ABOVE the buy flip level intrabar — unconfirmed until the bar closes. Early-entry zone.")

alertcondition(tlBreakUp, title = "Trendline BREAKOUT (falling resistance)", message = "{{ticker}} {{interval}}: closed above its falling resistance trendline at {{close}}")
alertcondition(tlBreakDn, title = "Trendline BREAKDOWN (rising support)", message = "{{ticker}} {{interval}}: closed below its rising support trendline at {{close}}")

alertcondition(proBreakUp, title = "PRO LINE breakout (closed above long resistance)", message = "{{ticker}} {{interval}}: closed above its long-term resistance trendline at {{close}}")
alertcondition(proBreakDn, title = "PRO LINE breakdown (closed below long support)", message = "{{ticker}} {{interval}}: closed below its long-term support trendline at {{close}}")


// ═══════════════════════════════════════════════════════════════════════════
// v64 — BREAKOUT CONSOLE + SETUP QUALITY + STRUCTURE
// Formatting helpers. Three str.tostring forms account for 106 calls in this
// block; at roughly five tokens each over a plain call they were most of the
// 48 tokens the script was over CE10117's limit of 100,256.
f_px(float _v) => str.tostring(_v, format.mintick)
f_n1(float _v) => str.tostring(_v, "#.#")
f_n0(float _v) => str.tostring(_v, "#")
// ───
boOn       = input.bool(true, "Enable BREAKOUT console", group = "6. Breakout Console")
boMinTouch = input.int(2, "Horizontal level: minimum touches", minval = 1, maxval = 6, group = "6. Breakout Console")
boTolATR   = input.float(0.50, "Horizontal level: cluster width (ATR)", minval = 0.05, maxval = 3.0, step = 0.05, group = "6. Breakout Console")
boBufPct   = input.float(0.15, "Breakout buffer (% beyond the level)", minval = 0.0, maxval = 5.0, step = 0.05, group = "6. Breakout Console")
boFresh    = input.int(3, "Breakout stays 'live' for N bars", minval = 1, maxval = 20, group = "6. Breakout Console")
boVolSurge = input.float(1.50, "Volume surge required (x 20-bar avg)", minval = 0.5, maxval = 5.0, step = 0.1, group = "6. Breakout Console")
boRsiMax   = input.float(80.0, "RSI ceiling (above = move already spent)", minval = 60, maxval = 95, step = 1, group = "6. Breakout Console")
boStopATR  = input.float(0.50, "Breakout stop: ATR below the broken level", minval = 0.1, maxval = 3.0, step = 0.1, group = "6. Breakout Console")
boFlipMaxATR = input.float(4.0, "Polarity: stale once price is this many ATR above it", minval = 1.0, maxval = 20.0, step = 0.5, group = "6. Breakout Console")
lvlMaxATR  = input.float(5.0, "LEVELS: ignore anything further than this many ATR", minval = 2.0, maxval = 40.0, step = 1.0, group = "6. Breakout Console")
boMinTgtATR = input.float(1.0, "Target must be at least this many ATR away", minval = 0.1, maxval = 10.0, step = 0.1, group = "6. Breakout Console")
boMaxSize  = input.float(25.0, "Maximum position size (% of account)", minval = 1.0, maxval = 100.0, step = 1.0, group = "6. Breakout Console")
boFailBars = input.int(4, "Failed breakout: closes back under within N bars", minval = 1, maxval = 20, group = "6. Breakout Console")
boShowLvl  = input.bool(true, "Draw the defended horizontal levels", group = "6. Breakout Console")
boShowVert = input.bool(true, "Vertical line at each scored breakout", group = "6. Breakout Console")
boSlim     = input.bool(true, "Compact console — decision rows only", group = "6. Breakout Console")
boPos      = input.string("Top Right", "Console position", options = ["Top Right", "Top Left", "Middle Right", "Bottom Left", "Bottom Right"], group = "6. Breakout Console")
suOn       = input.bool(true, "Enable SETUP QUALITY (base, new high, squeeze, targets)", group = "7. Setup Quality")
suBaseMax  = input.float(25.0, "Base: max range width (% of its low)", minval = 3.0, maxval = 80.0, step = 0.5, group = "7. Setup Quality")
suBaseMin  = input.int(30, "Base: minimum bars to call it a base", minval = 10, maxval = 200, group = "7. Setup Quality")
suSqzPct   = input.float(15.0, "Squeeze: within % of the tightest band in 100 bars", minval = 2.0, maxval = 60.0, step = 1.0, group = "7. Setup Quality")
suShowBox  = input.bool(true, "Draw the base box", group = "7. Setup Quality")
suShowTgt  = input.bool(true, "Draw measured-move targets (1.0 / 1.618)", group = "7. Setup Quality")
suShowATH  = input.bool(true, "Draw the 52-week and all-time high lines", group = "7. Setup Quality")
wgOn       = input.bool(true, "Draw the converging pair / channel + apex", group = "8. Structure")
wgMaxBar   = input.int(60, "Apex: ignore if further out than N bars", minval = 5, maxval = 400, group = "8. Structure")
wgFlat     = input.float(0.02, "Flat-slope tolerance (ATR per bar)", minval = 0.001, maxval = 0.5, step = 0.005, group = "8. Structure")
wgShowMid  = input.bool(true, "Channel: draw the midline (3rd rail)", group = "8. Structure")
flagOn     = input.bool(true, "Detect BULL / BEAR FLAGS (pole + channel)", group = "8. Structure")
flagPoleLen = input.int(20, "Flag: bars of 'pole' to look back through", minval = 5, maxval = 100, group = "8. Structure")
flagLen    = input.int(12, "Flag: maximum bars the flag itself may run", minval = 3, maxval = 60, group = "8. Structure")
flagPoleMin = input.float(20.0, "Flag: minimum pole size (%)", minval = 3.0, maxval = 200.0, step = 1.0, group = "8. Structure")
flagRetMax = input.float(50.0, "Flag: maximum retrace of the pole (%)", minval = 15.0, maxval = 90.0, step = 5.0, group = "8. Structure")

// ── DEFENDED HORIZONTAL LEVELS ───
var array<float> boLvlPx  = array.new_float()
var array<int>   boLvlHit = array.new_int()
var array<int>   boLvlBar = array.new_int()

f_boMerge(array<float> _px, array<int> _hit, array<int> _bar, float _new, float _tol, int _bi) =>
    int _found = -1
    if not na(_new) and not na(_tol) and _tol > 0
        if array.size(_px) > 0
            for i = 0 to array.size(_px) - 1
                if math.abs(array.get(_px, i) - _new) <= _tol
                    _found := i
                    break
        if _found >= 0
            int   _n = array.get(_hit, _found) + 1
            float _o = array.get(_px, _found)
            array.set(_px,  _found, _o + (_new - _o) / _n)
            array.set(_hit, _found, _n)
        else
            if array.size(_px) >= 60
                array.shift(_px)
                array.shift(_hit)
                array.shift(_bar)
            array.push(_px,  _new)
            array.push(_hit, 1)
            array.push(_bar, _bi)
    _found

f_boPick(array<float> _px, array<int> _hit, array<int> _bar, int _min, bool _above, float _ref) =>
    float _bestPx  = na
    int   _bestHit = 0
    int   _bestBar = na
    if array.size(_px) > 0
        for i = 0 to array.size(_px) - 1
            float _v = array.get(_px, i)
            int   _h = array.get(_hit, i)
            if _h >= _min and (_above ? _v > _ref : _v < _ref)
                if na(_bestPx) or (_above ? _v < _bestPx : _v > _bestPx)
                    _bestPx  := _v
                    _bestHit := _h
                    _bestBar := array.get(_bar, i)
    [_bestPx, _bestHit, _bestBar]

boTol = na(atrV) ? na : boTolATR * atrV
if not na(ph)
    f_boMerge(boLvlPx, boLvlHit, boLvlBar, ph, boTol, bar_index - pivLen)
if not na(pl)
    f_boMerge(boLvlPx, boLvlHit, boLvlBar, pl, boTol, bar_index - pivLen)

[boRes, boResHit, boResBar] = f_boPick(boLvlPx, boLvlHit, boLvlBar, boMinTouch, true,  close)
[boSup, boSupHit, boSupBar] = f_boPick(boLvlPx, boLvlHit, boLvlBar, boMinTouch, false, close)

boResRef = boRes[1]
boSupRef = boSup[1]
boBrkHorzUp = boOn and not na(boResRef) and close > boResRef * (1 + boBufPct / 100) and close[1] <= boResRef
boBrkHorzDn = boOn and not na(boSupRef) and close < boSupRef * (1 - boBufPct / 100) and close[1] >= boSupRef

// ── SETUP QUALITY: base / new high / squeeze / targets ───
f_suW(float _h, float _l) => _l > 0 ? (_h - _l) / _l * 100 : na
f_suBase(float _maxW) =>
    h200 = ta.highest(high, 200), l200 = ta.lowest(low, 200)
    h120 = ta.highest(high, 120), l120 = ta.lowest(low, 120)
    h80  = ta.highest(high,  80), l80  = ta.lowest(low,  80)
    h50  = ta.highest(high,  50), l50  = ta.lowest(low,  50)
    h30  = ta.highest(high,  30), l30  = ta.lowest(low,  30)
    h20  = ta.highest(high,  20), l20  = ta.lowest(low,  20)
    t200 = bar_index >= 200 and f_suW(h200, l200) <= _maxW
    t120 = bar_index >= 120 and f_suW(h120, l120) <= _maxW
    t80  = bar_index >=  80 and f_suW(h80,  l80)  <= _maxW
    t50  = bar_index >=  50 and f_suW(h50,  l50)  <= _maxW
    t30  = bar_index >=  30 and f_suW(h30,  l30)  <= _maxW
    t20  = bar_index >=  20 and f_suW(h20,  l20)  <= _maxW
    bb = t200 ? 200 : t120 ? 120 : t80 ? 80 : t50 ? 50 : t30 ? 30 : t20 ? 20 : 0
    bh = t200 ? h200 : t120 ? h120 : t80 ? h80 : t50 ? h50 : t30 ? h30 : t20 ? h20 : na
    bl = t200 ? l200 : t120 ? l120 : t80 ? l80 : t50 ? l50 : t30 ? l30 : t20 ? l20 : na
    [bb, bh, bl]

f_suSqueeze(float _pct) =>
    _basis = ta.sma(close, 20)
    _sd    = ta.stdev(close, 20)
    _w     = _basis > 0 ? (4 * _sd) / _basis * 100 : na
    _lo    = ta.lowest(_w, 100)
    not na(_w) and not na(_lo) and _lo > 0 and _w <= _lo * (1 + _pct / 100)

[suBars, suHi, suLo] = f_suBase(suBaseMax)
suSqzRaw = f_suSqueeze(suSqzPct)
suSqz    = suOn and suSqzRaw
suIsBase = suOn and suBars >= suBaseMin
suBaseBrk = suIsBase and not na(suHi[1]) and close > suHi[1] and close[1] <= suHi[1]
suNewATH = suOn and close >= hiAll * 0.995
suNew52  = suOn and close >= hi52  * 0.995
suATHBrk = suOn and close > hiAll[1] and close[1] <= hiAll[1]
suHeight = na(suHi) or na(suLo) ? na : suHi - suLo
suTgt1   = na(suHeight) ? na : suHi + suHeight
suTgt2   = na(suHeight) ? na : suHi + suHeight * 1.618
suPts    = (suIsBase ? 1 : 0) + (suNewATH ? 2 : suNew52 ? 1 : 0) + (suSqz ? 1 : 0)
suGrade  = not suOn ? "—" : suPts >= 4 ? "A+" : suPts == 3 ? "A" : suPts == 2 ? "B" : suPts == 1 ? "C" : "D"

// ── STRUCTURE: the converging pair, its apex, the channel ───
f_wgCalc(float _flatTol) =>
    _ok = not na(hiA_px) and not na(hiB_px) and not na(loA_px) and not na(loB_px) and not na(tlUpNow) and not na(tlLoNow) and hiB_bar > hiA_bar and loB_bar > loA_bar
    _rs = _ok ? (hiB_px - hiA_px) / (hiB_bar - hiA_bar) : na
    _ss = _ok ? (loB_px - loA_px) / (loB_bar - loA_bar) : na
    _gp = _ok ? tlUpNow - tlLoNow : na
    _cv = _ok ? _ss - _rs : na
    [_ok, _rs, _ss, _gp, _cv]

[wgHave, wgResSl, wgSupSl, wgGap, wgConv] = f_wgCalc(wgFlat)
wgApexN  = wgHave and not na(wgConv) and wgConv > 0 and not na(wgGap) and wgGap > 0 ? wgGap / wgConv : na
wgApexOk = wgOn and not na(wgApexN) and wgApexN <= wgMaxBar
wgTol    = na(atrV) ? na : wgFlat * atrV
wgRFlat  = wgHave and not na(wgTol) and math.abs(wgResSl) <= wgTol
wgSFlat  = wgHave and not na(wgTol) and math.abs(wgSupSl) <= wgTol
wgType   = not wgOn or not wgHave ? "—" : wgApexOk ? (wgRFlat and wgSupSl > 0 ? "ASCENDING TRIANGLE" : wgSFlat and wgResSl < 0 ? "DESCENDING TRIANGLE" : wgResSl < 0 and wgSupSl > 0 ? "SYMMETRICAL TRIANGLE" : wgResSl < 0 and wgSupSl < 0 ? "FALLING WEDGE" : wgResSl > 0 and wgSupSl > 0 ? "RISING WEDGE" : "CONVERGING") : (wgRFlat and wgSFlat ? "RECTANGLE" : not na(wgGap) and wgGap < 0 ? "APEX PASSED — lines crossed" : not na(wgConv) and wgConv < 0 ? "BROADENING" : "CHANNEL")
wgCrossed = wgHave and not na(wgGap) and wgGap < 0
wgIsChan = not wgCrossed and (wgType == "CHANNEL" or wgType == "BROADENING")
wgPct    = wgHave and close > 0 and not wgCrossed ? wgGap / close * 100 : na
wgPos    = wgHave and not na(wgGap) and wgGap > 0 ? (close - tlLoNow) / wgGap * 100 : na

// ── BULL / BEAR FLAGS ───
f_flag(int _poleLen, int _flagLen) =>
    _top = ta.highest(high, _flagLen)
    _lo  = ta.lowest(low,  _flagLen)
    _pLo = ta.lowest(low,  _flagLen + _poleLen)
    _pHi = ta.highest(high, _flagLen + _poleLen)
    [_top, _lo, _pLo, _pHi]

[flagTop, flagLow, flagPLo, flagPHi] = f_flag(flagPoleLen, flagLen)
flagPoleUp = flagPLo > 0 ? (flagTop - flagPLo) / flagPLo * 100 : na
flagPoleDn = flagPHi > 0 ? (flagPHi - flagLow) / flagPHi * 100 : na
flagRetUp  = flagTop > flagPLo ? (flagTop - flagLow) / (flagTop - flagPLo) * 100 : na
flagRetDn  = flagPHi > flagLow ? (flagTop - flagLow) / (flagPHi - flagLow) * 100 : na
flagPar = wgHave and not na(wgResSl) and not na(wgSupSl) and math.abs(wgResSl - wgSupSl) <= math.max(math.abs(wgResSl), math.abs(wgSupSl)) * 0.6
flagBull = flagOn and flagPar and wgResSl < 0 and wgSupSl < 0 and not na(flagPoleUp) and flagPoleUp >= flagPoleMin and not na(flagRetUp) and flagRetUp <= flagRetMax
flagBear = flagOn and flagPar and wgResSl > 0 and wgSupSl > 0 and not na(flagPoleDn) and flagPoleDn >= flagPoleMin and not na(flagRetDn) and flagRetDn <= flagRetMax
flagBrkUp = flagBull[1] and not na(tlUpNow) and not na(tlUpNow[1]) and close > tlUpNow and close[1] <= tlUpNow[1]
flagBrkDn = flagBear[1] and not na(tlLoNow) and not na(tlLoNow[1]) and close < tlLoNow and close[1] >= tlLoNow[1]
flagTgtUp = flagBull or flagBrkUp ? nz(tlUpNow, close) + (flagTop - flagPLo) : na
flagTgtDn = flagBear or flagBrkDn ? nz(tlLoNow, close) - (flagPHi - flagLow) : na
pennUp = flagOn and flagPar and not na(wgResSl) and not na(wgSupSl) and wgResSl < 0 and wgSupSl > 0 and not na(flagPoleUp) and flagPoleUp >= flagPoleMin and not na(flagRetUp) and flagRetUp <= flagRetMax
pennDn = flagOn and flagPar and not na(wgResSl) and not na(wgSupSl) and wgResSl > 0 and wgSupSl < 0 and not na(flagPoleDn) and flagPoleDn >= flagPoleMin and not na(flagRetDn) and flagRetDn <= flagRetMax
flagWord  = flagBull ? "BULL FLAG" : flagBear ? "BEAR FLAG" : pennUp ? "BULLISH PENNANT" : pennDn ? "BEARISH PENNANT" : ""

// ── THE EVENT: six sources, four of them already in this script ───
boBrkUp = boOn and (flagBrkUp or suBaseBrk or suATHBrk or boBrkHorzUp or proBreakUp or tlBreakUp or buySignal)
boBrkDn = boOn and (flagBrkDn or boBrkHorzDn or proBreakDn or tlBreakDn or sellSignal)
boKindCode = flagBrkUp ? 7 : flagBrkDn ? -7 : suATHBrk ? 6 : suBaseBrk ? 5 : boBrkHorzUp ? 4 : proBreakUp ? 3 : tlBreakUp ? 2 : buySignal ? 1 : boBrkHorzDn ? -4 : proBreakDn ? -3 : tlBreakDn ? -2 : sellSignal ? -1 : 0
boKindAt   = ta.valuewhen(boBrkUp or boBrkDn, boKindCode, 0)
boAgeUp = ta.barssince(boBrkUp)
boAgeDn = ta.barssince(boBrkDn)
boLiveUp = not na(boAgeUp) and boAgeUp <= boFresh and (na(boAgeDn) or boAgeUp < boAgeDn)
boLiveDn = not na(boAgeDn) and boAgeDn <= boFresh and (na(boAgeUp) or boAgeDn < boAgeUp)

boVolOwn  = volAvg > 0 ? volume / volAvg : na
boVolAt   = ta.valuewhen(boBrkUp or boBrkDn, boVolOwn, 0)
boCloAt   = ta.valuewhen(boBrkUp or boBrkDn, (close - low) / math.max(high - low, syminfo.mintick), 0)
boLvlNow  = flagBrkUp ? tlUpNow : flagBrkDn ? tlLoNow : suATHBrk ? hiAll[1] : suBaseBrk ? suHi[1] : boBrkHorzUp ? boResRef : proBreakUp ? proResNow : tlBreakUp ? tlUpNow : boBrkHorzDn ? boSupRef : proBreakDn ? proSupNow : tlBreakDn ? tlLoNow : (buySignal or sellSignal) ? moneyLine : na
boLvlAt   = ta.valuewhen(boBrkUp or boBrkDn, nz(boLvlNow, close), 0)
boLiveBar = barstate.islast and time_close > timenow

// ── THE FAILED BREAKOUT ───
boTrapUp = not na(boLvlAt) and not na(boAgeUp) and boAgeUp <= boFailBars and boAgeUp > 0 and close < boLvlAt
boTrapDn = not na(boLvlAt) and not na(boAgeDn) and boAgeDn <= boFailBars and boAgeDn > 0 and close > boLvlAt
boFailUp = boTrapUp and not boTrapUp[1]
boFailDn = boTrapDn and not boTrapDn[1]
boFailATH = boTrapUp and boKindAt == 6

// ── k1-k10: IS THIS BREAKOUT REAL ───
boDir = boLiveUp ? 1 : boLiveDn ? -1 : 0
k1  = na(boVolAt) ? false : boVolAt >= boVolSurge                                      // participation
k2  = na(boCloAt) ? false : (boDir >= 0 ? boCloAt >= 0.60 : boCloAt <= 0.40)           // closed strong, not rejected
k3  = na(rsiV)    ? false : (boDir >= 0 ? rsiV > 50 : rsiV < 50)                       // momentum on side
k4  = na(rsiV)    ? false : (boDir >= 0 ? rsiV < boRsiMax : rsiV > 100 - boRsiMax)     // not already spent
k5  = na(macdL) or na(macdS) ? false : (boDir >= 0 ? macdL > macdS : macdL < macdS)    // MACD crossed
k6  = na(macdH)   ? false : (boDir >= 0 ? macdH > 0 and macdH > macdH[1] : macdH < 0 and macdH < macdH[1])
k7  = boDir >= 0 ? trend == 1 : trend == -1                                            // ATR model agrees
k8  = na(ma200bar) ? false : (boDir >= 0 ? close > ma200bar : close < ma200bar)        // right side of the slow line
k9  = na(adxV)    ? false : adxV >= adxMin                                             // actually trending
k10 = na(ext200)  ? false : math.abs(ext200) <= extMax                                 // not stretched
boScore = (k1?1:0)+(k2?1:0)+(k3?1:0)+(k4?1:0)+(k5?1:0)+(k6?1:0)+(k7?1:0)+(k8?1:0)+(k9?1:0)+(k10?1:0)

boBrkAge    = boDir == 1 ? boAgeUp : boDir == -1 ? boAgeDn : na
boBrkUnconf = boDir != 0 and not na(boBrkAge) and boBrkAge == 0 and boLiveBar
boGate      = k1 and k2
boPending   = boBrkUnconf and not boGate
boAssess    = boDir != 0
boVerdict = not boOn ? "OFF" : thinHist ? "NO CALL — too little history" : boDir == 0 ? "NO SETUP" : boPending ? "PENDING — bar still forming" : boDir == 1 ? (boGate and boScore >= 8 ? "STRONG BUY" : boGate and boScore >= 6 ? "BUY" : boScore >= 6 ? "WATCH — no volume / weak close" : boScore >= 4 ? "WATCH" : "STAND ASIDE") : (boGate and boScore >= 8 ? "STRONG SELL" : boGate and boScore >= 6 ? "SELL" : boScore >= 6 ? "WATCH — no volume / weak close" : boScore >= 4 ? "WATCH" : "STAND ASIDE")
boActing  = boVerdict == "STRONG BUY" or boVerdict == "BUY" or boVerdict == "STRONG SELL" or boVerdict == "SELL"

boEntry  = close
boStop   = boDir == 1 ? nz(boLvlAt, close) - boStopATR * atrV : boDir == -1 ? nz(boLvlAt, close) + boStopATR * atrV : na
boRisk   = na(boStop) ? na : math.abs(boEntry - boStop)
boTgtATH = not na(hiAll) and hiAll > close * 1.005 and hiAll < close * 1.6 ? hiAll : na
boTgtMA  = not na(ma200bar) and ma200bar < close * 0.995 ? ma200bar : not na(loAll) and loAll < close * 0.995 and loAll > close * 0.5 ? loAll : na
f_tgt(float _a, float _b, float _c, float _d, bool _up, float _px, float _at, float _min) =>
    _g  = na(_at) or _at <= 0 ? 0.0 : _min * _at
    _oa = na(_a) ? false : (_up ? _a - _px >= _g : _px - _a >= _g)
    _ob = na(_b) ? false : (_up ? _b - _px >= _g : _px - _b >= _g)
    _oc = na(_c) ? false : (_up ? _c - _px >= _g : _px - _c >= _g)
    _od = na(_d) ? false : (_up ? _d - _px >= _g : _px - _d >= _g)
    _oa ? _a : _ob ? _b : _oc ? _c : _od ? _d : na

tgtUp = f_tgt(flagTgtUp, boRes, suTgt1, boTgtATH, true, close, atrV, boMinTgtATR)
tgtDn = f_tgt(flagTgtDn, boSup, suLo, boTgtMA, false, close, atrV, boMinTgtATR)
boTarget = boDir == 1 ? tgtUp : boDir == -1 ? tgtDn : na
boTgtSrc = not na(boTarget) and not na(flagTgtUp) and boTarget == flagTgtUp ? " (flag measured move)" : not na(boTarget) and not na(flagTgtDn) and boTarget == flagTgtDn ? " (flag measured move)" : boDir == 1 and na(boRes) and not na(suTgt1) ? " (measured move)" : boDir == 1 and na(boRes) and na(suTgt1) and not na(boTgtATH) ? " (all-time high)" : boDir == -1 and na(boSup) and na(suLo) and not na(boTgtMA) ? " (200-bar mean)" : ""
boRR     = na(boTarget) or na(boRisk) or boRisk <= 0 ? na : math.abs(boTarget - boEntry) / boRisk
boSizeRaw = na(boRisk) or boEntry <= 0 or boRisk <= 0 ? na : riskPct / (boRisk / boEntry * 100) * 100
boSizePc  = na(boSizeRaw) ? na : math.min(boSizeRaw, boMaxSize)

// ── THE FAST PAIR, THE EXTENSION, AND THE POLARITY FLIP ───
emaFastLen = input.int(9,  "Fast EMA", minval = 2, maxval = 50, group = "9. Fast pair & polarity")
emaSlowLen = input.int(21, "Slow EMA", minval = 3, maxval = 100, group = "9. Fast pair & polarity")
emaAtrLen  = input.int(11, "ATR length for the extension reading", minval = 2, maxval = 50, group = "9. Fast pair & polarity")
emaExtMax  = input.float(3.0, "Extended beyond this many ATR from the slow EMA", minval = 0.5, maxval = 10.0, step = 0.25, group = "9. Fast pair & polarity")
emaShow    = input.bool(true, "Plot the fast pair", group = "9. Fast pair & polarity")

f_emaExt(int _f, int _s, int _a) =>
    _e9  = ta.ema(close, _f)
    _e21 = ta.ema(close, _s)
    _at  = ta.atr(_a)
    _x9  = _at > 0 ? (close - _e9) / _at : na
    _x21 = _at > 0 ? (close - _e21) / _at : na
    _ba  = ta.barssince(close < _e21)
    [_e9, _e21, _at, _x9, _x21, _ba]

[emaF, emaS, emaAtr, emaX9, emaX21, emaBarsAbove] = f_emaExt(emaFastLen, emaSlowLen, emaAtrLen)
emaAtrPct = close > 0 and not na(emaAtr) ? emaAtr / close * 100 : na
emaPctF = not na(emaF) and emaF > 0 ? (close - emaF) / emaF * 100 : na
emaPctS = not na(emaS) and emaS > 0 ? (close - emaS) / emaS * 100 : na
emaOver   = not na(emaX21) and emaX21 >= emaExtMax

boFlipLvl = ta.valuewhen(boBrkHorzUp or suBaseBrk or suATHBrk, nz(boLvlNow, close), 0)
boFlipOn  = not na(boFlipLvl) and close > boFlipLvl
boFlipTag = boFlipOn and low <= boFlipLvl * 1.015 and close > boFlipLvl
boFlipAgo = ta.barssince(boFlipTag)
boBrkAgoU = ta.barssince(boBrkHorzUp or suBaseBrk or suATHBrk)
boFlipRe  = boFlipOn and not na(boFlipAgo) and not na(boBrkAgoU) and boFlipAgo < boBrkAgoU
boFlipPct = boFlipOn and close > 0 ? (close - boFlipLvl) / close * 100 : na
boFlipATR = boFlipOn and not na(emaAtr) and emaAtr > 0 ? (close - boFlipLvl) / emaAtr : na
boFlipFar = boFlipOn and not na(boFlipATR) and boFlipATR > boFlipMaxATR
boFlipLive = boFlipOn and not boFlipFar

// ── THE NEAREST LEVEL THAT MATTERS ───
lvlR    = na(boRes) ? (suIsBase and not na(suHi) and suHi > close ? suHi : na) : (suIsBase and not na(suHi) and suHi > close and suHi < boRes ? suHi : boRes)
lvlSa   = na(boSup) or boSup >= close ? na : boSup
lvlSb   = suIsBase and not na(suLo) and suLo < close ? suLo : na
lvlSc   = boFlipLive and not na(boFlipLvl) and boFlipLvl < close ? boFlipLvl : na
lvlS    = math.max(nz(lvlSa, -1e18), math.max(nz(lvlSb, -1e18), nz(lvlSc, -1e18)))
lvlS    := lvlS <= -1e17 ? na : lvlS
lvlRfar = na(lvlR) or na(atrV) or atrV <= 0 ? false : (lvlR - close) / atrV > lvlMaxATR
lvlSfar = na(lvlS) or na(atrV) or atrV <= 0 ? false : (close - lvlS) / atrV > lvlMaxATR
lvlRsrc = na(lvlR) ? "" : (not na(boRes) and lvlR == boRes ? " defended" : " base top")
lvlSsrc = na(lvlS) ? "" : (not na(lvlSc) and lvlS == lvlSc ? " flip-support" + (boFlipRe ? " ✓held" : " ·untested") : not na(lvlSa) and lvlS == lvlSa ? " defended" : " base floor")

// ── THE WEEKLY 9 EMA RULE ───
profOn    = input.bool(true, "Weekly 9 EMA rule (reclaim / respect / lose)", group = "10. Weekly 9 EMA rule")
profWeeks = input.int(9, "EMA length in WEEKS (not bars)", minval = 2, maxval = 52, group = "10. Weekly 9 EMA rule")
profNear  = input.float(0.5, "'At the line' = within this many ATR of it", minval = 0.1, maxval = 3.0, step = 0.1, group = "10. Weekly 9 EMA rule")
profShow  = input.bool(true, "Plot the weekly 9 EMA", group = "10. Weekly 9 EMA rule")

f_prof(int _wk, float _atr) =>
    _len = f_daysToBars(_wk * 5)
    _e   = ta.ema(close, _len)
    _ab  = close > _e
    _rec = _ab and not _ab[1]
    _los = not _ab and _ab[1]
    _res = _ab and low <= _e
    _bars = ta.barssince(not _ab)
    _px   = ta.valuewhen(_rec, close, 0)
    _dist = not na(_atr) and _atr > 0 ? (close - _e) / _atr : na
    [_len, _e, _ab, _rec, _los, _res, _bars, _px, _dist]

[profLen, profEma, profAbove, profReclaim, profLost, profRespect, profBars, profRecPx, profDist] = f_prof(profWeeks, emaAtr)
profExact = timeframe.isweekly
profGain  = profAbove and not na(profRecPx) and profRecPx > 0 ? (close - profRecPx) / profRecPx * 100 : na
profAtLine = profAbove and not na(profDist) and profDist <= profNear
profPct   = not na(profEma) and profEma > 0 ? (close - profEma) / profEma * 100 : na

// ── DRAWING — every object this section owns lives in one of three arr
var array<line>  boLn = array.new<line>()
var array<label> boLb = array.new<label>()
var array<box>   boBx = array.new<box>()
var array<line>  boVt = array.new<line>()

f_wipe(array<line> _l, array<label> _b, array<box> _x) =>
    if array.size(_l) > 0
        for i = 0 to array.size(_l) - 1
            line.delete(array.get(_l, i))
        array.clear(_l)
    if array.size(_b) > 0
        for i = 0 to array.size(_b) - 1
            label.delete(array.get(_b, i))
        array.clear(_b)
    if array.size(_x) > 0
        for i = 0 to array.size(_x) - 1
            box.delete(array.get(_x, i))
        array.clear(_x)
    0

f_boDraw(array<line> _l, array<label> _b, array<box> _x) =>
    if boShowLvl and not na(boRes)
        array.push(_l, line.new(bar_index - 100, boRes, bar_index + 12, boRes, extend = extend.right, color = color.new(#ff5252, 0), width = 2))
        array.push(_b, label.new(bar_index + 12, boRes, "DEFENDED R " + f_px(boRes) + "  ·  " + f_n0(boResHit) + " touches", style = label.style_label_left, color = color.new(#ff5252, 25), textcolor = color.white, size = size.tiny))
    if boShowLvl and not na(boSup)
        array.push(_l, line.new(bar_index - 100, boSup, bar_index + 12, boSup, extend = extend.right, color = cP18, width = 2))
        array.push(_b, label.new(bar_index + 12, boSup, "DEFENDED S " + f_px(boSup) + "  ·  " + f_n0(boSupHit) + " touches", style = label.style_label_left, color = color.new(#00e676, 25), textcolor = color.white, size = size.tiny))
    if suOn and suShowBox and suIsBase and not na(suHi) and not na(suLo)
        array.push(_x, box.new(bar_index - suBars + 1, suHi, bar_index, suLo, border_color = color.new(#00bcd4, 20), border_width = 2, bgcolor = color.new(#00bcd4, 92), text = f_n0(suBars) + "-bar base  ·  " + str.tostring(f_suW(suHi, suLo), "#.#") + "% wide", text_color = color.new(#00bcd4, 0), text_size = size.small, text_halign = text.align_center, text_valign = text.align_top))
    if suOn and suShowTgt and suIsBase and not na(suTgt1)
        array.push(_l, line.new(bar_index - suBars + 1, suTgt1, bar_index + 12, suTgt1, extend = extend.right, color = color.new(#9c27b0, 25), style = line.style_dashed, width = 1))
        array.push(_b, label.new(bar_index + 12, suTgt1, "T1 " + f_px(suTgt1) + "  (1.0x base)", style = label.style_label_left, color = color.new(#9c27b0, 30), textcolor = color.white, size = size.tiny))
        array.push(_l, line.new(bar_index - suBars + 1, suTgt2, bar_index + 12, suTgt2, extend = extend.right, color = color.new(#9c27b0, 55), style = line.style_dashed, width = 1))
        array.push(_b, label.new(bar_index + 12, suTgt2, "T2 " + f_px(suTgt2) + "  (1.618x)", style = label.style_label_left, color = color.new(#9c27b0, 55), textcolor = color.white, size = size.tiny))
    if suOn and suShowATH and not na(hiAll)
        array.push(_l, line.new(bar_index - 100, hiAll, bar_index + 12, hiAll, extend = extend.right, color = color.new(#ffc107, 20), style = line.style_dotted, width = 2))
        array.push(_b, label.new(bar_index + 12, hiAll, (suNewATH ? "AT ALL-TIME HIGH " : "ATH ") + f_px(hiAll), style = label.style_label_left, color = color.new(#ffc107, 25), textcolor = color.black, size = size.tiny))
    if wgOn and wgHave and wgApexOk
        wgApexBar = bar_index + int(math.round(wgApexN))
        wgApexPx  = tlUpNow + wgResSl * wgApexN
        array.push(_l, line.new(hiB_bar, hiB_px, wgApexBar, wgApexPx, color = cP17, width = 2))
        array.push(_l, line.new(loB_bar, loB_px, wgApexBar, wgApexPx, color = cP17, width = 2))
        array.push(_b, label.new(wgApexBar, wgApexPx, wgType + "\napex in " + f_n0(wgApexN) + " bars", style = label.style_label_left, color = cP22, textcolor = color.white, size = size.tiny))
    if wgOn and wgHave and wgIsChan
        array.push(_l, line.new(hiB_bar, hiB_px, bar_index + 15, tlUpNow + wgResSl * 15, color = color.new(#2962ff, 15), width = 2))
        array.push(_l, line.new(loB_bar, loB_px, bar_index + 15, tlLoNow + wgSupSl * 15, color = color.new(#2962ff, 15), width = 2))
        if wgShowMid
            wgMidSl = (wgResSl + wgSupSl) / 2
            wgMidNw = (tlUpNow + tlLoNow) / 2
            array.push(_l, line.new(bar_index - 40, wgMidNw - wgMidSl * 40, bar_index + 15, wgMidNw + wgMidSl * 15, color = color.new(#2962ff, 45), style = line.style_dashed, width = 1))
    if boFlipOn and boShowLvl
        array.push(_l, line.new(bar_index - 60, boFlipLvl, bar_index + 12, boFlipLvl, extend = extend.right, color = color.new(#2962ff, 10), width = 2))
        array.push(_b, label.new(bar_index + 12, boFlipLvl, "Resistance turned into support  " + f_px(boFlipLvl) + (boFlipRe ? "  ✓ retested" : "  · untested"), style = label.style_label_left, color = cP24, textcolor = color.white, size = size.tiny))
    if boActing
        array.push(_b, label.new(bar_index, boDir == 1 ? low : high, boVerdict + "  " + f_n0(boScore) + "/10", style = boDir == 1 ? label.style_label_up : label.style_label_down, color = boDir == 1 ? cP4 : cP5, textcolor = color.white, size = size.normal))
    0

f_boVert(array<line> _v) =>
    array.push(_v, line.new(bar_index, low, bar_index, high + syminfo.mintick, extend = extend.both, color = boBrkUp ? color.new(#00e676, 55) : color.new(#ff1744, 55), style = line.style_dotted, width = 1))
    if array.size(_v) > 12
        line.delete(array.shift(_v))
    0

plot(profOn and profShow and not syncMode ? profEma : na, "Weekly 9 EMA", color = color.new(#ffd600, 0), linewidth = 3)
plot(emaShow and not syncMode ? emaF : na, "Fast EMA", color = color.new(#ff5252, 10), linewidth = 2)
plot(emaShow and not syncMode ? emaS : na, "Slow EMA", color = color.new(color.gray, 10), linewidth = 2)
plotshape(boBrkHorzUp, "BO — defended level", style = shape.triangleup,   location = location.belowbar, color = cP18, size = size.small, text = "BO", textcolor = cP18)
plotshape(boBrkHorzDn, "BD — defended level", style = shape.triangledown, location = location.abovebar, color = cP21, size = size.small, text = "BD", textcolor = cP21)

if boOn and boShowVert and (boBrkUp or boBrkDn) and barstate.isconfirmed
    f_boVert(boVt)
if barstate.islast
    f_wipe(boLn, boLb, boBx)
if barstate.islast and boOn and not syncMode
    f_boDraw(boLn, boLb, boBx)

// ── THE CONSOLE ───
f_boKind(float _c) => _c == 7 ? "BULL FLAG" : _c == -7 ? "BEAR FLAG" : _c == 6 ? "ALL-TIME HIGH" : _c == 5 ? "BASE BREAKOUT" : _c == 4 ? "DEFENDED LEVEL" : _c == 3 ? "PRO TRENDLINE" : _c == 2 ? "SWING TRENDLINE" : _c == 1 ? "ATR MONEY LINE" : _c == -4 ? "DEFENDED LEVEL" : _c == -3 ? "PRO TRENDLINE" : _c == -2 ? "SWING TRENDLINE" : _c == -1 ? "ATR MONEY LINE" : "—"

f_emaCaveat() =>
    _sz = ""
    _tm = ""
    if trend == -1
        _sz := "  ⚠ the ATR model is BEARISH — a scout entry against the regime."
    else if not na(adxV) and adxV < adxMin
        _sz := "  ⚠ ADX is " + f_n1(adxV) + " — no trend to ride yet, so expect chop."
    if wgApexOk and not na(wgApexN) and wgApexN <= 5
        _tm := "  ⏱ a " + wgType + " resolves in " + f_n0(wgApexN) + " bars — size for either outcome, not just this one."
    else if suOn and suSqz
        _tm := "  ⏱ the squeeze is on — expect the range to expand soon, in whichever direction."
    _sz + _tm

// ── THE TWO MODELS, SCORED SEPARATELY ───
lnV1 = not na(profEma) ? (close > profEma ? 1 : -1) : 0
lnV2 = not na(emaS)    ? (close > emaS    ? 1 : -1) : 0
lnV3 = na(boKindAt) or boKindAt == 0 ? 0 : (boKindAt > 0 ? 1 : -1)
lnV4 = not na(ma200bar) ? (close > ma200bar ? 1 : -1) : 0
lnNet  = lnV1 + lnV2 + lnV3 + lnV4
lnBull = lnNet >= 2
lnBear = lnNet <= -2
lnWord = lnBull ? "BULLISH" : lnBear ? "BEARISH" : "MIXED"
atrBull = trend == 1
bothBuy  = atrBull and lnBull
bothSell = not atrBull and lnBear
agreeWord = bothBuy ? "BOTH AGREE — BUY SIDE" : bothSell ? "BOTH AGREE — SELL SIDE" : "SPLIT — they disagree, wait"

// ── WHAT TO DO ───
f_rsiWord(float _v) => na(_v) ? "—" : _v >= 70 ? "overbought" : _v >= 55 ? "healthy" : _v >= 45 ? "neutral" : _v >= 30 ? "weak" : "oversold"
f_adxWord(float _v) => na(_v) ? "—" : _v >= 40 ? "strong trend" : _v >= adxMin ? "trending" : "no trend (chop)"
f_volWord(float _v) => na(_v) ? "—" : _v >= 2.0 ? "heavy" : _v >= 1.5 ? "above average" : _v >= 0.8 ? "normal" : "light"

// ───
// v64 — THE BOTTOM LINE   (anchored VWAP from the cycle low)
// ───
botOn   = input.bool(true, "Bottom line — average cost of every buyer since the low", group = "v64 · BOTTOM LINE")
botLook = input.int(250, "How far back to hunt for the cycle low (bars)", minval = 50, maxval = 1000, group = "v64 · BOTTOM LINE")
botMinB  = input.int(10, "Bars of base required before it is tradable", minval = 3, maxval = 100, group = "v64 · BOTTOM LINE")
botMaxATR = input.float(6.0, "Stop calling it a bottom past this many ATR above average cost", minval = 1.0, maxval = 30.0, step = 0.5, group = "v64 · BOTTOM LINE")
botMaxPct = input.float(20.0, "...or past this % above average cost", minval = 3.0, maxval = 100.0, step = 1.0, group = "v64 · BOTTOM LINE")

botCorrMin = input.float(10.0, "A correction must be at least this deep (%) to count", minval = 2.0, maxval = 60.0, step = 1.0, group = "v64 · BOTTOM LINE")

botHi  = ta.highest(high, botLook)
botLo3 = ta.lowest(low, 3)
botCyc = math.abs(ta.lowestbars(low, botLook))
botHiO = math.abs(ta.highestbars(high, botLook))

f_anchVwap(int _n) =>
    _pv = 0.0
    _vv = 0.0
    _px = 0.0
    for _i = 0 to _n
        _pv += hlc3[_i] * nz(volume[_i])
        _vv += nz(volume[_i])
        _px += hlc3[_i]
    _vv > 0 ? _pv / _vv : _px / (_n + 1)

f_lowOff(int _n) =>
    _lo = high
    _k = 0
    for _i = 0 to _n
        if low[_i] < _lo
            _lo := low[_i]
            _k := _i
    _k

corrOff = f_lowOff(botHiO)
corrLo  = low[corrOff]
corrDD  = botHi > 0 ? (botHi - corrLo) / botHi * 100 : na

cycAV  = f_anchVwap(botCyc)
corrAV = f_anchVwap(corrOff)
cycLo  = low[botCyc]
cycStr = na(cycAV) or na(atrV) or atrV <= 0 ? na : (close - cycAV) / atrV
cycPct = na(cycAV) ? na : (close - cycAV) / close * 100
cycOld = not na(cycStr) and cycStr > botMaxATR or not na(cycPct) and cycPct > botMaxPct

useCorr = cycOld and corrOff >= botMinB and not na(corrDD) and corrDD >= botCorrMin

botAV    = useCorr ? corrAV : cycAV
botAnc   = useCorr ? corrLo : cycLo
botN     = useCorr ? corrOff : botCyc
botSrc   = useCorr ? "correction low" : "cycle low"
botRise  = not na(botAV) and not na(botAV[1]) and botAV > botAV[1]
botAbove = not na(botAV) and close > botAV
botReady = botN >= botMinB
botStr   = na(botAV) or na(atrV) or atrV <= 0 ? na : (close - botAV) / atrV
botDistP = na(botAV) ? na : (close - botAV) / close * 100
botMature = cycOld and not useCorr

// ══════════════════════════════════════════════════════════════
// REVERSAL PATTERNS · CANDLES · THE 50/200 CROSS
// The triangles, wedges, flags, channels and bases are already read
// further up (wgType, flagWord, suIsBase). What was missing is the
// family built from matching swing points — double and triple tops
// and bottoms, and head and shoulders — plus the seven candles and
// the 50/200 cross. Daily and weekly come from regD / regW, which
// are already fetched, so none of this adds a request.security call.
// ══════════════════════════════════════════════════════════════
patOn    = input.bool(true, "Reversal patterns: double/triple top & bottom, head and shoulders", group = "11. Patterns")
patPiv   = input.int(5, "Pattern pivot strength (bars each side)", minval = 2, maxval = 30, group = "11. Patterns")
patTol   = input.float(3.0, "Two highs (or lows) count as equal within this %", minval = 0.5, maxval = 15.0, step = 0.5, group = "11. Patterns")
patHSpc  = input.float(3.0, "Head must clear both shoulders by this %", minval = 1.0, maxval = 25.0, step = 0.5, group = "11. Patterns")
patAge   = input.int(60, "Forget a pattern once its last swing is this many bars old", minval = 10, maxval = 300, group = "11. Patterns")
patLbl   = input.bool(true, "Mark confirmed patterns and crosses on the chart", group = "11. Patterns")
candOn   = input.bool(true, "Read the last candle (hammer, engulfing, doji, star)", group = "11. Patterns")
candDoji = input.float(10.0, "Doji: body under this % of the candle's range", minval = 1.0, maxval = 40.0, step = 1.0, group = "11. Patterns")
candWick = input.float(2.0, "Hammer / shooting star: shadow this many times the body", minval = 1.0, maxval = 6.0, step = 0.5, group = "11. Patterns")
gcOn     = input.bool(true, "Golden cross / death cross on the 50-bar vs 200-bar MA", group = "11. Patterns")
gcNew    = input.int(26, "A cross counts as news for this many bars; older is background", minval = 4, maxval = 400, group = "11. Patterns")
bqPEmax  = input.float(35.0, "P/E above this counts as expensive", minval = 5.0, maxval = 200.0, step = 1.0, group = "11. Patterns")

// ── the last three swing highs and lows ───
// Held as plain state and rewritten only when a pivot confirms, so there
// is nothing to drift: every value is a real swing the chart printed.
patPH = ta.pivothigh(high, patPiv, patPiv)
patPL = ta.pivotlow(low, patPiv, patPiv)
var float pH1 = na
var float pH2 = na
var float pH3 = na
var int pH1b = na
var int pH2b = na
var int pH3b = na
var float pL1 = na
var float pL2 = na
var float pL3 = na
var int pL1b = na
var int pL2b = na
var int pL3b = na
if not na(patPH)
    pH3 := pH2
    pH2 := pH1
    pH1 := patPH
    pH3b := pH2b
    pH2b := pH1b
    pH1b := bar_index - patPiv
if not na(patPL)
    pL3 := pL2
    pL2 := pL1
    pL1 := patPL
    pL3b := pL2b
    pL2b := pL1b
    pL1b := bar_index - patPiv

f_eqPct(float _a, float _b, float _tol) => not na(_a) and not na(_b) and _b != 0 and math.abs(_a - _b) / math.abs(_b) * 100 <= _tol

patHaveH = not na(pH1) and not na(pH2)
patHaveL = not na(pL1) and not na(pL2)
patFresh = patOn and not na(pH1b) and not na(pL1b) and bar_index - math.max(pH1b, pL1b) <= patAge

// The neckline is the swing between the matching extremes, found by bar index
// rather than by "whichever pivot is newest". Picking the newest would work
// until price broke the neckline and printed a fresh swing - at which point
// the pattern would vanish from the panel at the exact moment it mattered.
farOff = 1e20
f_pick(float _v, int _b, int _lo, int _hi) => na(_b) or na(_lo) or na(_hi) or _b <= _lo or _b >= _hi ? na : _v
f_lo3(int _lo, int _hi) => math.min(nz(f_pick(pL1, pL1b, _lo, _hi), farOff), math.min(nz(f_pick(pL2, pL2b, _lo, _hi), farOff), nz(f_pick(pL3, pL3b, _lo, _hi), farOff)))
f_hi3(int _lo, int _hi) => math.max(nz(f_pick(pH1, pH1b, _lo, _hi), -farOff), math.max(nz(f_pick(pH2, pH2b, _lo, _hi), -farOff), nz(f_pick(pH3, pH3b, _lo, _hi), -farOff)))

nk2T = f_lo3(pH2b, pH1b)
nk3T = f_lo3(pH3b, pH1b)
nk2B = f_hi3(pL2b, pL1b)
nk3B = f_hi3(pL3b, pL1b)

patDT = patFresh and patHaveH and f_eqPct(pH1, pH2, patTol) and nk2T < farOff
patDB = patFresh and patHaveL and f_eqPct(pL1, pL2, patTol) and nk2B > -farOff
patTT = patDT and not na(pH3) and f_eqPct(pH3, pH1, patTol) and nk3T < farOff
patTB = patDB and not na(pL3) and f_eqPct(pL3, pL1, patTol) and nk3B > -farOff
patHS = patFresh and patHaveH and not na(pH3) and pH2 > pH1 * (1 + patHSpc / 100) and pH2 > pH3 * (1 + patHSpc / 100) and f_eqPct(pH1, pH3, patTol) and nk3T < farOff
patIH = patFresh and patHaveL and not na(pL3) and pL2 < pL1 * (1 - patHSpc / 100) and pL2 < pL3 * (1 - patHSpc / 100) and f_eqPct(pL1, pL3, patTol) and nk3B > -farOff

patDir  = patHS or patTT or patDT ? -1 : patIH or patTB or patDB ? 1 : 0
patName = patHS ? "HEAD AND SHOULDERS" : patIH ? "INVERSE HEAD AND SHOULDERS" : patTT ? "TRIPLE TOP" : patTB ? "TRIPLE BOTTOM" : patDT ? "DOUBLE TOP" : patDB ? "DOUBLE BOTTOM" : ""
patNeck = patHS or patTT ? nk3T : patIH or patTB ? nk3B : patDT ? nk2T : patDB ? nk2B : na
patExt  = patHS ? pH2 : patIH ? pL2 : patDir == -1 ? math.max(pH1, pH2) : patDir == 1 ? math.min(pL1, pL2) : na
patHgt  = na(patNeck) or na(patExt) ? na : math.abs(patExt - patNeck)
patTgt  = na(patHgt) ? na : patDir == -1 ? patNeck - patHgt : patDir == 1 ? patNeck + patHgt : na
patConf = na(patNeck) ? false : patDir == -1 ? close < patNeck : patDir == 1 ? close > patNeck : false
patNew  = patConf and not patConf[1]
patDead = na(patExt) ? false : patDir == -1 ? close > patExt : patDir == 1 ? close < patExt : false

// A confirmed pattern is remembered, because the swing that confirms it will
// eventually roll the pivot store forward and erase the live read. The target
// outlives the detection, so the panel keeps reporting it until it is hit or
// the pattern ages out.
var string patMem = ""
var float patMemT = na
var float patMemN = na
var int patMemD = 0
var int patMemB = na
if patNew
    patMem := patName
    patMemT := patTgt
    patMemN := patNeck
    patMemD := patDir
    patMemB := bar_index
patMemAge = na(patMemB) ? na : bar_index - patMemB
patMemOld = patMem != "" and not na(patMemAge) and patMemAge <= patAge
// A remembered pattern is only still a pattern while price respects the side it
// broke to. Close back through the neckline and it has failed: reporting a
// triple top as live while price trades above its own neckline is worse than
// saying nothing at all.
patMemBack = patMemOld and not na(patMemN) and (patMemD == -1 ? close > patMemN : close < patMemN)
var bool patMemX = false
if patNew
    patMemX := false
if patMemBack
    patMemX := true
patMemHit = patMemOld and not na(patMemT) and (patMemD == -1 ? low <= patMemT : high >= patMemT)
patMemLive = patMemOld and not patMemX and not patMemHit
patMemGap = na(patMemT) or close <= 0 ? na : math.abs(patMemT - close) / close * 100

// ── the 50/200 cross ───
// ta.* kept out of the ternary and off the `and`, so the call runs on every
// bar whatever the input says (CW10002).
gcRaw = ta.crossover(ma50bar, ma200bar)
dcRaw = ta.crossunder(ma50bar, ma200bar)
gcX = gcOn and gcRaw
dcX = gcOn and dcRaw
gcBars = ta.barssince(gcRaw)
dcBars = ta.barssince(dcRaw)
gcAbove = not na(ma50bar) and not na(ma200bar) and ma50bar > ma200bar
gcAge = gcAbove ? gcBars : dcBars
// A cross of two slow averages lags the price feeding it: it can read "golden"
// during a fall from 345 to 128. And a cross 512 bars back is structure, not an
// event. Both were being stated bare, which is what made the row misleading.
gcStale = not na(ma200bar) and (gcAbove ? close < ma200bar : close > ma200bar)
gcFresh = not na(gcAge) and gcAge <= gcNew
gcShort = not gcOn or na(ma50bar) or na(ma200bar) ? "" : (gcFresh ? (gcAbove ? "▲ GOLDEN CROSS " : "▼ DEATH CROSS ") + f_n0(gcAge) + " bars ago" : (gcAbove ? "50-bar above the 200-bar" : "50-bar below the 200-bar") + (na(gcAge) ? "" : ", crossed " + f_n0(gcAge) + " back — background, not a signal")) + (not gcStale ? "" : gcAbove ? " — and price is BELOW the 200-bar, so it is stale" : " — and price is back ABOVE the 200-bar, so it is lagging")

// ── the seven candles ───
// A shape only means something where it sits, so the hammer and the shooting
// star are named as signals only when they follow the move they are meant to
// reverse; otherwise they are reported as shapes and nothing more.
cRng = high - low
cBod = math.abs(close - open)
cUpW = high - math.max(close, open)
cDnW = math.min(close, open) - low
cDown5 = not na(close[5]) and close[1] < close[5]
cUp5 = not na(close[5]) and close[1] > close[5]
cDoji = cRng > 0 and cBod / cRng * 100 <= candDoji
cHam = cRng > 0 and not cDoji and cDnW >= cBod * candWick and cUpW <= cBod
cSS = cRng > 0 and not cDoji and cUpW >= cBod * candWick and cDnW <= cBod
cBE = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
cSE = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]
cSml1 = not na(high[1]) and high[1] - low[1] > 0 and math.abs(close[1] - open[1]) / (high[1] - low[1]) * 100 <= 50
cMS = close[2] < open[2] and cSml1 and close > open and close > (open[2] + close[2]) / 2
cES = close[2] > open[2] and cSml1 and close < open and close < (open[2] + close[2]) / 2
cB1 = close[1] > open[1]
cR1 = close[1] < open[1]
cBod1 = math.abs(close[1] - open[1])
cHar = cBod < cBod1 * 0.6 and math.max(close, open) <= math.max(close[1], open[1]) and math.min(close, open) >= math.min(close[1], open[1])
cBullHar = cHar and cR1 and close > open
cBearHar = cHar and cB1 and close < open
cPierce = cR1 and close > open and open < low[1] and close > (open[1] + close[1]) / 2 and close < open[1]
cDark = cB1 and close < open and open > high[1] and close < (open[1] + close[1]) / 2 and close > open[1]
cTwzB = cR1 and close > open and cRng > 0 and math.abs(low - low[1]) <= cRng * 0.1
cTwzT = cB1 and close < open and cRng > 0 and math.abs(high - high[1]) <= cRng * 0.1
c3W = close > open and close[1] > open[1] and close[2] > open[2] and close > close[1] and close[1] > close[2]
c3B = close < open and close[1] < open[1] and close[2] < open[2] and close < close[1] and close[1] < close[2]
cInvH = cRng > 0 and not cDoji and cUpW >= cBod * candWick and cDnW <= cBod and cDown5
cHang = cRng > 0 and not cDoji and cDnW >= cBod * candWick and cUpW <= cBod and cUp5
candName = not candOn ? "" : cMS ? "MORNING STAR" : cES ? "EVENING STAR" : cBE ? "BULLISH ENGULFING" : cSE ? "BEARISH ENGULFING" : c3W ? "THREE WHITE SOLDIERS" : c3B ? "THREE BLACK CROWS" : cPierce ? "PIERCING LINE" : cDark ? "DARK CLOUD COVER" : cBullHar ? "BULLISH HARAMI" : cBearHar ? "BEARISH HARAMI" : cTwzB ? "TWEEZER BOTTOM" : cTwzT ? "TWEEZER TOP" : cInvH ? "INVERTED HAMMER" : cHang ? "HANGING MAN" : cHam ? (cDown5 ? "HAMMER" : "hammer shape, but not after a decline") : cSS ? (cUp5 ? "SHOOTING STAR" : "shooting-star shape, but not after a rally") : cDoji ? "DOJI" : ""
candBull = cMS or cBE or c3W or cPierce or cBullHar or cTwzB or cInvH or (cHam and cDown5)
candBear = cES or cSE or c3B or cDark or cBearHar or cTwzT or cHang or (cSS and cUp5)
// Most bars match no textbook shape. Saying only "none named" threw away what
// the bar did: RELIANCE closed +4.6% near its high on a long lower tail and the
// row reported nothing. An unnamed candle still gets described - but it does
// not become candBull, so it never votes in the bottom score.
candPlain = (close > open ? "▲ up bar" : close < open ? "▼ down bar" : "► flat bar") + (cRng <= 0 ? "" : cDnW >= cRng * 0.35 ? ", long lower tail" : cUpW >= cRng * 0.35 ? ", long upper tail" : cBod / cRng >= 0.6 ? ", strong body" : "")
candSay = not candOn ? "" : candName == "" ? "last candle " + candPlain : "last candle " + (candBull ? "▲ BULLISH" : candBear ? "▼ BEARISH" : cDoji ? "► indecision" : "► neutral") + ": " + candName

// ── daily and weekly, stated plainly ───
// On a weekly chart "Weekly" and "This chart" are the same series. Listing both
// read as two agreeing opinions and counted the same vote twice, which is how a
// single bullish weekly became "2 of 3 bullish".
tfSameD = timeframe.isdaily and timeframe.multiplier == 1
tfSameW = timeframe.isweekly and timeframe.multiplier == 1
tfCnt = 1 + (tfSameD ? 0 : 1) + (tfSameW ? 0 : 1)

// ── BOTTOM SCORE ───
botDeep  = input.float(20.0, "Washout: % off the high to qualify", minval = 5.0, maxval = 80.0, step = 1.0, group = "v64 · BOTTOM SCORE")
botRsiOS = input.float(32.0, "Oversold: RSI must have reached this", minval = 10.0, maxval = 50.0, step = 1.0, group = "v64 · BOTTOM SCORE")
botRec   = input.int(30, "How recently those must have happened (bars)", minval = 5, maxval = 200, group = "v64 · BOTTOM SCORE")
botVolX  = input.float(2.0, "Capitulation: down-bar volume vs average", minval = 1.2, maxval = 10.0, step = 0.1, group = "v64 · BOTTOM SCORE")
botPivL  = input.int(5, "Pivot left bars", minval = 2, maxval = 20, group = "v64 · BOTTOM SCORE")
botPivR  = input.int(3, "Pivot right bars (this is the confirmation lag)", minval = 1, maxval = 20, group = "v64 · BOTTOM SCORE")
botRsiUp = input.float(45.0, "Oversold level for a PULLBACK in an uptrend", minval = 20.0, maxval = 60.0, step = 1.0, group = "v64 · BOTTOM SCORE")
botRngX  = input.float(2.0, "Capitulation range (x ATR) when the symbol reports no volume", minval = 1.0, maxval = 8.0, step = 0.1, group = "v64 · BOTTOM SCORE")
botHLatr = input.float(0.5, "A holding low must sit this many ATR above the anchor", minval = 0.1, maxval = 5.0, step = 0.1, group = "v64 · BOTTOM SCORE")
botLvlATR = input.float(1.0, "The low must form within this many ATR of a real support level", minval = 0.2, maxval = 5.0, step = 0.1, group = "v64 · BOTTOM SCORE")
botNeed  = input.int(7, "Checks required to call it a bottom (of 13)", minval = 3, maxval = 13, group = "v64 · BOTTOM SCORE")
botCool  = input.int(20, "Minimum bars between BOTTOM labels", minval = 1, maxval = 200, group = "v64 · BOTTOM SCORE")

botDD   = botHi > 0 ? (botHi - close) / botHi * 100 : na
botRsLo = ta.lowest(rsiV, botRec)
botCapV = close < open and volAvg > 0 ? volume / volAvg : 0.0
botCap  = ta.highest(botCapV, botRec)
botCapR = close < open and not na(atrV) and atrV > 0 ? ta.tr / atrV : 0.0
botCapX = ta.highest(botCapR, botRec)
botPv   = ta.pivotlow(low, botPivL, botPivR)
var float pvP1 = na
var float pvP2 = na
var float pvR1 = na
var float pvR2 = na
if not na(botPv)
    pvP2 := pvP1
    pvR2 := pvR1
    pvP1 := botPv
    pvR1 := rsiV[botPivR]

bv1 = useCorr ? not na(corrDD) and corrDD >= botCorrMin : not na(botDD) and botDD >= botDeep
bv2 = not na(botRsLo) and botRsLo <= (useCorr ? botRsiUp : botRsiOS)
bv3 = not na(pvP1) and not na(pvP2) and (pvP1 < pvP2 and pvR1 > pvR2 or pvP1 > pvP2) or botReady and not na(atrV) and atrV > 0 and not na(botAnc) and botLo3 - botAnc >= botHLatr * atrV
bv4 = na(volRatio) ? botCapX >= botRngX : botCap >= botVolX
// 5 RECLAIM counts either moving average that matters here: the 21 EMA, or
//   the weekly EMA the method actually trades. A low that reclaims one of
//   them has done the same thing.
// 6 MOMENTUM accepts a MACD cross as well as a rising histogram - the cross
//   is the stronger signal and was being ignored.
// 8 LEVEL is the piece that was missing entirely. A low that forms at a
//   defended support, a base floor or an old flip level is worth far more
//   than the same low in mid-air: there is a reason for buyers to be there.
//   It asks that the anchor low sit within botLvlATR of a real level AND
//   that price still hold above it.
bv5 = not na(emaS) and close > emaS or profOn and profAbove
bv6 = not na(macdH) and macdH > macdH[1] or macdXUp
bv7 = botAbove and botRise
bv8 = not na(lvlS) and not na(botAnc) and not na(atrV) and atrV > 0 and math.abs(botAnc - lvlS) <= botLvlATR * atrV and close > lvlS
// The chart patterns and the candles were computed after this block and so
// could never reach it. With the detection moved above, a bullish reversal
// shape and a bullish candle become checks nine and ten.
bv9 = (patConf and patDir == 1) or (patMemLive and patMemD == 1) or (wgType == "FALLING WEDGE" and not na(tlUpNow) and close > tlUpNow)
bv10 = candBull
// The two indicators on the panel that never reached this score. ADX cooling
// says the decline is losing force, which is what a low is made of. The daily
// turning up before the chart timeframe is the classic early tell.
// The 50/200 cross is deliberately NOT here: real bottoms form in death-cross
// territory, so requiring it would guarantee missing them.
// A bottom is not in until the swing structure turns: the last pivot low
// above the one before it AND the last pivot high above the one before it.
// Everything else here is a reason to expect a turn; this is the turn.
bv13 = not na(pL1) and not na(pL2) and not na(pH1) and not na(pH2) and pL1 > pL2 and pH1 > pH2
bv11 = not na(adxV) and not na(adxV[3]) and adxV < adxV[3]
bv12 = regD == 1
botScr  = (bv1 ? 1 : 0) + (bv2 ? 1 : 0) + (bv3 ? 1 : 0) + (bv4 ? 1 : 0) + (bv5 ? 1 : 0) + (bv6 ? 1 : 0) + (bv7 ? 1 : 0) + (bv8 ? 1 : 0) + (bv9 ? 1 : 0) + (bv10 ? 1 : 0) + (bv11 ? 1 : 0) + (bv12 ? 1 : 0) + (bv13 ? 1 : 0)
// The row counted the missing signs without ever saying which, so "2 more
// signs needed" gave the reader nothing to watch for. Each check gets a name.
// Short names on purpose: with seven of the ten missing, the long form ran
// past the right edge of the panel and the sentence was cut mid-word.
botMissR = (bv13 ? "" : "higher low + higher high · ") + (bv9 ? "" : "reversal pattern · ") + (bv10 ? "" : "bullish candle · ") + (bv1 ? "" : "deep fall · ") + (bv2 ? "" : "RSI oversold · ") + (bv3 ? "" : "divergence · ") + (bv4 ? "" : "volume spike · ") + (bv5 ? "" : "above fast EMA · ") + (bv6 ? "" : "MACD up · ") + (bv7 ? "" : "holding the low · ") + (bv8 ? "" : "support · ") + (bv11 ? "" : "ADX cooling · ") + (bv12 ? "" : "daily turned up · ")
botMiss = botMissR == "" ? "" : str.substring(botMissR, 0, math.max(0, str.length(botMissR) - 3))
botMissN = 13 - botScr

// ─── THREE GATES, because the seven checks only detect a BOUNCE ───
// TCS printed BOTTOM over and over from 4200 down to 2120. Every one of the
// seven checks goes true on any rally inside a downtrend - washout, oversold,
// capitulation, a 21 EMA reclaim, MACD turning up, holding above average cost
// are all things a bear-market bounce does. A score of 5 means "this looks
// like a low", not "this is the low", and on the way down a stock produces
// that look five or six times.
//
// 1 LONG-TERM TREND. A low while the 200-bar average is below where it was a
//   year ago is a counter-trend bounce, whatever the score says. Rows 12 and
//   13 already refused TCS on exactly this ground while row 11 kept buying
//   it; now they agree. This gate alone removes every false TCS signal and
//   touches none of the others on your list.
// 2 STRUCTURE BREAK. A downtrend ends when price takes out a prior high, not
//   when it stops falling. Requiring a new multi-bar high turns "the selling
//   paused" into "the buyers won", which is what a bottom actually is.
// 3 ESCALATION. Each failed bottom raises the bar for the next one. If this
//   level has already fooled the engine once, one more check is the price of
//   admission to try again.
var bool botFail = false
var float botSigLo = na
var int botSigBar = na
botHiBars = input.int(8, "Structure break: close above the high of this many bars", minval = 3, maxval = 52, group = "v64 · BOTTOM SCORE")
botLTreq  = input.bool(true, "Require the long-term trend to be up (stops knife-catching)", group = "v64 · BOTTOM SCORE")
ltDown  = not na(ma200bar) and not na(ma200bar[52]) and ma200bar < ma200bar[52]
botNewHi = close > ta.highest(high, botHiBars)[1]
botRFail = botFail and not na(botSigBar) and bar_index - botSigBar <= botLook
botNeedN = botNeed + (botRFail ? 1 : 0)
botBlock = botLTreq and ltDown ? "long-term trend still DOWN" : not botNewHi ? "no structure break yet" : ""
botConf = botScr >= botNeedN and not botMature and botReady and botBlock == ""

var int botLastSig = na
botSigRaw = botOn and botConf and not botConf[1]
botSig = botSigRaw and (na(botLastSig) or bar_index - botLastSig >= botCool or botFail)
if botSig
    botLastSig := bar_index
    botSigLo := botAnc
    botSigBar := bar_index
    botFail := false
if not na(botSigLo) and low < botSigLo
    botFail := true
botFailNew = botFail and not botFail[1]

plotshape(botFailNew, title = "BOTTOM failed", style = shape.xcross, location = location.belowbar, color = cP5, size = size.tiny, text = "✗ bottom failed", textcolor = cP5)

plotshape(botSig, title = "BOTTOM confirmed", style = shape.labelup, location = location.belowbar, color = cP4, text = "BOTTOM", textcolor = color.white, size = size.small)
alertcondition(botSig, title = "Bottom confirmed", message = "BOTTOM confirmed on {{ticker}} — bottom score met on the {{interval}} chart")

f_botTicks() =>
    (bv1 ? "✓" : "✗") + "washout " + (bv2 ? "✓" : "✗") + "oversold " + (bv3 ? "✓" : "✗") + "structure " + (bv4 ? "✓" : "✗") + "volume " + (bv5 ? "✓" : "✗") + "21EMA " + (bv6 ? "✓" : "✗") + "MACD " + (bv7 ? "✓" : "✗") + "cost " + (bv8 ? "✓" : "✗") + "level"

// The plot breaks on the bar the anchor switches. Without the gap the line
// jumps from one average cost straight to the other and TradingView draws the
// connector, which on gold was a near-vertical teal line a thousand points
// long - a price level that never existed, through bars nobody traded at.
// botN counts bars since the anchor, so in normal running it goes up by one
// each bar. Any other step means the anchor itself moved - a new low printed,
// or the old one rolled out of the lookback - and the average cost is then
// measured from a different bar, which is a different number, not a move in
// the old one. Breaking only on the mode switch missed this: TCS still drew
// 1,500-point vertical teal lines in 2020 and 2022 where the cycle anchor
// jumped while useCorr never changed.
botJump = useCorr != useCorr[1] or botN != nz(botN[1]) + 1
plot(botOn and not syncMode and not botJump ? botAV : na, "Bottom line — average cost since the anchor low", color = color.new(#00bfa5, 0), linewidth = 3)

f_botSay() =>
    _s = ""
    if not botOn or na(botAV)
        _s := "—"
    else if botMature
        _s := "MATURED — a trend now, not a bottom. " + f_n1(cycPct) + "% above the cycle low's average cost, and the current pullback is only " + f_n1(corrDD) + "% deep — too shallow to call a bottom. Judge this on the rows above."
    else if not botReady
        _s := "TOO EARLY — only " + f_n0(botN) + " bar(s) since the " + botSrc + " at " + f_px(botAnc) + ". Let a base build before buying."
    else
        _s := (useCorr ? "PULLBACK " : "BOTTOM ") + f_n0(botScr) + " of 13 " + (botConf ? (bv13 ? "✓ CONFIRMED — buy zone" : "⚠ scored, but no higher low + higher high yet") : botBlock != "" ? "⚠ BOUNCE ONLY — " + botBlock : botScr >= botNeedN - 1 ? "— ONE CHECK SHORT, get ready" : "— not a bottom yet") + (botRFail ? "  ·  a bottom here already failed at " + f_px(botSigLo) + ", bar raised" : "") + " (" + botSrc + " " + f_px(botAnc) + ").  " + f_botTicks() + (botAbove ? "  ·  " + f_n1(botDistP) + "% above avg cost " + f_px(botAV) : "  ·  " + str.tostring(math.abs(botDistP), "#.#") + "% UNDER avg cost " + f_px(botAV) + ", buyers off the low are offside")
    _s
botSay = f_botSay()

// ── ROW 12 · BUY BIG AND HOLD ───
bigRoe  = input.float(12.0, "Quality: minimum ROE %", minval = 0.0, maxval = 60.0, step = 1.0, group = "v64 · BUY BIG")
bigDE   = input.float(1.5, "Quality: maximum debt / equity", minval = 0.1, maxval = 10.0, step = 0.1, group = "v64 · BUY BIG")
bigDD   = input.float(25.0, "Discount: minimum % off the high", minval = 5.0, maxval = 80.0, step = 1.0, group = "v64 · BUY BIG")
bigNeed = input.int(3, "Quality checks required (of 4)", minval = 1, maxval = 4, group = "v64 · BUY BIG")

bqProf  = not na(niTTM) and niTTM > 0
bqGrow  = not na(revGrowth) and revGrowth > 0
bqRoe   = not na(roeFY) and roeFY >= bigRoe
bqDebt  = not na(deFY) and deFY <= bigDE
bqHave  = not na(niTTM) or not na(roeFY) or not na(revGrowth)
bqN     = (bqProf ? 1 : 0) + (bqGrow ? 1 : 0) + (bqRoe ? 1 : 0) + (bqDebt ? 1 : 0)
bqTrend = not na(ma200bar) and not na(ma200bar[52]) and ma200bar > ma200bar[52]
bqDisc  = not na(botDD) and botDD >= bigDD
bigBuy  = botOn and botConf and bqHave and bqN >= bigNeed and bqTrend and bqDisc
bigSig  = bigBuy and not bigBuy[1]

plotshape(bigSig, title = "BUY BIG", style = shape.labelup, location = location.belowbar, color = color.new(#1b5e20, 0), text = "BUY BIG", textcolor = color.white, size = size.normal)
alertcondition(bigSig, title = "Buy big and hold", message = "BUY BIG on {{ticker}} — confirmed bottom in a quality business at a discount ({{interval}})")

f_bigSay() =>
    _b = ""
    if not botOn
        _b := "—"
    else if not bqHave
        _b := "NO FINANCIALS for this symbol — this row only grades individual stocks. Judge indices, metals and crypto on the rows above."
    else if bigBuy
        _b := "★ BUY BIG AND HOLD — bottom confirmed, business qualifies " + f_n0(bqN) + "/4, " + f_n1(botDD) + "% off the high, 200-bar MA still rising. Size up and hold; this is the compounding entry."
    else if botMature
        _b := "NOT THIS SETUP — price is a long way above its low, so there is no discount to buy. Business grades " + f_n0(bqN) + "/4 and the long-term trend is " + (bqTrend ? "intact" : "broken") + ". This row waits for a real selloff; it is not a verdict on the stock."
    else if not botConf
        _b := "NOT YET — the bottom is not confirmed on the chart (see BOTTOM). Business grade " + f_n0(bqN) + "/4" + (bqN >= bigNeed ? ", which is fine — it is the chart that is not ready." : ", so it would not qualify anyway.")
    else if not bqTrend
        _b := "NOT A LONG-TERM BUY — the 200-bar MA is LOWER than a year ago, so the multi-year uptrend is over. Business grades " + f_n0(bqN) + "/4" + (bqN >= bigNeed ? ", which is not the problem" : ", which is also weak") + ". Trade it on the rows above; do not hold until that average turns up — a rolled-over trend prints washouts all the way down."
    else if bqN < bigNeed
        _b := "NO — the chart bottomed but the business does not qualify (" + f_n0(bqN) + "/4): " + (bqProf ? "" : "not profitable · ") + (bqGrow ? "" : "revenue not growing · ") + (bqRoe ? "" : "ROE below " + f_n0(bigRoe) + "% · ") + (bqDebt ? "" : "debt too high") + ". Trade it, do not hold it."
    else
        _b := "GOOD, NOT GENERATIONAL — bottom confirmed and business qualifies " + f_n0(bqN) + "/4, but only " + f_n1(botDD) + "% off the high. Normal size. BUY BIG wants " + f_n0(bigDD) + "% or more."
    _b
bigSay = f_bigSay()

// ── ROW 13 · EXIT THE LONG-TERM HOLD ───
exTrim = input.float(8.0, "Trim when this many ATR above the 200-bar MA", minval = 2.0, maxval = 30.0, step = 0.5, group = "v64 · EXIT")

exRoll = ltDown
exStr  = na(ma200bar) or na(atrV) or atrV <= 0 ? na : (close - ma200bar) / atrV
// Any negative number counted as deterioration, so LULU - profitable, ROE 34%,
// debt/equity 0.4, graded 3/4 - was called deteriorating on revenue of -0.1%
// and told to SELL EVERYTHING. A decline has to be big enough to be a decline.
bizRevMin = input.float(-5.0, "Revenue growth below this counts as deteriorating (%)", minval = -50.0, maxval = 0.0, step = 0.5, group = "v64 · EXIT")
exBizRev = not na(revGrowth) and revGrowth < bizRevMin
exBiz  = bqHave and (not bqProf or exBizRev or bqN <= 1)
// Name the reason rather than printing a grade that may look healthy.
bizWhy = not bqProf ? "it is lossmaking" : exBizRev ? "revenue is " + f_n1(revGrowth) + "%" : "it grades " + f_n0(bqN) + "/4"
exFade = not na(macdH) and macdH < macdH[1]
exHot  = not na(exStr) and exStr >= exTrim and exFade
exSig  = botOn and exRoll and not exRoll[1]

plotshape(exSig, title = "EXIT long-term hold", style = shape.labeldown, location = location.abovebar, color = color.new(#b71c1c, 0), text = "EXIT", textcolor = color.white, size = size.normal)
alertcondition(exSig, title = "Exit the long-term hold", message = "EXIT on {{ticker}} — the 200-bar MA has rolled over ({{interval}})")

f_exitSay() =>
    _x = ""
    if not botOn
        _x := "—"
    else if exRoll and exBiz
        _x := "⛔ SELL EVERYTHING — the 200-bar MA is FALLING and the business is deteriorating: " + bizWhy + ". Both reasons to own this are gone. This is not a dip to buy."
    else if exRoll
        _x := "EXIT THE LONG-TERM HOLD — the 200-bar MA has rolled over, so the multi-year trend is finished" + (bqHave ? " even though the business still grades " + f_n0(bqN) + "/4" : "") + ". Close the investment; trade it on the rows above if you still want exposure."
    else if exBiz
        // exRoll is false when there is no 200-bar MA to roll over, so this
        // branch was asserting "the trend still holds" on a symbol too young to
        // have a long-term trend at all - SPCX, 132 days old, bearish on every
        // other row. Absence of the test is not a pass.
        _x := "WARNING — the business is deteriorating: " + bizWhy + " (grade " + f_n0(bqN) + "/4). " + (na(ma200bar) ? "No 200-bar MA yet — too little history to judge the long-term trend. Trade only." : atrBull ? "The trend still holds, but this is how long-term holds die. Stop adding; exit if the 200-bar MA rolls over." : "The trend has turned too. Stop adding.")
    else if exHot
        _x := "TRIM — " + f_n1(exStr) + " ATR above the 200-bar MA and momentum is fading. Take something off, keep the core, add back nearer " + f_px(ma200bar) + "."
    else if profOn and profLost
        _x := "IF YOU OWN IT — HOLD, BUT WATCH. Closed below the " + f_n0(profWeeks) + "-week EMA " + f_px(profEma) + ". First crack, not yet an exit: the 200-bar MA is still rising. Stop adding until it is reclaimed."
    else
        _x := "IF YOU OWN IT — HOLD. Nothing is broken: 200-bar MA still rising" + (bqHave ? ", business " + f_n0(bqN) + "/4" : "") + (na(exStr) ? "" : ", " + f_n1(exStr) + " ATR above the long-term mean") + ". Do nothing."
    _x
exitSay = f_exitSay()


// ─── BOTTOM CALL ───
// Row 10 reports the score. This one answers the question in plain words -
// is this the low, is it forming, or is it still a long way off - and names
// the one thing that would move it to the next stage. The score is evidence;
// this is the verdict, and most of the time the verdict is "not yet".
f_botCall() =>
    _c = ""
    _gap = botNeedN - botScr
    // A label that fired and then lapsed leaves nothing on screen to say so.
    // The failure mark only appears when price undercuts the anchor low; when
    // the low holds but the confirmation simply goes away - price slips back
    // under the 8-bar high - the label stands there unqualified and reads as a
    // live buy. BTC showed exactly that: a BOTTOM a few bars back, and a panel
    // saying do not buy ahead of it, with no way to reconcile the two.
    _age = na(botLastSig) or botFail ? na : bar_index - botLastSig
    // "Do not buy" is right when the chart is broken and wrong when it is not.
    // BTC showed DO THIS saying buy the 9-week EMA pullback and size up, with
    // BOTTOM CALL saying do not buy, three rows apart. Both were correct about
    // their own question: one is the trend trade, the other is the bottom
    // signal. In an intact uptrend this row should decline to answer the first.
    _nb = trend == 1 ? " Bottom signal only; the trend trade is in DO THIS." : " Do not buy ahead of it."
    _lapsed = not botConf and not na(_age) and _age <= botCool ? "  ·  the BOTTOM label " + f_n0(_age) + " bars back LAPSED — the low holds, the setup does not" : ""
    if not botOn
        _c := "—"
    else if botMature
        _c := "NOT A BOTTOM QUESTION — price is a long way above its low. Judge this as a trend, on the rows above."
    else if exRoll and exBiz
        _c := "⛔ DO NOT BUY THIS LOW — the trend is falling and " + bizWhy + ". Companies in decline make lower lows, not bottoms. Whatever the score says, there is no floor under this one."
    else if botConf and trend == 1
        // "Best entry this chart offers" is true at the low and false once price
        // has run away from it. BRK.B sat 17% above its anchor and 1.9% off the
        // all-time high while this row still called it the best entry going.
        _c := "✅ THE BOTTOM IS IN — the ATR model has turned up with it." + (na(botAnc) or botAnc <= 0 ? "" : (close - botAnc) / botAnc * 100 >= 10 ? "  But price has already run " + f_n1((close - botAnc) / botAnc * 100) + "% off that low — you are buying the continuation, not the bottom." : "  This is the best entry this chart offers.") + " Stop on a close below " + f_px(botAnc) + " (the swing low)" + (na(botAnc) or close <= 0 ? "" : " — " + f_n1((close - botAnc) / close * 100) + "% risk") + "."
    else if botConf
        _c := "✅ BOTTOM LOOKS IN — start a first position, small. The ATR model has not turned yet, so add only on a " + tfWord + " close above " + f_px(moneyLine) + ". Stop below " + f_px(botAnc) + "."
    else if _gap <= 0 and botBlock != ""
        _c := "⏳ BOTTOM IS FORMING — one thing missing: " + botBlock + ". Set an alert." + _nb + _lapsed
    else if _gap <= 1
        _c := "⏳ BOTTOM IS FORMING — one check short" + (botMiss == "" ? "" : ", any one of: " + botMiss) + (botBlock == "" ? "" : ", and " + botBlock) + "." + _nb + _lapsed
    else if botScr >= 2
        _c := "⚠ BOTTOM IS STILL AWAY — need any " + f_n0(_gap) + " of these " + f_n0(botMissN) + ": " + botMiss + (botRFail ? ". A bottom here already failed" : "") + ". A bounce here is a trade, not an entry."
    else
        _c := "⛔ STILL FALLING — almost no sign of a low. Stay out; there is nothing to catch yet."
    _c
botCall = f_botCall()

// Every branch that says buy, add or hold has to know the long-term trend.
// This was fixed twice one branch at a time - the flip retest for ORCL, the
// EMA reclaim for TCS - while five more branches had the same hole. One
// caveat, appended at every such site, is the fix for the class.
// The target was a number with no instruction attached. NUMBERS printed it
// while the setup was live and nothing spoke when price arrived, which is
// the one moment a plan is worth having. This states the plan in advance -
// what to do there, decided now, while nothing is at stake.
f_tgtPlan() =>
    _n = thinHist ? "not enough history" : "none in range"
    _fib = na(tgtDn) or tgtDn >= close ? na : tgtDn + (close - tgtDn) * 1.618
    _sky = na(tgtUp) and not thinHist and not na(moneyLine) and close > moneyLine
    _pj = thinHist or na(atrV) or atrV <= 0
    _u = _sky ? "blue sky, 2R projection " + f_px(close + (close - moneyLine) * 2) : na(tgtUp) ? (_pj ? _n : "3 ATR projection " + f_px(close + atrV * 3)) : f_px(tgtUp) + "  +" + f_n1((tgtUp - close) / close * 100) + "%" + (close >= tgtUp ? " ✓" : "")
    _d = na(tgtDn) ? (_pj ? _n : "3 ATR projection " + f_px(close - atrV * 3)) : f_px(tgtDn) + "  −" + f_n1((close - tgtDn) / close * 100) + "%" + (close <= tgtDn ? " ✓" : "")
    _far = not na(tgtDn) and (close - tgtDn) / close * 100 > 20
    "▲ UP " + _u + "   ·   ▼ DOWN " + _d + (na(_fib) ? "" : "   ·   fib 1.618 " + f_px(_fib)) + (_far ? (atrBull ? "   ·   nothing below if it breaks — not broken yet, so this is a sizing note" : "   ·   nothing to lean on below — the air pocket is live") : "") + "   ·   " + (boDir == 1 ? "bank a third to a half at the upside, lift the stop to the money line, trail the rest" : boDir == -1 ? "cover into the downside; never add at a target" : "no live break — these are the levels either way")
tgtPlan = f_tgtPlan()

f_ltWarn() => ltDown ? "  ⚠ 200-bar MA falling — counter-trend, keep it small." : ""

f_whatToDo() =>
    _a = ""
    if not boOn
        _a := "—"
    else if thinHist
        _a := "DO NOTHING — only " + f_n0(histDays) + " days of history. Nothing here is trustworthy yet."
    else if boTrapUp
        _a := "FAILED BREAKOUT" + (boFailATH ? " AT ALL-TIME HIGHS" : "") + " — price broke " + f_px(boLvlAt) + " and has closed back UNDER it. If you bought that break you are offside: get out. Do not re-buy until a close back above " + f_px(boLvlAt) + "."
    else if boTrapDn
        // Written for a short seller, it left a long reader with "wait" while
        // BUY NOW? said buy here on 10 of 14. In an uptrend a failed breakdown
        // is support holding, which is the long case, not a reason to stand by.
        _a := "FAILED BREAKDOWN — price broke " + f_px(boLvlAt) + " and has closed back ABOVE it. Shorts are trapped; cover." + (atrBull ? " Support held and the uptrend stands — the long case is in BUY NOW?." : " The level has to fail again to mean anything.")
    else if boPending or boBrkUnconf
        _a := "WAIT for this bar to close. A level is giving way intrabar and it can still un-happen."
    else if profOn and profLost
        // One close below the EMA is the swing rule firing, not the regime
        // turning. A bare EXIT printed over a bullish ATR model and a BUY-SIDE
        // verdict was the panel arguing with itself.
        _a := atrBull ? "SWING EXIT — closed below the " + f_n0(profWeeks) + "-week EMA " + f_px(profEma) + ". Ends the TRADE, not the position: ATR still bullish above " + f_px(moneyLine) + ". Re-enter on a close above the EMA; long hold is the LONG TERM row." : "EXIT — closed below the " + f_n0(profWeeks) + "-week EMA " + f_px(profEma) + " and the ATR model is bearish too. Re-entry only on a close back above it."
    else if boDir == -1 and boGate and boScore >= 6
        _a := "EXIT / STAY OUT. Stop for a short " + f_px(boStop) + (na(boTarget) ? "" : ", target " + f_px(boTarget)) + ". Do not buy until a close back above " + f_px(boLvlAt) + "."
    else if boDir == 1 and boGate and boScore >= 6
        _a := (bothSell ? "BUY SMALL — against the trend. " : "BUY ") + (na(boSizePc) ? "" : f_n1(boSizePc) + "% of account at " + f_n1(riskPct) + "% risk") + ". Stop " + f_px(boStop) + (na(boTarget) ? "" : ", first target " + f_px(boTarget) + (na(boRR) ? "" : " (R:R " + str.tostring(boRR, "#.##") + ")")) + "." + (bothSell ? " Row 3 reads sell side: a confirmed break up here is an early turn, not a trend trade." : "") + f_ltWarn()
    else if profOn and (profReclaim or profRespect or profAtLine) and not emaOver
        _a := (ltDown ? "COUNTER-TREND TRADE ONLY near " : trend == -1 ? "HALF SIZE AT MOST near " : "BUY near ") + f_px(profEma) + " — the " + f_n0(profWeeks) + "-week EMA. Stop on a CLOSE below it." + (ltDown ? " The 200-bar MA is falling, so this is a bounce to trade, not a position to build. Keep it small." : trend == -1 ? "" : " Size up here because the stop is close.") + f_emaCaveat()
    else if boFlipLive and boFlipRe and not emaOver
        _a := (bothSell ? "COUNTER-TREND BOUNCE ONLY at " : trend == -1 ? "HALF SIZE AT MOST at " : not bothBuy ? "MODELS SPLIT (see VERDICT) — half size at most on the retest of " : "BUY the retest of ") + f_px(boFlipLvl) + ". Stop just under it — tightest stop available on this chart." + (bothSell ? " Both models read sell side, so this is a trade against the trend, not an entry." : "") + f_ltWarn()
    else if emaOver
        _a := "DO NOT START HERE. " + f_n1(emaX21) + " ATR above the " + f_n0(emaSlowLen) + " EMA. Hold what you have; add only back near " + f_px(emaS) + "."
    else if profOn and profAbove and not na(profBars) and profBars >= 3 and trend == 1
        _a := "HOLD. Exit is a CLOSE below " + f_px(profEma) + ". Add only on a pullback back toward it — do not add " + (na(profDist) ? "out here." : f_n1(profDist) + " ATR above it.") + f_ltWarn()
    else if botOn and botConf and trend == -1
        _a := "SCALE IN SLOWLY — bottom score " + f_n0(botScr) + "/" + f_n0(botNeedN) + ". ATR model still bearish, but price holds above the average cost since the low (" + f_px(botAV) + ") and that line is RISING. Quarter size · add above " + f_px(moneyLine) + " · out below " + f_px(botAV) + "."
    else if suIsBase
        _a := "DO NOTHING YET — mid-base, nothing to buy here. LADDER (" + tfWord + " closes): " + (profOn and not na(profEma) ? "above " + f_px(profEma) + " " + f_n0(profWeeks) + "wEMA = pullback over · " : "") + "above " + f_px(moneyLine) + " = ATR turns bullish · above " + f_px(suHi) + " = base breaks, full size · below " + f_px(suLo) + " = all off." + f_ltWarn()
    else if trend == 1 and lnBear
        _a := "HOLD ONLY IF ALREADY LONG — and do not add. The ATR line is still bullish but " + str.tostring((lnV1 > 0 ? 1 : 0) + (lnV2 > 0 ? 1 : 0) + (lnV3 > 0 ? 1 : 0) + (lnV4 > 0 ? 1 : 0), "#") + " of 4 lines are. That gap usually closes by the ATR line giving way. Exit on a close below " + f_px(moneyLine) + "."
    else if trend == 1
        _a := "HOLD. Only act if a " + tfWord + " candle CLOSES below " + f_px(moneyLine) + "." + f_ltWarn()
    else if lnBull
        _a := "STAY OUT, but watch closely — the lines have turned up while the ATR model has not. It confirms on a " + tfWord + " close above " + f_px(moneyLine) + " (" + str.tostring((moneyLine - close) / close * 100, "#.#") + "% away). Anything bought before that is a scout entry against the regime."
    else
        _a := "STAY OUT. Your only entry trigger is a " + tfWord + " close above " + f_px(moneyLine) + " (" + str.tostring((moneyLine - close) / close * 100, "#.#") + "% away)."
    _a

boWTD = f_whatToDo()

tfNB = (trend == 1 ? 1 : 0) + (not tfSameD and not na(regD) and regD == 1 ? 1 : 0) + (not tfSameW and not na(regW) and regW == 1 ? 1 : 0)
tfAll = tfCnt == 3 ? "ALL THREE" : "BOTH"
tfConf = (not tfSameD and na(regD)) or (not tfSameW and na(regW)) ? "partial data" : tfNB == tfCnt ? tfAll + " BULLISH — the cleanest backdrop there is" : tfNB == 0 ? tfAll + " BEARISH — stand aside" : "CONFLICT " + str.tostring(tfNB) + "/" + str.tostring(tfCnt) + " bullish — the small timeframe is fighting the big one"
tfSay = (tfSameD ? "" : "Daily " + f_arw(regD) + "   ·   ") + (tfSameW ? "" : "Weekly " + f_arw(regW) + "   ·   ") + "This chart (" + tfWord + ") " + f_arw(trend) + "   —   " + tfConf

patMemWord = patMem == "" or not patMemOld ? "" : patMemX ? patMem + " from " + f_n0(patMemAge) + " bars ago has FAILED — price closed back through " + f_px(patMemN) : patMemHit ? patMem + " from " + f_n0(patMemAge) + " bars ago — target " + f_px(patMemT) + " ✓ REACHED" : patMem + " confirmed " + f_n0(patMemAge) + " bars ago, neckline " + f_px(patMemN) + (na(patMemT) ? "" : ", target " + f_px(patMemT) + " — AWAITING, " + f_n1(patMemGap) + "% away")
patSay = not patOn ? gcShort : patName == "" ? (patMemWord == "" ? "no double/triple top or bottom and no head and shoulders in the last " + f_n0(patAge) + " bars" : patMemWord) + (gcShort == "" ? "" : "   ·   " + gcShort) : patName + (patConf ? " CONFIRMED — closed " + (patDir == 1 ? "above " : "below ") + f_px(patNeck) : patDead ? " FAILED — price went back through " + f_px(patExt) : " FORMING — not a signal until a " + tfWord + " close " + (patDir == 1 ? "above " : "below ") + f_px(patNeck)) + (na(patTgt) ? "" : "   target " + f_px(patTgt)) + (na(patExt) ? "" : "   stop " + f_px(patExt)) + (gcShort == "" ? "" : "   ·   " + gcShort)

// ── the final call ───
// Seven checks that are already on the panel, counted in one place so the
// console ends with a verdict instead of leaving the reader to add up rows.
// Five checks that each assert something bullish. This counted seven, and two
// of them were "no topping pattern" and "no bearish candle" - absence of bad
// news, which scored a stock in freefall at 2/7 and printed it as "leaning".
// Those two now qualify the sentence instead of padding the count.
fc1 = atrBull
fc2 = lnBull
fc3 = regD == 1
fc4 = regW == 1
fc5 = gcAbove and not gcStale
fcMax = 5
fcN = (fc1 ? 1 : 0) + (fc2 ? 1 : 0) + (fc3 ? 1 : 0) + (fc4 ? 1 : 0) + (fc5 ? 1 : 0)
fcRaw = fcN >= fcMax ? "ALIGNED BULLISH" : fcN == 4 ? "LEANING BULLISH" : fcN == 3 ? "MIXED — no edge" : fcN >= 1 ? "LEANING BEARISH" : "ALIGNED BEARISH"
// Never print ALIGNED BULLISH above a LONG TERM row that says to get out.
fcWord = ltDown and fcN >= 4 ? "BULLISH BUT COUNTER-TREND" : fcRaw
fcMiss = (fc1 ? "" : "ATR · ") + (fc2 ? "" : "lines · ") + (fc3 ? "" : "daily · ") + (fc4 ? "" : "weekly · ") + (fc5 ? "" : "50/200 · ")
fcPat = patConf and patDir == -1 ? "  Topping pattern live." : patConf and patDir == 1 ? "  Bottoming pattern live." : patMemLive and patMemD == -1 ? "  Topping pattern still live." : patMemLive and patMemD == 1 ? "  Bottoming pattern still live." : ""
fcCan = candBear ? "  Bearish candle." : candBull ? "  Bullish candle." : ""
fcSay = "★ " + fcWord + "   " + str.tostring(fcN) + "/" + str.tostring(fcMax) + " bullish" + (fcN == fcMax ? " — everything agrees." : " — against: " + str.substring(fcMiss, 0, math.max(0, str.length(fcMiss) - 3))) + "   Flip " + f_px(moneyLine) + "." + fcPat + fcCan + f_ltWarn()

// ══════════════════════════════════════════════════════════════
// BUSINESS · BUY NOW? · SELL NOW?
// P/E comes out of epsTTM, which is already fetched - the script is at
// 40/40 request calls, so a ratio that can be derived is the only kind
// that can still be added.
// ══════════════════════════════════════════════════════════════
peTTM = not na(epsTTM) and epsTTM > 0 ? close / epsTTM : na
// Market cap with no new request: the script is at 40/40, so shares have to be
// derived. Net income over EPS gives the share count, and price does the rest.
// Both are TTM so they are the same period. It needs positive EPS, so a
// lossmaking company reports n/a rather than a negative market cap.
mcShares = not na(niTTM) and not na(epsTTM) and epsTTM != 0 ? niTTM / epsTTM : na
mcapV = na(mcShares) or mcShares <= 0 ? na : mcShares * close
f_cap(float _v) => na(_v) or _v <= 0 ? "n/a" : _v >= 1e12 ? str.tostring(_v / 1e12, "#.##") + "T" : _v >= 1e9 ? str.tostring(_v / 1e9, "#.#") + "B" : _v >= 1e6 ? str.tostring(_v / 1e6, "#") + "M" : str.tostring(_v, "#")
bqPE = not na(peTTM) and peTTM <= bqPEmax
bizSay = not bqHave ? "NO FINANCIALS for this symbol — an index, metal or crypto is judged on the rows above, not here" : "Grade " + f_n0(bqN) + "/4   ·   cap " + f_cap(mcapV) + " " + syminfo.currency + "   ·   P/E " + (na(peTTM) ? "n/a" : f_n1(peTTM) + (bqPE ? " ok" : " RICH")) + "   ·   profitable " + (bqProf ? "✓" : "✗") + "   ·   revenue " + (bqGrow ? "✓" : "✗") + (na(revGrowth) ? "" : " " + (revGrowth >= 0 ? "+" : "") + f_n1(revGrowth) + "%") + "   ·   ROE " + (na(roeFY) ? "n/a" : f_n1(roeFY) + "%" + (bqRoe ? " ✓" : " ✗")) + "   ·   debt/eq " + (na(deFY) ? "n/a" : f_n1(deFY) + (bqDebt ? " ✓" : " ✗"))

// Eight entry conditions, drawn from the rows above so the answer cannot
// disagree with the evidence the panel is already showing.
// Fourteen conditions in five families, so the row can show WHICH family is
// against the trade rather than a bare number. Eight of these were here
// before; ADX, the 50/200 cross, the 200-bar line, the bottom engine and the
// triangle/wedge/flag family were not, and patterns could only ever count
// against a buy, never for one.
wgUpBrk = not na(tlUpNow) and close > tlUpNow
wgDnBrk = not na(tlLoNow) and close < tlLoNow
wgHgt = na(hiA_px) or na(loA_px) ? na : math.abs(hiA_px - loA_px)
wgTgt = na(wgHgt) ? na : wgDnBrk ? tlLoNow - wgHgt : wgUpBrk ? tlUpNow + wgHgt : na
stBull = flagBull or pennUp or suIsBase or ((wgType == "FALLING WEDGE" or wgType == "ASCENDING TRIANGLE") and wgUpBrk) or (wgType == "RECTANGLE" and atrBull)
stBear = flagBear or pennDn or ((wgType == "RISING WEDGE" or wgType == "DESCENDING TRIANGLE") and wgDnBrk) or (wgType == "RECTANGLE" and not atrBull)
mcdUp = not na(macdL) and not na(macdS) and (macdL > macdS or macdXUp or (not na(macdH) and macdH > nz(macdH[1])))
over200 = not na(ma200bar) and close > ma200bar
patUp = (patConf and patDir == 1) or (patMemLive and patMemD == 1) or botConf
patDn = (patConf and patDir == -1) or (patMemLive and patMemD == -1)

// A verdict per row, in that row's own terms, so each can be read on its own
// instead of only through the FINAL CALL. These live in their own variables
// so the row lines they prefix do not get any wider.
patVote = ((patConf and patDir == 1) or (patMemLive and patMemD == 1) ? 1 : 0) - ((patConf and patDir == -1) or (patMemLive and patMemD == -1) ? 1 : 0) + (stBull ? 1 : 0) - (stBear ? 1 : 0) + (gcStale ? 0 : gcAbove ? 1 : -1)
patWord = (patVote >= 2 ? "▲ BULLISH" : patVote <= -2 ? "▼ BEARISH" : patVote == 1 ? "► leaning bullish" : patVote == -1 ? "► leaning bearish" : "► NEUTRAL") + " per patterns   ·   "
// RSI and MACD give direction. ADX and volume give force, not side, so they
// describe the move in the row rather than voting on it.
momVote = (na(rsiV) ? 0 : rsiV >= 55 ? 1 : rsiV <= 45 ? -1 : 0) + (mcdUp ? 1 : not na(macdL) and not na(macdS) and macdL < macdS ? -1 : 0)
momWord = (momVote >= 2 ? "▲ BULLISH" : momVote <= -2 ? "▼ BEARISH" : momVote == 1 ? "► leaning bullish" : momVote == -1 ? "► leaning bearish" : "► NEUTRAL") + " per indicators   ·   "

buy1 = atrBull
buy2 = not na(moneyLine) and close > moneyLine
buy3 = lnBull
buy4 = over200
buy5 = gcAbove
buy6 = not (regD == -1 and regW == -1)
buy7 = not patDn
buy8 = patUp
buy9 = stBull
buy10 = not na(rsiV) and rsiV >= 45 and rsiV <= 72
buy11 = mcdUp
buy12 = not na(adxV) and adxV >= 20
buy13 = na(volRatio) or volRatio >= 1.0
buy14 = not emaOver
bA = (buy1 ? 1 : 0) + (buy2 ? 1 : 0)
// buy3 is the LINES row's own verdict; buy4 and buy5 are long-term MA
// structure. Billing all three as "lines" put "lines 1/3" under a LINES row
// reading "3 of 4 bullish", which reads as the panel contradicting itself.
bLn = buy3 ? 1 : 0
bLT = (buy4 ? 1 : 0) + (buy5 ? 1 : 0)
bL = bLn + bLT
bT = buy6 ? 1 : 0
bP = (buy7 ? 1 : 0) + (buy8 ? 1 : 0) + (buy9 ? 1 : 0)
bI = (buy10 ? 1 : 0) + (buy11 ? 1 : 0) + (buy12 ? 1 : 0) + (buy13 ? 1 : 0) + (buy14 ? 1 : 0)
buyN = bA + bL + bT + bP + bI
buyGrp = "ATR " + str.tostring(bA) + "/2 · lines " + str.tostring(bLn) + "/1 · long-term " + str.tostring(bLT) + "/2 · daily+weekly " + str.tostring(bT) + "/1 · patterns " + str.tostring(bP) + "/3 · indicators " + str.tostring(bI) + "/5"
buyGo = buyN >= 10 and buy1 and buy2
// The money line is the regime boundary, not an entry stop. On TCS that is
// 16.4% below price while the panel's own structural stop sits at 10.5% and
// DO THIS is already using it. Take the tighter of the two and name which.
buyTight = not na(boStop) and boDir == 1 and boStop < close and (na(moneyLine) or boStop > moneyLine)
buyStop = buyTight ? boStop : moneyLine
buyRiskPc = na(buyStop) or close <= 0 ? na : (close - buyStop) / close * 100
buySay = buyGo ? (ltDown ? "✅ YES, BUT COUNTER-TREND — " : "✅ YES — ") + f_n0(buyN) + "/14   " + buyGrp + "   Buy here, stop " + f_px(buyStop) + (buyTight ? " (trade stop" : " (the money line") + (na(buyRiskPc) ? ")" : ", " + f_n1(buyRiskPc) + "% risk)") + ", grade " + grade + "." + f_ltWarn() : buyN >= 8 ? "⏳ ALMOST — " + f_n0(buyN) + "/14   " + buyGrp + "   Trigger: a " + tfWord + " close above " + f_px(moneyLine) + "." : "⛔ NO — " + f_n0(buyN) + "/14   " + buyGrp + "."

sel1 = not atrBull
sel2 = not na(moneyLine) and close < moneyLine
sel3 = lnBear
sel4 = not over200
sel5 = not gcAbove
sel6 = regD == -1 and regW == -1
sel7 = patDn
sel8 = not patUp
sel9 = stBear
sel10 = not na(rsiV) and (rsiV >= 78 or rsiV < 40)
sel11 = not na(macdL) and not na(macdS) and macdL < macdS
sel12 = not na(adxV) and adxV >= 20 and not atrBull
sel13 = profOn and profLost
sel14 = emaOver
sA = (sel1 ? 1 : 0) + (sel2 ? 1 : 0)
sLn = sel3 ? 1 : 0
sLT = (sel4 ? 1 : 0) + (sel5 ? 1 : 0)
sL = sLn + sLT
sT = sel6 ? 1 : 0
sP = (sel7 ? 1 : 0) + (sel8 ? 1 : 0) + (sel9 ? 1 : 0)
sI = (sel10 ? 1 : 0) + (sel11 ? 1 : 0) + (sel12 ? 1 : 0) + (sel13 ? 1 : 0) + (sel14 ? 1 : 0)
selN = sA + sL + sT + sP + sI
selGrp = "ATR " + str.tostring(sA) + "/2 · lines " + str.tostring(sLn) + "/1 · long-term " + str.tostring(sLT) + "/2 · daily+weekly " + str.tostring(sT) + "/1 · patterns " + str.tostring(sP) + "/3 · indicators " + str.tostring(sI) + "/5"
// Telling a reader to "exit below" a line price has already broken is advice
// for a position the regime closed long ago. Say which side they are on.
selOut = na(moneyLine) ? "" : close > moneyLine ? "  Exit fully on a close below " + f_px(moneyLine) + "." : "  Price is already below the line, so the regime exit has fired."
// In the buy zone there are two exits and they are not the same thing: the
// trade stop is where THIS trade is wrong, the money line is where the whole
// stance flips. Quoting only one of them left the reader guessing which.
selSay = buyGo ? "✅ NO — this is the buy zone." + (buyTight ? "  Trade stop " + f_px(buyStop) + "; regime exit on a close below " + f_px(moneyLine) + "." : selOut) : selN >= 9 ? "⛔ YES — SELL or REDUCE. " + f_n0(selN) + "/14   " + selGrp + "." + selOut : selN >= 6 ? "⚠ TRIM — " + f_n0(selN) + "/14   " + selGrp + "." + selOut : "✅ NO — only " + f_n0(selN) + "/14 sell signs.   " + selGrp + "." + selOut

if patLbl and patNew and not na(patTgt)
    label.new(bar_index, patDir == 1 ? low : high, patName + "\ntarget " + f_px(patTgt), style = patDir == 1 ? label.style_label_up : label.style_label_down, color = patDir == 1 ? cP12 : cP11, textcolor = color.white, size = size.small)
// The label a confirmed pattern printed stays on the chart for good. When the
// pattern later fails, that label is still advertising a target that is dead,
// so the failure gets marked too - the same courtesy the bottom call already
// gets with its "bottom failed" cross.
patFailNew = patMemBack and not patMemX[1]
if patLbl and patFailNew
    label.new(bar_index, patMemD == -1 ? high : low, "✗ " + patMem + " failed", style = patMemD == -1 ? label.style_label_down : label.style_label_up, color = cP2, textcolor = color.white, size = size.tiny)
if patLbl and (gcX or dcX)
    label.new(bar_index, gcX ? low : high, gcX ? "GOLDEN CROSS" : "DEATH CROSS", style = gcX ? label.style_label_up : label.style_label_down, color = gcX ? cP4 : cP5, textcolor = color.white, size = size.small)

// ── THE 10-LINE SUMMARY ───
// One helper for all 26 console cells. Every one carried the same 19 tokens
// of white text, left align and txtSize; at 100,351 against a limit of
// 100,256 that repetition was the whole overage. No ta.*, no var, no history
// inside, so calling it from the barstate branch stays pure.
f_boSummary(table _t) =>
    if barstate.islast and boOn
        table.clear(_t, 0, 0, 1, 25)
        aCol = atrBull ? cP13 : cP11
        lCol = lnBull ? cP13 : lnBear ? cP11 : cP3
        vCol = bothBuy ? cP4 : bothSell ? cP5 : color.new(color.orange, 0)
        bCol = not botOn or na(botAV) ? cP9 : botConf ? cP12 : botAbove ? cP2 : cP11
        ltBad = exRoll or exBiz or exHot or (profOn and profLost)
        ltCol = not bqHave and not ltBad ? cP9 : exRoll and exBiz ? color.new(#b71c1c, 0) : exRoll ? cP6 : exBiz or exHot ? cP15 : bigBuy ? color.new(#1b5e20, 0) : color.new(#1b5e20, 30)
        _r = 0
        f_cellL(_t, 0, _r, "ATR MODEL", cP8)
        f_cellL(_t, 1, _r, (atrBull ? "▲ BULLISH   —   STAY LONG above " + f_px(moneyLine) + "   ·   SELL on a " + tfWord + " close BELOW it" : "▼ BEARISH   —   STAY OUT below " + f_px(moneyLine) + "   ·   BUY on a " + tfWord + " close ABOVE it") + "   (" + str.tostring(math.abs(moneyLine - close) / close * 100, "#.#") + "% " + (moneyLine > close ? "above" : "below") + " price)", aCol)
        _r := _r + 1
        f_cellL(_t, 0, _r, "LINES", cP8)
        f_cellL(_t, 1, _r, (lnBull ? "▲ BULLISH" : lnBear ? "▼ BEARISH" : "► MIXED") + "  " + str.tostring((lnV1 > 0 ? 1 : 0) + (lnV2 > 0 ? 1 : 0) + (lnV3 > 0 ? 1 : 0) + (lnV4 > 0 ? 1 : 0), "#") + " of 4 lines bullish   —   " + f_n0(profWeeks) + "wEMA " + (lnV1 > 0 ? "▲ above" : lnV1 < 0 ? "▼ below" : "· n/a") + "   ·   21EMA " + (lnV2 > 0 ? "▲ above" : lnV2 < 0 ? "▼ below" : "· n/a") + "   ·   last break " + (lnV3 > 0 ? "▲ up" : lnV3 < 0 ? "▼ down" : "· none") + "   ·   200-bar " + (lnV4 > 0 ? "▲ above" : lnV4 < 0 ? "▼ below" : "· n/a"), lCol)
        _r := _r + 1
        f_cellL(_t, 0, _r, "TIMEFRAMES", cP8)
        f_cellL(_t, 1, _r, tfSay, tfNB == tfCnt ? cP12 : tfNB == 0 ? cP11 : cP3)
        _r := _r + 1
        if patOn or gcOn
            f_cellL(_t, 0, _r, "PATTERN", cP8)
            f_cellL(_t, 1, _r, patWord + patSay, patConf and patDir == 1 ? cP12 : patConf and patDir == -1 ? cP11 : patName == "" ? cP9 : cP3)
            _r := _r + 1
        f_cellL(_t, 0, _r, "MOMENTUM", color.new(color.purple, 25))
        f_cellL(_t, 1, _r, momWord + "RSI " + (na(rsiV) ? "—" : f_n0(rsiV) + " " + f_rsiWord(rsiV)) + "   ·   MACD " + (na(macdL) or na(macdS) ? "—" : (macdL > macdS ? "up" : "down") + (na(macdH) ? "" : macdH > nz(macdH[1]) ? ", building" : ", fading")) + "   ·   ADX " + (na(adxV) ? "—" : f_n0(adxV) + " " + f_adxWord(adxV)) + "   ·   vol " + (na(volRatio) ? "not reported for this symbol — the volume check is skipped" : str.tostring(volRatio, "#.##") + "x the 20-bar average — " + f_volWord(volRatio) + (boDir == 0 ? "" : "   ·   on the break " + (na(boVolAt) ? "—" : str.tostring(boVolAt, "#.##") + "x " + (k1 ? "✓" : boBrkUnconf ? "⧗ still filling" : "✗ too light")))) + (candSay == "" ? "" : "   ·   " + candSay), color.new(color.purple, 0))
        _r := _r + 1
        f_cellL(_t, 0, _r, "BUSINESS", color.new(#4527a0, 10))
        f_cellL(_t, 1, _r, bizSay, not bqHave ? cP9 : bqN >= 3 and bqPE ? cP12 : bqN >= 3 ? cP13 : bqN == 2 ? cP3 : cP11)
        _r := _r + 1
        f_cellL(_t, 0, _r, "VERDICT", cP8)
        f_cellL(_t, 1, _r, agreeWord + (boTrapUp ? "   ⚠ failed breakout = Wyckoff upthrust, the break was retaken" : boTrapDn ? "   ⚠ failed breakdown = Wyckoff spring, shorts trapped" : "") + (boDir == 0 ? "   ·   nothing has broken recently" : "   ·   " + f_boKind(boKindAt) + " broke " + f_n0(boBrkAge) + " bar(s) ago, " + f_n0(boScore) + "/10" + (boBrkUnconf ? " ⧗ bar not closed" : boGate ? " ✓gate" : " ✗gate — " + (k1 ? "weak close" : k2 ? "no volume surge" : "no volume surge, weak close"))), vCol)
        _r := _r + 1
        f_cellL(_t, 0, _r, "▶ DO THIS", cP8)
        f_cellL(_t, 1, _r, boWTD, color.new(#00695c, 10))
        _r := _r + 1
        f_cellL(_t, 0, _r, "✅ BUY NOW?", cP8)
        f_cellL(_t, 1, _r, buySay, buyGo ? color.new(#1b5e20, 0) : buyN >= 8 ? cP3 : cP11)
        _r := _r + 1
        f_cellL(_t, 0, _r, "⛔ SELL NOW?", cP8)
        f_cellL(_t, 1, _r, selSay, buyGo or selN < 6 ? color.new(#1b5e20, 30) : selN >= 9 ? color.new(#b71c1c, 0) : cP15)
        _r := _r + 1
        tCol = boDir == 0 ? cP9 : boDir == -1 ? cP5 : color.new(#00695c, 0)
        f_cellL(_t, 0, _r, "AT TARGET", cP8)
        f_cellL(_t, 1, _r, tgtPlan, tCol)
        _r := _r + 1
        // The evidence rows. They explain the verdict rather than carry it, so a
        // compact panel drops them and keeps the four decision rows plus the two
        // long-horizon ones. Row numbers are gone from the labels for the same
        // reason: with rows appearing and disappearing, a printed "7" would lie.
        if not boSlim
            f_cellL(_t, 0, _r, "NUMBERS", color.new(color.navy, 15))
            f_cellL(_t, 1, _r, boDir == 0 or na(boStop) ? "no live setup — nothing to size yet" : (boGate ? "" : boPending ? "⧗ NOT SETTLED, bar still filling — reference only:  " : "⚠ GATE FAILED — reference only, do NOT size off this:  ") + "entry " + f_px(boEntry) + "   stop " + f_px(boStop) + "   (" + f_n1(boRisk / boEntry * 100) + "% risk)" + (na(boTarget) ? "" : "   target " + f_px(boTarget) + boTgtSrc) + (na(boRR) ? "" : "   R:R " + str.tostring(boRR, "#.##")) + (na(boSizePc) ? "" : "   size " + f_n1(boSizePc) + "%" + (not na(boSizeRaw) and boSizeRaw > boMaxSize + 0.05 ? " (capped, risk maths said " + f_n1(boSizeRaw) + "%)" : "")), color.new(color.navy, 0))
            _r := _r + 1
            f_cellL(_t, 0, _r, "TREND", color.new(#ffd600, 30))
            f_cellL(_t, 1, _r, na(profEma) ? "—" : (profAbove ? "above" : "below") + " the " + f_n0(profWeeks) + "wEMA " + f_px(profEma) + (profAbove and not na(profBars) ? ", held " + f_n0(profBars) + " bars" : "") + (na(profGain) ? "" : ", " + (profGain >= 0 ? "+" : "") + f_n1(profGain) + "% since reclaim") + (na(emaX21) ? "" : "   ·   " + f_n1(emaX21) + "x ATR from the 21" + (emaOver ? " ⚠ extended" : "")), profAbove ? color.new(#00c853, 45) : color.new(#d50000, 45))
            _r := _r + 1
            f_cellL(_t, 0, _r, "LEVELS", color.new(color.olive, 20))
            f_cellL(_t, 1, _r, (na(lvlR) or lvlRfar ? "resistance — none within " + f_n0(lvlMaxATR) + " ATR" : "resistance " + f_px(lvlR) + lvlRsrc + " (" + str.tostring((lvlR - close) / close * 100, "#.#") + "%)") + "   ·   " + (na(lvlS) or lvlSfar ? "support — none within " + f_n0(lvlMaxATR) + " ATR" : "support " + f_px(lvlS) + lvlSsrc + " (" + str.tostring((lvlS - close) / close * 100, "#.#") + "%)") + (not boFlipLive or (not na(lvlS) and math.abs(boFlipLvl - lvlS) < syminfo.mintick) ? "" : "   ·   flip " + f_px(boFlipLvl) + (boFlipRe ? " ✓held" : " ·untested")), color.new(color.olive, 0))
            _r := _r + 1
            f_cellL(_t, 0, _r, "STRUCTURE", cP24)
            f_cellL(_t, 1, _r, (flagWord == "" ? "" : flagWord + (na(flagTgtUp) and na(flagTgtDn) ? "" : " → target " + str.tostring(nz(flagTgtUp, flagTgtDn), format.mintick)) + "   ·   ") + (suIsBase ? f_n0(suBars) + "-bar base " + f_px(suLo) + "-" + f_px(suHi) : "no base") + (suSqz ? "  · SQUEEZE" : "") + (suNewATH ? "  · AT ALL-TIME HIGH" : suNew52 ? "  · at 52w high" : "") + "   ·   " + wgType + (wgApexOk ? " (apex " + f_n0(wgApexN) + " bars)" : "") + (wgType == "—" or na(wgTgt) ? "" : " broke " + (wgDnBrk ? "DOWN" : "UP") + ", target " + f_px(wgTgt)) + (not suIsBase or na(suTgt1) ? "" : "   ·   measured move " + f_px(suTgt1)), color.new(#2962ff, 0))
            _r := _r + 1
        cCol = botMature ? cP9 : botConf ? cP4 : botNeedN - botScr <= 1 ? color.new(color.orange, 10) : botScr >= 2 ? cP11 : color.new(#b71c1c, 10)
        f_cellL(_t, 0, _r, "BOTTOM", color.new(#00bfa5, 0))
        f_cellL(_t, 1, _r, botCall, cCol)
        _r := _r + 1
        if not boSlim
            f_cellL(_t, 0, _r, "BOTTOM — WHY", color.new(#00bfa5, 15))
            f_cellL(_t, 1, _r, botSay, bCol)
            _r := _r + 1
        f_cellL(_t, 0, _r, "LONG TERM", color.new(#1b5e20, 10))
        f_cellL(_t, 1, _r, ltBad ? exitSay : bigSay, ltCol)
        _r := _r + 1
        f_cellL(_t, 0, _r, "★ FINAL CALL", cP8)
        f_cellL(_t, 1, _r, fcSay, fcN >= fcMax and not ltDown ? color.new(#1b5e20, 0) : fcN >= 4 ? cP13 : fcN == 3 ? cP3 : fcN >= 1 ? cP11 : color.new(#b71c1c, 0))
    0

boPosMap = boPos == "Top Right" ? position.top_right : boPos == "Top Left" ? position.top_left : boPos == "Middle Right" ? position.middle_right : boPos == "Bottom Left" ? position.bottom_left : position.bottom_right
var table bot = table.new(boPosMap, 2, 26, border_width = 2)

// ── CHART SYNC MODE — remove only what drags the axis ───
f_syncWipe() =>
    if barstate.islast and syncMode
        line.delete(proResLn)
    line.delete(proSupLn)
    line.delete(proChLn)
    line.delete(proKRLn)
    line.delete(proKSLn)
    label.delete(proResLb)
    label.delete(proSupLb)
    label.delete(proKRLb)
    label.delete(proKSLb)
    line.delete(lnR1)
    line.delete(lnR2)
    line.delete(lnR3)
    line.delete(lnS1)
    line.delete(lnS2)
    line.delete(lnS3)
    label.delete(lbR1)
    label.delete(lbS1)
    line.delete(flipLn)
    label.delete(flipLb)
    line.delete(tlUpLn)
    line.delete(tlLoLn)
    0

f_boSummary(bot)
f_syncWipe()

alertcondition(boBrkHorzUp, title = "v64 BREAKOUT — defended level", message = "{{ticker}} {{interval}}: closed above a defended level at {{close}}")
alertcondition(boBrkHorzDn, title = "v64 BREAKDOWN — defended level", message = "{{ticker}} {{interval}}: closed below a defended level at {{close}}")
alertcondition(suBaseBrk, title = "v64 BASE BREAKOUT (out of a long consolidation)", message = "{{ticker}} {{interval}}: closed above a multi-bar base at {{close}}")
alertcondition(suATHBrk,  title = "v64 NEW ALL-TIME HIGH", message = "{{ticker}} {{interval}}: new all-time high at {{close}} — no overhead supply")
alertcondition(profReclaim, title = "v64 RECLAIMED the weekly 9 EMA", message = "{{ticker}} {{interval}}: closed back above the 9-week EMA at {{close}} — the method's entry")
alertcondition(profLost,    title = "v64 LOST the weekly 9 EMA", message = "{{ticker}} {{interval}}: closed below the 9-week EMA at {{close}} — the method's exit")
alertcondition(profRespect, title = "v64 RESPECTED the weekly 9 EMA (pullback held)", message = "{{ticker}} {{interval}}: wicked into the 9-week EMA and closed above at {{close}}")
alertcondition(flagBrkUp, title = "v64 BULL FLAG breakout", message = "{{ticker}} {{interval}}: broke out of a bull flag at {{close}} — pole measured move projected")
alertcondition(flagBrkDn, title = "v64 BEAR FLAG breakdown", message = "{{ticker}} {{interval}}: broke down from a bear flag at {{close}}")
alertcondition(boFailUp, title = "v64 FAILED BREAKOUT (closed back under the level)", message = "{{ticker}} {{interval}}: closed back UNDER a level it had broken — failed breakout at {{close}}")
alertcondition(boFailDn, title = "v64 FAILED BREAKDOWN (closed back above the level)", message = "{{ticker}} {{interval}}: closed back ABOVE a level it had broken down through at {{close}}")
alertcondition(patNew and patDir == 1, title = "v64 REVERSAL PATTERN confirmed — bullish", message = "{{ticker}} {{interval}}: a bullish reversal pattern (double/triple bottom or inverse head and shoulders) confirmed its neckline at {{close}}")
alertcondition(patNew and patDir == -1, title = "v64 REVERSAL PATTERN confirmed — bearish", message = "{{ticker}} {{interval}}: a bearish reversal pattern (double/triple top or head and shoulders) confirmed its neckline at {{close}}")
alertcondition(gcX, title = "v64 GOLDEN CROSS (50-bar over 200-bar)", message = "{{ticker}} {{interval}}: the 50-bar MA crossed above the 200-bar MA at {{close}}")
alertcondition(dcX, title = "v64 DEATH CROSS (50-bar under 200-bar)", message = "{{ticker}} {{interval}}: the 50-bar MA crossed below the 200-bar MA at {{close}}")
