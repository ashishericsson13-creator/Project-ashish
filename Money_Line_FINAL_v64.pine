[st9, sd9, sf9, sq9] = request.security(s9, scanTF, f_scanTrend(), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true, currency = scanNoFx ? currency.NONE : syminfo.currency, calc_bars_count = scanBars)
